      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">Atmos</string>
          <string name="Source"><![CDATA[-- Lighting for a track theme (sky haze, sun, bloom, colour grading). Runs on
-- each client: racers see the track's theme while lobby players keep the
-- carnival look, since Lighting changes made on a client stay on that client.

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local function child(parent: Instance, name: string): Instance
	return parent:FindFirstChild(name) or parent:WaitForChild(name)
end
local Tracks = require(child(child(ReplicatedStorage, "Shared"), "Tracks"))

local Atmos = {}

local function rgb(c: { number }): Color3
	return Color3.fromRGB(c[1], c[2], c[3])
end

-- Sky, sun and colour grading for a theme. Replaces the previous track's.
function Atmos.applyTheme(theme: any)
	for _, name in { "KartAtmosphere", "KartBloom", "KartGrade", "KartSunRays" } do
		local old = Lighting:FindFirstChild(name)
		if old then
			old:Destroy()
		end
	end
	Lighting.ClockTime = theme.clock
	Lighting.Brightness = theme.brightness
	Lighting.Ambient = rgb(theme.ambient)
	Lighting.OutdoorAmbient = rgb(theme.ambient)
	Lighting.GlobalShadows = true
	Lighting.EnvironmentDiffuseScale = 0.5
	Lighting.EnvironmentSpecularScale = 0.5

	local a = theme.atmosphere
	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Name = "KartAtmosphere"
	atmosphere.Density = a.density
	atmosphere.Haze = a.haze
	atmosphere.Glare = a.glare
	atmosphere.Color = rgb(a.color)
	atmosphere.Decay = rgb(a.decay)
	atmosphere.Parent = Lighting

	local bloom = Instance.new("BloomEffect")
	bloom.Name = "KartBloom"
	bloom.Intensity = theme.bloom
	bloom.Size = 24
	bloom.Threshold = 0.9
	bloom.Parent = Lighting

	local grade = Instance.new("ColorCorrectionEffect")
	grade.Name = "KartGrade"
	grade.TintColor = rgb(theme.tint)
	grade.Saturation = theme.saturation
	grade.Contrast = 0.08
	grade.Parent = Lighting

	local rays = Instance.new("SunRaysEffect")
	rays.Name = "KartSunRays"
	rays.Intensity = if theme.clock > 6 and theme.clock < 19 then 0.08 else 0
	rays.Spread = 0.6
	rays.Parent = Lighting
end

function Atmos.apply(themeId: string)
	local theme = Tracks.Themes[themeId] or Tracks.Themes.carnival
	Atmos.applyTheme(theme)
end

return Atmos
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">KartRig</string>
          <string name="Source"><![CDATA[-- Builds a kart and connects KartPhysics to Roblox physics. Shared by the
-- server (CPU karts) and the client (your own kart, which you own physics for).
--
-- How it looks alive: the body hangs off the ball on a Motor6D ("BodyJoint")
-- and each wheel has its own Motor6D, so clients (client/KartVisuals) can
-- lean the body into turns, bounce the suspension, flip it for tricks, steer
-- the front wheels and spin all of them, without touching the physics.
--
-- How it moves: an invisible sphere carries the kart. A LinearVelocity pushes
-- it horizontally at the speed KartPhysics wants (vertical is left to
-- gravity, so hills and jumps just work), and an AlignOrientation turns the
-- visible body to match the heading and the slope of the road.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- FindFirstChild first so the smoke test (Lune has no WaitForChild) can load this.
local function child(parent: Instance, name: string): Instance
	return parent:FindFirstChild(name) or parent:WaitForChild(name)
end

local Shared = child(ReplicatedStorage, "Shared")
local KartPhysics = require(child(Shared, "KartPhysics"))
local KartBodies = require(child(Shared, "KartBodies"))
local Karts = require(child(Shared, "Karts"))

local KartRig = {}

KartRig.BallRadius = 2
local BODY_DROP = 1.0 -- body center sits this far below the ball center

local function weld(a: BasePart, b: BasePart)
	local w = Instance.new("WeldConstraint")
	w.Part0 = a
	w.Part1 = b
	w.Parent = b
end

local function visual(model: Model, root: BasePart, name: string, size: Vector3, offset: CFrame, color: Color3, material: Enum.Material?, shape: string?, weldTo: BasePart?): BasePart
	local p: BasePart
	if shape == "Wedge" then
		p = Instance.new("WedgePart")
	else
		local part = Instance.new("Part")
		if shape == "Ball" then
			part.Shape = Enum.PartType.Ball
		elseif shape == "Cylinder" then
			part.Shape = Enum.PartType.Cylinder
		end
		p = part
	end
	p.Name = name
	p.Size = size
	p.CFrame = root.CFrame * offset
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = model
	weld(weldTo or root, p)
	return p
end

local function motor(name: string, part0: BasePart, part1: BasePart, c0: CFrame): Motor6D
	local m = Instance.new("Motor6D")
	m.Name = name
	m.Part0 = part0
	m.Part1 = part1
	m.C0 = c0
	m.C1 = CFrame.new()
	m.Parent = part0
	return m
end

local function rgb(c: { number }): Color3
	return Color3.fromRGB(c[1], c[2], c[3])
end

-- Colour and material for each body part role.
local function roleStyle(role: string, main: Color3, accent: Color3): (Color3, Enum.Material, number)
	if role == "main" then
		return main, Enum.Material.SmoothPlastic, 0
	elseif role == "accent" then
		return accent, Enum.Material.SmoothPlastic, 0
	elseif role == "glass" then
		return Color3.fromRGB(150, 210, 255), Enum.Material.Glass, 0.45
	elseif role == "chrome" then
		return Color3.fromRGB(205, 210, 220), Enum.Material.Metal, 0
	elseif role == "light" then
		return Color3.fromRGB(255, 250, 220), Enum.Material.Neon, 0
	end
	return Color3.fromRGB(35, 35, 40), Enum.Material.SmoothPlastic, 0
end

-- `cf` is where the kart should sit on the road (position on the surface).
-- `look` picks the body design and paint (see KartBodies); stats come from `kartId`.
function KartRig.build(kartId: string, driverName: string, cf: CFrame, parent: Instance, look: KartBodies.Look?): Model
	local def = Karts.get(kartId)
	local chosen = look or { body = KartBodies.Default, main = 1, accent = 10 }
	local body = KartBodies.get(chosen.body)
	local main = rgb(KartBodies.color(chosen.main))
	local accent = rgb(KartBodies.color(chosen.accent))

	local model = Instance.new("Model")
	model.Name = driverName

	local root = Instance.new("Part")
	root.Name = "Root"
	root.Shape = Enum.PartType.Ball
	root.Size = Vector3.one * KartRig.BallRadius * 2
	root.CFrame = cf + Vector3.new(0, KartRig.BallRadius + 0.2, 0)
	root.Transparency = 1
	-- No friction: the LinearVelocity decides speed, walls just deflect.
	root.CustomPhysicalProperties = PhysicalProperties.new(0.6 + def.stats.weight * 0.25, 0, 0.1, 100, 1)
	root.Parent = model
	model.PrimaryPart = root

	local center = Instance.new("Attachment")
	center.Name = "Center"
	center.Parent = root

	local drive = Instance.new("LinearVelocity")
	drive.Name = "Drive"
	drive.Attachment0 = center
	drive.RelativeTo = Enum.ActuatorRelativeTo.World
	drive.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
	drive.ForceLimitMode = Enum.ForceLimitMode.PerAxis
	drive.MaxAxesForce = Vector3.zero
	drive.VectorVelocity = Vector3.zero
	drive.Parent = root

	local align = Instance.new("AlignOrientation")
	align.Name = "Align"
	align.Mode = Enum.OrientationAlignmentMode.OneAttachment
	align.Attachment0 = center
	align.MaxTorque = math.huge
	align.Responsiveness = 40
	align.CFrame = cf.Rotation
	align.Parent = root

	local drop = CFrame.new(0, -BODY_DROP, 0)
	-- Everything that leans and bounces hangs off this invisible part.
	local bodyRoot = Instance.new("Part")
	bodyRoot.Name = "BodyRoot"
	bodyRoot.Size = Vector3.one
	bodyRoot.CFrame = root.CFrame * drop
	bodyRoot.Transparency = 1
	bodyRoot.CanCollide = false
	bodyRoot.CanQuery = false
	bodyRoot.CanTouch = false
	bodyRoot.Massless = true
	bodyRoot.Parent = model
	motor("BodyJoint", root, bodyRoot, drop)

	for i, part in body.parts do
		local color, material, transparency = roleStyle(part.role, main, accent)
		local rot = part.rotation or { 0, 0, 0 }
		local offset = drop
			* CFrame.new(part.offset[1], part.offset[2], part.offset[3])
			* CFrame.Angles(math.rad(rot[1]), math.rad(rot[2]), math.rad(rot[3]))
		local p = visual(model, root, `Body{i}`, Vector3.new(part.size[1], part.size[2], part.size[3]), offset, color, material, part.shape, bodyRoot)
		p.Transparency = transparency
	end
	local ex = body.exhaust
	local exhaust = visual(model, root, "Exhaust", Vector3.new(1.2, 0.6, 0.4), drop * CFrame.new(ex[1], ex[2], ex[3]), Color3.fromRGB(255, 140, 40), Enum.Material.Neon, nil, bodyRoot)
	exhaust.Transparency = 1
	local puff = Instance.new("ParticleEmitter")
	puff.Name = "ExhaustPuff"
	puff.Texture = "rbxasset://textures/particles/smoke_main.dds"
	puff.Color = ColorSequence.new(Color3.fromRGB(235, 235, 245))
	puff.Size = NumberSequence.new(0.5, 1.6)
	puff.Transparency = NumberSequence.new(0.5, 1)
	puff.Lifetime = NumberRange.new(0.4, 0.7)
	puff.Speed = NumberRange.new(3, 6)
	puff.EmissionDirection = Enum.NormalId.Back
	puff.Rate = 6
	puff.Parent = exhaust

	-- Wheels sit on the road: the body's center rides BODY_DROP below the ball's center.
	local groundToBody = KartRig.BallRadius - BODY_DROP
	local wheelY = body.wheelRadius - groundToBody
	local rearZ = -math.huge
	for _, w in body.wheels do
		rearZ = math.max(rearZ, w[2])
	end
	for i, w in body.wheels do
		local name = if w[2] >= rearZ then (if w[1] < 0 then "WheelRL" else "WheelRR") else `Wheel{i}`
		local d = body.wheelRadius * 2
		local wheelCf = drop * CFrame.new(w[1], wheelY, w[2])
		local wheel = Instance.new("Part")
		wheel.Name = name
		wheel.Shape = Enum.PartType.Cylinder
		wheel.Size = Vector3.new(body.wheelWidth, d, d)
		wheel.CFrame = root.CFrame * wheelCf
		wheel.Color = Color3.fromRGB(26, 26, 30)
		wheel.Material = Enum.Material.SmoothPlastic
		wheel.CanCollide = false
		wheel.CanQuery = false
		wheel.CanTouch = false
		wheel.Massless = true
		wheel.Parent = model
		-- Wheels turn on their own joint: front ones steer, all of them spin.
		local joint = motor("WheelJoint", root, wheel, wheelCf)
		joint:SetAttribute("Front", w[2] < rearZ)
		visual(model, root, `{name}Hub`, Vector3.new(body.wheelWidth + 0.06, d * 0.55, d * 0.55), wheelCf, accent, Enum.Material.SmoothPlastic, "Cylinder", wheel)
		-- A spoke so you can see the wheel turning.
		visual(model, root, `{name}Spoke`, Vector3.new(body.wheelWidth + 0.08, d * 0.5, d * 0.14), wheelCf, Color3.fromRGB(240, 240, 245), Enum.Material.SmoothPlastic, nil, wheel)
		if w[2] >= rearZ then
			local sparks = Instance.new("ParticleEmitter")
			sparks.Name = "DriftSparks"
			sparks.Texture = "rbxasset://textures/particles/sparkles_main.dds"
			sparks.Size = NumberSequence.new(0.5, 0)
			sparks.Lifetime = NumberRange.new(0.15, 0.3)
			sparks.Speed = NumberRange.new(8, 14)
			sparks.SpreadAngle = Vector2.new(40, 40)
			sparks.EmissionDirection = Enum.NormalId.Back
			sparks.Rate = 60
			sparks.LightEmission = 1
			sparks.Enabled = false
			sparks.Parent = wheel
		end
	end

	local seatPos = body.seat
	local seat = Instance.new("Seat")
	seat.Name = "DriverSeat"
	seat.Size = Vector3.new(2, 0.4, 2)
	seat.CFrame = root.CFrame * drop * CFrame.new(seatPos[1], seatPos[2], seatPos[3])
	seat.Transparency = 1
	seat.CanCollide = false
	seat.Massless = true
	seat.Parent = model
	weld(bodyRoot, seat)

	local tag = Instance.new("BillboardGui")
	tag.Name = "NameTag"
	tag.Size = UDim2.new(0, 120, 0, 24)
	tag.StudsOffset = Vector3.new(0, 5, 0)
	tag.MaxDistance = 150
	tag.Adornee = root
	tag.Parent = model
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.4
	label.Text = driverName
	label.Parent = tag

	model:SetAttribute("KartId", def.id)
	model:SetAttribute("Body", body.id)
	model:SetAttribute("WheelRadius", body.wheelRadius)
	model.Parent = parent
	return model
end

export type Sensed = { grounded: boolean, normal: Vector3, position: Vector3 }

-- Raycasts for the road under the kart. `ignore` should hold every kart.
function KartRig.sense(model: Model, params: RaycastParams): Sensed
	local root = model.PrimaryPart :: BasePart
	local hit = workspace:Raycast(root.Position, Vector3.new(0, -(KartRig.BallRadius + 1.5), 0), params)
	return {
		grounded = hit ~= nil,
		normal = if hit then hit.Normal else Vector3.yAxis,
		position = root.Position,
	}
end

-- If something (a wall, another kart) is holding the kart back, let the
-- simulated speed drop to what the kart is really doing.
function KartRig.sync(model: Model, s: KartPhysics.State)
	local root = model.PrimaryPart :: BasePart
	local fx, fz = KartPhysics.forward(s.yaw)
	local actual = root.AssemblyLinearVelocity.X * fx + root.AssemblyLinearVelocity.Z * fz
	if s.speed > 20 and actual < s.speed * 0.6 then
		s.speed += (math.max(actual, 0) - s.speed) * 0.25
	end
end

function KartRig.apply(model: Model, s: KartPhysics.State, sensed: Sensed)
	local root = model.PrimaryPart :: BasePart
	local drive = root:FindFirstChild("Drive") :: LinearVelocity
	local align = root:FindFirstChild("Align") :: AlignOrientation

	local fx, fz = KartPhysics.forward(s.yaw)
	local force = root.AssemblyMass * (if sensed.grounded then 400 else 60)
	drive.MaxAxesForce = Vector3.new(force, 0, force)
	drive.VectorVelocity = Vector3.new(fx * s.speed, 0, fz * s.speed)

	local vyaw = KartPhysics.visualYaw(s)
	local look = Vector3.new(-math.sin(vyaw), 0, -math.cos(vyaw))
	local up = sensed.normal
	local right = look:Cross(up).Unit
	align.CFrame = CFrame.fromMatrix(Vector3.zero, right, up)
end

-- Effects every viewer sees: drift sparks by mini-turbo level, exhaust flame on boost.
local SPARK_COLORS = {
	Color3.fromRGB(80, 170, 255),
	Color3.fromRGB(255, 150, 40),
	Color3.fromRGB(200, 90, 255),
}
function KartRig.setEffects(model: Model, driftLevel: number, boosting: boolean)
	for _, name in { "WheelRL", "WheelRR" } do
		local wheel = model:FindFirstChild(name)
		local sparks = wheel and wheel:FindFirstChild("DriftSparks") :: ParticleEmitter?
		if sparks then
			sparks.Enabled = driftLevel > 0
			if driftLevel > 0 then
				sparks.Color = ColorSequence.new(SPARK_COLORS[driftLevel])
			end
		end
	end
	local exhaust = model:FindFirstChild("Exhaust") :: BasePart?
	if exhaust then
		exhaust.Transparency = if boosting then 0.1 else 1
	end
end

-- Puts a kart back on the road (after falling off, or on the grid).
function KartRig.place(model: Model, cf: CFrame)
	local root = model.PrimaryPart :: BasePart
	model:PivotTo(cf + Vector3.new(0, KartRig.BallRadius + 0.2, 0))
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
	local align = root:FindFirstChild("Align") :: AlignOrientation
	align.CFrame = cf.Rotation
	local drive = root:FindFirstChild("Drive") :: LinearVelocity
	drive.VectorVelocity = Vector3.zero
end

return KartRig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Shapes</string>
          <string name="Source"><![CDATA[-- Rounded building blocks for a smooth cartoon look without imported meshes:
-- ellipsoids (stretched spheres), discs, capsules and rounded boxes. Every
-- shape is one or a few anchored parts with smooth plastic.
--
-- Ellipsoids use a SpecialMesh sphere, which stretches to the part's size.
-- These are stand-ins: custom MeshParts made in Blender look better and can
-- replace any of them later.

local Shapes = {}

export type Style = {
	color: Color3,
	material: Enum.Material?,
	transparency: number?,
	reflectance: number?,
	collide: boolean?,
	anchored: boolean?,
	name: string?,
}

local function apply(p: BasePart, style: Style, parent: Instance?)
	p.Name = style.name or p.Name
	p.Anchored = if style.anchored == nil then true else style.anchored
	p.CanCollide = style.collide == true
	p.CanQuery = style.collide == true
	p.CanTouch = false
	p.Color = style.color
	p.Material = style.material or Enum.Material.SmoothPlastic
	p.Transparency = style.transparency or 0
	p.Reflectance = style.reflectance or 0
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if parent then
		p.Parent = parent
	end
end

function Shapes.box(parent: Instance?, size: Vector3, cf: CFrame, style: Style): Part
	local p = Instance.new("Part")
	p.Size = size
	p.CFrame = cf
	apply(p, style, parent)
	return p
end

function Shapes.ball(parent: Instance?, diameter: number, cf: CFrame, style: Style): Part
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Ball
	p.Size = Vector3.one * diameter
	p.CFrame = cf
	apply(p, style, parent)
	return p
end

-- A stretched sphere filling `size`.
function Shapes.ellipsoid(parent: Instance?, size: Vector3, cf: CFrame, style: Style): Part
	local p = Instance.new("Part")
	p.Size = size
	p.CFrame = cf
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = p
	apply(p, style, parent)
	return p
end

-- A cylinder standing upright (height along y).
function Shapes.pillar(parent: Instance?, diameter: number, height: number, cf: CFrame, style: Style): Part
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Cylinder
	p.Size = Vector3.new(height, diameter, diameter)
	p.CFrame = cf * CFrame.Angles(0, 0, math.rad(90))
	apply(p, style, parent)
	return p
end

-- A flat round disc lying on the ground (thickness along y).
function Shapes.disc(parent: Instance?, diameter: number, thickness: number, cf: CFrame, style: Style): Part
	return Shapes.pillar(parent, diameter, thickness, cf, style)
end

-- A cylinder lying along local x (wheels, pipes, logs).
function Shapes.tube(parent: Instance?, diameter: number, length: number, cf: CFrame, style: Style): Part
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Cylinder
	p.Size = Vector3.new(length, diameter, diameter)
	p.CFrame = cf
	apply(p, style, parent)
	return p
end

-- Upright capsule: a pillar with ball ends.
function Shapes.capsule(parent: Instance?, diameter: number, height: number, cf: CFrame, style: Style): { Part }
	local body = math.max(height - diameter, 0.05)
	return {
		Shapes.pillar(parent, diameter, body, cf, style),
		Shapes.ball(parent, diameter, cf * CFrame.new(0, body / 2, 0), style),
		Shapes.ball(parent, diameter, cf * CFrame.new(0, -body / 2, 0), style),
	}
end

-- A box with rounded vertical edges (four corner cylinders and two inner
-- boxes). Good for buildings, signs and counters.
function Shapes.roundedBox(parent: Instance?, size: Vector3, radius: number, cf: CFrame, style: Style): { Part }
	local r = math.min(radius, size.X / 2, size.Z / 2)
	local parts = {
		Shapes.box(parent, Vector3.new(size.X - r * 2, size.Y, size.Z), cf, style),
		Shapes.box(parent, Vector3.new(size.X, size.Y, size.Z - r * 2), cf, style),
	}
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			table.insert(parts, Shapes.pillar(parent, r * 2, size.Y, cf * CFrame.new(sx * (size.X / 2 - r), 0, sz * (size.Z / 2 - r)), style))
		end
	end
	return parts
end

-- A semicircular arch made of short segments (tunnels, doors, gates).
function Shapes.arch(parent: Instance?, span: number, thickness: number, depth: number, cf: CFrame, style: Style, segments: number?): { Part }
	local n = segments or 12
	local radius = span / 2
	local parts = {}
	for i = 0, n - 1 do
		local a0 = math.pi * i / n
		local a1 = math.pi * (i + 1) / n
		local mid = (a0 + a1) / 2
		local len = 2 * radius * math.sin((a1 - a0) / 2) + thickness * 0.3
		local pos = CFrame.new(math.cos(mid) * radius, math.sin(mid) * radius, 0)
		table.insert(parts, Shapes.box(parent, Vector3.new(len, thickness, depth), cf * pos * CFrame.Angles(0, 0, mid - math.pi / 2), style))
	end
	return parts
end

return Shapes
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Folder" referent="6">
      <Properties>
        <string name="Name">Shared</string>
      </Properties>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">AIDriver</string>
          <string name="Source"><![CDATA[--!strict
-- CPU driving: look ahead along the centerline, steer toward a point in the
-- driver's preferred lane, drift through long corners, ease off in hairpins.

local KartPhysics = require("./KartPhysics")
local Karts = require("./Karts")
local Track = require("./Track")

export type Profile = {
	lane: number, -- -1..1 preferred side of the road
	skill: number, -- 0..1
}

local AIDriver = {}

-- Signed angle from the kart's heading to a world direction; positive = turn right.
function AIDriver.angleTo(yaw: number, dx: number, dz: number): number
	local fx, fz = KartPhysics.forward(yaw)
	return math.atan2(fx * dz - fz * dx, fx * dx + fz * dz)
end

function AIDriver.input(
	track: Track.Built,
	proj: Track.Projection,
	pos: Track.Vec,
	s: KartPhysics.State,
	stats: Karts.KartStats,
	profile: Profile
): KartPhysics.Input
	local lookahead = 28 + math.max(s.speed, 0) * 0.42
	local target, tangent = Track.at(track, proj.distance + lookahead)
	-- Lane offset: right of travel is (-tz, tx) in this coordinate frame.
	local tl = math.sqrt(tangent.x * tangent.x + tangent.z * tangent.z)
	local rx, rz = -tangent.z / tl, tangent.x / tl
	local laneOffset = profile.lane * track.def.width * 0.28
	local tx = target.x + rx * laneOffset - pos.x
	local tz = target.z + rz * laneOffset - pos.z

	local angle = AIDriver.angleTo(s.yaw, tx, tz)
	local steer = math.clamp(angle * 2.4, -1, 1)

	local throttle = 1
	if math.abs(angle) > 0.7 and s.speed > stats.topSpeed * 0.6 then
		throttle = 0.2
	end

	-- Drift through bends that will last a while; skilled drivers drift more.
	local drift = false
	local farTarget = Track.at(track, proj.distance + lookahead * 2)
	local farAngle = AIDriver.angleTo(s.yaw, farTarget.x - pos.x, farTarget.z - pos.z)
	if s.drift ~= 0 then
		drift = math.sign(angle) == s.drift and math.abs(angle) > 0.06
	elseif math.abs(farAngle) > 0.35 - 0.12 * profile.skill and math.abs(angle) > 0.12 and math.sign(farAngle) == math.sign(angle) then
		drift = true
	end

	return { throttle = throttle, steer = steer, drift = drift, grounded = true, surface = "road" }
end

return AIDriver
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Items</string>
          <string name="Source"><![CDATA[--!strict
-- Item definitions and the item box roll. Front runners mostly get defensive
-- items and modest traps; the middle gets a mix; the back gets more recovery
-- boosts and stronger attacks.
--
-- Every attack has a warning and a counter: rockets can be blocked with a
-- Bubble Shield or dodged sideways, bombs show a fuse, traps sit still where
-- you can see them, and a hit gives a few seconds of protection so nobody
-- gets juggled.

export type ItemDef = {
	id: string,
	name: string,
	icon: string,
	description: string,
	uses: number,
	front: number, -- roll weight in 1st
	back: number, -- roll weight in last
}

local Items = {}

Items.RouletteTime = 1.5 -- seconds of spinning before an item can be used
Items.BoxRespawn = 3
Items.MaxActiveHazards = 16 -- traps and projectiles on the track at once
Items.MaxTrapsPerRacer = 3

-- Tuning shared by server effects and tests.
Items.SodaBoost = 1.4
Items.ShieldTime = 12
Items.RocketSpeed = 170
Items.RocketLife = 6
Items.BombThrow = 45 -- studs ahead it lands
Items.BombFuse = 1.6
Items.BombRadius = 14
Items.JellyLife = 20
Items.JellyHits = 2
Items.JellySlow = 2
Items.MineLife = 25

Items.Defs = {
	turboSoda = { id = "turboSoda", name = "Turbo Soda", icon = "🥤", description = "A fizzy speed boost.", uses = 1, front = 8, back = 30 },
	windupRocket = { id = "windupRocket", name = "Wind-up Rocket", icon = "🚀", description = "Zooms along the road and pops on the first kart it meets. Hold back to fire it behind you.", uses = 1, front = 10, back = 26 },
	popcornBomb = { id = "popcornBomb", name = "Popcorn Bomb", icon = "🍿", description = "Throw it ahead (or drop it behind). Pops after a short fuse.", uses = 1, front = 14, back = 20 },
	jellyPuddle = { id = "jellyPuddle", name = "Jelly Puddle", icon = "🍮", description = "A sticky wobbly trap dropped behind you. Slows whoever drives in.", uses = 1, front = 26, back = 8 },
	bubbleShield = { id = "bubbleShield", name = "Bubble Shield", icon = "🫧", description = "Blocks one attack, then pops.", uses = 1, front = 24, back = 10 },
	springMine = { id = "springMine", name = "Spring Mine", icon = "🌀", description = "A springy trap dropped behind you. Boings karts into the air.", uses = 1, front = 18, back = 6 },
} :: { [string]: ItemDef }

Items.Order = { "turboSoda", "windupRocket", "popcornBomb", "jellyPuddle", "bubbleShield", "springMine" }

-- Weight of one item for a racer at `place` of `field`.
function Items.weight(id: string, place: number, field: number): number
	local def = Items.Defs[id]
	local f = if field > 1 then (place - 1) / (field - 1) else 0.5
	return math.max(def.front + (def.back - def.front) * f, 0)
end

-- r is a random number in [0, 1).
function Items.roll(place: number, field: number, r: number): string
	local total = 0
	for _, id in Items.Order do
		total += Items.weight(id, place, field)
	end
	local pick = r * total
	for _, id in Items.Order do
		pick -= Items.weight(id, place, field)
		if pick < 0 then
			return id
		end
	end
	return Items.Order[1]
end

-- Odds (0..1) of each item, for tests and an "item odds" screen.
function Items.odds(place: number, field: number): { [string]: number }
	local total = 0
	for _, id in Items.Order do
		total += Items.weight(id, place, field)
	end
	local out = {}
	for _, id in Items.Order do
		out[id] = Items.weight(id, place, field) / total
	end
	return out
end

-- Defensive = shield or trap; used to check the front gets more of them.
Items.Defensive = { bubbleShield = true, jellyPuddle = true, springMine = true }
Items.Recovery = { turboSoda = true, windupRocket = true }

return Items
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">KartBodies</string>
          <string name="Source"><![CDATA[--!strict
-- Kart body designs and paint. Bodies are looks only: speed and handling come
-- from the kart class (Karts.luau), so any body can be paired with any class.
--
-- Adding a body: copy one below and change its parts. Each part is a box,
-- ball, cylinder or wedge with a size and an offset from the kart's center
-- (cylinders run along their x size; rotate them to point elsewhere)
-- (x = right, y = up, z = back; the nose points toward -z). `role` picks the
-- colour: main/accent paint, dark trim, glass, chrome or light (glowing).

export type BodyPart = {
	size: { number },
	offset: { number },
	role: "main" | "accent" | "dark" | "glass" | "chrome" | "light",
	shape: ("Block" | "Ball" | "Cylinder" | "Wedge")?,
	rotation: { number }?, -- degrees x, y, z
}

export type Body = {
	id: string,
	name: string,
	wheelRadius: number,
	wheelWidth: number,
	wheels: { { number } }, -- x, z of each wheel; the two with the largest z are rear wheels
	seat: { number }, -- where the driver sits
	exhaust: { number },
	parts: { BodyPart },
}

local KartBodies = {}

KartBodies.Default = "classic"

KartBodies.Palette = {
	{ 230, 60, 60 }, -- red
	{ 255, 140, 40 }, -- orange
	{ 255, 210, 50 }, -- yellow
	{ 120, 220, 90 }, -- lime
	{ 40, 170, 110 }, -- green
	{ 80, 200, 255 }, -- sky
	{ 40, 90, 220 }, -- blue
	{ 140, 80, 230 }, -- purple
	{ 255, 110, 190 }, -- pink
	{ 245, 245, 250 }, -- white
	{ 120, 120, 130 }, -- grey
	{ 25, 25, 30 }, -- black
}

local WHEELS_STANDARD = { { -2.5, -2.4 }, { 2.5, -2.4 }, { -2.5, 2.4 }, { 2.5, 2.4 } }

KartBodies.List = {
	{
		id = "classic",
		name = "Classic",
		wheelRadius = 0.8,
		wheelWidth = 0.9,
		wheels = WHEELS_STANDARD,
		seat = { 0, 0.6, 0.6 },
		exhaust = { 0, 0.6, 3.6 },
		parts = {
			{ size = { 4.6, 0.6, 7 }, offset = { 0, 0, 0 }, role = "dark" },
			{ size = { 4.2, 1.2, 4.4 }, offset = { 0, 0.8, -0.6 }, role = "main" },
			{ size = { 3.4, 0.8, 1.6 }, offset = { 0, 0.5, -3.4 }, role = "main" },
			{ size = { 4.4, 0.25, 1 }, offset = { 0, 2.2, 3.2 }, role = "accent" },
			{ size = { 0.3, 1.4, 0.3 }, offset = { 0, 1.4, 3.2 }, role = "dark" },
			{ size = { 3.6, 0.3, 0.3 }, offset = { 0, 0.7, -4.2 }, role = "chrome" },
		},
	},
	{
		id = "racer",
		name = "Wedge Racer",
		wheelRadius = 0.75,
		wheelWidth = 1,
		wheels = { { -2.6, -2.6 }, { 2.6, -2.6 }, { -2.6, 2.6 }, { 2.6, 2.6 } },
		seat = { 0, 0.5, 0.9 },
		exhaust = { 0, 0.5, 3.9 },
		parts = {
			{ size = { 4.8, 0.5, 7.6 }, offset = { 0, 0, 0 }, role = "dark" },
			{ size = { 3.8, 1, 3.4 }, offset = { 0, 0.6, -2.4 }, role = "main", shape = "Wedge" },
			{ size = { 4.2, 1, 3 }, offset = { 0, 0.6, 1.6 }, role = "main" },
			{ size = { 1, 0.7, 4 }, offset = { -2.1, 0.5, 0.2 }, role = "accent" },
			{ size = { 1, 0.7, 4 }, offset = { 2.1, 0.5, 0.2 }, role = "accent" },
			{ size = { 5, 0.2, 1.2 }, offset = { 0, 2.4, 3.6 }, role = "accent" },
			{ size = { 0.3, 1.6, 0.4 }, offset = { -1.6, 1.5, 3.6 }, role = "dark" },
			{ size = { 0.3, 1.6, 0.4 }, offset = { 1.6, 1.5, 3.6 }, role = "dark" },
			{ size = { 4.2, 0.2, 0.2 }, offset = { 0, 0.4, -4 }, role = "light" },
		},
	},
	{
		id = "buggy",
		name = "Dune Buggy",
		wheelRadius = 1.05,
		wheelWidth = 1.2,
		wheels = { { -2.7, -2.5 }, { 2.7, -2.5 }, { -2.7, 2.5 }, { 2.7, 2.5 } },
		seat = { 0, 0.8, 0.4 },
		exhaust = { 0, 1.2, 3.4 },
		parts = {
			{ size = { 3.6, 0.6, 6.4 }, offset = { 0, 0.2, 0 }, role = "main" },
			{ size = { 3.2, 0.6, 1.2 }, offset = { 0, 0.6, -3.1 }, role = "accent" },
			-- Roll cage
			{ size = { 0.25, 2.6, 0.25 }, offset = { -1.5, 1.8, -0.8 }, role = "chrome" },
			{ size = { 0.25, 2.6, 0.25 }, offset = { 1.5, 1.8, -0.8 }, role = "chrome" },
			{ size = { 0.25, 2.6, 0.25 }, offset = { -1.5, 1.8, 1.8 }, role = "chrome" },
			{ size = { 0.25, 2.6, 0.25 }, offset = { 1.5, 1.8, 1.8 }, role = "chrome" },
			{ size = { 3.25, 0.25, 0.25 }, offset = { 0, 3.1, -0.8 }, role = "chrome" },
			{ size = { 3.25, 0.25, 0.25 }, offset = { 0, 3.1, 1.8 }, role = "chrome" },
			{ size = { 0.25, 0.25, 2.85 }, offset = { -1.5, 3.1, 0.5 }, role = "chrome" },
			{ size = { 0.25, 0.25, 2.85 }, offset = { 1.5, 3.1, 0.5 }, role = "chrome" },
			{ size = { 2.4, 1.4, 1.2 }, offset = { 0, 1, 2.7 }, role = "dark" },
			{ size = { 0.6, 0.6, 0.3 }, offset = { -0.9, 1.1, -3.7 }, role = "light" },
			{ size = { 0.6, 0.6, 0.3 }, offset = { 0.9, 1.1, -3.7 }, role = "light" },
		},
	},
	{
		id = "muscle",
		name = "Muscle",
		wheelRadius = 0.9,
		wheelWidth = 1.3,
		wheels = { { -2.6, -2.6 }, { 2.6, -2.6 }, { -2.6, 2.5 }, { 2.6, 2.5 } },
		seat = { 0, 0.7, 1 },
		exhaust = { 0, 0.5, 3.9 },
		parts = {
			{ size = { 4.4, 1.3, 7.6 }, offset = { 0, 0.5, 0 }, role = "main" },
			{ size = { 1.6, 0.5, 2 }, offset = { 0, 1.35, -2 }, role = "dark" },
			{ size = { 0.8, 1.3, 7.7 }, offset = { 0, 0.52, 0 }, role = "accent" },
			{ size = { 4.5, 0.4, 0.4 }, offset = { 0, 0.1, -3.9 }, role = "chrome" },
			{ size = { 4.5, 0.4, 0.4 }, offset = { 0, 0.1, 3.9 }, role = "chrome" },
			{ size = { 1, 0.45, 0.45 }, offset = { -1.4, 0.2, 4.1 }, role = "chrome", shape = "Cylinder", rotation = { 0, 90, 0 } },
			{ size = { 1, 0.45, 0.45 }, offset = { 1.4, 0.2, 4.1 }, role = "chrome", shape = "Cylinder", rotation = { 0, 90, 0 } },
			{ size = { 1, 0.4, 0.2 }, offset = { -1.5, 0.8, -3.85 }, role = "light" },
			{ size = { 1, 0.4, 0.2 }, offset = { 1.5, 0.8, -3.85 }, role = "light" },
		},
	},
	{
		id = "bubble",
		name = "Bubble",
		wheelRadius = 0.7,
		wheelWidth = 0.9,
		wheels = { { -2.2, -2 }, { 2.2, -2 }, { -2.2, 2 }, { 2.2, 2 } },
		seat = { 0, 0.5, 0.3 },
		exhaust = { 0, 0.5, 3 },
		parts = {
			{ size = { 4.6, 4.6, 4.6 }, offset = { 0, 0.9, 0.2 }, role = "main", shape = "Ball" },
			{ size = { 3.4, 3.4, 3.4 }, offset = { 0, 1.9, -0.4 }, role = "glass", shape = "Ball" },
			{ size = { 4.2, 0.5, 6 }, offset = { 0, -0.1, 0 }, role = "dark" },
			{ size = { 1.2, 1.2, 1.2 }, offset = { -1.4, 0.8, -2.2 }, role = "light", shape = "Ball" },
			{ size = { 1.2, 1.2, 1.2 }, offset = { 1.4, 0.8, -2.2 }, role = "light", shape = "Ball" },
			{ size = { 0.25, 1.8, 0.25 }, offset = { 1.2, 3.6, 1.6 }, role = "dark" },
			{ size = { 0.9, 0.9, 0.9 }, offset = { 1.2, 4.6, 1.6 }, role = "accent", shape = "Ball" },
		},
	},
	{
		id = "formula",
		name = "Formula",
		wheelRadius = 0.85,
		wheelWidth = 1.2,
		wheels = { { -2.8, -2.8 }, { 2.8, -2.8 }, { -2.8, 2.6 }, { 2.8, 2.6 } },
		seat = { 0, 0.5, 0.8 },
		exhaust = { 0, 0.8, 4 },
		parts = {
			{ size = { 1.6, 0.9, 8.4 }, offset = { 0, 0.3, -0.2 }, role = "main" },
			{ size = { 1.2, 0.6, 2 }, offset = { 0, 0.2, -4.8 }, role = "main", shape = "Wedge" },
			{ size = { 5.6, 0.2, 1 }, offset = { 0, -0.1, -4.9 }, role = "accent" },
			{ size = { 1.2, 0.8, 3 }, offset = { -1.4, 0.3, 0.8 }, role = "accent" },
			{ size = { 1.2, 0.8, 3 }, offset = { 1.4, 0.3, 0.8 }, role = "accent" },
			{ size = { 1.2, 1.2, 1.6 }, offset = { 0, 1.1, 2 }, role = "main" },
			{ size = { 4.8, 0.25, 1.2 }, offset = { 0, 2.3, 3.8 }, role = "accent" },
			{ size = { 0.25, 1.4, 0.8 }, offset = { -2.2, 1.6, 3.8 }, role = "dark" },
			{ size = { 0.25, 1.4, 0.8 }, offset = { 2.2, 1.6, 3.8 }, role = "dark" },
			{ size = { 3, 0.2, 0.2 }, offset = { 0, 1.5, -0.6 }, role = "chrome" },
		},
	},
} :: { Body }

export type Look = { body: string, main: number, accent: number }

function KartBodies.get(id: string?): Body
	for _, b in KartBodies.List do
		if b.id == id then
			return b
		end
	end
	return KartBodies.get(KartBodies.Default)
end

function KartBodies.color(index: number?): { number }
	local n = #KartBodies.Palette
	local i = math.clamp(math.floor(tonumber(index) or 1), 1, n)
	return KartBodies.Palette[i]
end

-- Cleans a look sent by a client.
function KartBodies.sanitize(look: any): Look
	local t = if type(look) == "table" then look else {}
	return {
		body = KartBodies.get(t.body).id,
		main = math.clamp(math.floor(tonumber(t.main) or 1), 1, #KartBodies.Palette),
		accent = math.clamp(math.floor(tonumber(t.accent) or 10), 1, #KartBodies.Palette),
	}
end

-- A varied look for CPU driver number n (the same every race).
function KartBodies.cpuLook(n: number): Look
	local body = KartBodies.List[(n - 1) % #KartBodies.List + 1].id
	local main = (n * 5) % #KartBodies.Palette + 1
	local accent = (n * 7 + 4) % #KartBodies.Palette + 1
	if accent == main then
		accent = accent % #KartBodies.Palette + 1
	end
	return { body = body, main = main, accent = accent }
end

return KartBodies
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">KartPhysics</string>
          <string name="Source"><![CDATA[--!strict
-- Arcade kart handling as a pure step function. The same code drives player
-- karts (on their client) and CPU karts (on the server), and runs in tests.
--
-- Drifting: hold drift while turning at speed. The longer you hold it (and the
-- harder you steer into it), the bigger the mini-turbo when you let go:
-- level 1 (blue sparks), 2 (orange), 3 (purple).

local Karts = require("./Karts")

export type State = {
	speed: number, -- forward speed, studs/s (negative = reversing)
	yaw: number, -- heading in radians; forward = (-sin yaw, 0, -cos yaw)
	drift: number, -- 0 = not drifting, -1 = drifting left, 1 = right
	charge: number, -- mini-turbo charge while drifting
	boost: number, -- seconds of boost left
	spin: number, -- seconds left spinning out after a hit
	invincible: number, -- seconds of Overdrive left
	slow: number, -- seconds left stuck in something sticky (jelly, syrup)
	draft: number, -- slipstream charge built up behind another kart
	air: number, -- seconds airborne in the current jump
	trick: number, -- 0 = none, else seconds since a trick started in this jump
}

export type Input = {
	throttle: number, -- -1..1
	steer: number, -- -1 (left) .. 1 (right)
	drift: boolean,
	grounded: boolean,
	surface: string, -- "road" | "offroad" | "boost"
	trick: boolean?, -- drift button pressed this frame (does a trick when airborne)
	drafting: boolean?, -- tucked in behind another kart this frame
}

local KartPhysics = {}

KartPhysics.OffroadFactor = 0.55
KartPhysics.BoostFactor = 1.35
KartPhysics.ReverseFactor = 0.35
KartPhysics.BoostPadTime = 1.0
KartPhysics.ChargeLevels = { 0.9, 1.8, 2.9 } -- charge needed for each mini-turbo
KartPhysics.TurboTimes = { 0.6, 1.1, 1.7 } -- boost seconds each level gives
KartPhysics.SlowFactor = 0.5
KartPhysics.ConveyorFactor = 1.15
KartPhysics.SlipperyGrip = 0.55 -- normal steering on wet ground
KartPhysics.LaunchBoost = 1.2
-- Slipstream: stay behind someone this long to get a boost.
KartPhysics.DraftTime = 1.1
KartPhysics.DraftBoost = 0.9
KartPhysics.DraftRange = { 6, 38 } -- studs behind the kart ahead
KartPhysics.DraftWidth = 5 -- how far off their line you can be
-- Tricks: press drift soon after leaving a ramp, land for a boost.
KartPhysics.TrickWindow = 0.6
KartPhysics.TrickMinAir = 0.25
KartPhysics.TrickBoost = 0.8
KartPhysics.TrickSpinTime = 0.45
KartPhysics.SpinTime = 1.2
KartPhysics.SpinSpeedKeep = 0.3
KartPhysics.DriftSlide = 0.35 -- radians the body swings out while drifting (visual)

function KartPhysics.newState(yaw: number): State
	return { speed = 0, yaw = yaw, drift = 0, charge = 0, boost = 0, spin = 0, invincible = 0, slow = 0, draft = 0, air = 0, trick = 0 }
end

function KartPhysics.chargeLevel(charge: number): number
	local level = 0
	for i, need in KartPhysics.ChargeLevels do
		if charge >= need then
			level = i
		end
	end
	return level
end

function KartPhysics.forward(yaw: number): (number, number)
	return -math.sin(yaw), -math.cos(yaw)
end

-- Top speed for the current surface and boost state.
function KartPhysics.targetTop(stats: Karts.KartStats, s: State, surface: string): number
	local top = stats.topSpeed
	if s.boost > 0 then
		top *= KartPhysics.BoostFactor
	elseif surface == "offroad" then
		top *= KartPhysics.OffroadFactor
	end
	if surface == "sticky" then
		top *= KartPhysics.OffroadFactor
	elseif surface == "conveyor" then
		top *= KartPhysics.ConveyorFactor
	end
	if s.slow > 0 then
		top *= KartPhysics.SlowFactor
	end
	return top
end

-- Where the kart body points: the travel heading plus the drift swing and
-- two full turns while spinning out. Travel direction never changes on a spin.
function KartPhysics.visualYaw(s: State): number
	local spinAngle = 0
	if s.spin > 0 then
		spinAngle = (1 - s.spin / KartPhysics.SpinTime) * math.pi * 4
	end
	-- Drifting right (drift = 1) swings the nose further right, i.e. lower yaw.
	return s.yaw - s.drift * KartPhysics.DriftSlide + spinAngle
end

-- A hit from an item. Overdrive makes you immune.
function KartPhysics.hit(s: State): boolean
	if s.invincible > 0 or s.spin > 0 then
		return false
	end
	s.spin = KartPhysics.SpinTime
	s.speed *= KartPhysics.SpinSpeedKeep
	s.drift = 0
	s.charge = 0
	s.boost = 0
	return true
end

-- Sticky traps: half speed for a while, no spin.
function KartPhysics.slow(s: State, seconds: number)
	if s.invincible > 0 then
		return
	end
	s.slow = math.max(s.slow, seconds)
	s.boost = 0
end

function KartPhysics.giveBoost(s: State, seconds: number)
	s.boost = math.max(s.boost, seconds)
end

function KartPhysics.overdrive(s: State, seconds: number)
	s.invincible = math.max(s.invincible, seconds)
	s.boost = math.max(s.boost, seconds)
	s.spin = 0
end

local function approach(value: number, target: number, rate: number): number
	if value < target then
		return math.min(value + rate, target)
	end
	return math.max(value - rate, target)
end

-- Is a kart at (px, pz) heading `yaw` tucked in behind any of `others`?
function KartPhysics.isDrafting(px: number, pz: number, yaw: number, others: { { x: number, z: number } }): boolean
	local fx, fz = KartPhysics.forward(yaw)
	for _, o in others do
		local dx, dz = o.x - px, o.z - pz
		local ahead = dx * fx + dz * fz
		local side = math.abs(dx * -fz + dz * fx)
		if ahead >= KartPhysics.DraftRange[1] and ahead <= KartPhysics.DraftRange[2] and side <= KartPhysics.DraftWidth then
			return true
		end
	end
	return false
end

-- Extra roll (radians) for the trick animation: one full barrel roll.
function KartPhysics.trickRoll(s: State): number
	if s.trick <= 0 then
		return 0
	end
	return math.clamp(s.trick / KartPhysics.TrickSpinTime, 0, 1) * math.pi * 2
end

-- Events returned by step: mini-turbo levels 1..3 as numbers, plus these.
KartPhysics.Events = { Trick = 10, Draft = 11 }

-- Advances the kart by dt. Mutates and returns the state, plus what happened
-- this step for sound/effects: a mini-turbo level (1..3), Events.Trick when a
-- trick lands, Events.Draft when a slipstream boost kicks in, or 0.
function KartPhysics.step(stats: Karts.KartStats, s: State, input: Input, dt: number): (State, number)
	local released = 0
	s.boost = math.max(0, s.boost - dt)
	s.invincible = math.max(0, s.invincible - dt)
	s.slow = math.max(0, s.slow - dt)

	-- Jumps and tricks.
	if not input.grounded then
		s.air += dt
		if s.trick > 0 then
			s.trick += dt
		elseif input.trick and s.air <= KartPhysics.TrickWindow and s.spin <= 0 then
			s.trick = dt
		end
	else
		if s.trick > 0 and s.air >= KartPhysics.TrickMinAir and s.spin <= 0 then
			KartPhysics.giveBoost(s, KartPhysics.TrickBoost)
			released = KartPhysics.Events.Trick
		end
		s.air = 0
		s.trick = 0
	end

	-- Slipstream.
	if input.drafting and input.grounded and s.speed > stats.topSpeed * 0.6 then
		s.draft += dt
		if s.draft >= KartPhysics.DraftTime then
			s.draft = 0
			KartPhysics.giveBoost(s, KartPhysics.DraftBoost)
			released = KartPhysics.Events.Draft
		end
	else
		s.draft = math.max(0, s.draft - dt * 2)
	end

	if input.surface == "boost" then
		KartPhysics.giveBoost(s, KartPhysics.BoostPadTime)
	elseif input.surface == "launch" then
		KartPhysics.giveBoost(s, KartPhysics.LaunchBoost)
	end

	if s.spin > 0 then
		s.spin = math.max(0, s.spin - dt)
		s.speed = approach(s.speed, 0, stats.accel * 1.5 * dt)
		return s, released
	end

	local top = KartPhysics.targetTop(stats, s, input.surface)
	local throttle = math.clamp(input.throttle, -1, 1)
	local steer = math.clamp(input.steer, -1, 1)

	-- Speed ----------------------------------------------------------------
	if s.boost > 0 then
		s.speed = approach(s.speed, top, stats.accel * 3 * dt)
	elseif not input.grounded then
		-- Airborne: hold speed.
	elseif s.speed > top then
		s.speed = approach(s.speed, top, stats.accel * 1.5 * dt)
	elseif throttle > 0 then
		s.speed = approach(s.speed, top * throttle, stats.accel * dt)
	elseif throttle < 0 then
		if s.speed > 0 then
			s.speed = approach(s.speed, 0, stats.accel * 2.5 * dt)
		else
			s.speed = approach(s.speed, -top * KartPhysics.ReverseFactor, stats.accel * 0.8 * dt)
		end
	else
		s.speed = approach(s.speed, 0, stats.accel * 0.6 * dt)
	end

	-- Drift start / release ------------------------------------------------
	if s.drift == 0 then
		if input.drift and input.grounded and math.abs(steer) > 0.3 and s.speed > stats.topSpeed * 0.4 then
			s.drift = if steer > 0 then 1 else -1
			s.charge = 0
		end
	elseif not input.drift or s.speed < stats.topSpeed * 0.3 then
		local level = KartPhysics.chargeLevel(s.charge)
		if level > 0 then
			released = level
			KartPhysics.giveBoost(s, KartPhysics.TurboTimes[level])
		end
		s.drift = 0
		s.charge = 0
	end

	-- Turning ----------------------------------------------------------------
	local turn: number
	if s.drift ~= 0 then
		-- Always turning into the drift; steering into it tightens, against widens.
		turn = s.drift * stats.handling * (0.7 + 0.45 * steer * s.drift)
		if input.grounded then
			s.charge += dt * (1 + math.max(0, steer * s.drift))
		end
	else
		local grip = math.clamp(math.abs(s.speed) / (stats.topSpeed * 0.25), 0, 1)
		if input.surface == "slippery" then
			grip *= KartPhysics.SlipperyGrip
		end
		turn = steer * stats.handling * grip * (if s.speed < 0 then -1 else 1)
	end
	if not input.grounded then
		turn *= 0.4
	end
	-- Positive steer turns right, which is clockwise seen from above: yaw goes down.
	s.yaw -= turn * dt

	return s, released
end

return KartPhysics
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Karts</string>
          <string name="Source"><![CDATA[--!strict
-- Kart bodies players choose before a race. Your Roblox avatar is the driver;
-- the kart sets the handling. Every kart totals the same number of stat
-- points, so the choice is about style, not power.

export type KartStats = {
	topSpeed: number, -- studs/s
	accel: number, -- studs/s^2
	handling: number, -- turn rate in rad/s at full lock
	weight: number, -- 1..5, heavier karts push lighter ones around
}

export type KartDef = {
	id: string,
	name: string,
	blurb: string,
	color: { number },
	stats: KartStats,
}

local Karts = {}

Karts.Default = "classic"

Karts.List = {
	{
		id = "zippy",
		name = "Zippy",
		blurb = "Light and quick off the line. Great for beginners.",
		color = { 80, 200, 255 },
		stats = { topSpeed = 92, accel = 70, handling = 2.3, weight = 1 },
	},
	{
		id = "classic",
		name = "Classic",
		blurb = "Balanced in every way.",
		color = { 230, 60, 60 },
		stats = { topSpeed = 100, accel = 58, handling = 2.2, weight = 3 },
	},
	{
		id = "brute",
		name = "Brute",
		blurb = "Top speed and weight. Slow to get going.",
		color = { 120, 220, 90 },
		stats = { topSpeed = 106, accel = 54, handling = 2.0, weight = 5 },
	},
} :: { KartDef }

function Karts.get(id: string?): KartDef
	for _, k in Karts.List do
		if k.id == id then
			return k
		end
	end
	return Karts.get(Karts.Default)
end

-- CPU drivers that fill empty grid slots. Original characters.
Karts.CpuDrivers = {
	{ name = "Pip", kart = "zippy" },
	{ name = "Nova", kart = "classic" },
	{ name = "Bolt", kart = "brute" },
	{ name = "Mochi", kart = "zippy" },
	{ name = "Rex", kart = "brute" },
	{ name = "Juno", kart = "classic" },
	{ name = "Taffy", kart = "zippy" },
	{ name = "Gizmo", kart = "classic" },
}

return Karts
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">LobbyLayout</string>
          <string name="Source"><![CDATA[--!strict
-- Where everything in the Kart Carnival lobby goes. The lobby sits far from
-- the race tracks (which are built around the world origin), so the two never
-- overlap. Coordinates are world studs; +z is "south", away from the voting area.
--
--            [voting pads + track displays]
--   [podium]       [status board]          [garage + kart displays]
--   [ready arch]     (spawn plaza)         [photo spot]
--   [spectator screen]
--            [practice loop: drift circle, jump ramp, boost tunnel]

local Track = require("./Track")
local v = Track.v

export type Spot = { x: number, y: number, z: number }

local LobbyLayout = {}

local OX, OZ = 0, 5000
local function at(dx: number, dz: number, y: number?): Spot
	return { x = OX + dx, y = y or 0, z = OZ + dz }
end

LobbyLayout.Origin = at(0, 0)
LobbyLayout.Spawn = at(0, 0)
LobbyLayout.PlazaRadius = 46
LobbyLayout.StatusBoard = at(0, -58)
LobbyLayout.VotePads = { at(-52, -112), at(0, -112), at(52, -112) }
LobbyLayout.VotePadSize = 26
LobbyLayout.ReadyArch = at(-72, 0)
LobbyLayout.Garage = at(140, 0)
LobbyLayout.KartDisplays = (function()
	local spots = {}
	for i = 0, 7 do
		table.insert(spots, at(92, -56 + i * 16))
	end
	return spots
end)()
LobbyLayout.Podium = at(-120, -70)
LobbyLayout.SpectatorScreen = at(-130, 60)
LobbyLayout.PhotoSpot = at(120, 110)
LobbyLayout.FerrisWheel = at(-190, -150)

-- Hidden collectibles (stage 5 turns these into coins).
LobbyLayout.Collectibles = {
	at(176, 30, 2), -- behind the garage
	at(-190, -110, 2), -- under the Ferris wheel
	at(120, 132, 2), -- behind the photo wall
	at(-150, 74, 2), -- behind the spectator screen
	at(0, 300, 3), -- inside the boost tunnel
	at(-180, 380, 2), -- far corner of the practice area
}

-- Practice loop: an open area (no walls) south of the plaza.
LobbyLayout.PracticeArea = { min = at(-240, 170), max = at(240, 470) }
LobbyLayout.DriftCircle = { center = at(0, 320), radius = 46 }
LobbyLayout.PracticeTrack = {
	id = "practice",
	name = "Practice Loop",
	theme = "carnival",
	width = 36,
	laps = 1,
	walls = false,
	controls = {
		v(OX + 0, 0, OZ + 200),
		v(OX + 150, 0, OZ + 200),
		v(OX + 205, 0, OZ + 260),
		v(OX + 205, 0, OZ + 380),
		v(OX + 150, 0, OZ + 440),
		v(OX - 150, 0, OZ + 440),
		v(OX - 205, 0, OZ + 380),
		v(OX - 205, 0, OZ + 260),
		v(OX - 150, 0, OZ + 200),
	},
	-- Boost "tunnel" pads on the opening straight; the jump ramp is on the far straight.
	boostPads = { { t = 0.04, offset = 0 }, { t = 0.08, offset = 0 } },
	itemRows = {},
	ramps = { { t = 0.6, offset = 0, width = 18 } },
	difficulty = "Easy",
	feature = "Practice drifting, jumping and boosting",
	icon = "🎡",
} :: Track.TrackDef

function LobbyLayout.inPlaza(x: number, z: number): boolean
	local dx, dz = x - LobbyLayout.Spawn.x, z - LobbyLayout.Spawn.z
	return dx * dx + dz * dz <= LobbyLayout.PlazaRadius * LobbyLayout.PlazaRadius
end

-- Which vote pad (1..3) a position is standing on, if any.
function LobbyLayout.padAt(x: number, z: number): number?
	local half = LobbyLayout.VotePadSize / 2
	for i, pad in LobbyLayout.VotePads do
		if math.abs(x - pad.x) <= half and math.abs(z - pad.z) <= half then
			return i
		end
	end
	return nil
end

return LobbyLayout
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">RaceRules</string>
          <string name="Source"><![CDATA[--!strict
-- Placings, Grand Prix points, the start boost, and how hard CPU drivers push.

local RaceRules = {}

RaceRules.MaxRacers = 8
RaceRules.Points = { 15, 12, 10, 8, 6, 4, 2, 1 }
RaceRules.CountdownSeconds = 3
-- Press the throttle in this window before GO for a rocket start.
RaceRules.StartBoostWindow = { -1.0, -0.35 }
RaceRules.StartBoostTime = 1.0

export type Entry = {
	id: string,
	finished: boolean,
	finishTime: number?,
	score: number, -- Track.score: higher is further ahead
}

-- Finishers by time, then everyone else by how far along they are.
function RaceRules.rank(entries: { Entry }): { Entry }
	local list = table.clone(entries)
	table.sort(list, function(a: Entry, b: Entry): boolean
		if a.finished ~= b.finished then
			return a.finished
		end
		if a.finished and a.finishTime ~= b.finishTime then
			return (a.finishTime :: number) < (b.finishTime :: number)
		end
		if a.score ~= b.score then
			return a.score > b.score
		end
		return a.id < b.id
	end)
	return list
end

function RaceRules.pointsFor(place: number): number
	return RaceRules.Points[place] or 0
end

-- `pressedAt` is when the throttle went down, in seconds relative to GO
-- (negative = before GO). Returns boost seconds (0 = no rocket start).
function RaceRules.startBoost(pressedAt: number?): number
	if not pressedAt then
		return 0
	end
	local lo, hi = RaceRules.StartBoostWindow[1], RaceRules.StartBoostWindow[2]
	if pressedAt >= lo and pressedAt <= hi then
		return RaceRules.StartBoostTime
	end
	return 0
end

-- Top-speed multiplier for a CPU driver. CPUs far behind the leader speed up a
-- little; a CPU running away from every human eases off. Humans never get this.
function RaceRules.cpuSpeedFactor(gapToLeader: number, leadOverBestHuman: number, skill: number): number
	local factor = 0.93 + 0.07 * math.clamp(skill, 0, 1)
	factor += math.clamp(gapToLeader / 600, 0, 1) * 0.1
	if leadOverBestHuman > 120 then
		factor -= math.clamp((leadOverBestHuman - 120) / 400, 0, 1) * 0.08
	end
	return factor
end

export type CupRow = { id: string, name: string, points: number, lastPlace: number }

-- Overall cup standings; ties go to whoever placed better in the last race.
function RaceRules.cupStandings(rows: { CupRow }): { CupRow }
	local list = table.clone(rows)
	table.sort(list, function(a: CupRow, b: CupRow): boolean
		if a.points ~= b.points then
			return a.points > b.points
		end
		return a.lastPlace < b.lastPlace
	end)
	return list
end

return RaceRules
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">RemoteNames</string>
          <string name="Source"><![CDATA[--!strict
-- Names of every RemoteEvent the server creates under ReplicatedStorage.Remotes.

return {
	-- server -> client
	Round = "Round", -- (state) lobby phase, countdowns, vote options, live race summary
	RaceStart = "RaceStart", -- (info) track id, your kart, grid yaw, GO time
	PracticeStart = "PracticeStart", -- (info) your practice kart on the lobby loop
	RaceState = "RaceState", -- (info) standings, your lap/place, about 5x a second
	KartEvent = "KartEvent", -- (kind, value) "spin" | "slow" | "launch" | "boost" | "overdrive" | "respawn" | "warning"
	ItemState = "ItemState", -- (itemId?, uses, readyAt)
	Results = "Results", -- (info) placements and rewards
	Notify = "Notify", -- (text)
	OpenGarage = "OpenGarage", -- () the garage prompt was used
	Spectate = "Spectate", -- () start watching the current race

	-- client -> server
	ChooseKart = "ChooseKart", -- (kartId)
	ChooseLook = "ChooseLook", -- ({ body, main, accent }) body design and paint
	Ready = "Ready", -- (isReady)
	Vote = "Vote", -- (trackId) same as standing on a vote pad
	UseItem = "UseItem", -- (aimBack) aimBack = throw/drop behind you
	Respawn = "Respawn", -- () put my stuck kart back on the road
	LeavePractice = "LeavePractice", -- ()
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">Scenery</string>
          <string name="Source"><![CDATA[--!strict
-- Decides where scenery goes around a track: trees and grandstands on Sunny
-- Loop, rocks and mesas in the canyon, towers and lamps in the neon city.
-- Placement is seeded by the track id, so every server builds the same
-- scenery, and nothing is ever placed on (or too close to) the road.
--
-- To get more or fewer props, change the counts in Scenery.Themes.

local Track = require("./Track")

export type Prop = {
	kind: string,
	x: number,
	y: number,
	z: number,
	size: number, -- 1 = normal, props scale from this
	yaw: number,
}

local Scenery = {}

-- kind = how many, how close to the barrier (min, max studs), size range, footprint radius.
type Rule = { kind: string, count: number, near: number, far: number, minSize: number, maxSize: number, radius: number }

Scenery.Themes = {
	sunny = {
		{ kind = "tree", count = 170, near = 12, far = 220, minSize = 0.8, maxSize = 1.5, radius = 8 },
		{ kind = "bush", count = 80, near = 6, far = 120, minSize = 0.7, maxSize = 1.3, radius = 4 },
		{ kind = "billboard", count = 8, near = 14, far = 30, minSize = 1, maxSize = 1, radius = 14 },
		{ kind = "flag", count = 18, near = 4, far = 10, minSize = 1, maxSize = 1, radius = 3 },
	},
	canyon = {
		{ kind = "mesa", count = 22, near = 60, far = 320, minSize = 0.8, maxSize = 1.8, radius = 40 },
		{ kind = "rock", count = 110, near = 8, far = 200, minSize = 0.6, maxSize = 1.8, radius = 9 },
		{ kind = "cactus", count = 70, near = 8, far = 160, minSize = 0.8, maxSize = 1.4, radius = 4 },
	},
	-- Tiny racers, oversized world: everything here is giant.
	toyroom = {
		{ kind = "toyBlock", count = 70, near = 10, far = 220, minSize = 0.8, maxSize = 1.6, radius = 10 },
		{ kind = "toyBall", count = 30, near = 14, far = 240, minSize = 0.8, maxSize = 1.5, radius = 12 },
		{ kind = "crayon", count = 40, near = 6, far = 160, minSize = 0.9, maxSize = 1.3, radius = 6 },
		{ kind = "book", count = 24, near = 20, far = 240, minSize = 0.9, maxSize = 1.4, radius = 18 },
	},
	kitchen = {
		{ kind = "fruit", count = 60, near = 8, far = 200, minSize = 0.8, maxSize = 1.5, radius = 9 },
		{ kind = "jar", count = 26, near = 16, far = 220, minSize = 0.9, maxSize = 1.5, radius = 12 },
		{ kind = "cookie", count = 40, near = 6, far = 160, minSize = 0.8, maxSize = 1.3, radius = 7 },
		{ kind = "shaker", count = 20, near = 10, far = 180, minSize = 1, maxSize = 1.4, radius = 6 },
	},
	backyard = {
		{ kind = "grassBlade", count = 170, near = 4, far = 200, minSize = 0.7, maxSize = 1.6, radius = 3 },
		{ kind = "flower", count = 60, near = 8, far = 220, minSize = 0.8, maxSize = 1.5, radius = 7 },
		{ kind = "pebble", count = 50, near = 4, far = 180, minSize = 0.6, maxSize = 1.6, radius = 7 },
		{ kind = "mushroom", count = 26, near = 10, far = 200, minSize = 0.8, maxSize = 1.5, radius = 8 },
		{ kind = "clover", count = 50, near = 2, far = 120, minSize = 0.8, maxSize = 1.3, radius = 4 },
	},
	neon = {
		{ kind = "tower", count = 80, near = 30, far = 300, minSize = 0.7, maxSize = 2.2, radius = 24 },
		{ kind = "lamp", count = 60, near = 3, far = 6, minSize = 1, maxSize = 1, radius = 2 },
		{ kind = "billboard", count = 10, near = 14, far = 30, minSize = 1, maxSize = 1, radius = 14 },
	},
} :: { [string]: { Rule } }

-- Small deterministic random generator (exact in doubles).
local function rng(seedText: string): () -> number
	local seed = 1
	for i = 1, #seedText do
		seed = (seed * 31 + string.byte(seedText, i)) % 2147483647
	end
	return function(): number
		seed = (seed * 48271) % 2147483647
		return seed / 2147483647
	end
end

-- Distance from the centerline to just outside the barrier.
function Scenery.barrier(track: Track.Built): number
	return track.def.width / 2 + Track.ShoulderWidth + 1
end

Scenery.SetPieceRadius = 40

-- Where each landmark from the track's setPieces goes, and which way it faces
-- (toward the road). side 0 puts it over the road itself (e.g. an arch).
function Scenery.setPieceSpots(track: Track.Built): { Prop }
	local out = {}
	local barrier = Scenery.barrier(track)
	for _, sp in track.def.setPieces or {} do
		local d = sp.t * track.length
		local gap = sp.gap or 30
		local lateral = if sp.side == 0 then 0 else sp.side * (barrier + gap)
		local spot = Track.spot(track, d, lateral)
		local _, tan = Track.at(track, d)
		local faceRoad = math.atan2(tan.x, tan.z) + (if sp.side > 0 then math.pi / 2 else -math.pi / 2)
		table.insert(out, { kind = sp.kind, x = spot.x, y = spot.y, z = spot.z, size = 1, yaw = faceRoad })
	end
	return out
end

-- Flat distance from a point to a shortcut's path.
local function shortcutDistance(track: Track.Built, x: number, z: number): number
	local best = math.huge
	for _, sc in track.def.shortcuts or {} do
		local a, b = Track.shortcutEnds(track, sc)
		local abx, abz = b.x - a.x, b.z - a.z
		local t = math.clamp(((x - a.x) * abx + (z - a.z) * abz) / (abx * abx + abz * abz), 0, 1)
		local dx, dz = x - (a.x + abx * t), z - (a.z + abz * t)
		best = math.min(best, math.sqrt(dx * dx + dz * dz) - sc.width / 2)
	end
	return best
end
Scenery.shortcutDistance = shortcutDistance

function Scenery.place(track: Track.Built): { Prop }
	local rules = Scenery.Themes[track.def.theme] or {}
	local random = rng(track.def.id)
	local barrier = Scenery.barrier(track)
	local minY = math.huge
	for _, p in track.points do
		minY = math.min(minY, p.y)
	end

	local props: { Prop } = {}
	local placedRadius: { number } = {}
	local reserved = Scenery.setPieceSpots(track)

	local function clear(x: number, z: number, radius: number): boolean
		-- Away from every part of the track (matters where the track loops back).
		for _, p in track.points do
			local dx, dz = p.x - x, p.z - z
			local need = barrier + radius + 2
			if dx * dx + dz * dz < need * need then
				return false
			end
		end
		for i, other in props do
			local dx, dz = other.x - x, other.z - z
			local need = placedRadius[i] + radius
			if dx * dx + dz * dz < need * need then
				return false
			end
		end
		-- Keep shortcut paths and landmark spots clear.
		if shortcutDistance(track, x, z) < radius + 6 then
			return false
		end
		for _, sp in reserved do
			local dx, dz = sp.x - x, sp.z - z
			local need = Scenery.SetPieceRadius + radius
			if dx * dx + dz * dz < need * need then
				return false
			end
		end
		return true
	end

	for _, rule in rules do
		local placed, attempts = 0, 0
		while placed < rule.count and attempts < rule.count * 12 do
			attempts += 1
			local d = random() * track.length
			local side = if random() < 0.5 then -1 else 1
			local size = rule.minSize + random() * (rule.maxSize - rule.minSize)
			local radius = rule.radius * size
			local lateral = side * (barrier + radius + rule.near + random() * (rule.far - rule.near))
			local spot = Track.spot(track, d, lateral)
			if clear(spot.x, spot.z, radius) then
				local _, tan = Track.at(track, d)
				-- Billboards and flags face the road; everything else is random.
				local faceRoad = rule.kind == "billboard" or rule.kind == "flag" or rule.kind == "lamp"
				local yaw = if faceRoad then math.atan2(tan.x, tan.z) + (if side > 0 then math.pi / 2 else -math.pi / 2) else random() * math.pi * 2
				table.insert(props, { kind = rule.kind, x = spot.x, y = minY, z = spot.z, size = size, yaw = yaw })
				table.insert(placedRadius, radius)
				placed += 1
			end
		end
	end

	-- Grandstands either side of the start line.
	local _, tan = Track.at(track, 0)
	for _, side in { -1, 1 } do
		local lateral = side * (barrier + 18)
		local spot = Track.spot(track, 30, lateral)
		table.insert(props, {
			kind = "grandstand",
			x = spot.x,
			y = minY,
			z = spot.z,
			size = 1,
			yaw = math.atan2(tan.x, tan.z) + (if side > 0 then math.pi / 2 else -math.pi / 2),
		})
	end
	return props
end

return Scenery
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">Track</string>
          <string name="Source"><![CDATA[--!strict
-- Turns a track's control points into a smooth closed centerline, and answers
-- "where along the track is this kart?" for positions, laps, CPU steering and
-- respawning. Pure math on {x, y, z} tables.

export type Vec = { x: number, y: number, z: number }

export type TrackDef = {
	id: string,
	name: string,
	width: number, -- road width in studs
	laps: number,
	controls: { Vec }, -- closed loop, driven in list order; first point is the finish line
	boostPads: { { t: number, offset: number } }, -- t = 0..1 along the lap, offset = -1..1 across
	itemRows: { number }, -- t values for rows of item boxes
	theme: string,
	-- Multiplies every control point (x, y and z), so the whole layout grows
	-- without changing its shape or how steep the hills are. Default 1.
	scale: number?,
	-- Shown on the voting cards.
	difficulty: string?, -- "Easy" | "Medium" | "Hard"
	feature: string?, -- the track's main attraction, one short line
	icon: string?, -- emoji for the card
	-- false = open area with no walls or grass shoulders (the lobby practice loop).
	walls: boolean?,
	-- Jump ramps: t along the lap, offset across (-1..1), ramp width in studs.
	ramps: { { t: number, offset: number, width: number } }?,
	-- Surface patches: "sticky" (syrup, mud: slow), "slippery" (water: less
	-- grip), "conveyor" (pushes you along), "launch" (a big boost). Optional
	-- period/duty make them switch on and off (sprinklers), in seconds.
	zones: { Zone }?,
	-- Moving hazards that cross the road (toy robot, beetles, train).
	crossers: { Crosser }?,
	-- Skill shortcuts: a narrow path leaving the road at `from` and rejoining
	-- at `to` (both t values), on one side (-1 left, 1 right).
	shortcuts: { Shortcut }?,
	-- Covered stretches: "bed", "hose", "log", "box", "arch".
	tunnels: { { from: number, to: number, style: string } }?,
	-- Big themed landmarks placed beside the road.
	setPieces: { { kind: string, t: number, side: number, gap: number? } }?,
}

export type Zone = { kind: string, t: number, length: number, offset: number?, width: number?, period: number?, duty: number? }
export type Crosser = { kind: string, t: number, period: number, phase: number?, radius: number }
export type Shortcut = { from: number, to: number, side: number, width: number, surface: string? }

export type Built = {
	def: TrackDef,
	points: { Vec }, -- dense samples; points[1] is on the finish line
	cum: { number }, -- distance from the finish line to each point
	length: number,
	sectors: number,
}

local Track = {}

Track.Spacing = 12
Track.Sectors = 12
Track.ShoulderWidth = 10

local function v(x: number, y: number, z: number): Vec
	return { x = x, y = y, z = z }
end
Track.v = v

local function sub(a: Vec, b: Vec): Vec
	return v(a.x - b.x, a.y - b.y, a.z - b.z)
end

local function len(a: Vec): number
	return math.sqrt(a.x * a.x + a.y * a.y + a.z * a.z)
end

local function lerp(a: Vec, b: Vec, t: number): Vec
	return v(a.x + (b.x - a.x) * t, a.y + (b.y - a.y) * t, a.z + (b.z - a.z) * t)
end

-- Uniform Catmull-Rom between p1 and p2.
local function catmull(p0: Vec, p1: Vec, p2: Vec, p3: Vec, t: number): Vec
	local t2, t3 = t * t, t * t * t
	local function c(a: number, b: number, cc: number, d: number): number
		return 0.5 * ((2 * b) + (-a + cc) * t + (2 * a - 5 * b + 4 * cc - d) * t2 + (-a + 3 * b - 3 * cc + d) * t3)
	end
	return v(c(p0.x, p1.x, p2.x, p3.x), c(p0.y, p1.y, p2.y, p3.y), c(p0.z, p1.z, p2.z, p3.z))
end

function Track.build(def: TrackDef): Built
	local scale = def.scale or 1
	local ctrl = {}
	for i, c in def.controls do
		ctrl[i] = v(c.x * scale, c.y * scale, c.z * scale)
	end
	local n = #ctrl
	-- Fine samples first, then resample evenly by distance.
	local fine: { Vec } = {}
	for i = 1, n do
		local p0, p1 = ctrl[(i - 2) % n + 1], ctrl[i]
		local p2, p3 = ctrl[i % n + 1], ctrl[(i + 1) % n + 1]
		for s = 0, 19 do
			table.insert(fine, catmull(p0, p1, p2, p3, s / 20))
		end
	end
	table.insert(fine, fine[1])

	local fineCum = { 0 }
	for i = 2, #fine do
		fineCum[i] = fineCum[i - 1] + len(sub(fine[i], fine[i - 1]))
	end
	local total = fineCum[#fine]
	local count = math.max(8, math.floor(total / Track.Spacing + 0.5))
	local step = total / count

	local points: { Vec } = {}
	local cum: { number } = {}
	local j = 1
	for k = 0, count - 1 do
		local d = k * step
		while fineCum[j + 1] < d do
			j += 1
		end
		local segLen = fineCum[j + 1] - fineCum[j]
		local t = if segLen > 0 then (d - fineCum[j]) / segLen else 0
		table.insert(points, lerp(fine[j], fine[j + 1], t))
		table.insert(cum, d)
	end

	return { def = def, points = points, cum = cum, length = total, sectors = Track.Sectors }
end

function Track.pointCount(track: Built): number
	return #track.points
end

-- Point and unit tangent at distance d along the lap (wraps).
function Track.at(track: Built, d: number): (Vec, Vec)
	local n = #track.points
	d %= track.length
	local step = track.length / n
	local i = math.floor(d / step) + 1
	local a, b = track.points[i], track.points[i % n + 1]
	local t = (d - track.cum[i]) / step
	local dir = sub(b, a)
	local l = len(dir)
	return lerp(a, b, t), v(dir.x / l, dir.y / l, dir.z / l)
end

export type Projection = { index: number, distance: number, lateral: number, gap: number }

-- Nearest spot on the centerline. `hint` (a previous index) keeps the search
-- local so crossing bridges don't snap to the road below.
function Track.project(track: Built, pos: Vec, hint: number?): Projection
	local n = #track.points
	local function test(i: number, best: Projection?): Projection?
		local a, b = track.points[i], track.points[i % n + 1]
		local ab = sub(b, a)
		local ap = sub(pos, a)
		local abLen2 = ab.x * ab.x + ab.y * ab.y + ab.z * ab.z
		local t = math.clamp((ap.x * ab.x + ap.y * ab.y + ap.z * ab.z) / abLen2, 0, 1)
		local closest = lerp(a, b, t)
		local gap = len(sub(pos, closest))
		if best and gap >= best.gap then
			return best
		end
		-- Lateral: positive = right of travel direction (flat cross product).
		local fx, fz = ab.x, ab.z
		local fl = math.sqrt(fx * fx + fz * fz)
		local lateral = if fl > 0 then ((pos.x - closest.x) * -fz + (pos.z - closest.z) * fx) / fl else 0
		return { index = i, distance = track.cum[i] + t * math.sqrt(abLen2), lateral = lateral, gap = gap }
	end

	local best: Projection? = nil
	if hint then
		for k = -12, 12 do
			best = test((hint - 1 + k) % n + 1, best)
		end
		if best and best.gap <= track.def.width * 1.5 then
			return best
		end
	end
	for i = 1, n do
		best = test(i, best)
	end
	return best :: Projection
end

function Track.sectorOf(track: Built, d: number): number
	return math.floor((d % track.length) / track.length * track.sectors)
end

function Track.sectorStart(track: Built, sector: number): number
	return sector / track.sectors * track.length
end

---------------------------------------------------------------------------
-- Layout shared by the builder, the server and the tests.
---------------------------------------------------------------------------
Track.PadLength = 24
Track.PadWidth = 16

export type Pad = { distance: number, lateral: number }

function Track.pads(track: Built): { Pad }
	local out = {}
	local half = track.def.width / 2 - Track.PadWidth / 2 - 2
	for _, pad in track.def.boostPads do
		table.insert(out, { distance = pad.t * track.length, lateral = pad.offset * half })
	end
	return out
end

-- Four item boxes across the road for each row.
function Track.itemBoxes(track: Built): { Pad }
	local out = {}
	local spread = track.def.width / 2 - 8
	for _, t in track.def.itemRows do
		for i = 0, 3 do
			table.insert(out, { distance = t * track.length, lateral = -spread + i * (spread * 2 / 3) })
		end
	end
	return out
end

-- World position of a spot given by distance along the lap and lateral offset.
function Track.spot(track: Built, distance: number, lateral: number): Vec
	local p, tan = Track.at(track, distance)
	local tl = math.sqrt(tan.x * tan.x + tan.z * tan.z)
	return v(p.x - tan.z / tl * lateral, p.y, p.z + tan.x / tl * lateral)
end

-- Signed distance from b to a along the lap, wrapped into [-length/2, length/2).
local function along(track: Built, a: number, b: number): number
	return (a - b + track.length / 2) % track.length - track.length / 2
end

-- Is a timed zone switched on at `time`?
function Track.zoneActive(zone: Zone, time: number): boolean
	if not zone.period then
		return true
	end
	local duty = zone.duty or 0.5
	return (time % zone.period) < zone.period * duty
end

-- The zone (if any) covering a projected position at `time`.
function Track.zoneAt(track: Built, proj: Projection, time: number): Zone?
	for _, zone in track.def.zones or {} do
		local center = zone.t * track.length
		local a = along(track, proj.distance, center)
		if a >= -zone.length / 2 and a <= zone.length / 2 then
			local width = zone.width or track.def.width
			local offset = (zone.offset or 0) * (track.def.width / 2 - width / 2)
			if math.abs(proj.lateral - offset) <= width / 2 and Track.zoneActive(zone, time) then
				return zone
			end
		end
	end
	return nil
end

-- Shortcut endpoints just outside the barrier on the chosen side.
function Track.shortcutEnds(track: Built, sc: Shortcut): (Vec, Vec)
	local lat = sc.side * (track.def.width / 2 + Track.ShoulderWidth + 2)
	return Track.spot(track, sc.from * track.length, lat), Track.spot(track, sc.to * track.length, lat)
end

-- Index of the shortcut whose path contains `pos` (flat distance), if any.
function Track.shortcutAt(track: Built, pos: Vec): number?
	for i, sc in track.def.shortcuts or {} do
		local a, b = Track.shortcutEnds(track, sc)
		local abx, abz = b.x - a.x, b.z - a.z
		local len2 = abx * abx + abz * abz
		local t = math.clamp(((pos.x - a.x) * abx + (pos.z - a.z) * abz) / len2, -0.05, 1.05)
		local cx, cz = a.x + abx * t, a.z + abz * t
		local dx, dz = pos.x - cx, pos.z - cz
		if dx * dx + dz * dz <= (sc.width / 2 + 1) ^ 2 then
			return i
		end
	end
	return nil
end

-- Where a crossing hazard is at `time`: distance along the lap, lateral
-- offset, and whether it is out on the road. It walks from one side to the
-- other, waits, and walks back.
function Track.crosserAt(track: Built, c: Crosser, time: number): (number, number, boolean)
	local reach = track.def.width / 2 + Track.ShoulderWidth
	local phase = ((time + (c.phase or 0)) % c.period) / c.period -- 0..1
	-- 0..0.35 cross, 0.35..0.5 wait, 0.5..0.85 cross back, 0.85..1 wait
	local u: number
	if phase < 0.35 then
		u = phase / 0.35
	elseif phase < 0.5 then
		u = 1
	elseif phase < 0.85 then
		u = 1 - (phase - 0.5) / 0.35
	else
		u = 0
	end
	local lateral = -reach + u * reach * 2
	return c.t * track.length, lateral, math.abs(lateral) < track.def.width / 2 + c.radius
end

-- "road" | "boost" | "offroad" (the grass shoulder) | "wall" (past the
-- barrier) | a zone kind ("sticky", "slippery", "conveyor", "launch").
-- Pass the world position to count shortcuts, and the server time for
-- timed zones.
function Track.surfaceAt(track: Built, proj: Projection, pos: Vec?, time: number?): string
	local half = track.def.width / 2
	local lat = math.abs(proj.lateral)
	if lat > half and pos then
		local sc = Track.shortcutAt(track, pos)
		if sc then
			return (track.def.shortcuts :: { Shortcut })[sc].surface or "road"
		end
	end
	if lat > half + Track.ShoulderWidth then
		return "wall"
	elseif lat > half then
		return "offroad"
	end
	for _, pad in Track.pads(track) do
		local a = along(track, proj.distance, pad.distance)
		if math.abs(a) <= Track.PadLength / 2 and math.abs(proj.lateral - pad.lateral) <= Track.PadWidth / 2 then
			return "boost"
		end
	end
	local zone = Track.zoneAt(track, proj, time or 0)
	if zone then
		return zone.kind
	end
	return "road"
end

-- Starting grid: two columns behind the finish line, staggered.
function Track.gridSpot(track: Built, slot: number): (Vec, number)
	local row = (slot - 1) // 2
	local col = (slot - 1) % 2
	local distance = track.length - 16 - row * 14 - col * 7
	local lateral = (col * 2 - 1) * track.def.width * 0.22
	return Track.spot(track, distance, lateral), distance
end

---------------------------------------------------------------------------
-- Lap progress. Laps only count when every sector is passed in order, so
-- cutting across the infield or reversing over the line never helps.
---------------------------------------------------------------------------
export type Progress = {
	lap: number, -- 0 on the grid (behind the line), 1 after first crossing...
	sector: number,
	distance: number, -- distance along the lap, kept inside the current sector
	index: number, -- last projected point, used as the next search hint
}

function Track.newProgress(track: Built, gridDistance: number): Progress
	return {
		lap = 0,
		sector = Track.sectorOf(track, gridDistance),
		distance = gridDistance % track.length,
		index = 1,
	}
end

-- Returns true when this update crossed the finish line forwards.
function Track.updateProgress(track: Built, p: Progress, proj: Projection): boolean
	local k = track.sectors
	local s = Track.sectorOf(track, proj.distance)
	p.index = proj.index
	local crossed = false
	if s == (p.sector + 1) % k then
		if s == 0 then
			p.lap += 1
			crossed = true
		end
		p.sector = s
	elseif s == (p.sector - 1) % k then
		if p.sector == 0 then
			p.lap -= 1 -- backed over the line
		end
		p.sector = s
	end
	if s == p.sector then
		p.distance = proj.distance
	end
	return crossed
end

-- One number for ranking racers: higher is further ahead.
function Track.score(track: Built, p: Progress): number
	return p.lap * track.length + p.distance
end

-- Is the kart driving the wrong way? heading is a flat unit vector.
function Track.wrongWay(track: Built, proj: Projection, hx: number, hz: number): boolean
	local _, tan = Track.at(track, proj.distance)
	local tl = math.sqrt(tan.x * tan.x + tan.z * tan.z)
	if tl == 0 then
		return false
	end
	return (hx * tan.x + hz * tan.z) / tl < -0.5
end

return Track
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">Tracks</string>
          <string name="Source"><![CDATA[--!strict
-- The tracks and the cup they make up. Control points are {x, y, z} and are
-- driven in list order; the first point is the start/finish line.
-- tests/Simulation.spec.luau has CPU drivers race every track, so a bad edit
-- here (a corner too tight, a jump too steep) fails the tests.
--
-- Making a track bigger: raise `scale` (stretches the whole layout) and
-- `width` (road width in studs). Then run `lune run tests/run`.

local LobbyLayout = require("./LobbyLayout")
local Track = require("./Track")
local v = Track.v

local Tracks = {}

Tracks.Themes = {
	sunny = {
		road = { 70, 70, 78 },
		shoulder = { 120, 170, 80 },
		ground = { 100, 160, 70 },
		wall = { 235, 235, 240 },
		accent = { 255, 210, 60 },
		curb = { { 220, 40, 40 }, { 245, 245, 245 } },
		line = { 245, 245, 245 },
		clock = 14,
		-- Lighting: hazy summer afternoon.
		ambient = { 120, 120, 130 },
		brightness = 3,
		atmosphere = { density = 0.3, haze = 1.2, glare = 0.4, color = { 200, 220, 255 }, decay = { 110, 140, 200 } },
		bloom = 0.6,
		tint = { 255, 250, 240 },
		saturation = 0.15,
	},
	canyon = {
		road = { 92, 80, 72 },
		shoulder = { 196, 150, 100 },
		ground = { 180, 120, 80 },
		wall = { 150, 90, 60 },
		accent = { 255, 140, 60 },
		curb = { { 230, 110, 40 }, { 250, 235, 210 } },
		line = { 250, 230, 190 },
		clock = 17.2,
		-- Lighting: dusty golden hour.
		ambient = { 140, 100, 80 },
		brightness = 2.6,
		atmosphere = { density = 0.38, haze = 2.2, glare = 1.2, color = { 255, 200, 150 }, decay = { 200, 110, 70 } },
		bloom = 0.9,
		tint = { 255, 235, 210 },
		saturation = 0.2,
	},
	-- Midnight Toy Room: a giant bedroom at night, lit by a night light.
	toyroom = {
		road = { 70, 78, 120 },
		shoulder = { 150, 105, 70 },
		ground = { 160, 112, 74 }, -- wooden floorboards
		wall = { 255, 220, 120 },
		accent = { 120, 220, 255 },
		curb = { { 255, 90, 90 }, { 255, 230, 120 } },
		line = { 255, 240, 200 },
		clock = 0.5,
		ambient = { 90, 90, 150 },
		brightness = 1.6,
		atmosphere = { density = 0.32, haze = 1.2, glare = 0, color = { 90, 100, 170 }, decay = { 50, 50, 110 } },
		bloom = 1.1,
		tint = { 230, 230, 255 },
		saturation = 0.25,
		room = { wall = { 90, 110, 190 }, trim = { 255, 255, 255 }, height = 420 },
	},
	-- Kitchen Chaos: countertop racing in a bright kitchen.
	kitchen = {
		road = { 96, 100, 112 },
		shoulder = { 235, 230, 220 },
		ground = { 240, 236, 228 }, -- marble countertop
		wall = { 230, 90, 80 },
		accent = { 255, 200, 60 },
		curb = { { 230, 90, 80 }, { 255, 255, 255 } },
		line = { 255, 255, 255 },
		clock = 11,
		ambient = { 170, 165, 160 },
		brightness = 3.2,
		atmosphere = { density = 0.22, haze = 0.6, glare = 0.2, color = { 255, 245, 230 }, decay = { 220, 200, 170 } },
		bloom = 0.5,
		tint = { 255, 250, 240 },
		saturation = 0.25,
		room = { wall = { 130, 200, 210 }, trim = { 255, 255, 255 }, height = 380 },
	},
	-- Backyard Bug Rally: dirt paths through giant grass on a sunny day.
	backyard = {
		road = { 150, 110, 75 }, -- packed dirt
		shoulder = { 110, 170, 70 },
		ground = { 100, 165, 65 },
		wall = { 160, 120, 80 },
		accent = { 255, 210, 60 },
		curb = { { 200, 150, 90 }, { 245, 230, 200 } },
		line = { 245, 230, 200 },
		clock = 15,
		ambient = { 130, 140, 120 },
		brightness = 3,
		atmosphere = { density = 0.3, haze = 1.4, glare = 0.5, color = { 210, 235, 255 }, decay = { 140, 170, 120 } },
		bloom = 0.6,
		tint = { 255, 252, 235 },
		saturation = 0.3,
	},
	-- The Kart Carnival lobby: bright, clear afternoon.
	carnival = {
		road = { 64, 66, 82 },
		shoulder = { 120, 200, 110 },
		ground = { 120, 200, 110 },
		wall = { 255, 255, 255 },
		accent = { 255, 90, 120 },
		curb = { { 255, 90, 120 }, { 255, 255, 255 } },
		line = { 255, 255, 255 },
		clock = 13,
		ambient = { 140, 140, 160 },
		brightness = 3,
		atmosphere = { density = 0.25, haze = 0.8, glare = 0.3, color = { 210, 230, 255 }, decay = { 120, 160, 220 } },
		bloom = 0.5,
		tint = { 255, 250, 245 },
		saturation = 0.25,
	},
	neon = {
		road = { 30, 30, 42 },
		shoulder = { 50, 30, 80 },
		ground = { 16, 12, 28 },
		wall = { 0, 230, 255 },
		accent = { 255, 60, 220 },
		curb = { { 255, 60, 220 }, { 0, 230, 255 } },
		line = { 0, 230, 255 },
		clock = 0,
		-- Lighting: dark city night with glowing neon.
		ambient = { 60, 40, 90 },
		brightness = 1,
		atmosphere = { density = 0.42, haze = 1.5, glare = 0, color = { 120, 60, 180 }, decay = { 40, 20, 80 } },
		bloom = 1.6,
		tint = { 235, 220, 255 },
		saturation = 0.3,
	},
}

Tracks.List = {
	{
		id = "sunny",
		name = "Sunny Loop",
		theme = "sunny",
		difficulty = "Easy",
		feature = "Wide, fast corners and a big crowd",
		icon = "🌳",
		width = 56,
		scale = 1.6,
		laps = 3,
		controls = {
			v(0, 0, 0),
			v(0, 0, -260),
			v(40, 0, -400),
			v(170, 0, -470),
			v(310, 0, -430),
			v(370, 0, -320),
			v(330, 0, -190),
			v(380, 0, -80),
			v(470, 0, 10),
			v(500, 0, 160),
			v(430, 0, 280),
			v(280, 0, 320),
			v(130, 0, 300),
			v(30, 0, 210),
			v(0, 0, 100),
		},
		boostPads = { { t = 0.08, offset = 0 }, { t = 0.55, offset = 0.4 }, { t = 0.83, offset = -0.4 } },
		itemRows = { 0.2, 0.62 },
	},
	{
		id = "canyon",
		name = "Canyon Climb",
		theme = "canyon",
		difficulty = "Medium",
		feature = "Rolling hills under giant mesas",
		icon = "🏜️",
		width = 52,
		scale = 1.6,
		laps = 3,
		controls = {
			v(0, 0, 0),
			v(0, 0, -250),
			v(60, 18, -400),
			v(200, 36, -460),
			v(360, 40, -400),
			v(430, 30, -260),
			v(390, 12, -120),
			v(460, 0, 20),
			v(570, 14, 150),
			v(550, 32, 310),
			v(400, 40, 370),
			v(240, 26, 330),
			v(150, 10, 230),
			v(50, 0, 150),
			v(0, 0, 80),
		},
