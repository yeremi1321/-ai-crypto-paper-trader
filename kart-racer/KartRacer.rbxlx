-- Original low racing bodies: open cockpits, broad slicks and twin exhausts.
local racingBodies = {
 { id = "embergt", name = "Ember GT", nose = "Ellipsoid", wing = 2.1 },
 { id = "arrowsprint", name = "Arrow Sprint", nose = "Wedge", wing = 2.8 },
 { id = "rallycomet", name = "Rally Comet", nose = "Ellipsoid", wing = 1.8 },
}
for index, design in racingBodies do
 local parts: { BodyPart } = {
  { size = { 5.4, 0.45, 7.8 }, offset = { 0, 0, 0 }, role = "dark", shape = "Ellipsoid" },
  { size = { 3.4, 1, 4.2 }, offset = { 0, 0.45, -2 }, role = "main", shape = design.nose },
  { size = { 5.5, 0.25, 0.8 }, offset = { 0, 0.05, -4.2 }, role = "accent", shape = "Ellipsoid" },
  { size = { 2, 0.15, 3 }, offset = { 0, 1, -2 }, role = "accent", shape = "Ellipsoid" },
  { size = { 4.8, 0.25, 1.1 }, offset = { 0, design.wing, 3.4 }, role = "accent", shape = "Ellipsoid" },
 }
 for _, side in { -1, 1 } do
  table.insert(parts, { size = { 1.1, 1.2, 4.8 }, offset = { side * 2.1, 0.65, 0.2 }, role = "main", shape = "Ellipsoid" })
  table.insert(parts, { size = { 0.25, design.wing, 0.5 }, offset = { side * 1.8, design.wing / 2, 3.4 }, role = "dark" })
  table.insert(parts, { size = { 2.4, 1.1, 1.1 }, offset = { side * 1.4, 1.2, 2.9 }, role = "chrome", shape = "Cylinder", rotation = { 0, 90, 0 } })
  table.insert(parts, { size = { 0.12, 0.75, 0.75 }, offset = { side * 1.4, 1.2, 4.12 }, role = "dark", shape = "Cylinder", rotation = { 0, 90, 0 } })
  table.insert(parts, { size = { 0.8, 0.45, 0.15 }, offset = { side * 1.7, 0.6, -3.8 }, role = "chrome", shape = "Ellipsoid" })
 end
 for k = -2, 2 do table.insert(parts, { size = { 0.1, 0.45, 0.18 }, offset = { k * 0.24, 0.52, -4.05 }, role = "chrome" }) end
 if design.id == "rallycomet" then
  for _, side in { -1, 1 } do
   table.insert(parts, { size = { 0.25, 2.8, 0.25 }, offset = { side * 1.4, 1.8, 1.8 }, role = "chrome" })
  end
  table.insert(parts, { size = { 3, 0.25, 0.25 }, offset = { 0, 3.2, 1.8 }, role = "chrome" })
 end
 table.insert(KartBodies.List, index, {
  id = design.id, name = design.name, icon = "🏎️", price = 0,
  wheelRadius = 0.95, wheelWidth = 1.4,
  wheels = { { -2.8, -2.6 }, { 2.8, -2.6 }, { -2.8, 2.6 }, { 2.8, 2.6 } },
  seat = { 0, 0.55, 0.6 }, exhaust = { 0, 1.1, 4.1 }, parts = parts,
 })
end

---------------------------------------------------------------------------
-- Big-motor cars: realistic paint, chrome and rubber, with exposed engines
-- that rumble. Original designs, built from small helpers so each stays short.
---------------------------------------------------------------------------
local function P(parts: { BodyPart }, size: { number }, offset: { number }, role: any, shape: any?, extra: { [string]: any }?)
	local part: any = { size = size, offset = offset, role = role, shape = shape }
	for k, v in extra or {} do
		part[k] = v
	end
	table.insert(parts, part)
end

local GLOSS = { reflectance = 0.12 }
local RED_LIGHT = { color = { 255, 40, 30 } }

-- An exposed V8: block, chrome valve covers, a supercharger with its belt
-- pulley, eight velocity stacks (or a scoop) and four-into-one headers.
-- The blower and stacks rumble.
type EngineOptions = { stacks: boolean?, headers: boolean?, length: number? }
local function v8(parts: { BodyPart }, x: number, y: number, z: number, options: EngineOptions?)
	local o: EngineOptions = options or {}
	local L = o.length or 2.4
	P(parts, { 1.8, 1, L }, { x, y, z }, "accent", nil, { material = "Metal", reflectance = 0.1 })
	for _, side in { -1, 1 } do
		P(parts, { 0.7, 0.45, L - 0.2 }, { x + side * 0.75, y + 0.6, z }, "chrome", nil, { rotation = { 0, 0, side * -25 } })
	end
	P(parts, { 1.3, 0.75, L * 0.65 }, { x, y + 1.05, z }, "chrome", nil, { anim = "engine" })
	P(parts, { 0.5, 0.9, 0.9 }, { x, y + 0.95, z - L / 2 - 0.1 }, "dark", "Cylinder", { rotation = { 0, 90, 0 } })
	if o.stacks ~= false then
		for k = 0, 3 do
			for _, side in { -1, 1 } do
				P(parts, { 0.75, 0.34, 0.34 }, { x + side * 0.32, y + 1.75, z - L * 0.25 + k * L * 0.17 }, "chrome", "Cylinder", { rotation = { 0, 0, 90 }, anim = "engine" })
			end
		end
	else
		P(parts, { 1.2, 0.6, 1.1 }, { x, y + 1.7, z }, "dark", nil, { anim = "engine" })
	end
	if o.headers ~= false then
		for _, side in { -1, 1 } do
			for k = 0, 3 do
				P(parts, { 1.3, 0.24, 0.24 }, { x + side * 1.35, y - 0.05, z - L * 0.35 + k * L * 0.23 }, "chrome", "Cylinder", { rotation = { 0, 0, side * -40 } })
			end
		end
	end
end

local bigMotor: { Body } = {}

do -- Blower Rod: an open hot rod, supercharged V8 out front, fat rear tyres.
	local parts: { BodyPart } = {}
	for _, side in { -1, 1 } do
		P(parts, { 0.35, 0.4, 8.6 }, { side * 1.05, -0.15, -0.3 }, "dark")
	end
	P(parts, { 4.4, 0.28, 0.28 }, { 0, -0.2, -3.7 }, "dark", "Cylinder")
	P(parts, { 3.2, 1.5, 3.4 }, { 0, 0.55, 1.5 }, "main", "Ellipsoid", GLOSS)
	P(parts, { 3.4, 0.35, 3.6 }, { 0, 1.2, 1.5 }, "accent", "Ellipsoid")
	for _, side in { -1, 1 } do
		P(parts, { 1.5, 1.1, 3.2 }, { side * 2.55, 1.3, 2.6 }, "main", "Ellipsoid", GLOSS)
	end
	P(parts, { 2.2, 2, 0.5 }, { 0, 0.75, -4.3 }, "chrome")
	P(parts, { 1.8, 1.6, 0.2 }, { 0, 0.75, -4.6 }, "dark")
	for k = -3, 3 do
		P(parts, { 0.1, 1.5, 0.25 }, { k * 0.22, 0.75, -4.62 }, "chrome")
	end
	v8(parts, 0, 0.35, -2.1)
	P(parts, { 2.6, 1, 0.12 }, { 0, 1.9, 0.1 }, "glass", nil, { rotation = { -15, 0, 0 } })
	P(parts, { 2.8, 0.15, 0.2 }, { 0, 2.45, 0.25 }, "chrome")
	for _, side in { -1, 1 } do
		P(parts, { 0.18, 0.9, 0.18 }, { side * 1.45, 0.6, -3.9 }, "chrome")
		P(parts, { 0.4, 0.8, 0.8 }, { side * 1.45, 1.2, -3.95 }, "chrome", "Cylinder", { rotation = { 0, 90, 0 } })
		P(parts, { 0.06, 0.65, 0.65 }, { side * 1.45, 1.2, -4.38 }, "light", "Cylinder", { rotation = { 0, 90, 0 } })
		P(parts, { 0.5, 0.35, 0.12 }, { side * 2.55, 1.2, 4.25 }, "light", nil, RED_LIGHT)
	end
	table.insert(bigMotor, {
		id = "blowerrod", name = "Blower Rod", icon = "🔥", price = 0, realistic = true,
		wheelRadius = 0.75, wheelWidth = 0.8, rearWheelRadius = 1.3, rearWheelWidth = 1.9,
		wheels = { { -2.3, -3.7 }, { 2.3, -3.7 }, { -2.55, 2.6 }, { 2.55, 2.6 } },
		seat = { 0, 0.35, 1.6 }, exhaust = { 0, 0, 4.3 }, parts = parts,
	})
end

do -- Thunder Muscle: a wide convertible muscle car, blower through the hood.
	local parts: { BodyPart } = {}
	P(parts, { 4.2, 1.1, 8.8 }, { 0, 0.25, 0 }, "main", nil, GLOSS)
	P(parts, { 4.2, 0.9, 1.6 }, { 0, 0.15, -4.3 }, "main", "Ellipsoid", GLOSS)
	P(parts, { 4.2, 0.9, 1.4 }, { 0, 0.2, 4.3 }, "main", "Ellipsoid", GLOSS)
	for _, side in { -1, 1 } do
		P(parts, { 0.55, 0.06, 8.8 }, { side * 0.45, 0.82, 0 }, "accent")
		for _, z in { -2.9, 2.8 } do
			P(parts, { 0.9, 0.9, 2.8 }, { side * 2.3, 0.6, z }, "main", "Ellipsoid", GLOSS)
		end
		P(parts, { 5.2, 0.42, 0.42 }, { side * 2.25, -0.4, 0 }, "chrome", "Cylinder", { rotation = { 0, 90, 0 } })
		P(parts, { 1.4, 0.3, 0.1 }, { side * 1.3, 0.45, 4.98 }, "light", nil, RED_LIGHT)
		for k = 0, 1 do
			P(parts, { 0.12, 0.45, 0.45 }, { side * (1.2 + k * 0.6), 0.35, -5.05 }, "light", "Cylinder", { rotation = { 0, 90, 0 } })
		end
		P(parts, { 0.2, 0.6, 0.2 }, { side * 1.8, 1.05, 4.2 }, "dark")
	end
	P(parts, { 3.4, 0.3, 2.6 }, { 0, 0.85, 1.2 }, "dark")
	P(parts, { 3.8, 1, 0.12 }, { 0, 1.35, -0.3 }, "glass", nil, { rotation = { -25, 0, 0 } })
	P(parts, { 3.9, 0.12, 0.2 }, { 0, 1.85, -0.1 }, "chrome")
	P(parts, { 2.2, 0.35, 3.4 }, { 0, 0.9, -2.4 }, "main", "Ellipsoid", GLOSS)
	v8(parts, 0, 0, -2.5, { headers = false })
	P(parts, { 4.2, 0.2, 0.9 }, { 0, 1.35, 4.2 }, "accent")
	P(parts, { 3.4, 0.6, 0.15 }, { 0, 0.25, -5.0 }, "dark")
	P(parts, { 4.4, 0.25, 0.3 }, { 0, -0.25, -5.05 }, "chrome")
	P(parts, { 4.4, 0.25, 0.3 }, { 0, -0.15, 5.0 }, "chrome")
	table.insert(bigMotor, {
		id = "thunder", name = "Thunder Muscle", icon = "⚡", price = 300, realistic = true,
		wheelRadius = 0.95, wheelWidth = 1.3, rearWheelRadius = 1.1, rearWheelWidth = 1.7,
		wheels = { { -2.45, -2.9 }, { 2.45, -2.9 }, { -2.45, 2.8 }, { 2.45, 2.8 } },
		seat = { 0, 0.3, 1.3 }, exhaust = { 0, -0.2, 5.1 }, parts = parts,
	})
end

do -- Twin-Turbo Dragster: long nose, tiny front wheels, huge slicks, a wing.
	local parts: { BodyPart } = {}
	for _, side in { -1, 1 } do
		P(parts, { 0.25, 0.25, 10.5 }, { side * 0.6, -0.1, -1.6 }, "dark")
	end
	P(parts, { 1.4, 0.9, 5 }, { 0, 0.15, -4.3 }, "main", "Ellipsoid", { reflectance = 0.15 })
	P(parts, { 1, 0.5, 1.6 }, { 0, 0.2, -6.9 }, "accent", "Ellipsoid")
	P(parts, { 2.6, 0.12, 0.6 }, { 0, -0.1, -6.9 }, "accent")
	P(parts, { 2, 1.2, 2.4 }, { 0, 0.5, -0.6 }, "main", "Ellipsoid", { reflectance = 0.15 })
	P(parts, { 1.8, 0.18, 0.18 }, { 0, 2.6, 0.2 }, "chrome")
	P(parts, { 2.2, 1, 2 }, { 0, 0.3, 3.3 }, "main", "Ellipsoid", GLOSS)
	v8(parts, 0, 0.4, 1.9, { headers = false })
	for _, side in { -1, 1 } do
		P(parts, { 0.18, 2, 0.18 }, { side * 0.8, 1.6, 0.2 }, "chrome")
		P(parts, { 0.9, 1.1, 1.1 }, { side * 1.45, 1.3, 1.6 }, "chrome", "Cylinder", { rotation = { 0, 90, 0 } })
		P(parts, { 0.1, 0.75, 0.75 }, { side * 1.45, 1.3, 1.03 }, "dark", "Cylinder", { rotation = { 0, 90, 0 } })
		for k = 0, 1 do
			P(parts, { 1.4, 0.3, 0.3 }, { side * 1.3, 1.1, 2.2 + k * 0.6 }, "chrome", "Cylinder", { rotation = { 0, 0, side * 35 } })
		end
		P(parts, { 0.15, 1.1, 1.7 }, { side * 2.7, 4.1, 3.9 }, "accent")
		P(parts, { 0.2, 3.2, 0.2 }, { side * 1, 2.7, 3.6 }, "dark")
	end
	P(parts, { 5.4, 0.25, 1.8 }, { 0, 4.3, 3.9 }, "accent", nil, { rotation = { -8, 0, 0 } })
	table.insert(bigMotor, {
		id = "dragster", name = "Twin-Turbo Dragster", icon = "🚀", price = 500, realistic = true,
		wheelRadius = 0.6, wheelWidth = 0.6, rearWheelRadius = 1.55, rearWheelWidth = 2.3,
		wheels = { { -1.5, -6.2 }, { 1.5, -6.2 }, { -2.65, 2.9 }, { 2.65, 2.9 } },
		seat = { 0, 0.15, -0.4 }, exhaust = { 0, 1.6, 3.4 }, parts = parts,
	})
end

do -- Dune Hauler: a long-travel trophy truck with a roll cage and light bar.
	local parts: { BodyPart } = {}
	P(parts, { 4.2, 1.1, 7.2 }, { 0, 0.9, -0.2 }, "main", nil, GLOSS)
	P(parts, { 4.2, 0.9, 1.4 }, { 0, 0.8, -3.9 }, "main", "Ellipsoid", GLOSS)
	P(parts, { 4.4, 0.3, 0.5 }, { 0, 0.2, -4.4 }, "chrome")
	v8(parts, 0, 1.1, -2.2, { headers = false })
	for _, side in { -1, 1 } do
		for _, z in { -0.4, 1.6 } do
			P(parts, { 0.2, 2.2, 0.2 }, { side * 1.6, 2.5, z }, "chrome")
		end
		P(parts, { 0.2, 0.2, 2.2 }, { side * 1.6, 3.6, 0.6 }, "chrome")
		for _, z in { -2.7, 2.8 } do
			P(parts, { 1.1, 0.45, 3 }, { side * 2.4, 1.65, z }, "accent", "Ellipsoid")
			P(parts, { 1.8, 0.3, 0.3 }, { side * 1.7, 1.3, z }, "chrome", "Cylinder", { rotation = { 0, 0, side * -50 } })
		end
		P(parts, { 0.4, 0.8, 0.1 }, { side * 1.6, 1.0, 3.45 }, "light", nil, RED_LIGHT)
	end
	for _, z in { -0.4, 1.6 } do
		P(parts, { 3.4, 0.2, 0.2 }, { 0, 3.6, z }, "chrome")
	end
	P(parts, { 3, 0.4, 0.4 }, { 0, 3.85, -0.45 }, "dark")
	for k = -3, 3, 2 do
		P(parts, { 0.12, 0.3, 0.3 }, { k * 0.4, 3.85, -0.7 }, "light", "Cylinder", { rotation = { 0, 90, 0 } })
	end
	P(parts, { 3.8, 0.5, 2.6 }, { 0, 1.6, 2.7 }, "dark")
	P(parts, { 0.9, 1.8, 1.8 }, { 0, 2.3, 2.7 }, "dark", "Cylinder", { rotation = { 0, 0, 90 }, material = "Rubber" })
	table.insert(bigMotor, {
		id = "dunehauler", name = "Dune Hauler", icon = "🛻", price = 300, realistic = true,
		wheelRadius = 1.2, wheelWidth = 1.5,
		wheels = { { -2.6, -2.7 }, { 2.6, -2.7 }, { -2.6, 2.8 }, { 2.6, 2.8 } },
		seat = { 0, 0.9, 0.6 }, exhaust = { 0, 0.8, 4 }, parts = parts,
	})
end

do -- Midnight V12: a low mid-engine speedster, the V12 under a glass cover.
	local parts: { BodyPart } = {}
	P(parts, { 4.4, 0.8, 8.4 }, { 0, 0.05, 0 }, "main", "Ellipsoid", { reflectance = 0.18 })
	P(parts, { 4.2, 0.7, 3.2 }, { 0, 0.35, -2.6 }, "main", "Wedge", { reflectance = 0.18 })
	P(parts, { 2.8, 0.4, 2.2 }, { 0, 0.5, 0 }, "dark")
	P(parts, { 3, 0.6, 0.1 }, { 0, 0.95, -1 }, "glass", nil, { rotation = { -35, 0, 0 } })
	P(parts, { 2.2, 0.7, 2.6 }, { 0, 0.6, 2.4 }, "accent", nil, { material = "Metal", reflectance = 0.1 })
	for k = 0, 5 do
		for _, side in { -1, 1 } do
			P(parts, { 0.5, 0.26, 0.26 }, { side * 0.5, 1.05, 1.4 + k * 0.4 }, "chrome", "Cylinder", { rotation = { 0, 0, 90 }, anim = "engine" })
		end
	end
	P(parts, { 3, 0.15, 3 }, { 0, 1.3, 2.4 }, "glass", nil, { transparency = 0.5 })
	for _, side in { -1, 1 } do
		P(parts, { 0.3, 0.6, 1.6 }, { side * 2.15, 0.4, 1.2 }, "dark")
		P(parts, { 1, 0.15, 0.1 }, { side * 1.4, 0.35, -4.15 }, "light")
		P(parts, { 0.2, 0.7, 0.2 }, { side * 1.6, 1.05, 3.9 }, "dark")
		for k = 0, 1 do
			P(parts, { 0.5, 0.35, 0.35 }, { side * (0.35 + k * 0.5), -0.1, 4.2 }, "chrome", "Cylinder", { rotation = { 0, 90, 0 } })
		end
	end
	P(parts, { 3.6, 0.12, 0.1 }, { 0, 0.55, 4.2 }, "light", nil, RED_LIGHT)
	P(parts, { 4.2, 0.15, 0.8 }, { 0, 1.4, 4 }, "accent")
	table.insert(bigMotor, {
		id = "v12", name = "Midnight V12", icon = "🌙", price = 600, realistic = true,
		wheelRadius = 0.9, wheelWidth = 1.2, rearWheelRadius = 1, rearWheelWidth = 1.6,
		wheels = { { -2.3, -2.7 }, { 2.3, -2.7 }, { -2.35, 2.6 }, { 2.35, 2.6 } },
		seat = { 0, -0.1, 0.2 }, exhaust = { 0, 0, 4.4 }, parts = parts,
	})
end

for _, body in bigMotor do
	table.insert(KartBodies.List, body)
end
-- The racing-style bodies get the realistic finish too.
for _, body in KartBodies.List do
	if table.find({ "embergt", "arrowsprint", "rallycomet", "racer", "buggy", "muscle", "formula" }, body.id) then
		body.realistic = true
	end
end

-- CPU drivers race the realistic cars so every grid shows them off.
KartBodies.CpuBodies = {}
for _, body in KartBodies.List do
	if body.realistic then
		table.insert(KartBodies.CpuBodies, body.id)
	end
end

-- Give the familiar starter body the same visible exhaust detail.
local starter = nil
for _, body in KartBodies.List do if body.id == "classic" then starter = body end end
if starter then
 for _, side in { -1, 1 } do
  table.insert(starter.parts, { size = { 2.4, 1, 1 }, offset = { side * 1.35, 1.1, 2.8 }, role = "chrome", shape = "Cylinder", rotation = { 0, 90, 0 } })
  table.insert(starter.parts, { size = { 0.12, 0.7, 0.7 }, offset = { side * 1.35, 1.1, 4.02 }, role = "dark", shape = "Cylinder", rotation = { 0, 90, 0 } })
 end
end

export type Look = { body: string, main: number, accent: number }

function KartBodies.get(id: string?): Body
	for _, b in KartBodies.List do
		if b.id == id then
			return b
		end
	end
	return KartBodies.get(KartBodies.Default)
end

function KartBodies.color(index: number?): { number }
	local n = #KartBodies.Palette
	local i = math.clamp(math.floor(tonumber(index) or 1), 1, n)
	return KartBodies.Palette[i]
end

-- Cleans a look sent by a client.
function KartBodies.sanitize(look: any): Look
	local t = if type(look) == "table" then look else {}
	return {
		body = KartBodies.get(t.body).id,
		main = math.clamp(math.floor(tonumber(t.main) or 1), 1, #KartBodies.Palette),
		accent = math.clamp(math.floor(tonumber(t.accent) or 10), 1, #KartBodies.Palette),
	}
end

-- A varied look for CPU driver number n (the same every race).
function KartBodies.cpuLook(n: number): Look
	local pool = KartBodies.CpuBodies
	local body = pool[(n * 5 - 1) % #pool + 1]
	local main = (n * 5) % #KartBodies.Palette + 1
	local accent = (n * 7 + 4) % #KartBodies.Palette + 1
	if accent == main then
		accent = accent % #KartBodies.Palette + 1
	end
	return { body = body, main = main, accent = accent }
end

return KartBodies
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">KartPhysics</string>
          <string name="Source"><![CDATA[--!strict
-- Arcade kart handling as a pure step function. The same code drives player
-- karts (on their client) and CPU karts (on the server), and runs in tests.
--
-- Drifting: hold drift while turning at speed. The longer you hold it (and the
-- harder you steer into it), the bigger the mini-turbo when you let go:
-- level 1 (blue sparks), 2 (orange), 3 (purple).

local Karts = require("./Karts")

export type State = {
	speed: number, -- forward speed, studs/s (negative = reversing)
	yaw: number, -- heading in radians; forward = (-sin yaw, 0, -cos yaw)
	drift: number, -- 0 = not drifting, -1 = drifting left, 1 = right
	charge: number, -- mini-turbo charge while drifting
	boost: number, -- seconds of boost left
	spin: number, -- seconds left spinning out after a hit
	invincible: number, -- seconds of Overdrive left
	slow: number, -- seconds left stuck in something sticky (jelly, syrup)
	draft: number, -- slipstream charge built up behind another kart
	air: number, -- seconds airborne in the current jump
	trick: number, -- 0 = none, else seconds since a trick started in this jump
}

export type Input = {
	throttle: number, -- -1..1
	steer: number, -- -1 (left) .. 1 (right)
	drift: boolean,
	grounded: boolean,
	surface: string, -- "road" | "offroad" | "boost"
	trick: boolean?, -- drift button pressed this frame (does a trick when airborne)
	drafting: boolean?, -- tucked in behind another kart this frame
}

local KartPhysics = {}

KartPhysics.OffroadFactor = 0.55
KartPhysics.BoostFactor = 1.35
KartPhysics.ReverseFactor = 0.35
KartPhysics.BoostPadTime = 1.0
KartPhysics.ChargeLevels = { 0.9, 1.8, 2.9 } -- charge needed for each mini-turbo
KartPhysics.TurboTimes = { 0.6, 1.1, 1.7 } -- boost seconds each level gives
KartPhysics.SlowFactor = 0.5
KartPhysics.ConveyorFactor = 1.15
KartPhysics.SlipperyGrip = 0.55 -- normal steering on wet ground
KartPhysics.LaunchBoost = 1.2
-- Slipstream: stay behind someone this long to get a boost.
KartPhysics.DraftTime = 1.1
KartPhysics.DraftBoost = 0.9
KartPhysics.DraftRange = { 6, 38 } -- studs behind the kart ahead
KartPhysics.DraftWidth = 5 -- how far off their line you can be
-- Tricks: press drift soon after leaving a ramp, land for a boost.
KartPhysics.TrickWindow = 0.6
KartPhysics.TrickMinAir = 0.25
KartPhysics.TrickBoost = 0.8
KartPhysics.TrickSpinTime = 0.45
KartPhysics.SpinTime = 1.2
KartPhysics.SpinSpeedKeep = 0.3
KartPhysics.DriftSlide = 0.35 -- radians the body swings out while drifting (visual)

function KartPhysics.newState(yaw: number): State
	return { speed = 0, yaw = yaw, drift = 0, charge = 0, boost = 0, spin = 0, invincible = 0, slow = 0, draft = 0, air = 0, trick = 0 }
end

function KartPhysics.chargeLevel(charge: number): number
	local level = 0
	for i, need in KartPhysics.ChargeLevels do
		if charge >= need then
			level = i
		end
	end
	return level
end

function KartPhysics.forward(yaw: number): (number, number)
	return -math.sin(yaw), -math.cos(yaw)
end

-- Top speed for the current surface and boost state.
function KartPhysics.targetTop(stats: Karts.KartStats, s: State, surface: string): number
	local top = stats.topSpeed
	if s.boost > 0 then
		top *= KartPhysics.BoostFactor
	elseif surface == "offroad" then
		top *= KartPhysics.OffroadFactor
	end
	if surface == "sticky" then
		top *= KartPhysics.OffroadFactor
	elseif surface == "conveyor" then
		top *= KartPhysics.ConveyorFactor
	end
	if s.slow > 0 then
		top *= KartPhysics.SlowFactor
	end
	return top
end

-- Where the kart body points: the travel heading plus the drift swing and
-- two full turns while spinning out. Travel direction never changes on a spin.
function KartPhysics.visualYaw(s: State): number
	local spinAngle = 0
	if s.spin > 0 then
		spinAngle = (1 - s.spin / KartPhysics.SpinTime) * math.pi * 4
	end
	-- Drifting right (drift = 1) swings the nose further right, i.e. lower yaw.
	return s.yaw - s.drift * KartPhysics.DriftSlide + spinAngle
end

-- A hit from an item. Overdrive makes you immune.
function KartPhysics.hit(s: State): boolean
	if s.invincible > 0 or s.spin > 0 then
		return false
	end
	s.spin = KartPhysics.SpinTime
	s.speed *= KartPhysics.SpinSpeedKeep
	s.drift = 0
	s.charge = 0
	s.boost = 0
	return true
end

-- Sticky traps: half speed for a while, no spin.
function KartPhysics.slow(s: State, seconds: number)
	if s.invincible > 0 then
		return
	end
	s.slow = math.max(s.slow, seconds)
	s.boost = 0
end

function KartPhysics.giveBoost(s: State, seconds: number)
	s.boost = math.max(s.boost, seconds)
end

function KartPhysics.overdrive(s: State, seconds: number)
	s.invincible = math.max(s.invincible, seconds)
	s.boost = math.max(s.boost, seconds)
	s.spin = 0
end

local function approach(value: number, target: number, rate: number): number
	if value < target then
		return math.min(value + rate, target)
	end
	return math.max(value - rate, target)
end

-- Is a kart at (px, pz) heading `yaw` tucked in behind any of `others`?
function KartPhysics.isDrafting(px: number, pz: number, yaw: number, others: { { x: number, z: number } }): boolean
	local fx, fz = KartPhysics.forward(yaw)
	for _, o in others do
		local dx, dz = o.x - px, o.z - pz
		local ahead = dx * fx + dz * fz
		local side = math.abs(dx * -fz + dz * fx)
		if ahead >= KartPhysics.DraftRange[1] and ahead <= KartPhysics.DraftRange[2] and side <= KartPhysics.DraftWidth then
			return true
		end
	end
	return false
end

-- Extra roll (radians) for the trick animation: one full barrel roll.
function KartPhysics.trickRoll(s: State): number
	if s.trick <= 0 then
		return 0
	end
	return math.clamp(s.trick / KartPhysics.TrickSpinTime, 0, 1) * math.pi * 2
end

-- Events returned by step: mini-turbo levels 1..3 as numbers, plus these.
KartPhysics.Events = { Trick = 10, Draft = 11 }

-- Advances the kart by dt. Mutates and returns the state, plus what happened
-- this step for sound/effects: a mini-turbo level (1..3), Events.Trick when a
-- trick lands, Events.Draft when a slipstream boost kicks in, or 0.
function KartPhysics.step(stats: Karts.KartStats, s: State, input: Input, dt: number): (State, number)
	local released = 0
	s.boost = math.max(0, s.boost - dt)
	s.invincible = math.max(0, s.invincible - dt)
	s.slow = math.max(0, s.slow - dt)

	-- Jumps and tricks.
	if not input.grounded then
		s.air += dt
		if s.trick > 0 then
			s.trick += dt
		elseif input.trick and s.air <= KartPhysics.TrickWindow and s.spin <= 0 then
			s.trick = dt
		end
	else
		if s.trick > 0 and s.air >= KartPhysics.TrickMinAir and s.spin <= 0 then
			KartPhysics.giveBoost(s, KartPhysics.TrickBoost)
			released = KartPhysics.Events.Trick
		end
		s.air = 0
		s.trick = 0
	end

	-- Slipstream.
	if input.drafting and input.grounded and s.speed > stats.topSpeed * 0.6 then
		s.draft += dt
		if s.draft >= KartPhysics.DraftTime then
			s.draft = 0
			KartPhysics.giveBoost(s, KartPhysics.DraftBoost)
			released = KartPhysics.Events.Draft
		end
	else
		s.draft = math.max(0, s.draft - dt * 2)
	end

	if input.surface == "boost" then
		KartPhysics.giveBoost(s, KartPhysics.BoostPadTime)
	elseif input.surface == "launch" then
		KartPhysics.giveBoost(s, KartPhysics.LaunchBoost)
	end

	if s.spin > 0 then
		s.spin = math.max(0, s.spin - dt)
		s.speed = approach(s.speed, 0, stats.accel * 1.5 * dt)
		return s, released
	end

	local top = KartPhysics.targetTop(stats, s, input.surface)
	local throttle = math.clamp(input.throttle, -1, 1)
	local steer = math.clamp(input.steer, -1, 1)

	-- Speed ----------------------------------------------------------------
	if s.boost > 0 then
		s.speed = approach(s.speed, top, stats.accel * 3 * dt)
	elseif not input.grounded then
		-- Airborne: hold speed.
	elseif s.speed > top then
		s.speed = approach(s.speed, top, stats.accel * 1.5 * dt)
	elseif throttle > 0 then
		s.speed = approach(s.speed, top * throttle, stats.accel * dt)
	elseif throttle < 0 then
		if s.speed > 0 then
			s.speed = approach(s.speed, 0, stats.accel * 2.5 * dt)
		else
			s.speed = approach(s.speed, -top * KartPhysics.ReverseFactor, stats.accel * 0.8 * dt)
		end
	else
		s.speed = approach(s.speed, 0, stats.accel * 0.6 * dt)
	end

	-- Drift start / release ------------------------------------------------
	if s.drift == 0 then
		if input.drift and input.grounded and math.abs(steer) > 0.3 and s.speed > stats.topSpeed * 0.4 then
			s.drift = if steer > 0 then 1 else -1
			s.charge = 0
		end
	elseif not input.drift or s.speed < stats.topSpeed * 0.3 then
		local level = KartPhysics.chargeLevel(s.charge)
		if level > 0 then
			released = level
			KartPhysics.giveBoost(s, KartPhysics.TurboTimes[level])
		end
		s.drift = 0
		s.charge = 0
	end

	-- Turning ----------------------------------------------------------------
	local turn: number
	if s.drift ~= 0 then
		-- Always turning into the drift; steering into it tightens, against widens.
		turn = s.drift * stats.handling * (0.7 + 0.45 * steer * s.drift)
		if input.grounded then
			s.charge += dt * (1 + math.max(0, steer * s.drift))
		end
	else
		local grip = math.clamp(math.abs(s.speed) / (stats.topSpeed * 0.25), 0, 1)
		if input.surface == "slippery" then
			grip *= KartPhysics.SlipperyGrip
		end
		turn = steer * stats.handling * grip * (if s.speed < 0 then -1 else 1)
	end
	if not input.grounded then
		turn *= 0.4
	end
	-- Positive steer turns right, which is clockwise seen from above: yaw goes down.
	s.yaw -= turn * dt

	return s, released
end

return KartPhysics
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">Karts</string>
          <string name="Source"><![CDATA[--!strict
-- Kart bodies players choose before a race. Your Roblox avatar is the driver;
-- the kart sets the handling. Every kart totals the same number of stat
-- points, so the choice is about style, not power.

export type KartStats = {
	topSpeed: number, -- studs/s
	accel: number, -- studs/s^2
	handling: number, -- turn rate in rad/s at full lock
	weight: number, -- 1..5, heavier karts push lighter ones around
}

export type KartDef = {
	id: string,
	name: string,
	blurb: string,
	color: { number },
	stats: KartStats,
}

local Karts = {}

Karts.Default = "classic"

Karts.List = {
	{
		id = "zippy",
		name = "Zippy",
		blurb = "Light and quick off the line. Great for beginners.",
		color = { 80, 200, 255 },
		stats = { topSpeed = 92, accel = 70, handling = 2.3, weight = 1 },
	},
	{
		id = "classic",
		name = "Classic",
		blurb = "Balanced in every way.",
		color = { 230, 60, 60 },
		stats = { topSpeed = 100, accel = 58, handling = 2.2, weight = 3 },
	},
	{
		id = "brute",
		name = "Brute",
		blurb = "Top speed and weight. Slow to get going.",
		color = { 120, 220, 90 },
		stats = { topSpeed = 106, accel = 54, handling = 2.0, weight = 5 },
	},
} :: { KartDef }

function Karts.get(id: string?): KartDef
	for _, k in Karts.List do
		if k.id == id then
			return k
		end
	end
	return Karts.get(Karts.Default)
end

-- CPU drivers that fill empty grid slots. Original characters.
Karts.CpuDrivers = {
	{ name = "Pip", kart = "zippy" },
	{ name = "Nova", kart = "classic" },
	{ name = "Bolt", kart = "brute" },
	{ name = "Mochi", kart = "zippy" },
	{ name = "Rex", kart = "brute" },
	{ name = "Juno", kart = "classic" },
	{ name = "Taffy", kart = "zippy" },
	{ name = "Gizmo", kart = "classic" },
}

return Karts
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">Landscape</string>
          <string name="Source"><![CDATA[--!strict
-- Plans the land around a track: the ground, earth banks under raised road,
-- rolling hills, lakes, distant snow-capped mountains and desert mesas.
-- It's pure data, so tests can check that nothing lands on the road;
-- server/TerrainBuilder turns the plan into Roblox Terrain.
--
-- Each theme's `terrain` table (in Tracks.Themes) sets the materials and
-- counts. A track can also place its own lakes (`lakes = { { x, z, r } }`)
-- and rivers (`rivers = { { r, points = { { x, z }, ... } } }`), in the same
-- units as its control points; the road may cross those on a bridge. A
-- river is a chain of overlapping round pools, which gives it natural,
-- wavy banks.
-- Placement is seeded by the track id, so every server builds the same land.

local RoadGeometry = require("./RoadGeometry")
local Scenery = require("./Scenery")
local Track = require("./Track")
local Tracks = require("./Tracks")

export type Ball = { x: number, y: number, z: number, r: number, material: string }
export type Mesa = { x: number, z: number, r: number, bottom: number, top: number, material: string, band: string? }
export type Lake = { x: number, z: number, r: number, surface: number, shore: string, liquid: string, bridged: boolean }
-- One earth block under the road, from top-centre point a to b, hanging `depth` down.
export type Bank = { ax: number, ay: number, az: number, bx: number, by: number, bz: number, width: number, depth: number }

export type Plan = {
	trackId: string,
	spec: any,
	groundTop: number,
	minX: number,
	maxX: number,
	minZ: number,
	maxZ: number,
	banks: { Bank },
	bankAt: { [number]: boolean }, -- road points whose verge is terrain
	hills: { Ball },
	mountains: { Ball },
	caps: { Ball },
	mesas: { Mesa },
	lakes: { Lake },
}

local Landscape = {}

Landscape.BankSpread = 1.8 -- each stud of bank height widens its foot by this much

local function rng(seedText: string): () -> number
	local seed = 7
	for i = 1, #seedText do
		seed = (seed * 31 + string.byte(seedText, i)) % 2147483647
	end
	return function(): number
		seed = (seed * 48271) % 2147483647
		return seed / 2147483647
	end
end

-- Flat distance from (x, z) to the nearest road point, and that point's index.
local function nearestRoad(track: Track.Built, x: number, z: number): (number, number)
	local best, index = math.huge, 1
	for i, p in track.points do
		local dx, dz = p.x - x, p.z - z
		local d = dx * dx + dz * dz
		if d < best then
			best, index = d, i
		end
	end
	return math.sqrt(best), index
end

function Landscape.plan(track: Track.Built): Plan?
	local def = track.def
	local theme = Tracks.Themes[def.theme]
	local spec = theme and theme.terrain
	if not spec then
		return nil
	end
	local random = rng(def.id .. ":land")
	local pts = track.points
	local n = #pts
	local half = def.width / 2
	local barrier = half + Track.ShoulderWidth + 1
	local drop = spec.drop or 0.7

	local minY, minX, maxX, minZ, maxZ = math.huge, math.huge, -math.huge, math.huge, -math.huge
	for _, p in pts do
		minY = math.min(minY, p.y)
		minX, maxX = math.min(minX, p.x), math.max(maxX, p.x)
		minZ, maxZ = math.min(minZ, p.z), math.max(maxZ, p.z)
	end
	local groundTop = minY - drop
	local cx, cz = (minX + maxX) / 2, (minZ + maxZ) / 2
	local extent = math.max(maxX - minX, maxZ - minZ) / 2

	local plan: Plan = {
		trackId = def.id,
		spec = spec,
		groundTop = groundTop,
		minX = 0,
		maxX = 0,
		minZ = 0,
		maxZ = 0,
		banks = {},
		bankAt = {},
		hills = {},
		mountains = {},
		caps = {},
		mesas = {},
		lakes = {},
	}

	-- How far a raised road's bank reaches sideways at point i.
	local function bankReach(i: number): number
		return barrier + (pts[i].y - minY) * Landscape.BankSpread / 2
	end
	local landmarks = Scenery.setPieceSpots(track)
	local function clearOfRoad(x: number, z: number, radius: number, margin: number): boolean
		local d, i = nearestRoad(track, x, z)
		if d <= radius + bankReach(i) + margin or Scenery.shortcutDistance(track, x, z) <= radius + margin then
			return false
		end
		for _, spot in landmarks do
			local dx, dz = spot.x - x, spot.z - z
			if math.sqrt(dx * dx + dz * dz) < radius + Scenery.SetPieceRadius + margin then
				return false
			end
		end
		return true
	end

	-- Lakes the track asks for (the road may bridge them), then random ones.
	local scale = def.scale or 1
	local ownLakes = table.clone((def :: any).lakes or {})
	for _, river in (def :: any).rivers or {} do
		local pts = river.points
		for k = 1, #pts - 1 do
			local ax, az, bx, bz = pts[k][1], pts[k][2], pts[k + 1][1], pts[k + 1][2]
			local length = math.sqrt((bx - ax) ^ 2 + (bz - az) ^ 2)
			local steps = math.max(1, math.ceil(length / (river.r * 0.9)))
			for step = 0, steps - (if k < #pts - 1 then 1 else 0) do
				local f = step / steps
				-- Alternate the width a little so the banks aren't ruler-straight.
				local wobble = 1 + 0.18 * math.sin((k * 7 + step) * 1.7)
				table.insert(ownLakes, { x = ax + (bx - ax) * f, z = az + (bz - az) * f, r = river.r * wobble })
			end
		end
	end
	for _, l in ownLakes do
		table.insert(plan.lakes, {
			x = l.x * scale,
			z = l.z * scale,
			r = l.r * scale,
			surface = groundTop - 1.4,
			shore = (spec.lakes and spec.lakes.shore) or "Sand",
			liquid = (spec.lakes and spec.lakes.liquid) or "Water",
			bridged = true,
		})
	end
	local function clearOfLakes(x: number, z: number, radius: number, margin: number): boolean
		for _, l in plan.lakes do
			local dx, dz = l.x - x, l.z - z
			if math.sqrt(dx * dx + dz * dz) < l.r + radius + margin then
				return false
			end
		end
		return true
	end
	local lakeRule = spec.lakes
	if lakeRule then
		local placed, tries = 0, 0
		while placed < (lakeRule.count or 0) and tries < 400 do
			tries += 1
			local r = lakeRule.min + random() * (lakeRule.max - lakeRule.min)
			local a = random() * math.pi * 2
			local dist = random() * (extent + 220)
			local x, z = cx + math.cos(a) * dist, cz + math.sin(a) * dist
			if clearOfRoad(x, z, r, 30) and clearOfLakes(x, z, r, 40) then
				placed += 1
				table.insert(plan.lakes, { x = x, z = z, r = r, surface = groundTop - 1.4, shore = lakeRule.shore or "Sand", liquid = lakeRule.liquid or "Water", bridged = false })
			end
		end
	end

	-- Earth banks: raised road sits on terrain instead of floating, except
	-- over other road (a bridge) or over a lake the track crosses.
	local overpass = RoadGeometry.overpasses(track, barrier + 40, 6)
	for i, p in pts do
		local overLake = false
		for _, l in plan.lakes do
			if l.bridged then
				local dx, dz = l.x - p.x, l.z - p.z
				if math.sqrt(dx * dx + dz * dz) < l.r + barrier + 8 then
					overLake = true
				end
			end
		end
		plan.bankAt[i] = spec.embank ~= false and not overpass[i] and not overLake
	end
	if spec.embank ~= false then
		local frames = RoadGeometry.frames(track)
		for i = 1, n do
			local j = i % n + 1
			if plan.bankAt[i] and plan.bankAt[j] then
				local a, b = frames[i], frames[j]
				local height = math.max(a.y, b.y) - minY
				-- Road at ground level needs nothing: the slab is its verge.
				local tiers = if height < 0.5 then 0 elseif height < 3 then 1 else 3
				local mx, mz = (a.x + b.x) / 2, (a.z + b.z) / 2
				for k = 0, tiers - 1 do
					local lower = height * k / 3
					local width = (barrier + 4) * 2 + lower * Landscape.BankSpread
					-- Stop short of any other stretch of road lower than this tier,
					-- so a hill section's bank never buries the road beside it.
					local tierTop = math.max(a.y, b.y) - drop - lower
					for q = 1, n do
						local apart = math.min(math.abs(q - i), n - math.abs(q - i))
						local other = pts[q]
						if apart > 6 and other.y < tierTop + 2 then
							local dx, dz = other.x - mx, other.z - mz
							local room = math.sqrt(dx * dx + dz * dz) - barrier - 6
							width = math.min(width, math.max((barrier + 4) * 2, room * 2))
						end
					end
					table.insert(plan.banks, {
						ax = a.x,
						ay = a.y - drop - lower,
						az = a.z,
						bx = b.x,
						by = b.y - drop - lower,
						bz = b.z,
						width = width,
						depth = math.max(4, a.y - drop - lower - groundTop + 6),
					})
				end
			end
		end
	end

	-- Earth under shortcut paths, so a shortcut across a valley sits on a
	-- ridge instead of floating.
	for _, sc in def.shortcuts or {} do
		local a, b = Track.shortcutEnds(track, sc)
		local top = math.min(a.y, b.y) - drop
		if top > groundTop + 0.5 then
			table.insert(plan.banks, { ax = a.x, ay = a.y - drop, az = a.z, bx = b.x, by = b.y - drop, bz = b.z, width = sc.width + 12, depth = top - groundTop + 6 })
		end
	end

	-- Rolling hills, clear of the road and its banks.
	local hillRule = spec.hills
	if hillRule then
		local placed, tries = 0, 0
		while placed < hillRule.count and tries < hillRule.count * 30 do
			tries += 1
			local r = hillRule.min + random() * (hillRule.max - hillRule.min)
			local a = random() * math.pi * 2
			local dist = random() * (extent + 320)
			local x, z = cx + math.cos(a) * dist, cz + math.sin(a) * dist
			local foot = r * 0.79 -- footprint radius of a cap 0.38r tall
			if clearOfRoad(x, z, foot, 25) and clearOfLakes(x, z, foot, 15) then
				placed += 1
				table.insert(plan.hills, { x = x, y = groundTop - r * 0.62, z = z, r = r, material = hillRule.material or spec.ground })
			end
		end
	end

	-- Desert mesas: flat-topped rock with a coloured band.
	local mesaRule = spec.mesas
	if mesaRule then
		local placed, tries = 0, 0
		while placed < mesaRule.count and tries < mesaRule.count * 40 do
			tries += 1
			local r = mesaRule.min + random() * (mesaRule.max - mesaRule.min)
			local a = random() * math.pi * 2
			local dist = extent * 0.3 + random() * (extent + (mesaRule.ring or 300))
			local x, z = cx + math.cos(a) * dist, cz + math.sin(a) * dist
			if clearOfRoad(x, z, r, 40) and clearOfLakes(x, z, r, 20) then
				placed += 1
				local height = mesaRule.minHeight + random() * (mesaRule.maxHeight - mesaRule.minHeight)
				table.insert(plan.mesas, { x = x, z = z, r = r, bottom = groundTop - 4, top = groundTop + height, material = mesaRule.material, band = mesaRule.band })
			end
		end
	end

	-- Distant mountains in a ring: a main mass, two shoulders, a peak and a cap.
	-- An optional `outer` ring sits further out: bigger, hazier peaks behind.
	local reach = extent + 200
	local rings = {}
	if spec.mountains then
		table.insert(rings, spec.mountains)
		if spec.mountains.outer then
			local outer = table.clone(spec.mountains.outer)
			outer.material = outer.material or spec.mountains.material
			outer.cap = if outer.cap ~= nil then outer.cap else spec.mountains.cap
			table.insert(rings, outer)
		end
	end
	for _, mountainRule in rings do
		local count = mountainRule.count
		for k = 0, count - 1 do
			local r = mountainRule.min + random() * (mountainRule.max - mountainRule.min)
			local a = (k + random() * 0.6) / count * math.pi * 2
			local dist = extent + (mountainRule.ring or 400) + random() * 260
			local x, z = cx + math.cos(a) * dist, cz + math.sin(a) * dist
			if clearOfRoad(x, z, r * 1.25, 60) then
				local material = mountainRule.material or "Rock"
				local baseY = groundTop - r * 0.35
				table.insert(plan.mountains, { x = x, y = baseY, z = z, r = r, material = material })
				local sx, sz = -math.sin(a), math.cos(a)
				for _, side in { -1, 1 } do
					local o = r * (0.65 + random() * 0.2)
					table.insert(plan.mountains, { x = x + sx * side * o, y = groundTop - r * 0.25, z = z + sz * side * o, r = r * (0.5 + random() * 0.15), material = material })
				end
				local peakY = baseY + r * 0.72
				table.insert(plan.mountains, { x = x + (random() - 0.5) * r * 0.2, y = peakY, z = z + (random() - 0.5) * r * 0.2, r = r * 0.45, material = material })
				if mountainRule.cap then
					table.insert(plan.caps, { x = x, y = baseY + r * 0.98, z = z, r = r * 0.3, material = mountainRule.cap })
				end
				reach = math.max(reach, dist + r * 1.3)
			end
		end
	end

	-- Ground slab out to the horizon features.
	local margin = math.max(reach - extent, 400) + 60
	plan.minX, plan.maxX = cx - extent - margin, cx + extent + margin
	plan.minZ, plan.maxZ = cz - extent - margin, cz + extent + margin
	return plan
end

-- Height of the land at (x, z), or nil over water (props skip those spots).
function Landscape.groundAt(plan: Plan, x: number, z: number): number?
	for _, l in plan.lakes do
		local dx, dz = l.x - x, l.z - z
		if dx * dx + dz * dz < l.r * l.r then
			return nil
		end
	end
	local h = plan.groundTop
	for _, bank in plan.banks do
		local abx, abz = bank.bx - bank.ax, bank.bz - bank.az
		local len2 = abx * abx + abz * abz
		if len2 > 0 then
			-- The block spans its segment plus 2 studs at each end (TerrainBuilder).
			local len = math.sqrt(len2)
			local t = ((x - bank.ax) * abx + (z - bank.az) * abz) / len2
			if t * len >= -2 and t * len <= len + 2 then
				local px, pz = bank.ax + abx * t, bank.az + abz * t
				local dx, dz = x - px, z - pz
				if dx * dx + dz * dz < (bank.width / 2) ^ 2 then
					h = math.max(h, bank.ay + (bank.by - bank.ay) * math.clamp(t, 0, 1))
				end
			end
		end
	end
	local function ball(b: Ball)
		local dx, dz = b.x - x, b.z - z
		local d2 = dx * dx + dz * dz
		if d2 < b.r * b.r then
			h = math.max(h, b.y + math.sqrt(b.r * b.r - d2))
		end
	end
	for _, b in plan.hills do
		ball(b)
	end
	for _, b in plan.mountains do
		ball(b)
	end
	for _, m in plan.mesas do
		local dx, dz = m.x - x, m.z - z
		if dx * dx + dz * dz < m.r * m.r then
			h = math.max(h, m.top)
		end
	end
	return h
end

return Landscape
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">LobbyLayout</string>
          <string name="Source"><![CDATA[--!strict
-- Compact indoor voting hall with garage, trophies and party bays.
-- World-space coordinates; the legacy practice definition is kept only for
-- old data/module compatibility and is not built or reachable from the lobby.

local Track = require("./Track")
local v = Track.v

export type Spot = { x: number, y: number, z: number }
export type Box = { min: Spot, max: Spot }

local LobbyLayout = {}

local OX, OZ = 0, 5000
local function at(dx: number, dz: number, y: number?): Spot
	return { x = OX + dx, y = y or 0, z = OZ + dz }
end
local function box(x0: number, z0: number, x1: number, z1: number): Box
	return { min = at(x0, z0), max = at(x1, z1) }
end

LobbyLayout.Origin = at(0, 0)

-- Compact indoor chamber; no practice or viewing rooms.
LobbyLayout.HalfWidth = 68
LobbyLayout.HalfDepth = 78
LobbyLayout.Height = 44
LobbyLayout.DeckHeight = 8
LobbyLayout.Screen = { center = at(0, -77, 24), width = 76, height = 26, recess = 2 }
LobbyLayout.StatusBoard = at(0, -76, 39)
LobbyLayout.DepartureDoors = { at(-54, -78), at(54, -78) }
LobbyLayout.CentralFloor = { center = at(0, -10), radius = 25 }
LobbyLayout.VotePads = { at(-39, -48), at(-13, -52), at(13, -52), at(39, -48) }
LobbyLayout.VotePadSize = 16
LobbyLayout.RandomPad = 4
LobbyLayout.PadColors = { { 105, 165, 190 }, { 195, 125, 150 }, { 205, 175, 105 }, { 155, 140, 195 } }
LobbyLayout.Platform = box(-68, 48, 68, 78)
LobbyLayout.Spawn = at(0, 65, 8)
LobbyLayout.Stairs = { from = at(0, 48, 8), to = at(0, 28), width = 28, steps = 4 }
LobbyLayout.Ramps = {
 { from = at(-44, 48, 8), to = at(-44, 0), width = 12 },
 { from = at(44, 48, 8), to = at(44, 0), width = 12 },
}
LobbyLayout.Walkways = { box(-68, -66, -58, 48), box(58, -66, 68, 48) }
export type Room = { id: string, name: string, icon: string, door: Spot, side: number, box: Box }
LobbyLayout.Rooms = {
 { id = "garage", name = "Garage", icon = "🔧", door = at(-68, -24), side = -1, box = box(-110, -66, -68, 6) },
 { id = "trophy", name = "Trophy Room", icon = "🏆", door = at(68, -28), side = 1, box = box(68, -66, 110, 0) },
 { id = "party", name = "Party Bays", icon = "🎉", door = at(68, 28), side = 1, box = box(68, 8, 110, 66) },
} :: { Room }
LobbyLayout.DoorWidth = 16
LobbyLayout.DoorHeight = 13
LobbyLayout.KartDisplays = { at(-23, -70), at(0, -70), at(23, -70), at(-58, 20) }

-- Indoor practice circuit (inside the removed legacy practice layout). Open, no walls.
LobbyLayout.PracticeArea = box(150, -230, 510, -18)
LobbyLayout.DriftCircle = { center = at(330, -120), radius = 40 }
LobbyLayout.PracticeTrack = {
	id = "practice",
	name = "Practice Circuit",
	theme = "hq",
	width = 34,
	laps = 1,
	walls = false,
	controls = {
		v(OX + 240, 0, OZ - 40),
		v(OX + 420, 0, OZ - 40),
		v(OX + 465, 0, OZ - 80),
		v(OX + 465, 0, OZ - 160),
		v(OX + 420, 0, OZ - 200),
		v(OX + 240, 0, OZ - 200),
		v(OX + 195, 0, OZ - 160),
		v(OX + 195, 0, OZ - 80),
	},
	boostPads = { { t = 0.05, offset = 0 }, { t = 0.1, offset = 0 } },
	itemRows = {},
	ramps = { { t = 0.62, offset = 0, width = 16 } },
	difficulty = "Easy",
	feature = "Practice drifting, jumping and boosting",
	icon = "🏁",
} :: Track.TrackDef

-- Hidden golden tokens around the lobby rooms.
LobbyLayout.Collectibles = {
 at(-61, -62, 10), at(61, -62, 10), at(-104, -58, 2),
 at(104, 58, 2), at(104, -58, 2), at(-56, 67, 10),
}

-- Practice sign at the removed legacy practice layout entrance; it starts a practice kart.
LobbyLayout.PracticeStart = at(170, -70)

function LobbyLayout.roomById(id: string): Room?
	for _, room in LobbyLayout.Rooms do
		if room.id == id then
			return room
		end
	end
	return nil
end

-- Which vote pad (1..4, 4 = Random) a position is standing on, if any.
function LobbyLayout.padAt(x: number, z: number): number?
	local r = LobbyLayout.VotePadSize / 2
	for i, pad in LobbyLayout.VotePads do
		local dx, dz = x - pad.x, z - pad.z
		if dx * dx + dz * dz <= r * r then
			return i
		end
	end
	return nil
end

function LobbyLayout.inChamber(x: number, z: number): boolean
	return math.abs(x - OX) <= LobbyLayout.HalfWidth and math.abs(z - OZ) <= LobbyLayout.HalfDepth
end

function LobbyLayout.inBox(b: Box, x: number, z: number): boolean
	return x >= b.min.x and x <= b.max.x and z >= b.min.z and z <= b.max.z
end

return LobbyLayout
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">PlayerData</string>
          <string name="Source"><![CDATA[--!strict
-- A player's saved data and every rule for changing it: coins, unlocked and
-- equipped cosmetics, kart name and plate, settings, best laps, mastery,
-- lifetime stats and challenges. Pure data so the server validates
-- purchases and rewards in one tested place.

local Cosmetics = require("./Cosmetics")
local KartBodies = require("./KartBodies")
local Karts = require("./Karts")
local Rewards = require("./Rewards")

export type Equipped = {
	kart: string, -- stats class
	body: string,
	main: number,
	accent: number,
	wheels: string,
	sticker: string,
	horn: string,
	trail: string,
	plate: string,
	name: string,
}

export type Mastery = { races: number, finishes: number, podiums: number, wins: number, bestLap: number?, bestRace: number? }

export type Data = {
	version: number,
	coins: number,
	owned: { [string]: { [string]: boolean } },
	equipped: Equipped,
	settings: { autoAccelerate: boolean, reducedEffects: boolean, cameraFar: boolean },
	mastery: { [string]: Mastery },
	stats: { races: number, wins: number, podiums: number, shortcuts: number, cleanRaces: number, jumps: number, improvedLaps: number },
	challenges: { [string]: boolean },
	tokens: { [string]: boolean },
}

local PlayerData = {}

PlayerData.Version = 1
PlayerData.StartingCoins = 200

function PlayerData.new(): Data
	return {
		version = PlayerData.Version,
		coins = PlayerData.StartingCoins,
		owned = Cosmetics.starterOwned(),
		equipped = {
			kart = Karts.Default,
			body = KartBodies.Default,
			main = 1,
			accent = 10,
			wheels = "standard",
			sticker = "none",
			horn = "beep",
			trail = "smoke",
			plate = "",
			name = "",
		},
		settings = { autoAccelerate = false, reducedEffects = false, cameraFar = false },
		mastery = {},
		stats = { races = 0, wins = 0, podiums = 0, shortcuts = 0, cleanRaces = 0, jumps = 0, improvedLaps = 0 },
		challenges = {},
		tokens = {},
	}
end

-- Fills in anything missing from older or damaged saves.
function PlayerData.migrate(saved: any): Data
	local fresh = PlayerData.new()
	if type(saved) ~= "table" then
		return fresh
	end
	local function merge(into: any, defaults: any)
		for k, v in defaults do
			if into[k] == nil or type(into[k]) ~= type(v) then
				into[k] = v
			elseif type(v) == "table" and next(v) ~= nil and type(next(v)) == "string" then
				merge(into[k], v)
			end
		end
	end
	merge(saved, fresh)
	-- Make sure starter items stay owned even if the catalog grew.
	for kind, ids in Cosmetics.starterOwned() do
		saved.owned[kind] = saved.owned[kind] or {}
		for id in ids do
			saved.owned[kind][id] = true
		end
	end
	saved.version = PlayerData.Version
	PlayerData.validateEquipped(saved)
	return saved
end

-- Puts back defaults for anything equipped that isn't owned or no longer exists.
function PlayerData.validateEquipped(d: Data)
	local e = d.equipped
	if not Cosmetics.find("body", e.body) or not d.owned.body[e.body] then
		e.body = KartBodies.Default
	end
	for kind, default in { wheels = "standard", sticker = "none", horn = "beep", trail = "smoke" } do
		local id = (e :: any)[kind]
		if not Cosmetics.find(kind, id) or not (d.owned[kind] or {})[id] then
			(e :: any)[kind] = default
		end
	end
	e.kart = Karts.get(e.kart).id
	e.main = math.clamp(math.floor(tonumber(e.main) or 1), 1, #KartBodies.Palette)
	e.accent = math.clamp(math.floor(tonumber(e.accent) or 10), 1, #KartBodies.Palette)
	e.plate = Cosmetics.cleanText(e.plate, Cosmetics.PlateMaxLength)
	e.name = Cosmetics.cleanText(e.name, Cosmetics.NameMaxLength)
end

function PlayerData.owns(d: Data, kind: string, id: string): boolean
	return (d.owned[kind] or {})[id] == true
end

function PlayerData.buy(d: Data, kind: string, id: string): (boolean, string?)
	local price = Cosmetics.price(kind, id)
	if price == nil then
		return false, "That item doesn't exist"
	end
	if PlayerData.owns(d, kind, id) then
		return false, "You already own it"
	end
	if d.coins < price then
		return false, "Not enough coins"
	end
	d.coins -= price
	d.owned[kind] = d.owned[kind] or {}
	d.owned[kind][id] = true
	return true
end

-- Equip a cosmetic you own, a kart class, or paint.
function PlayerData.equip(d: Data, kind: string, value: any): (boolean, string?)
	local e = d.equipped
	if kind == "kart" then
		e.kart = Karts.get(tostring(value)).id
		return true
	elseif kind == "main" or kind == "accent" then
		local n = math.floor(tonumber(value) or 0)
		if n < 1 or n > #KartBodies.Palette then
			return false, "Unknown colour"
		end
		(e :: any)[kind] = n
		return true
	elseif kind == "body" or Cosmetics.Lists[kind] then
		local id = tostring(value)
		if not Cosmetics.find(kind, id) then
			return false, "That item doesn't exist"
		end
		if not PlayerData.owns(d, kind, id) then
			return false, "Unlock it first"
		end
		(e :: any)[kind] = id
		return true
	end
	return false, "Unknown setting"
end

-- What the kart builder needs (KartRig look).
function PlayerData.look(d: Data)
	local e = d.equipped
	return {
		body = e.body,
		main = e.main,
		accent = e.accent,
		wheels = e.wheels,
		sticker = e.sticker,
		trail = e.trail,
		plate = e.plate,
	}
end

export type RaceSummary = {
	coins: number,
	lines: { string },
	newBestLap: boolean,
	badge: number?,
	challenges: { string },
}

-- Applies one race to the save data and returns what was earned.
-- `stats` comes from the server's own tracking of that race.
function PlayerData.applyRace(d: Data, trackId: string, trackLength: number, trackCount: number, stats: Rewards.RaceStats, awardIds: { string }): RaceSummary
	local summary: RaceSummary = { coins = 0, lines = {}, newBestLap = false, badge = nil, challenges = {} }
	local function earn(amount: number, line: string)
		summary.coins += amount
		d.coins += amount
		table.insert(summary.lines, `+{amount} 🪙  {line}`)
	end

	earn(Rewards.placeCoins(stats.place, stats.finished), if stats.finished then `Finished {stats.place}` else "Took part")
	for _, id in awardIds do
		local info = Rewards.AwardInfo[id]
		earn(Rewards.AwardCoins, `{info.icon} {info.name}`)
	end

	-- Lifetime stats.
	local s = d.stats
	s.races += 1
	s.shortcuts += stats.shortcutsTaken
	s.jumps += stats.jumps
	if stats.finished then
		if stats.place == 1 then
			s.wins += 1
		end
		if stats.place <= 3 then
			s.podiums += 1
		end
		if stats.hitsTaken == 0 then
			s.cleanRaces += 1
		end
	end

	-- Track mastery and personal bests.
	local m = d.mastery[trackId]
	if not m then
		m = { races = 0, finishes = 0, podiums = 0, wins = 0 }
		d.mastery[trackId] = m
	end
	local before = Rewards.badge(m, trackLength)
	m.races += 1
	if stats.finished then
		m.finishes += 1
		if stats.place <= 3 then
			m.podiums += 1
		end
		if stats.place == 1 then
			m.wins += 1
		end
		if stats.time and (not m.bestRace or stats.time < m.bestRace) then
			m.bestRace = stats.time
		end
	end
	if stats.bestLap then
		if m.bestLap and stats.bestLap < m.bestLap then
			s.improvedLaps += 1
			summary.newBestLap = true
			table.insert(summary.lines, "⏱ New best lap!")
		elseif not m.bestLap then
			summary.newBestLap = true
		end
		if not m.bestLap or stats.bestLap < m.bestLap then
			m.bestLap = stats.bestLap
		end
	end
	local after = Rewards.badge(m, trackLength)
	if after > before then
		summary.badge = after
		table.insert(summary.lines, `{Rewards.BadgeIcons[after]} {Rewards.BadgeNames[after]} mastery badge!`)
	end

	-- Challenges.
	local tracksRaced = 0
	for _ in d.mastery do
		tracksRaced += 1
	end
	local tokenCount = 0
	for _ in d.tokens do
		tokenCount += 1
	end
	local view = {
		wins = s.wins,
		podiums = s.podiums,
		shortcuts = s.shortcuts,
		cleanRaces = s.cleanRaces,
		jumps = s.jumps,
		improvedLaps = s.improvedLaps,
		tracksRaced = tracksRaced,
		trackCount = trackCount,
		tokens = tokenCount,
		tokenCount = math.huge, -- tokens are checked when found, not after races
	}
	for _, c in Rewards.Challenges do
		if not d.challenges[c.id] and c.check(view) then
			d.challenges[c.id] = true
			table.insert(summary.challenges, c.name)
			earn(c.reward, `✅ Challenge: {c.name}`)
		end
	end
	return summary
end

-- A golden token found in the lobby. Returns coins earned (0 if already found).
function PlayerData.foundToken(d: Data, tokenId: string, totalTokens: number): (number, boolean)
	if d.tokens[tokenId] then
		return 0, false
	end
	d.tokens[tokenId] = true
	local coins = Rewards.TokenCoins
	local count = 0
	for _ in d.tokens do
		count += 1
	end
	local completedAll = false
	if count >= totalTokens and not d.challenges.tokens then
		d.challenges.tokens = true
		for _, c in Rewards.Challenges do
			if c.id == "tokens" then
				coins += c.reward
			end
		end
		completedAll = true
	end
	d.coins += coins
	return coins, completedAll
end

function PlayerData.setSetting(d: Data, key: string, value: any): boolean
	if d.settings[key] == nil or type(value) ~= "boolean" then
		return false
	end
	(d.settings :: any)[key] = value
	return true
end

return PlayerData
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">RaceRules</string>
          <string name="Source"><![CDATA[--!strict
-- Placings, Grand Prix points, the start boost, and how hard CPU drivers push.

local RaceRules = {}

RaceRules.MaxRacers = 8
RaceRules.Points = { 15, 12, 10, 8, 6, 4, 2, 1 }
RaceRules.CountdownSeconds = 3
-- Press the throttle in this window before GO for a rocket start.
RaceRules.StartBoostWindow = { -1.0, -0.35 }
RaceRules.StartBoostTime = 1.0

export type Entry = {
	id: string,
	finished: boolean,
	finishTime: number?,
	score: number, -- Track.score: higher is further ahead
}

-- Finishers by time, then everyone else by how far along they are.
function RaceRules.rank(entries: { Entry }): { Entry }
	local list = table.clone(entries)
	table.sort(list, function(a: Entry, b: Entry): boolean
		if a.finished ~= b.finished then
			return a.finished
		end
		if a.finished and a.finishTime ~= b.finishTime then
			return (a.finishTime :: number) < (b.finishTime :: number)
		end
		if a.score ~= b.score then
			return a.score > b.score
		end
		return a.id < b.id
	end)
	return list
end

function RaceRules.pointsFor(place: number): number
	return RaceRules.Points[place] or 0
end

-- `pressedAt` is when the throttle went down, in seconds relative to GO
-- (negative = before GO). Returns boost seconds (0 = no rocket start).
function RaceRules.startBoost(pressedAt: number?): number
	if not pressedAt then
		return 0
	end
	local lo, hi = RaceRules.StartBoostWindow[1], RaceRules.StartBoostWindow[2]
	if pressedAt >= lo and pressedAt <= hi then
		return RaceRules.StartBoostTime
	end
	return 0
end

-- Top-speed multiplier for a CPU driver. CPUs far behind the leader speed up a
-- little; a CPU running away from every human eases off. Humans never get this.
function RaceRules.cpuSpeedFactor(gapToLeader: number, leadOverBestHuman: number, skill: number): number
	local factor = 0.93 + 0.07 * math.clamp(skill, 0, 1)
	factor += math.clamp(gapToLeader / 600, 0, 1) * 0.1
	if leadOverBestHuman > 120 then
		factor -= math.clamp((leadOverBestHuman - 120) / 400, 0, 1) * 0.08
	end
	return factor
end

export type CupRow = { id: string, name: string, points: number, lastPlace: number }

-- Overall cup standings; ties go to whoever placed better in the last race.
function RaceRules.cupStandings(rows: { CupRow }): { CupRow }
	local list = table.clone(rows)
	table.sort(list, function(a: CupRow, b: CupRow): boolean
		if a.points ~= b.points then
			return a.points > b.points
		end
		return a.lastPlace < b.lastPlace
	end)
	return list
end

return RaceRules
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">RemoteNames</string>
          <string name="Source"><![CDATA[--!strict
-- Names of every RemoteEvent the server creates under ReplicatedStorage.Remotes.

return {
	-- server -> client
	Round = "Round", -- (state) lobby phase, countdowns, vote options, live race summary
	RaceStart = "RaceStart", -- (info) track id, your kart, grid yaw, GO time
	PracticeStart = "PracticeStart", -- (info) your practice kart on the lobby loop
	RaceState = "RaceState", -- (info) standings, your lap/place, about 5x a second
	KartEvent = "KartEvent", -- (kind, value) "spin" | "slow" | "launch" | "boost" | "overdrive" | "respawn" | "warning"
	ItemState = "ItemState", -- (itemId?, uses, readyAt)
	Results = "Results", -- (info) placements and rewards
	Notify = "Notify", -- (text)
	OpenGarage = "OpenGarage", -- () the garage prompt was used
	Profile = "Profile", -- (data, canSave) your coins, unlocks, equipped kart, settings, records
	Honk = "Honk", -- (kartName, text) someone honked
	Spectate = "Spectate", -- () start watching the current race

	-- client -> server
	GarageAction = "GarageAction", -- (action, kind, value) buy / equip / text / setting
	HonkRequest = "HonkRequest", -- () press H to honk your horn
	Ready = "Ready", -- (isReady)
	Vote = "Vote", -- (trackId) same as standing on a vote pad
	UseItem = "UseItem", -- (aimBack) aimBack = throw/drop behind you
	Respawn = "Respawn", -- () put my stuck kart back on the road
	LeavePractice = "LeavePractice", -- ()
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">Rewards</string>
          <string name="Source"><![CDATA[--!strict
-- Coins, end-of-race awards, challenges and track mastery badges. Everything
-- here is computed by the server from what it saw happen in the race (place,
-- hits, shortcuts, jumps, lap times), never from what a client claims.

local Rewards = {}

Rewards.PlaceCoins = { 120, 100, 85, 70, 60, 50, 45, 40 }
Rewards.DnfCoins = 20
Rewards.AwardCoins = 40
Rewards.TokenCoins = 25

export type RaceStats = {
	id: string, -- racer id
	name: string,
	place: number,
	finished: boolean,
	time: number?,
	bestLap: number?,
	worstPlace: number,
	hitsTaken: number,
	shortcutsTaken: number,
	jumps: number,
	isCpu: boolean,
}

export type Award = { id: string, name: string, icon: string, winner: string }

function Rewards.placeCoins(place: number, finished: boolean): number
	if not finished then
		return Rewards.DnfCoins
	end
	return Rewards.PlaceCoins[place] or Rewards.PlaceCoins[#Rewards.PlaceCoins]
end

Rewards.AwardInfo = {
	comeback = { name = "Best Comeback", icon = "🔥" },
	clean = { name = "Cleanest Driver", icon = "🧼" },
	shortcut = { name = "Shortcut Expert", icon = "🗺️" },
	flyer = { name = "High Flyer", icon = "🦅" },
}

-- Picks award winners for a finished race. Ties go to the better placing.
function Rewards.awards(rows: { RaceStats }): { Award }
	local out: { Award } = {}
	local function best(score: (RaceStats) -> number?, minimum: number): RaceStats?
		local winner: RaceStats? = nil
		local winnerScore = -math.huge
		for _, r in rows do
			local s = score(r)
			if s and s >= minimum and (s > winnerScore or (s == winnerScore and winner and r.place < winner.place)) then
				winner, winnerScore = r, s
			end
		end
		return winner
	end
	local function add(id: string, r: RaceStats?)
		if r then
			local info = Rewards.AwardInfo[id]
			table.insert(out, { id = id, name = info.name, icon = info.icon, winner = r.id })
		end
	end
	add("comeback", best(function(r)
		return if r.finished then r.worstPlace - r.place else nil
	end, 3))
	add("clean", best(function(r)
		-- Only clean finishers; better place scores higher.
		return if r.finished and r.hitsTaken == 0 then 100 - r.place else nil
	end, 0))
	add("shortcut", best(function(r)
		return r.shortcutsTaken
	end, 1))
	add("flyer", best(function(r)
		return r.jumps
	end, 4))
	return out
end

-- One-time challenges. `check` reads the lifetime stats in the save data.
Rewards.Challenges = {
	{ id = "firstWin", name = "Win a race", reward = 150, check = function(s) return s.wins >= 1 end },
	{ id = "podium3", name = "Finish on the podium 3 times", reward = 150, check = function(s) return s.podiums >= 3 end },
	{ id = "shortcut3", name = "Take 3 shortcuts", reward = 100, check = function(s) return s.shortcuts >= 3 end },
	{ id = "cleanRace", name = "Finish a race without being hit", reward = 120, check = function(s) return s.cleanRaces >= 1 end },
	{ id = "jumps10", name = "Land 10 big jumps", reward = 100, check = function(s) return s.jumps >= 10 end },
	{ id = "personalBest", name = "Beat one of your best lap times", reward = 80, check = function(s) return s.improvedLaps >= 1 end },
	{ id = "explorer", name = "Race on every track", reward = 200, check = function(s) return s.tracksRaced >= s.trackCount end },
	{ id = "tokens", name = "Find all golden tokens in the lobby", reward = 300, check = function(s) return s.tokens >= s.tokenCount end },
}

-- Mastery badge for a track: 1 bronze (finished a race), 2 silver (podium),
-- 3 gold (won, with a best lap under the gold time).
function Rewards.goldLap(trackLength: number): number
	return trackLength / 92
end

function Rewards.badge(mastery: { finishes: number, podiums: number, wins: number, bestLap: number? }, trackLength: number): number
	if mastery.wins >= 1 and mastery.bestLap and mastery.bestLap <= Rewards.goldLap(trackLength) then
		return 3
	elseif mastery.podiums >= 1 then
		return 2
	elseif mastery.finishes >= 1 then
		return 1
	end
	return 0
end

Rewards.BadgeNames = { "Bronze", "Silver", "Gold" }
Rewards.BadgeIcons = { "🥉", "🥈", "🥇" }

return Rewards
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">RoadGeometry</string>
          <string name="Source"><![CDATA[--!strict
-- The road's cross-section, shared by the road builder and its tests.
--
-- Every centreline point gets one frame: its position and a level sideways
-- unit vector (positive = right of travel, the same sign Track.spot uses).
-- The road, curbs, lines, shoulders and barriers all take their edges from
-- these frames, so each piece ends exactly where the next one starts: no
-- gaps on the outside of a bend, no overlapping slabs on the inside.

local Track = require("./Track")

export type Frame = {
	x: number,
	y: number,
	z: number,
	rx: number, -- sideways unit vector (level)
	rz: number,
	turn: number, -- smoothed signed turn here (radians per point, + = right)
}

local RoadGeometry = {}

local function heading(ax: number, az: number, bx: number, bz: number): number
	return math.atan2(bx - ax, bz - az)
end

local function wrapAngle(a: number): number
	return (a + math.pi) % (2 * math.pi) - math.pi
end

function RoadGeometry.frames(track: Track.Built): { Frame }
	local pts = track.points
	local n = #pts
	local raw = {}
	for i = 1, n do
		local a, b, c = pts[(i - 2) % n + 1], pts[i], pts[i % n + 1]
		raw[i] = wrapAngle(heading(b.x, b.z, c.x, c.z) - heading(a.x, a.z, b.x, b.z))
	end
	local frames = {}
	for i = 1, n do
		local prev, nextPoint = pts[(i - 2) % n + 1], pts[i % n + 1]
		local tx, tz = nextPoint.x - prev.x, nextPoint.z - prev.z
		local l = math.sqrt(tx * tx + tz * tz)
		tx, tz = tx / l, tz / l
		local sum = 0
		for k = -2, 2 do
			sum += raw[(i - 1 + k) % n + 1]
		end
		local p = pts[i]
		-- heading() grows to the left of travel, so flip it: + = turning right.
		frames[i] = { x = p.x, y = p.y, z = p.z, rx = -tz, rz = tx, turn = -sum / 5 }
	end
	return frames
end

-- A point `lateral` studs to the right of frame f, `lift` above the road.
function RoadGeometry.edge(f: Frame, lateral: number, lift: number?): Track.Vec
	return Track.v(f.x + f.rx * lateral, f.y + (lift or 0), f.z + f.rz * lateral)
end

-- Segments where an edge at `lateral` runs backwards (the bend is tighter
-- than the offset, so a strip there would fold over itself).
function RoadGeometry.folds(frames: { Frame }, lateral: number): { number }
	local out = {}
	local n = #frames
	for i = 1, n do
		local a, b = frames[i], frames[i % n + 1]
		local ea, eb = RoadGeometry.edge(a, lateral), RoadGeometry.edge(b, lateral)
		local dot = (eb.x - ea.x) * (b.x - a.x) + (eb.z - ea.z) * (b.z - a.z)
		if dot <= 0 then
			table.insert(out, i)
		end
	end
	return out
end

-- Corners get red-and-white curbs; straights get painted edge lines.
RoadGeometry.CurbTurn = 0.035 -- about a 340-stud radius at 12-stud spacing
function RoadGeometry.isCorner(f: Frame): boolean
	return math.abs(f.turn) > RoadGeometry.CurbTurn
end

-- Points carrying road over other road (a bridge): something lower passes
-- underneath within `reach` studs. Embankments and pillars skip these.
function RoadGeometry.overpasses(track: Track.Built, reach: number, clearance: number): { [number]: boolean }
	local pts = track.points
	local n = #pts
	local out = {}
	for i, p in pts do
		for j, q in pts do
			local apart = math.min(math.abs(i - j), n - math.abs(i - j))
			if apart > 12 and q.y < p.y - clearance then
				local dx, dz = q.x - p.x, q.z - p.z
				if dx * dx + dz * dz < reach * reach then
					out[i] = true
					break
				end
			end
		end
	end
	return out
end

return RoadGeometry
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">Scenery</string>
          <string name="Source"><![CDATA[--!strict
-- Decides where scenery goes around a track: trees and grandstands on Sunny
-- Loop, rocks and mesas in the canyon, towers and lamps in the neon city.
-- Placement is seeded by the track id, so every server builds the same
-- scenery, and nothing is ever placed on (or too close to) the road.
--
-- To get more or fewer props, change the counts in Scenery.Themes.

local Track = require("./Track")

export type Prop = {
	kind: string,
	x: number,
	y: number,
	z: number,
	size: number, -- 1 = normal, props scale from this
	yaw: number,
}

local Scenery = {}

-- kind = how many, how close to the barrier (min, max studs), size range, footprint radius.
type Rule = { kind: string, count: number, near: number, far: number, minSize: number, maxSize: number, radius: number }

Scenery.Themes = {
	fortress = {
		{ kind = "rock", count = 130, near = 15, far = 230, minSize = 0.8, maxSize = 2, radius = 8 },
		{ kind = "mesa", count = 18, near = 70, far = 300, minSize = 0.8, maxSize = 1.4, radius = 35 },
	},
	sunny = {
		{ kind = "tree", count = 150, near = 12, far = 220, minSize = 0.8, maxSize = 1.5, radius = 8 },
		{ kind = "pine", count = 60, near = 30, far = 260, minSize = 0.9, maxSize = 1.6, radius = 7 },
		{ kind = "farTree", count = 200, near = 260, far = 650, minSize = 1, maxSize = 1.8, radius = 9 },
		{ kind = "bush", count = 80, near = 6, far = 120, minSize = 0.7, maxSize = 1.3, radius = 4 },
		{ kind = "billboard", count = 8, near = 14, far = 30, minSize = 1, maxSize = 1, radius = 14 },
		{ kind = "flag", count = 18, near = 4, far = 10, minSize = 1, maxSize = 1, radius = 3 },
	},
	-- Mesas are terrain here (Landscape), so only the smaller things are props.
	canyon = {
		{ kind = "rock", count = 110, near = 8, far = 200, minSize = 0.6, maxSize = 1.8, radius = 9 },
		{ kind = "cactus", count = 70, near = 8, far = 160, minSize = 0.8, maxSize = 1.4, radius = 4 },
	},
	-- farTree = a cheap two-part tree for the distant forest (Props.luau).
	highland = {
		{ kind = "tree", count = 170, near = 10, far = 240, minSize = 0.9, maxSize = 1.6, radius = 8 },
		{ kind = "pine", count = 60, near = 20, far = 260, minSize = 0.9, maxSize = 1.6, radius = 7 },
		{ kind = "rock", count = 40, near = 12, far = 200, minSize = 0.6, maxSize = 1.6, radius = 8 },
		{ kind = "flag", count = 16, near = 4, far = 10, minSize = 1, maxSize = 1, radius = 3 },
		{ kind = "farTree", count = 280, near = 260, far = 700, minSize = 1, maxSize = 1.8, radius = 9 },
	},
	alpine = {
		{ kind = "pine", count = 240, near = 10, far = 260, minSize = 0.8, maxSize = 1.7, radius = 7 },
		{ kind = "farTree", count = 220, near = 260, far = 650, minSize = 1, maxSize = 1.8, radius = 9 },
		{ kind = "rock", count = 50, near = 12, far = 220, minSize = 0.6, maxSize = 1.6, radius = 8 },
		{ kind = "flag", count = 14, near = 4, far = 10, minSize = 1, maxSize = 1, radius = 3 },
	},
	-- Tiny racers, oversized world: everything here is giant.
	toyroom = {
		{ kind = "toyBlock", count = 70, near = 10, far = 220, minSize = 0.8, maxSize = 1.6, radius = 10 },
		{ kind = "toyBall", count = 30, near = 14, far = 240, minSize = 0.8, maxSize = 1.5, radius = 12 },
		{ kind = "crayon", count = 40, near = 6, far = 160, minSize = 0.9, maxSize = 1.3, radius = 6 },
		{ kind = "book", count = 24, near = 20, far = 240, minSize = 0.9, maxSize = 1.4, radius = 18 },
	},
	kitchen = {
		{ kind = "fruit", count = 60, near = 8, far = 200, minSize = 0.8, maxSize = 1.5, radius = 9 },
		{ kind = "jar", count = 26, near = 16, far = 220, minSize = 0.9, maxSize = 1.5, radius = 12 },
		{ kind = "cookie", count = 40, near = 6, far = 160, minSize = 0.8, maxSize = 1.3, radius = 7 },
		{ kind = "shaker", count = 20, near = 10, far = 180, minSize = 1, maxSize = 1.4, radius = 6 },
	},
	backyard = {
		{ kind = "grassBlade", count = 170, near = 4, far = 200, minSize = 0.7, maxSize = 1.6, radius = 3 },
		{ kind = "flower", count = 60, near = 8, far = 220, minSize = 0.8, maxSize = 1.5, radius = 7 },
		{ kind = "pebble", count = 50, near = 4, far = 180, minSize = 0.6, maxSize = 1.6, radius = 7 },
		{ kind = "mushroom", count = 26, near = 10, far = 200, minSize = 0.8, maxSize = 1.5, radius = 8 },
		{ kind = "clover", count = 50, near = 2, far = 120, minSize = 0.8, maxSize = 1.3, radius = 4 },
	},
	neon = {
		{ kind = "tower", count = 80, near = 30, far = 300, minSize = 0.7, maxSize = 2.2, radius = 24 },
		{ kind = "lamp", count = 60, near = 3, far = 6, minSize = 1, maxSize = 1, radius = 2 },
		{ kind = "billboard", count = 10, near = 14, far = 30, minSize = 1, maxSize = 1, radius = 14 },
	},
} :: { [string]: { Rule } }

-- Small deterministic random generator (exact in doubles).
local function rng(seedText: string): () -> number
	local seed = 1
	for i = 1, #seedText do
		seed = (seed * 31 + string.byte(seedText, i)) % 2147483647
	end
	return function(): number
		seed = (seed * 48271) % 2147483647
		return seed / 2147483647
	end
end

-- Distance from the centerline to just outside the barrier.
function Scenery.barrier(track: Track.Built): number
	return track.def.width / 2 + Track.ShoulderWidth + 1
end

Scenery.SetPieceRadius = 40

-- Where each landmark from the track's setPieces goes, and which way it faces
-- (toward the road). side 0 puts it over the road itself (e.g. an arch).
function Scenery.setPieceSpots(track: Track.Built): { Prop }
	local out = {}
	local barrier = Scenery.barrier(track)
	for _, sp in track.def.setPieces or {} do
		local d = sp.t * track.length
		local gap = sp.gap or 30
		local lateral = if sp.side == 0 then 0 else sp.side * (barrier + gap)
		local spot = Track.spot(track, d, lateral)
		local _, tan = Track.at(track, d)
		local faceRoad = math.atan2(tan.x, tan.z) + (if sp.side > 0 then math.pi / 2 else -math.pi / 2)
		table.insert(out, { kind = sp.kind, x = spot.x, y = spot.y, z = spot.z, size = 1, yaw = faceRoad })
	end
	return out
end

-- Flat distance from a point to a shortcut's path.
local function shortcutDistance(track: Track.Built, x: number, z: number): number
	local best = math.huge
	for _, sc in track.def.shortcuts or {} do
		local a, b = Track.shortcutEnds(track, sc)
		local abx, abz = b.x - a.x, b.z - a.z
		local t = math.clamp(((x - a.x) * abx + (z - a.z) * abz) / (abx * abx + abz * abz), 0, 1)
		local dx, dz = x - (a.x + abx * t), z - (a.z + abz * t)
		best = math.min(best, math.sqrt(dx * dx + dz * dz) - sc.width / 2)
	end
	return best
end
Scenery.shortcutDistance = shortcutDistance

function Scenery.place(track: Track.Built): { Prop }
	local rules = Scenery.Themes[track.def.theme] or {}
	local random = rng(track.def.id)
	local barrier = Scenery.barrier(track)
	local minY = math.huge
	for _, p in track.points do
		minY = math.min(minY, p.y)
	end

	local props: { Prop } = {}
	local placedRadius: { number } = {}
	local reserved = Scenery.setPieceSpots(track)

	local function clear(x: number, z: number, radius: number): boolean
		-- Away from every part of the track (matters where the track loops back).
		for _, p in track.points do
			local dx, dz = p.x - x, p.z - z
			local need = barrier + radius + 2
			if dx * dx + dz * dz < need * need then
				return false
			end
		end
		for i, other in props do
			local dx, dz = other.x - x, other.z - z
			local need = placedRadius[i] + radius
			if dx * dx + dz * dz < need * need then
				return false
			end
		end
		-- Keep shortcut paths and landmark spots clear.
		if shortcutDistance(track, x, z) < radius + 6 then
			return false
		end
		for _, sp in reserved do
			local dx, dz = sp.x - x, sp.z - z
			local need = Scenery.SetPieceRadius + radius
			if dx * dx + dz * dz < need * need then
				return false
			end
		end
		return true
	end

	for _, rule in rules do
		local placed, attempts = 0, 0
		while placed < rule.count and attempts < rule.count * 12 do
			attempts += 1
			local d = random() * track.length
			local side = if random() < 0.5 then -1 else 1
			local size = rule.minSize + random() * (rule.maxSize - rule.minSize)
			local radius = rule.radius * size
			local lateral = side * (barrier + radius + rule.near + random() * (rule.far - rule.near))
			local spot = Track.spot(track, d, lateral)
			if clear(spot.x, spot.z, radius) then
				local _, tan = Track.at(track, d)
				-- Billboards and flags face the road; everything else is random.
				local faceRoad = rule.kind == "billboard" or rule.kind == "flag" or rule.kind == "lamp"
				local yaw = if faceRoad then math.atan2(tan.x, tan.z) + (if side > 0 then math.pi / 2 else -math.pi / 2) else random() * math.pi * 2
				table.insert(props, { kind = rule.kind, x = spot.x, y = minY, z = spot.z, size = size, yaw = yaw })
				table.insert(placedRadius, radius)
				placed += 1
			end
		end
	end

	-- Grandstands either side of the start line.
	local _, tan = Track.at(track, 0)
	for _, side in { -1, 1 } do
		local lateral = side * (barrier + 18)
		local spot = Track.spot(track, 30, lateral)
		table.insert(props, {
			kind = "grandstand",
			x = spot.x,
			y = minY,
			z = spot.z,
			size = 1,
			yaw = math.atan2(tan.x, tan.z) + (if side > 0 then math.pi / 2 else -math.pi / 2),
		})
	end
	return props
end

return Scenery
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">Track</string>
          <string name="Source"><![CDATA[--!strict
-- Turns a track's control points into a smooth closed centerline, and answers
-- "where along the track is this kart?" for positions, laps, CPU steering and
-- respawning. Pure math on {x, y, z} tables.

export type Vec = { x: number, y: number, z: number }

export type TrackDef = {
	id: string,
	name: string,
	width: number, -- road width in studs
	laps: number,
	controls: { Vec }, -- closed loop, driven in list order; first point is the finish line
	boostPads: { { t: number, offset: number } }, -- t = 0..1 along the lap, offset = -1..1 across
	itemRows: { number }, -- t values for rows of item boxes
	theme: string,
	-- Multiplies every control point (x, y and z), so the whole layout grows
	-- without changing its shape or how steep the hills are. Default 1.
	scale: number?,
	-- Shown on the voting cards.
	difficulty: string?, -- "Easy" | "Medium" | "Hard"
	feature: string?, -- the track's main attraction, one short line
	icon: string?, -- emoji for the card
	-- false = open area with no walls or grass shoulders (the lobby practice loop).
	walls: boolean?,
	-- Jump ramps: t along the lap, offset across (-1..1), ramp width in studs.
	ramps: { { t: number, offset: number, width: number } }?,
	-- Surface patches: "sticky" (syrup, mud: slow), "slippery" (water: less
	-- grip), "conveyor" (pushes you along), "launch" (a big boost). Optional
	-- period/duty make them switch on and off (sprinklers), in seconds.
	zones: { Zone }?,
	-- Moving hazards that cross the road (toy robot, beetles, train).
	crossers: { Crosser }?,
	-- Skill shortcuts: a narrow path leaving the road at `from` and rejoining
	-- at `to` (both t values), on one side (-1 left, 1 right).
	shortcuts: { Shortcut }?,
	-- Covered stretches: "bed", "hose", "log", "box", "arch".
	tunnels: { { from: number, to: number, style: string } }?,
	-- Big themed landmarks placed beside the road.
	setPieces: { { kind: string, t: number, side: number, gap: number? } }?,
	-- Lakes the road may cross on a bridge (realistic themes with terrain).
	-- Same units as the control points: scaled by `scale`.
	lakes: { { x: number, z: number, r: number } }?,
	-- Rivers: a radius and a polyline of { x, z } points, same units.
	rivers: { { r: number, points: { { number } } } }?,
}

export type Zone = { kind: string, t: number, length: number, offset: number?, width: number?, period: number?, duty: number? }
export type Crosser = { kind: string, t: number, period: number, phase: number?, radius: number }
export type Shortcut = { from: number, to: number, side: number, width: number, surface: string? }

export type Built = {
	def: TrackDef,
	points: { Vec }, -- dense samples; points[1] is on the finish line
	cum: { number }, -- distance from the finish line to each point
	length: number,
	sectors: number,
}

local Track = {}

Track.Spacing = 12
Track.Sectors = 12
Track.ShoulderWidth = 10

local function v(x: number, y: number, z: number): Vec
	return { x = x, y = y, z = z }
end
Track.v = v

local function sub(a: Vec, b: Vec): Vec
	return v(a.x - b.x, a.y - b.y, a.z - b.z)
end

local function len(a: Vec): number
	return math.sqrt(a.x * a.x + a.y * a.y + a.z * a.z)
end

local function lerp(a: Vec, b: Vec, t: number): Vec
	return v(a.x + (b.x - a.x) * t, a.y + (b.y - a.y) * t, a.z + (b.z - a.z) * t)
end

-- Uniform Catmull-Rom between p1 and p2.
local function catmull(p0: Vec, p1: Vec, p2: Vec, p3: Vec, t: number): Vec
	local t2, t3 = t * t, t * t * t
	local function c(a: number, b: number, cc: number, d: number): number
		return 0.5 * ((2 * b) + (-a + cc) * t + (2 * a - 5 * b + 4 * cc - d) * t2 + (-a + 3 * b - 3 * cc + d) * t3)
	end
	return v(c(p0.x, p1.x, p2.x, p3.x), c(p0.y, p1.y, p2.y, p3.y), c(p0.z, p1.z, p2.z, p3.z))
end

function Track.build(def: TrackDef): Built
	local scale = def.scale or 1
	local ctrl = {}
	for i, c in def.controls do
		ctrl[i] = v(c.x * scale, c.y * scale, c.z * scale)
	end
	local n = #ctrl
	-- Fine samples first, then resample evenly by distance.
	local fine: { Vec } = {}
	for i = 1, n do
		local p0, p1 = ctrl[(i - 2) % n + 1], ctrl[i]
		local p2, p3 = ctrl[i % n + 1], ctrl[(i + 1) % n + 1]
		for s = 0, 19 do
			table.insert(fine, catmull(p0, p1, p2, p3, s / 20))
		end
	end
	table.insert(fine, fine[1])

	local fineCum = { 0 }
	for i = 2, #fine do
		fineCum[i] = fineCum[i - 1] + len(sub(fine[i], fine[i - 1]))
	end
	local total = fineCum[#fine]
	local count = math.max(8, math.floor(total / Track.Spacing + 0.5))
	local step = total / count

	local points: { Vec } = {}
	local cum: { number } = {}
	local j = 1
	for k = 0, count - 1 do
		local d = k * step
		while fineCum[j + 1] < d do
			j += 1
		end
		local segLen = fineCum[j + 1] - fineCum[j]
		local t = if segLen > 0 then (d - fineCum[j]) / segLen else 0
		table.insert(points, lerp(fine[j], fine[j + 1], t))
		table.insert(cum, d)
	end

	return { def = def, points = points, cum = cum, length = total, sectors = Track.Sectors }
end

function Track.pointCount(track: Built): number
	return #track.points
end

-- Point and unit tangent at distance d along the lap (wraps).
function Track.at(track: Built, d: number): (Vec, Vec)
	local n = #track.points
	d %= track.length
	local step = track.length / n
	local i = math.floor(d / step) + 1
	local a, b = track.points[i], track.points[i % n + 1]
	local t = (d - track.cum[i]) / step
	local dir = sub(b, a)
	local l = len(dir)
	return lerp(a, b, t), v(dir.x / l, dir.y / l, dir.z / l)
end

export type Projection = { index: number, distance: number, lateral: number, gap: number }

-- Nearest spot on the centerline. `hint` (a previous index) keeps the search
-- local so crossing bridges don't snap to the road below.
function Track.project(track: Built, pos: Vec, hint: number?): Projection
	local n = #track.points
	local function test(i: number, best: Projection?): Projection?
		local a, b = track.points[i], track.points[i % n + 1]
		local ab = sub(b, a)
		local ap = sub(pos, a)
		local abLen2 = ab.x * ab.x + ab.y * ab.y + ab.z * ab.z
		local t = math.clamp((ap.x * ab.x + ap.y * ab.y + ap.z * ab.z) / abLen2, 0, 1)
		local closest = lerp(a, b, t)
		local gap = len(sub(pos, closest))
		if best and gap >= best.gap then
			return best
		end
		-- Lateral: positive = right of travel direction (flat cross product).
		local fx, fz = ab.x, ab.z
		local fl = math.sqrt(fx * fx + fz * fz)
		local lateral = if fl > 0 then ((pos.x - closest.x) * -fz + (pos.z - closest.z) * fx) / fl else 0
		return { index = i, distance = track.cum[i] + t * math.sqrt(abLen2), lateral = lateral, gap = gap }
	end

	local best: Projection? = nil
	if hint then
		for k = -12, 12 do
			best = test((hint - 1 + k) % n + 1, best)
		end
		if best and best.gap <= track.def.width * 1.5 then
			return best
		end
	end
	for i = 1, n do
		best = test(i, best)
	end
	return best :: Projection
end

function Track.sectorOf(track: Built, d: number): number
	return math.floor((d % track.length) / track.length * track.sectors)
end

function Track.sectorStart(track: Built, sector: number): number
	return sector / track.sectors * track.length
end

---------------------------------------------------------------------------
-- Layout shared by the builder, the server and the tests.
---------------------------------------------------------------------------
Track.PadLength = 24
Track.PadWidth = 16

export type Pad = { distance: number, lateral: number }

function Track.pads(track: Built): { Pad }
	local out = {}
	local half = track.def.width / 2 - Track.PadWidth / 2 - 2
	for _, pad in track.def.boostPads do
		table.insert(out, { distance = pad.t * track.length, lateral = pad.offset * half })
	end
	return out
end

-- Four item boxes across the road for each row.
function Track.itemBoxes(track: Built): { Pad }
	local out = {}
	local spread = track.def.width / 2 - 8
	for _, t in track.def.itemRows do
		for i = 0, 3 do
			table.insert(out, { distance = t * track.length, lateral = -spread + i * (spread * 2 / 3) })
		end
	end
	return out
end

-- World position of a spot given by distance along the lap and lateral offset.
function Track.spot(track: Built, distance: number, lateral: number): Vec
	local p, tan = Track.at(track, distance)
	local tl = math.sqrt(tan.x * tan.x + tan.z * tan.z)
	return v(p.x - tan.z / tl * lateral, p.y, p.z + tan.x / tl * lateral)
end

-- Signed distance from b to a along the lap, wrapped into [-length/2, length/2).
local function along(track: Built, a: number, b: number): number
	return (a - b + track.length / 2) % track.length - track.length / 2
end

-- Is a timed zone switched on at `time`?
function Track.zoneActive(zone: Zone, time: number): boolean
	if not zone.period then
		return true
	end
	local duty = zone.duty or 0.5
	return (time % zone.period) < zone.period * duty
end

-- The zone (if any) covering a projected position at `time`.
function Track.zoneAt(track: Built, proj: Projection, time: number): Zone?
	for _, zone in track.def.zones or {} do
		local center = zone.t * track.length
		local a = along(track, proj.distance, center)
		if a >= -zone.length / 2 and a <= zone.length / 2 then
			local width = zone.width or track.def.width
			local offset = (zone.offset or 0) * (track.def.width / 2 - width / 2)
			if math.abs(proj.lateral - offset) <= width / 2 and Track.zoneActive(zone, time) then
				return zone
			end
		end
	end
	return nil
end

-- Shortcut endpoints just outside the barrier on the chosen side.
function Track.shortcutEnds(track: Built, sc: Shortcut): (Vec, Vec)
	local lat = sc.side * (track.def.width / 2 + Track.ShoulderWidth + 2)
	return Track.spot(track, sc.from * track.length, lat), Track.spot(track, sc.to * track.length, lat)
end

-- Index of the shortcut whose path contains `pos` (flat distance), if any.
function Track.shortcutAt(track: Built, pos: Vec): number?
	for i, sc in track.def.shortcuts or {} do
		local a, b = Track.shortcutEnds(track, sc)
		local abx, abz = b.x - a.x, b.z - a.z
		local len2 = abx * abx + abz * abz
		local t = math.clamp(((pos.x - a.x) * abx + (pos.z - a.z) * abz) / len2, -0.05, 1.05)
		local cx, cz = a.x + abx * t, a.z + abz * t
		local dx, dz = pos.x - cx, pos.z - cz
		if dx * dx + dz * dz <= (sc.width / 2 + 1) ^ 2 then
			return i
		end
	end
	return nil
end

-- Where a crossing hazard is at `time`: distance along the lap, lateral
-- offset, and whether it is out on the road. It walks from one side to the
-- other, waits, and walks back.
function Track.crosserAt(track: Built, c: Crosser, time: number): (number, number, boolean)
	local reach = track.def.width / 2 + Track.ShoulderWidth
	local phase = ((time + (c.phase or 0)) % c.period) / c.period -- 0..1
	-- 0..0.35 cross, 0.35..0.5 wait, 0.5..0.85 cross back, 0.85..1 wait
	local u: number
	if phase < 0.35 then
		u = phase / 0.35
	elseif phase < 0.5 then
		u = 1
	elseif phase < 0.85 then
		u = 1 - (phase - 0.5) / 0.35
	else
		u = 0
	end
	local lateral = -reach + u * reach * 2
	return c.t * track.length, lateral, math.abs(lateral) < track.def.width / 2 + c.radius
end

-- "road" | "boost" | "offroad" (the grass shoulder) | "wall" (past the
-- barrier) | a zone kind ("sticky", "slippery", "conveyor", "launch").
-- Pass the world position to count shortcuts, and the server time for
-- timed zones.
function Track.surfaceAt(track: Built, proj: Projection, pos: Vec?, time: number?): string
	local half = track.def.width / 2
	local lat = math.abs(proj.lateral)
	if lat > half and pos then
		local sc = Track.shortcutAt(track, pos)
		if sc then
			return (track.def.shortcuts :: { Shortcut })[sc].surface or "road"
		end
	end
	if lat > half + Track.ShoulderWidth then
		return "wall"
	elseif lat > half then
		return "offroad"
	end
	for _, pad in Track.pads(track) do
		local a = along(track, proj.distance, pad.distance)
		if math.abs(a) <= Track.PadLength / 2 and math.abs(proj.lateral - pad.lateral) <= Track.PadWidth / 2 then
			return "boost"
		end
	end
	local zone = Track.zoneAt(track, proj, time or 0)
	if zone then
		return zone.kind
	end
	return "road"
end

-- Starting grid: two columns behind the finish line, staggered.
function Track.gridSpot(track: Built, slot: number): (Vec, number)
	local row = (slot - 1) // 2
	local col = (slot - 1) % 2
	local distance = track.length - 16 - row * 14 - col * 7
	local lateral = (col * 2 - 1) * track.def.width * 0.22
	return Track.spot(track, distance, lateral), distance
end

---------------------------------------------------------------------------
-- Lap progress. Laps only count when every sector is passed in order, so
-- cutting across the infield or reversing over the line never helps.
---------------------------------------------------------------------------
export type Progress = {
	lap: number, -- 0 on the grid (behind the line), 1 after first crossing...
	sector: number,
	distance: number, -- distance along the lap, kept inside the current sector
	index: number, -- last projected point, used as the next search hint
}

function Track.newProgress(track: Built, gridDistance: number): Progress
	return {
		lap = 0,
		sector = Track.sectorOf(track, gridDistance),
		distance = gridDistance % track.length,
		index = 1,
	}
end

-- Returns true when this update crossed the finish line forwards.
function Track.updateProgress(track: Built, p: Progress, proj: Projection): boolean
	local k = track.sectors
	local s = Track.sectorOf(track, proj.distance)
	p.index = proj.index
	local crossed = false
	if s == (p.sector + 1) % k then
		if s == 0 then
			p.lap += 1
			crossed = true
		end
		p.sector = s
	elseif s == (p.sector - 1) % k then
		if p.sector == 0 then
			p.lap -= 1 -- backed over the line
		end
		p.sector = s
	end
	if s == p.sector then
		p.distance = proj.distance
	end
	return crossed
end

-- One number for ranking racers: higher is further ahead.
function Track.score(track: Built, p: Progress): number
	return p.lap * track.length + p.distance
end

-- Is the kart driving the wrong way? heading is a flat unit vector.
function Track.wrongWay(track: Built, proj: Projection, hx: number, hz: number): boolean
	local _, tan = Track.at(track, proj.distance)
	local tl = math.sqrt(tan.x * tan.x + tan.z * tan.z)
	if tl == 0 then
		return false
	end
	return (hx * tan.x + hz * tan.z) / tl < -0.5
end

return Track
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">Tracks</string>
          <string name="Source"><![CDATA[--!strict
-- The tracks and the cup they make up. Control points are {x, y, z} and are
-- driven in list order; the first point is the start/finish line.
-- tests/Simulation.spec.luau has CPU drivers race every track, so a bad edit
-- here (a corner too tight, a jump too steep) fails the tests.
--
-- Making a track bigger: raise `scale` (stretches the whole layout) and
-- `width` (road width in studs). Then run `lune run tests/run`.

local LobbyLayout = require("./LobbyLayout")
local Track = require("./Track")
local v = Track.v

local Tracks = {}

Tracks.Themes = {
	-- Sunny Loop: realistic countryside. Grass hills, two lakes, snowy peaks.
	sunny = {
		realistic = true,
		road = { 62, 63, 66 },
		shoulder = { 82, 124, 52 }, -- grass verge, matches the terrain
		shoulderMaterial = "Grass",
		ground = { 86, 128, 58 },
		wall = { 205, 204, 198 },
		accent = { 255, 196, 40 },
		curb = { { 196, 38, 34 }, { 236, 236, 232 } },
		line = { 236, 236, 228 },
		clock = 14.5,
		-- Lighting: clear summer afternoon with soft shadows and real clouds.
		ambient = { 95, 100, 110 },
		brightness = 3.2,
		atmosphere = { density = 0.32, haze = 1.6, glare = 0.5, color = { 199, 210, 225 }, decay = { 106, 124, 150 } },
		bloom = 0.25,
		tint = { 255, 252, 246 },
		saturation = 0.04,
		contrast = 0.12,
		clouds = { cover = 0.55, density = 0.75 },
		terrain = {
			ground = "Grass",
			bank = "Grass",
			drop = 3.5, -- terrain stays 3.5 studs under the road, hidden inside its 4-stud slab
			hills = { count = 16, min = 50, max = 140, material = "LeafyGrass" },
			lakes = { count = 2, min = 55, max = 120, shore = "Sand", liquid = "Water" },
			mountains = { count = 10, min = 170, max = 280, ring = 520, material = "Rock", cap = "Snow", outer = { count = 5, min = 240, max = 300, ring = 1100 } },
			colors = { Grass = { 82, 124, 52 }, LeafyGrass = { 72, 110, 46 }, Rock = { 104, 100, 96 }, Sand = { 196, 180, 140 }, Snow = { 238, 242, 246 }, Ground = { 102, 88, 66 }, Mud = { 70, 58, 46 } },
			water = { color = { 28, 74, 86 }, transparency = 0.35, reflectance = 0.6, waveSize = 0.1, waveSpeed = 7 },
		},
	},
	-- Canyon Climb: realistic desert. Dunes, banded mesas and an oasis.
	canyon = {
		realistic = true,
		road = { 74, 68, 64 },
		shoulder = { 206, 164, 112 }, -- sand verge
		shoulderMaterial = "Sand",
		ground = { 190, 146, 98 },
		wall = { 200, 190, 174 },
		accent = { 255, 140, 60 },
		curb = { { 186, 60, 40 }, { 236, 226, 206 } },
		line = { 240, 232, 210 },
		clock = 17.2,
		-- Lighting: dusty golden hour.
		ambient = { 120, 96, 82 },
		brightness = 2.8,
		atmosphere = { density = 0.36, haze = 2, glare = 1, color = { 240, 200, 160 }, decay = { 180, 110, 74 } },
		bloom = 0.3,
		tint = { 255, 240, 222 },
		saturation = 0.06,
		contrast = 0.12,
		clouds = { cover = 0.3, density = 0.5 },
		terrain = {
			ground = "Sand",
			bank = "Sandstone",
			drop = 3.5, -- terrain stays 3.5 studs under the road, hidden inside its 4-stud slab
			hills = { count = 10, min = 60, max = 150, material = "Sand" },
			mesas = { count = 14, min = 50, max = 120, minHeight = 60, maxHeight = 150, material = "Sandstone", band = "Rock", ring = 420 },
			lakes = { count = 1, min = 45, max = 70, shore = "Grass", liquid = "Water" },
			mountains = { count = 8, min = 180, max = 280, ring = 650, material = "Sandstone", outer = { count = 5, min = 220, max = 300, ring = 1200 } },
			colors = { Sand = { 206, 164, 112 }, Sandstone = { 176, 108, 72 }, Rock = { 120, 82, 62 }, Grass = { 110, 128, 60 }, Mud = { 90, 70, 50 } },
			water = { color = { 40, 90, 92 }, transparency = 0.35, reflectance = 0.5, waveSize = 0.08, waveSpeed = 6 },
		},
	},
	-- Midnight Toy Room: a giant bedroom at night, lit by a night light.
	toyroom = {
		road = { 70, 78, 120 },
		shoulder = { 150, 105, 70 },
		ground = { 160, 112, 74 }, -- wooden floorboards
		wall = { 255, 220, 120 },
		accent = { 120, 220, 255 },
		curb = { { 255, 90, 90 }, { 255, 230, 120 } },
		line = { 255, 240, 200 },
		clock = 0.5,
		ambient = { 90, 90, 150 },
		brightness = 1.6,
		atmosphere = { density = 0.32, haze = 1.2, glare = 0, color = { 90, 100, 170 }, decay = { 50, 50, 110 } },
		bloom = 1.1,
		tint = { 230, 230, 255 },
		saturation = 0.25,
		room = { wall = { 90, 110, 190 }, trim = { 255, 255, 255 }, height = 420 },
	},
	-- Kitchen Chaos: countertop racing in a bright kitchen.
	kitchen = {
		road = { 96, 100, 112 },
		shoulder = { 235, 230, 220 },
		ground = { 240, 236, 228 }, -- marble countertop
