      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[-- Creates the RemoteEvents listed in Shared.RemoteNames under ReplicatedStorage.Remotes.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RemoteNames = require(ReplicatedStorage.Shared.RemoteNames)

local folder = Instance.new("Folder")
folder.Name = "Remotes"

local Net: { [string]: RemoteEvent } = {}
for name in RemoteNames do
	local remote = Instance.new("RemoteEvent")
	remote.Name = name
	remote.Parent = folder
	Net[name] = remote
end

folder.Parent = ReplicatedStorage

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">RaceService</string>
          <string name="Source"><![CDATA[-- The game loop: lobby → Grand Prix (every track in the cup) → results → lobby.
-- Empty grid slots are filled with CPU drivers so solo play works. Players
-- drive their own karts on their client; the server tracks positions, laps,
-- respawns, items and points, and drives the CPU karts itself.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local AIDriver = require(Shared.AIDriver)
local KartPhysics = require(Shared.KartPhysics)
local Karts = require(Shared.Karts)
local RaceRules = require(Shared.RaceRules)
local Track = require(Shared.Track)
local Tracks = require(Shared.Tracks)
local KartRig = require(ReplicatedStorage.Common.KartRig)

local ItemService = require(script.Parent.ItemService)
local Net = require(script.Parent.Net)
local TrackBuilder = require(script.Parent.TrackBuilder)

local RaceService = {}

local LOBBY_WAIT = 15 -- seconds after the first player readies up
local LOAD_TIME = 3 -- time for clients to see the track before the countdown
local RESULTS_TIME = 9
local CUP_RESULTS_TIME = 14
local END_GRACE = 4 -- after the last player finishes
local FALL_DEPTH = 18
local TICK = 1 / 20

export type Entrant = {
	id: string,
	name: string,
	isCpu: boolean,
	player: Player?,
	kartId: string,
	points: number,
	lastPlace: number,
	profile: AIDriver.Profile,
}

export type Racer = {
	entrant: Entrant,
	model: Model,
	state: KartPhysics.State?, -- CPU karts only; players simulate their own
	stats: Karts.KartStats,
	progress: Track.Progress,
	score: number,
	place: number,
	finishTime: number?,
	invincibleUntil: number,
	speedFactor: number,
	-- Items (managed by ItemService)
	item: string?,
	uses: number,
	itemReadyAt: number,
	cpuUseAt: number,
}

type Race = {
	trackId: string,
	track: Track.Built,
	racers: { Racer },
	goTime: number,
	endAt: number?,
	timeLimit: number,
	lastBroadcast: number,
}

local phase = "lobby"
local choices: { [Player]: { kart: string, ready: boolean } } = {}
local firstReadyAt: number? = nil
local cup: { trackIndex: number, entrants: { Entrant } }? = nil
local race: Race? = nil

local kartsFolder = Instance.new("Folder")
kartsFolder.Name = "Karts"
kartsFolder.Parent = Workspace

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function now(): number
	return Workspace:GetServerTimeNow()
end

local function vec(p: Vector3): Track.Vec
	return Track.v(p.X, p.Y, p.Z)
end

local function refreshRayFilter()
	local ignore: { Instance } = { kartsFolder }
	local items = Workspace:FindFirstChild("Items")
	if items then
		table.insert(ignore, items)
	end
	for _, p in Players:GetPlayers() do
		if p.Character then
			table.insert(ignore, p.Character)
		end
	end
	rayParams.FilterDescendantsInstances = ignore
end

---------------------------------------------------------------------------
-- Effects (also used by ItemService)
---------------------------------------------------------------------------
local Effects = {}

function Effects.hit(racer: Racer): boolean
	if now() < racer.invincibleUntil then
		return false
	end
	if racer.state then
		return KartPhysics.hit(racer.state)
	end
	if racer.entrant.player then
		Net.KartEvent:FireClient(racer.entrant.player, "hit")
	end
	return true
end

function Effects.boost(racer: Racer, seconds: number)
	if racer.state then
		KartPhysics.giveBoost(racer.state, seconds)
	elseif racer.entrant.player then
		Net.KartEvent:FireClient(racer.entrant.player, "boost", seconds)
	end
end

function Effects.overdrive(racer: Racer, seconds: number)
	racer.invincibleUntil = now() + seconds
	if racer.state then
		KartPhysics.overdrive(racer.state, seconds)
	elseif racer.entrant.player then
		Net.KartEvent:FireClient(racer.entrant.player, "overdrive", seconds)
	end
end

function Effects.itemChanged(racer: Racer)
	if racer.entrant.player then
		Net.ItemState:FireClient(racer.entrant.player, racer.item, racer.uses, racer.itemReadyAt)
	end
end

---------------------------------------------------------------------------
-- Lobby
---------------------------------------------------------------------------
local function buildLobby()
	local lobby = Instance.new("Model")
	lobby.Name = "Lobby"
	local floor = Instance.new("Part")
	floor.Name = "Floor"
	floor.Anchored = true
	floor.Size = Vector3.new(120, 2, 120)
	floor.Position = Vector3.new(0, 400, 1200)
	floor.Material = Enum.Material.SmoothPlastic
	floor.Color = Color3.fromRGB(40, 44, 60)
	floor.Parent = lobby
	local spawn = Instance.new("SpawnLocation")
	spawn.Anchored = true
	spawn.Size = Vector3.new(12, 1, 12)
	spawn.Position = floor.Position + Vector3.new(0, 1.5, 0)
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Color = Color3.fromRGB(255, 200, 40)
	spawn.Material = Enum.Material.Neon
	spawn.Parent = lobby
	-- One of each kart on display.
	for i, def in Karts.List do
		local cf = CFrame.new(floor.Position + Vector3.new((i - 2) * 16, 1, -24)) * CFrame.Angles(0, math.pi, 0)
		local display = KartRig.build(def.id, def.name, cf, lobby)
		display.PrimaryPart.Anchored = true
	end
	lobby.Parent = Workspace
end

local function lobbyState()
	local list = {}
	for player, c in choices do
		table.insert(list, { name = player.DisplayName, kart = c.kart, ready = c.ready })
	end
	return {
		phase = phase,
		players = list,
		startsAt = if firstReadyAt then firstReadyAt + LOBBY_WAIT else nil,
		cupName = Tracks.Cup.name,
		raceNumber = cup and cup.trackIndex,
		raceCount = #Tracks.Cup.tracks,
	}
end

local function broadcastLobby()
	Net.Lobby:FireAllClients(lobbyState())
end

---------------------------------------------------------------------------
-- Racing
---------------------------------------------------------------------------
local function yawFromTangent(tan: Track.Vec): number
	return math.atan2(-tan.x, -tan.z)
end

local function scaledStats(base: Karts.KartStats, factor: number): Karts.KartStats
	return { topSpeed = base.topSpeed * factor, accel = base.accel, handling = base.handling, weight = base.weight }
end

local function seatDriver(player: Player, model: Model)
	local character = player.Character
	if not character or not character.Parent then
		player:LoadCharacter()
		character = player.Character or player.CharacterAdded:Wait()
	end
	local humanoid = character:WaitForChild("Humanoid", 5) :: Humanoid?
	local seat = model:FindFirstChild("DriverSeat") :: Seat
	if humanoid and seat then
		character:PivotTo(seat.CFrame + Vector3.new(0, 2, 0))
		seat:Sit(humanoid)
	end
end

local function startRace(index: number)
	assert(cup, "no cup")
	cup.trackIndex = index
	local trackId = Tracks.Cup.tracks[index]
	local _, track = TrackBuilder.build(trackId)
	kartsFolder:ClearAllChildren()

	-- Grid: race 1 puts players at the back; later races reverse the standings.
	local order = table.clone(cup.entrants)
	if index == 1 then
		table.sort(order, function(a, b)
			if a.isCpu ~= b.isCpu then
				return a.isCpu
			end
			return a.id < b.id
		end)
	else
		table.sort(order, function(a, b)
			if a.points ~= b.points then
				return a.points < b.points
			end
			return a.id < b.id
		end)
	end

	local r: Race = {
		trackId = trackId,
		track = track,
		racers = {},
		goTime = now() + LOAD_TIME + RaceRules.CountdownSeconds,
		timeLimit = track.def.laps * 120,
		lastBroadcast = 0,
	}

	for slot, entrant in order do
		local pos, gridD = Track.gridSpot(track, slot)
		local _, tan = Track.at(track, gridD)
		local yaw = yawFromTangent(tan)
		local cf = CFrame.new(pos.x, pos.y, pos.z) * CFrame.Angles(0, yaw, 0)
		local model = KartRig.build(entrant.kartId, entrant.name, cf, kartsFolder)
		model.PrimaryPart.Anchored = true
		local stats = Karts.get(entrant.kartId).stats
		local racer: Racer = {
			entrant = entrant,
			model = model,
			state = if entrant.isCpu then KartPhysics.newState(yaw) else nil,
			stats = stats,
			progress = Track.newProgress(track, gridD),
			score = 0,
			place = slot,
			finishTime = nil,
			invincibleUntil = 0,
			speedFactor = 1,
			item = nil,
			uses = 0,
			itemReadyAt = 0,
			cpuUseAt = 0,
		}
		racer.score = Track.score(track, racer.progress)
		table.insert(r.racers, racer)

		if entrant.player then
			seatDriver(entrant.player, model)
			Net.ItemState:FireClient(entrant.player, nil, 0, 0)
			Net.RaceStart:FireClient(entrant.player, {
				trackId = trackId,
				trackName = track.def.name,
				kart = model,
				kartId = entrant.kartId,
				yaw = yaw,
				goTime = r.goTime,
				laps = track.def.laps,
				raceNumber = index,
				raceCount = #Tracks.Cup.tracks,
			})
		end
	end

	ItemService.setup(track)
	race = r
	phase = "racing"
	refreshRayFilter()
	broadcastLobby()

	task.delay(r.goTime - now(), function()
		if race ~= r then
			return
		end
		for _, racer in r.racers do
			local root = racer.model.PrimaryPart
			if root then
				root.Anchored = false
				local player = racer.entrant.player
				if player and player.Parent then
					root:SetNetworkOwner(player)
				else
					root:SetNetworkOwner(nil)
				end
			end
		end
	end)
end

local function respawn(r: Race, racer: Racer)
	local d = racer.progress.distance
	local pos = Track.spot(r.track, d, 0)
	local _, tan = Track.at(r.track, d)
	local yaw = yawFromTangent(tan)
	KartRig.place(racer.model, CFrame.new(pos.x, pos.y, pos.z) * CFrame.Angles(0, yaw, 0))
	if racer.state then
		racer.state.speed = 0
		racer.state.yaw = yaw
		racer.state.drift = 0
		racer.state.charge = 0
	elseif racer.entrant.player then
		Net.KartEvent:FireClient(racer.entrant.player, "respawn", yaw)
	end
end

local function standings(r: Race)
	local entries = {}
	local byId = {}
	for _, racer in r.racers do
		table.insert(entries, { id = racer.entrant.id, finished = racer.finishTime ~= nil, finishTime = racer.finishTime, score = racer.score })
		byId[racer.entrant.id] = racer
	end
	local ranked = RaceRules.rank(entries)
	local out = {}
	for place, e in ranked do
		local racer = byId[e.id]
		racer.place = place
		table.insert(out, racer)
	end
	return out
end

local function raceStateFor(r: Race, ranked: { Racer }, me: Racer)
	local rows = {}
	for _, racer in ranked do
		table.insert(rows, { name = racer.entrant.name, isCpu = racer.entrant.isCpu, finished = racer.finishTime ~= nil })
	end
	return {
		place = me.place,
		field = #ranked,
		lap = math.clamp(me.progress.lap, 1, r.track.def.laps),
		laps = r.track.def.laps,
		finishTime = me.finishTime,
		rows = rows,
	}
end

local function endRace(r: Race)
	if race ~= r or not cup then
		return
	end
	race = nil
	phase = "results"
	local ranked = standings(r)
	local rows = {}
	for place, racer in ranked do
		local gained = RaceRules.pointsFor(place)
		racer.entrant.points += gained
		racer.entrant.lastPlace = place
		table.insert(rows, {
			place = place,
			name = racer.entrant.name,
			isCpu = racer.entrant.isCpu,
			time = racer.finishTime,
			gained = gained,
			total = racer.entrant.points,
		})
	end
	ItemService.clear()
	kartsFolder:ClearAllChildren()

	local lastRace = cup.trackIndex >= #Tracks.Cup.tracks
	Net.Results:FireAllClients({ kind = "race", trackName = r.track.def.name, rows = rows, lastRace = lastRace })
	for _, entrant in cup.entrants do
		if entrant.player and entrant.player.Parent then
			entrant.player:LoadCharacter()
		end
	end

	task.wait(RESULTS_TIME)
	if not lastRace and cup and RaceService.humansInCup() > 0 then
		startRace(cup.trackIndex + 1)
		return
	end

	-- Final cup standings.
	if cup then
		local cupRows = {}
		for _, e in cup.entrants do
			table.insert(cupRows, { id = e.id, name = e.name, points = e.points, lastPlace = e.lastPlace })
		end
		local final = RaceRules.cupStandings(cupRows)
		local out = {}
		for i, row in final do
			table.insert(out, { place = i, name = row.name, total = row.points })
		end
		Net.Results:FireAllClients({ kind = "cup", cupName = Tracks.Cup.name, rows = out })
		task.wait(CUP_RESULTS_TIME)
	end
	RaceService.toLobby()
end

function RaceService.humansInCup(): number
	local count = 0
	if cup then
		for _, e in cup.entrants do
			if e.player and e.player.Parent then
				count += 1
			end
		end
	end
	return count
end

function RaceService.toLobby()
	race = nil
	cup = nil
	phase = "lobby"
	firstReadyAt = nil
	ItemService.clear()
	kartsFolder:ClearAllChildren()
	local track = Workspace:FindFirstChild("Track")
	if track then
		track:Destroy()
	end
	for player, c in choices do
		c.ready = false
		if player.Character == nil then
			player:LoadCharacter()
		end
	end
	broadcastLobby()
end

local function startCup()
	local entrants: { Entrant } = {}
	for player, c in choices do
		if c.ready then
			table.insert(entrants, {
				id = `u{player.UserId}`,
				name = player.DisplayName,
				isCpu = false,
				player = player,
				kartId = c.kart,
				points = 0,
				lastPlace = 0,
				profile = { lane = 0, skill = 1 },
			})
		end
	end
	local cpuIndex = 0
	while #entrants < RaceRules.MaxRacers do
		cpuIndex += 1
		local driver = Karts.CpuDrivers[cpuIndex]
		table.insert(entrants, {
			id = `cpu{cpuIndex}`,
			name = driver.name,
			isCpu = true,
			kartId = driver.kart,
			points = 0,
			lastPlace = 0,
			profile = { lane = ((cpuIndex % 3) - 1) * 0.6, skill = 0.45 + (cpuIndex % 4) * 0.15 },
		})
	end
	cup = { trackIndex = 1, entrants = entrants }
	firstReadyAt = nil
	startRace(1)
end

---------------------------------------------------------------------------
-- Loops
---------------------------------------------------------------------------
local function stepCpus(dt: number)
	local r = race
	if not r or now() < r.goTime then
		return
	end
	for _, racer in r.racers do
		local s = racer.state
		local root = racer.model.PrimaryPart
		if not s or not root or root.Anchored then
			continue
		end
		local sensed = KartRig.sense(racer.model, rayParams)
		local pos = vec(root.Position)
		local proj = Track.project(r.track, pos, racer.progress.index)
		local input = AIDriver.input(r.track, proj, pos, s, racer.stats, racer.entrant.profile)
		local surface = Track.surfaceAt(r.track, proj)
		input.surface = if surface == "wall" then "offroad" else surface
		input.grounded = sensed.grounded
		KartPhysics.step(scaledStats(racer.stats, racer.speedFactor), s, input, dt)
		KartRig.sync(racer.model, s)
		KartRig.apply(racer.model, s, sensed)
		KartRig.setEffects(racer.model, if s.drift ~= 0 then KartPhysics.chargeLevel(s.charge) else 0, s.boost > 0)
	end
end

local function tickRace(r: Race)
	local t = now()
	if t < r.goTime then
		return
	end
	local track = r.track
	local humansRacing, humansLeft = 0, 0

	for _, racer in r.racers do
		local root = racer.model.PrimaryPart
		if not root then
			continue
		end
		local pos = vec(root.Position)
		local proj = Track.project(track, pos, racer.progress.index)
		local roadY = Track.spot(track, proj.distance, 0).y
		if proj.gap > track.def.width + Track.ShoulderWidth * 2 or root.Position.Y < roadY - FALL_DEPTH then
			respawn(r, racer)
		elseif Track.updateProgress(track, racer.progress, proj) then
			local player = racer.entrant.player
			if racer.progress.lap > track.def.laps and not racer.finishTime then
				racer.finishTime = t - r.goTime
				if player then
					Net.Notify:FireClient(player, "FINISH!")
				end
			elseif player and racer.progress.lap == track.def.laps then
				Net.Notify:FireClient(player, "FINAL LAP!")
			elseif player and racer.progress.lap > 1 then
				Net.Notify:FireClient(player, `Lap {racer.progress.lap}`)
			end
		end
		racer.score = Track.score(track, racer.progress)

		local player = racer.entrant.player
		if player then
			if not player.Parent then
				continue
			end
			humansLeft += 1
			if not racer.finishTime then
				humansRacing += 1
			end
		end
	end

	local ranked = standings(r)

	-- CPU pace: catch up when far behind, ease off when running away from players.
	local leaderScore = ranked[1] and ranked[1].score or 0
	local bestHuman = -math.huge
	for _, racer in r.racers do
		if not racer.entrant.isCpu then
			bestHuman = math.max(bestHuman, racer.score)
		end
	end
	for _, racer in r.racers do
		if racer.entrant.isCpu then
			local lead = if bestHuman > -math.huge then racer.score - bestHuman else 0
			racer.speedFactor = RaceRules.cpuSpeedFactor(leaderScore - racer.score, lead, racer.entrant.profile.skill)
		end
	end

	ItemService.tick(r.track, r.racers, TICK, Effects)

	if t - r.lastBroadcast >= 0.2 then
		r.lastBroadcast = t
		for _, racer in r.racers do
			local player = racer.entrant.player
			if player and player.Parent then
				Net.RaceState:FireClient(player, raceStateFor(r, ranked, racer))
			end
		end
	end

	if humansLeft == 0 then
		task.spawn(RaceService.toLobby)
		return
	end
	if humansRacing == 0 and not r.endAt then
		r.endAt = t + END_GRACE
	end
	if (r.endAt and t >= r.endAt) or t - r.goTime > r.timeLimit then
		task.spawn(endRace, r)
	end
end

---------------------------------------------------------------------------
-- Remotes
---------------------------------------------------------------------------
local function findRacer(player: Player): Racer?
	if race then
		for _, racer in race.racers do
			if racer.entrant.player == player then
				return racer
			end
		end
	end
	return nil
end

function RaceService.start()
	buildLobby()

	Players.PlayerAdded:Connect(function(player)
		choices[player] = { kart = Karts.Default, ready = false }
		task.delay(1, broadcastLobby)
	end)
	for _, player in Players:GetPlayers() do
		choices[player] = { kart = Karts.Default, ready = false }
	end
	Players.PlayerRemoving:Connect(function(player)
		choices[player] = nil
		local racer = findRacer(player)
		if racer then
			racer.model:Destroy()
			table.remove(race.racers, table.find(race.racers, racer) :: number)
		end
		broadcastLobby()
	end)

	Net.ChooseKart.OnServerEvent:Connect(function(player, kartId)
		local c = choices[player]
		if c and phase == "lobby" then
			c.kart = Karts.get(tostring(kartId)).id
			broadcastLobby()
		end
	end)
	Net.Ready.OnServerEvent:Connect(function(player, isReady)
		local c = choices[player]
		if c and phase == "lobby" then
			c.ready = isReady == true
			if c.ready and not firstReadyAt then
				firstReadyAt = now()
			end
			broadcastLobby()
		end
	end)
	Net.UseItem.OnServerEvent:Connect(function(player)
		local racer = findRacer(player)
		if racer and race and now() >= race.goTime then
			ItemService.use(race.track, race.racers, racer, Effects)
		end
	end)

	-- Lobby: start when everyone is ready, or LOBBY_WAIT after the first ready.
	task.spawn(function()
		while true do
			task.wait(1)
			if phase == "lobby" then
				local total, ready = 0, 0
				for _, c in choices do
					total += 1
					if c.ready then
						ready += 1
					end
				end
				if ready == 0 then
					firstReadyAt = nil
				elseif ready == total or (firstReadyAt and now() >= firstReadyAt + LOBBY_WAIT) then
					local ok, err = pcall(startCup)
					if not ok then
						warn("[RaceService] could not start the cup:", err)
						RaceService.toLobby()
					end
				end
				broadcastLobby()
			end
		end
	end)

	task.spawn(function()
		while true do
			task.wait(TICK)
			local r = race
			if r then
				local ok, err = pcall(tickRace, r)
				if not ok then
					warn("[RaceService] race tick failed:", err)
				end
			end
		end
	end)

	RunService.Heartbeat:Connect(function(dt)
		local ok, err = pcall(stepCpus, math.min(dt, 0.1))
		if not ok then
			warn("[RaceService] CPU step failed:", err)
		end
	end)

	Players.PlayerAdded:Connect(function(player)
		player.CharacterAdded:Connect(function()
			task.defer(refreshRayFilter)
		end)
	end)
end

return RaceService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">TrackBuilder</string>
          <string name="Source"><![CDATA[-- Builds a track's parts from its centerline: road, grass shoulders, walls,
-- bridge pillars, boost pads, the start line and the ground below.

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Track = require(Shared.Track)
local Tracks = require(Shared.Tracks)

local TrackBuilder = {}

local function rgb(c: { number }): Color3
	return Color3.fromRGB(c[1], c[2], c[3])
end

local function v3(p: Track.Vec): Vector3
	return Vector3.new(p.x, p.y, p.z)
end

local function part(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function flatAngle(a: Vector3, b: Vector3): number
	return math.atan2(b.X - a.X, b.Z - a.Z)
end

function TrackBuilder.build(trackId: string): (Folder, Track.Built)
	local def = Tracks.get(trackId)
	local track = Track.build(def)
	local theme = Tracks.Themes[def.theme]
	local roadColor, shoulderColor, wallColor = rgb(theme.road), rgb(theme.shoulder), rgb(theme.wall)

	local old = Workspace:FindFirstChild("Track")
	if old then
		old:Destroy()
	end
	local folder = Instance.new("Folder")
	folder.Name = "Track"
	folder:SetAttribute("TrackId", trackId)

	local half = def.width / 2
	local sw = Track.ShoulderWidth
	local pts = track.points
	local n = #pts
	local minY, minX, maxX, minZ, maxZ = math.huge, math.huge, -math.huge, math.huge, -math.huge

	for i = 1, n do
		local a, b, c = v3(pts[i]), v3(pts[i % n + 1]), v3(pts[(i + 1) % n + 1])
		local length = (b - a).Magnitude
		-- Lengthen segments on the outside of bends so the edges have no gaps.
		local turn = math.abs(((flatAngle(b, c) - flatAngle(a, b)) + math.pi) % (2 * math.pi) - math.pi)
		local extra = 1 + (half + sw + 1) * turn
		local cf = CFrame.lookAt((a + b) / 2, b)
		local segLen = length + extra

		local road = part(folder, "Road", Vector3.new(def.width, 1, segLen), cf * CFrame.new(0, -0.5, 0), roadColor, Enum.Material.Asphalt)
		road:SetAttribute("Surface", "road")
		for _, side in { -1, 1 } do
			local shoulder = part(folder, "Shoulder", Vector3.new(sw, 1, segLen), cf * CFrame.new(side * (half + sw / 2), -0.52, 0), shoulderColor, Enum.Material.Grass)
			shoulder:SetAttribute("Surface", "offroad")
			part(folder, "Wall", Vector3.new(1, 4, segLen), cf * CFrame.new(side * (half + sw + 0.5), 1.5, 0), wallColor, if def.theme == "neon" then Enum.Material.Neon else Enum.Material.SmoothPlastic)
		end

		minY = math.min(minY, a.Y)
		minX, maxX = math.min(minX, a.X), math.max(maxX, a.X)
		minZ, maxZ = math.min(minZ, a.Z), math.max(maxZ, a.Z)
	end

	-- Pillars under raised road, skipped where they would land on the road below.
	for i = 1, n, 6 do
		local p = pts[i]
		if p.y - minY > 8 then
			local blocked = false
			for j, q in pts do
				local apart = math.min(math.abs(i - j), n - math.abs(i - j))
				if apart > 20 and math.abs(q.x - p.x) < half + sw + 6 and math.abs(q.z - p.z) < half + sw + 6 and q.y < p.y - 8 then
					blocked = true
					break
				end
			end
			if not blocked then
				local h = p.y - minY
				part(folder, "Pillar", Vector3.new(6, h, 6), CFrame.new(p.x, minY + h / 2 - 1, p.z), wallColor, Enum.Material.Concrete)
			end
		end
	end

	-- Ground under everything.
	local margin = 300
	local sizeX, sizeZ = maxX - minX + margin * 2, maxZ - minZ + margin * 2
	local tile = 1000
	for x = minX - margin, minX - margin + sizeX, tile do
		for z = minZ - margin, minZ - margin + sizeZ, tile do
			local g = part(folder, "Ground", Vector3.new(tile, 2, tile), CFrame.new(x + tile / 2, minY - 1.6, z + tile / 2), rgb(theme.ground), Enum.Material.Grass)
			g:SetAttribute("Surface", "offroad")
		end
	end

	-- Boost pads (visual; the surface is worked out from Track.surfaceAt).
	for _, pad in Track.pads(track) do
		local pos = v3(Track.spot(track, pad.distance, pad.lateral))
		local _, tan = Track.at(track, pad.distance)
		local cf = CFrame.lookAt(pos, pos + v3(tan))
		local p = part(folder, "BoostPad", Vector3.new(Track.PadWidth, 0.2, Track.PadLength), cf * CFrame.new(0, 0.05, 0), rgb(theme.accent), Enum.Material.Neon)
		p.CanCollide = false
		p.CanQuery = false
		for k = -1, 1 do
			local arrow = part(folder, "Arrow", Vector3.new(6, 0.25, 2), cf * CFrame.new(0, 0.12, k * 7) * CFrame.Angles(0, math.rad(45), 0), Color3.new(1, 1, 1), Enum.Material.Neon)
			arrow.CanCollide = false
			arrow.CanQuery = false
		end
	end

	-- Checkered start/finish line.
	local start, tan = Track.at(track, 0)
	local lineCf = CFrame.lookAt(v3(start), v3(start) + v3(tan))
	local squares = 8
	for k = 0, squares - 1 do
		for row = 0, 1 do
			local sq = part(folder, "Finish", Vector3.new(def.width / squares, 0.2, 3), lineCf * CFrame.new(-half + (k + 0.5) * def.width / squares, 0.06, (row - 0.5) * 3), if (k + row) % 2 == 0 then Color3.new(1, 1, 1) else Color3.new(0.05, 0.05, 0.05), Enum.Material.SmoothPlastic)
			sq.CanCollide = false
			sq.CanQuery = false
		end
	end
	-- Banner over the line.
	for _, side in { -1, 1 } do
		part(folder, "BannerPost", Vector3.new(1.5, 18, 1.5), lineCf * CFrame.new(side * (half + 4), 9, 0), wallColor, Enum.Material.Metal)
	end
	part(folder, "Banner", Vector3.new(def.width + 10, 3, 1), lineCf * CFrame.new(0, 17, 0), rgb(theme.accent), Enum.Material.Neon)

	Lighting.ClockTime = theme.clock
	folder.Parent = Workspace
	return folder, track
end

return TrackBuilder
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="19">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="20">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="21">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">Hud</string>
            <string name="Source"><![CDATA[-- All screens, built in code: lobby (pick a kart, ready up), race HUD (place,
-- lap, item slot with roulette, standings, countdown, wrong-way warning),
-- race results, cup results and touch buttons.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Items = require(Shared:WaitForChild("Items"))
local Karts = require(Shared:WaitForChild("Karts"))

local Hud = {}

local player = Players.LocalPlayer
local gui = Instance.new("ScreenGui")
gui.Name = "KartHud"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local YELLOW = Color3.fromRGB(255, 210, 50)
local PLACE_COLORS = { Color3.fromRGB(255, 210, 50), Color3.fromRGB(200, 210, 225), Color3.fromRGB(230, 140, 70) }

local function frame(parent: Instance, props: { [string]: any }): Frame
	local f = Instance.new("Frame")
	f.BackgroundColor3 = Color3.fromRGB(16, 16, 24)
	f.BackgroundTransparency = 0.2
	f.BorderSizePixel = 0
	for k, v in props do
		(f :: any)[k] = v
	end
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 10)
	c.Parent = f
	f.Parent = parent
	return f
end

local function text(parent: Instance, props: { [string]: any }): TextLabel
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.GothamBlack
	l.TextColor3 = Color3.new(1, 1, 1)
	l.TextScaled = true
	l.TextStrokeTransparency = 0.5
	for k, v in props do
		(l :: any)[k] = v
	end
	l.Parent = parent
	return l
end

local function button(parent: Instance, label: string, props: { [string]: any }, onClick: () -> ()): TextButton
	local b = Instance.new("TextButton")
	b.Font = Enum.Font.GothamBlack
	b.TextScaled = true
	b.TextColor3 = Color3.new(1, 1, 1)
	b.BorderSizePixel = 0
	b.BackgroundColor3 = Color3.fromRGB(60, 60, 80)
	b.Text = label
	for k, v in props do
		(b :: any)[k] = v
	end
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 10)
	c.Parent = b
	b.Parent = parent
	b.Activated:Connect(onClick)
	return b
end

local function ordinal(n: number): string
	local suffix = "th"
	if n % 100 < 11 or n % 100 > 13 then
		suffix = ({ "st", "nd", "rd" })[n % 10] or "th"
	end
	return `{n}{suffix}`
end

local function fmtTime(t: number?): string
	if not t then
		return "--"
	end
	local m = math.floor(t / 60)
	return string.format("%d:%05.2f", m, t - m * 60)
end

---------------------------------------------------------------------------
-- Lobby
---------------------------------------------------------------------------
local lobby = frame(gui, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0, 620, 0, 420) })
text(lobby, { Position = UDim2.new(0, 20, 0, 14), Size = UDim2.new(1, -40, 0, 44), Text = "KART RACER" , TextColor3 = YELLOW })
local lobbySub = text(lobby, { Position = UDim2.new(0, 20, 0, 60), Size = UDim2.new(1, -40, 0, 22), Font = Enum.Font.GothamMedium, Text = "" })
local cards = Instance.new("Frame")
cards.BackgroundTransparency = 1
cards.Position = UDim2.new(0, 20, 0, 96)
cards.Size = UDim2.new(1, -40, 0, 170)
cards.Parent = lobby
local cardLayout = Instance.new("UIListLayout")
cardLayout.FillDirection = Enum.FillDirection.Horizontal
cardLayout.Padding = UDim.new(0, 10)
cardLayout.Parent = cards
local playersLabel = text(lobby, { Position = UDim2.new(0, 20, 0, 276), Size = UDim2.new(1, -40, 0, 60), Font = Enum.Font.GothamMedium, TextScaled = false, TextSize = 15, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, Text = "" })

local chosenKart = Karts.Default
local isReady = false
local cardButtons: { [string]: TextButton } = {}
Hud.onChooseKart = nil :: ((string) -> ())?
Hud.onReady = nil :: ((boolean) -> ())?

local function statBar(n: number, lo: number, hi: number): string
	local filled = math.clamp(math.floor((n - lo) / (hi - lo) * 5 + 0.5), 1, 5)
	return string.rep("■", filled) .. string.rep("□", 5 - filled)
end

for _, def in Karts.List do
	local c = Color3.fromRGB(def.color[1], def.color[2], def.color[3])
	local card = button(cards, "", { Size = UDim2.new(1 / 3, -7, 1, 0), BackgroundColor3 = c:Lerp(Color3.new(0, 0, 0), 0.55) }, function()
		chosenKart = def.id
		if Hud.onChooseKart then
			Hud.onChooseKart(def.id)
		end
		Hud.refreshCards()
	end)
	text(card, { Position = UDim2.new(0, 10, 0, 8), Size = UDim2.new(1, -20, 0, 30), Text = def.name, TextColor3 = c })
	text(card, {
		Position = UDim2.new(0, 10, 0, 42),
		Size = UDim2.new(1, -20, 0, 120),
		Font = Enum.Font.GothamMedium,
		TextScaled = false,
		TextSize = 14,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		Text = `{def.blurb}\n\nSpeed  {statBar(def.stats.topSpeed, 88, 108)}\nAccel  {statBar(def.stats.accel, 44, 72)}\nTurn    {statBar(def.stats.handling, 1.9, 2.4)}\nWeight {statBar(def.stats.weight, 1, 5)}`,
	})
	cardButtons[def.id] = card
end

function Hud.refreshCards()
	for id, card in cardButtons do
		local stroke = card:FindFirstChildOfClass("UIStroke") or Instance.new("UIStroke")
		stroke.Thickness = if id == chosenKart then 4 else 0
		stroke.Color = YELLOW
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		stroke.Parent = card
	end
end
Hud.refreshCards()

local readyButton = button(lobby, "READY", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -16), Size = UDim2.new(0, 240, 0, 52), BackgroundColor3 = Color3.fromRGB(40, 160, 80) }, function()
	isReady = not isReady
	if Hud.onReady then
		Hud.onReady(isReady)
	end
end)

local lobbyState: any = nil
function Hud.setLobby(state: any)
	lobbyState = state
	lobby.Visible = state.phase == "lobby"
	local lines = {}
	for _, p in state.players do
		local kart = Karts.get(p.kart).name
		table.insert(lines, `{if p.ready then "✔" else "…"} {p.name} ({kart})`)
		if p.name == player.DisplayName then
			isReady = p.ready
		end
	end
	playersLabel.Text = table.concat(lines, "    ")
	readyButton.Text = if isReady then "NOT READY" else "READY"
	readyButton.BackgroundColor3 = if isReady then Color3.fromRGB(150, 60, 60) else Color3.fromRGB(40, 160, 80)
end

function Hud.updateLobby()
	local s = lobbyState
	if not s or s.phase ~= "lobby" then
		if s and s.phase ~= "lobby" then
			lobbySub.Text = "Race in progress - you'll join the next cup."
		end
		return
	end
	local t = Workspace:GetServerTimeNow()
	if s.startsAt then
		lobbySub.Text = `{s.cupName}: {s.raceCount} races. Starting in {math.max(0, math.ceil(s.startsAt - t))}s (or when everyone is ready)`
	else
		lobbySub.Text = `{s.cupName}: {s.raceCount} races. Pick a kart and press READY. CPU drivers fill empty spots.`
	end
end

---------------------------------------------------------------------------
-- Race HUD
---------------------------------------------------------------------------
local race = Instance.new("Frame")
race.BackgroundTransparency = 1
race.Size = UDim2.fromScale(1, 1)
race.Visible = false
race.Parent = gui

local placeLabel = text(race, { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -24, 1, -20), Size = UDim2.new(0, 200, 0, 110), Text = "" })
local lapLabel = text(race, { Position = UDim2.new(0, 20, 0, 16), Size = UDim2.new(0, 220, 0, 44), Text = "" , TextXAlignment = Enum.TextXAlignment.Left })
local trackLabel = text(race, { Position = UDim2.new(0, 20, 0, 60), Size = UDim2.new(0, 300, 0, 22), Font = Enum.Font.GothamMedium, Text = "", TextXAlignment = Enum.TextXAlignment.Left })
local itemSlot = frame(race, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 14), Size = UDim2.new(0, 210, 0, 74) })
local itemLabel = text(itemSlot, { Position = UDim2.new(0, 10, 0, 6), Size = UDim2.new(1, -20, 0, 40), Text = "" })
local itemHint = text(itemSlot, { Position = UDim2.new(0, 10, 0, 48), Size = UDim2.new(1, -20, 0, 18), Font = Enum.Font.GothamMedium, Text = "" })
local standings = frame(race, { Position = UDim2.new(0, 20, 0, 96), Size = UDim2.new(0, 190, 0, 8 * 24 + 12) })
local standingRows: { TextLabel } = {}
for i = 1, 8 do
	standingRows[i] = text(standings, {
		Position = UDim2.new(0, 10, 0, 6 + (i - 1) * 24),
		Size = UDim2.new(1, -20, 0, 22),
		Font = Enum.Font.GothamBold,
		TextScaled = false,
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = "",
	})
end
local bigText = text(race, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.38), Size = UDim2.new(0, 500, 0, 120), Text = "", TextColor3 = YELLOW })
local speedLabel = text(race, { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -24, 1, -132), Size = UDim2.new(0, 200, 0, 30), Font = Enum.Font.GothamBold, Text = "" })
local warnLabel = text(race, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 100), Size = UDim2.new(0, 360, 0, 40), Text = "", TextColor3 = Color3.fromRGB(255, 80, 80) })

local raceInfo: any = nil
local item: { id: string?, uses: number, readyAt: number } = { id = nil, uses = 0, readyAt = 0 }
local flashUntil = 0
local flashText = ""
local raceState: any = nil

function Hud.raceStarted(info: any)
	raceInfo = info
	raceState = nil
	race.Visible = true
	lobby.Visible = false
	trackLabel.Text = `{info.trackName}  -  Race {info.raceNumber}/{info.raceCount}`
end

function Hud.raceEnded()
	race.Visible = false
	raceInfo = nil
end

function Hud.setRaceState(s: any)
	raceState = s
	if s.finishTime then
		lapLabel.Text = fmtTime(s.finishTime)
	else
		lapLabel.Text = `LAP {s.lap}/{s.laps}`
	end
	placeLabel.Text = ordinal(s.place)
	placeLabel.TextColor3 = PLACE_COLORS[s.place] or Color3.new(1, 1, 1)
	for i, row in standingRows do
		local r = s.rows[i]
		row.Text = if r then `{i}. {r.name}{if r.finished then "  ✓" else ""}` else ""
		row.TextColor3 = if r and not r.isCpu then YELLOW else Color3.new(1, 1, 1)
	end
end

function Hud.setItem(id: string?, uses: number, readyAt: number)
	item = { id = id, uses = uses, readyAt = readyAt }
end

function Hud.flash(message: string, seconds: number?)
	flashText = message
	flashUntil = os.clock() + (seconds or 1.5)
end

function Hud.setKart(info: any)
	if info.countdown and info.countdown > 0 then
		local n = math.ceil(info.countdown)
		bigText.Text = if n <= 3 then tostring(n) else "GET READY"
	elseif os.clock() < flashUntil then
		bigText.Text = flashText
	else
		bigText.Text = ""
	end
	speedLabel.Text = `{math.floor(math.abs(info.speed or 0) * 0.6 + 0.5)} km/h`
	warnLabel.Text = if info.wrongWay then "WRONG WAY!" else ""
end

function Hud.updateRace()
	if not raceInfo then
		return
	end
	local t = Workspace:GetServerTimeNow()
	if raceInfo.goTime and t >= raceInfo.goTime and t < raceInfo.goTime + 1 and os.clock() >= flashUntil then
		bigText.Text = "GO!"
	end
	if item.id then
		local def = Items.Defs[item.id]
		if t < item.readyAt then
			-- Roulette: flick through items until it lands.
			local i = math.floor(t * 14) % #Items.Order + 1
			itemLabel.Text = Items.Defs[Items.Order[i]].name
			itemHint.Text = ""
		else
			itemLabel.Text = if item.uses > 1 then `{def.name} x{item.uses}` else def.name
			itemHint.Text = "Press E (X / ITEM) to use"
		end
	else
		itemLabel.Text = ""
		itemHint.Text = "Drive through a ? box"
	end
end

---------------------------------------------------------------------------
-- Results
---------------------------------------------------------------------------
local results = frame(gui, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0, 460, 0, 400), Visible = false })
local resultsTitle = text(results, { Position = UDim2.new(0, 20, 0, 12), Size = UDim2.new(1, -40, 0, 38), TextColor3 = YELLOW, Text = "" })
local resultsBody = text(results, {
	Position = UDim2.new(0, 24, 0, 60),
	Size = UDim2.new(1, -48, 1, -76),
	Font = Enum.Font.GothamBold,
	TextScaled = false,
	TextSize = 18,
	TextXAlignment = Enum.TextXAlignment.Left,
	TextYAlignment = Enum.TextYAlignment.Top,
	RichText = true,
	Text = "",
})

function Hud.showResults(info: any)
	Hud.raceEnded()
	local lines = {}
	if info.kind == "race" then
		resultsTitle.Text = `{info.trackName} results`
		for _, r in info.rows do
			local name = if r.isCpu then r.name else `<font color="#FFD232">{r.name}</font>`
			table.insert(lines, `{ordinal(r.place)}  {name}   {fmtTime(r.time)}   +{r.gained}  ({r.total})`)
		end
		table.insert(lines, "")
		table.insert(lines, if info.lastRace then "Final standings next..." else "Next race coming up...")
	else
		resultsTitle.Text = `{info.cupName} final standings`
		for _, r in info.rows do
			table.insert(lines, `{ordinal(r.place)}  {r.name}   {r.total} pts`)
		end
	end
	resultsBody.Text = table.concat(lines, "\n")
	results.Visible = true
	task.delay(if info.kind == "cup" then 13 else 8.5, function()
		results.Visible = false
	end)
end

---------------------------------------------------------------------------
-- Touch buttons
---------------------------------------------------------------------------
function Hud.addTouchButtons(onDrift: (boolean) -> (), onItem: () -> ())
	local drift = button(race, "DRIFT", { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -24, 1, -170), Size = UDim2.new(0, 110, 0, 80), BackgroundColor3 = Color3.fromRGB(170, 70, 40) }, function() end)
	drift.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch then
			onDrift(true)
		end
	end)
	drift.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch then
			onDrift(false)
		end
	end)
	button(race, "ITEM", { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -144, 1, -170), Size = UDim2.new(0, 90, 0, 80), BackgroundColor3 = Color3.fromRGB(50, 110, 210) }, onItem)
end

return Hud
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">KartController</string>
            <string name="Source"><![CDATA[-- Drives your kart: reads input, runs KartPhysics on this client (you own the
-- kart's physics), handles drift / items / rocket starts, and runs the chase
-- camera.
--
-- Controls: W/S or stick to drive, A/D steer, Space or Shift to drift,
-- E to use your item. Gamepad: R2/L2 gas and brake, R1 drift, X item.

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local KartPhysics = require(Shared:WaitForChild("KartPhysics"))
local Karts = require(Shared:WaitForChild("Karts"))
local RaceRules = require(Shared:WaitForChild("RaceRules"))
local Track = require(Shared:WaitForChild("Track"))
local Tracks = require(Shared:WaitForChild("Tracks"))
local KartRig = require(ReplicatedStorage:WaitForChild("Common"):WaitForChild("KartRig"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local KartController = {}

local player = Players.LocalPlayer
local camera = Workspace.CurrentCamera
local controls = require(player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule")):GetControls()

type Session = {
	kart: Model,
	track: Track.Built,
	stats: Karts.KartStats,
	state: KartPhysics.State,
	goTime: number,
	hint: number?,
	throttleDownAt: number?,
	started: boolean,
	camYaw: number,
}

local session: Session? = nil
local driftHeld = false
local gasHeld, brakeHeld = false, false
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

-- Hooks set by Main so the HUD can show speed, drift charge and warnings.
KartController.onUpdate = nil :: ((info: any) -> ())?
KartController.onTurbo = nil :: ((level: number) -> ())?

local function refreshRayFilter()
	local ignore: { Instance } = {}
	for _, name in { "Karts", "Items" } do
		local f = Workspace:FindFirstChild(name)
		if f then
			table.insert(ignore, f)
		end
	end
	for _, p in Players:GetPlayers() do
		if p.Character then
			table.insert(ignore, p.Character)
		end
	end
	rayParams.FilterDescendantsInstances = ignore
end

local function setRacingControls(racing: boolean)
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.JumpHeight = if racing then 0 else 7.2
		humanoid.JumpPower = if racing then 0 else 50
	end
	if racing then
		-- Bound above the default controls so Space drifts instead of jumping out.
		ContextActionService:BindActionAtPriority("KartDrift", function(_, inputState)
			driftHeld = inputState == Enum.UserInputState.Begin
			return Enum.ContextActionResult.Sink
		end, false, Enum.ContextActionPriority.High.Value, Enum.KeyCode.Space, Enum.KeyCode.LeftShift, Enum.KeyCode.ButtonR1)
		ContextActionService:BindActionAtPriority("KartItem", function(_, inputState)
			if inputState == Enum.UserInputState.Begin then
				Remotes.UseItem:FireServer()
			end
			return Enum.ContextActionResult.Sink
		end, false, Enum.ContextActionPriority.High.Value, Enum.KeyCode.E, Enum.KeyCode.ButtonX)
		ContextActionService:BindActionAtPriority("KartPedals", function(action, inputState, input)
			local down = inputState ~= Enum.UserInputState.End
			if input.KeyCode == Enum.KeyCode.ButtonR2 then
				gasHeld = down
			else
				brakeHeld = down
			end
			return Enum.ContextActionResult.Sink
		end, false, Enum.ContextActionPriority.High.Value, Enum.KeyCode.ButtonR2, Enum.KeyCode.ButtonL2)
	else
		ContextActionService:UnbindAction("KartDrift")
		ContextActionService:UnbindAction("KartItem")
		ContextActionService:UnbindAction("KartPedals")
		driftHeld, gasHeld, brakeHeld = false, false, false
	end
end

-- Touch buttons call these.
function KartController.setDrift(on: boolean)
	driftHeld = on
end
function KartController.useItem()
	Remotes.UseItem:FireServer()
end

function KartController.isRacing(): boolean
	return session ~= nil
end

local function stop()
	session = nil
	setRacingControls(false)
	camera.CameraType = Enum.CameraType.Custom
	camera.FieldOfView = 70
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		camera.CameraSubject = humanoid
	end
end

local function begin(info: any)
	local kart: Model = info.kart
	local deadline = os.clock() + 10
	while (not kart or not kart.PrimaryPart) and os.clock() < deadline do
		task.wait()
	end
	if not kart or not kart.PrimaryPart then
		warn("[KartController] kart never arrived")
		return
	end
	session = {
		kart = kart,
		track = Track.build(Tracks.get(info.trackId)),
		stats = Karts.get(info.kartId).stats,
		state = KartPhysics.newState(info.yaw),
		goTime = info.goTime,
		hint = nil,
		throttleDownAt = nil,
		started = false,
		camYaw = info.yaw,
	}
	refreshRayFilter()
	setRacingControls(true)
	camera.CameraType = Enum.CameraType.Scriptable
end

local function readInput(): (number, number)
	local move = controls:GetMoveVector()
	local steer = math.clamp(move.X, -1, 1)
	local throttle = math.clamp(-move.Z, -1, 1)
	if gasHeld then
		throttle = 1
	elseif brakeHeld then
		throttle = -1
	end
	return throttle, steer
end

local function updateCamera(s: Session, dt: number)
	local root = s.kart.PrimaryPart
	if not root then
		return
	end
	-- The camera follows travel direction, so drifts show the kart sliding.
	local diff = (s.state.yaw - s.camYaw + math.pi) % (2 * math.pi) - math.pi
	s.camYaw += diff * math.min(1, dt * 6)
	local fx, fz = KartPhysics.forward(s.camYaw)
	local forward = Vector3.new(fx, 0, fz)
	local target = root.Position + Vector3.new(0, 6.5, 0) - forward * 17
	local look = root.Position + forward * 10 + Vector3.new(0, 2, 0)
	camera.CFrame = camera.CFrame:Lerp(CFrame.lookAt(target, look), math.min(1, dt * 10))
	local fov = if s.state.boost > 0 then 84 else 70
	camera.FieldOfView += (fov - camera.FieldOfView) * math.min(1, dt * 5)
end

local function step(dt: number)
	local s = session
	if not s then
		return
	end
	if not s.kart.Parent or not s.kart.PrimaryPart then
		stop()
		return
	end
	local root = s.kart.PrimaryPart :: BasePart
	local t = Workspace:GetServerTimeNow()
	local throttle, steer = readInput()

	if t < s.goTime then
		-- Countdown: remember when the gas went down for the rocket start.
		if throttle > 0.5 then
			s.throttleDownAt = s.throttleDownAt or (t - s.goTime)
		else
			s.throttleDownAt = nil
		end
		if KartController.onUpdate then
			KartController.onUpdate({ speed = 0, drift = 0, wrongWay = false, countdown = s.goTime - t })
		end
		return
	end
	if not s.started then
		s.started = true
		local boost = RaceRules.startBoost(s.throttleDownAt)
		if boost > 0 then
			KartPhysics.giveBoost(s.state, boost)
			if KartController.onTurbo then
				KartController.onTurbo(0)
			end
		end
	end
	if root.Anchored then
		return
	end

	local sensed = KartRig.sense(s.kart, rayParams)
	local pos = Track.v(root.Position.X, root.Position.Y, root.Position.Z)
	local proj = Track.project(s.track, pos, s.hint)
	s.hint = proj.index
	local surface = Track.surfaceAt(s.track, proj)

	local _, released = KartPhysics.step(s.stats, s.state, {
		throttle = throttle,
		steer = steer,
		drift = driftHeld,
		grounded = sensed.grounded,
		surface = if surface == "wall" then "offroad" else surface,
	}, dt)
	KartRig.sync(s.kart, s.state)
	KartRig.apply(s.kart, s.state, sensed)
	local level = if s.state.drift ~= 0 then KartPhysics.chargeLevel(s.state.charge) else 0
	KartRig.setEffects(s.kart, level, s.state.boost > 0)
	if released > 0 and KartController.onTurbo then
		KartController.onTurbo(released)
	end

	if KartController.onUpdate then
		local fx, fz = KartPhysics.forward(s.state.yaw)
		KartController.onUpdate({
			speed = s.state.speed,
			drift = level,
			boosting = s.state.boost > 0,
			invincible = s.state.invincible > 0,
			wrongWay = s.state.speed > 15 and Track.wrongWay(s.track, proj, fx, fz),
		})
	end
end

local function onKartEvent(kind: string, value: any)
	local s = session
	if not s then
		return
	end
	if kind == "hit" then
		KartPhysics.hit(s.state)
	elseif kind == "boost" then
		KartPhysics.giveBoost(s.state, tonumber(value) or 1)
	elseif kind == "overdrive" then
		KartPhysics.overdrive(s.state, tonumber(value) or 6)
	elseif kind == "respawn" then
		s.state.speed = 0
		s.state.yaw = tonumber(value) or s.state.yaw
		s.state.drift = 0
		s.state.charge = 0
		s.camYaw = s.state.yaw
		s.hint = nil
	end
end

function KartController.start()
	Remotes.RaceStart.OnClientEvent:Connect(function(info)
		task.spawn(begin, info)
	end)
	Remotes.KartEvent.OnClientEvent:Connect(onKartEvent)
	Remotes.Results.OnClientEvent:Connect(function()
		if session then
			stop()
		end
	end)
	RunService.Heartbeat:Connect(function(dt)
		local ok, err = pcall(step, math.min(dt, 0.1))
		if not ok then
			warn("[KartController]", err)
		end
	end)
	-- Camera runs every rendered frame so it stays smooth.
	RunService:BindToRenderStep("KartCamera", Enum.RenderPriority.Camera.Value + 1, function(dt)
		if session and session.kart.PrimaryPart then
			updateCamera(session, dt)
		end
	end)
	player.CharacterAdded:Connect(function()
		if session then
			task.defer(refreshRayFilter)
		end
	end)
end

return KartController
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="24">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- Client entry point: wires remotes to the HUD and the kart controller.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local Hud = require(script.Parent.Hud)
local KartController = require(script.Parent.KartController)

KartController.start()

Hud.onChooseKart = function(kartId)
	Remotes.ChooseKart:FireServer(kartId)
end
Hud.onReady = function(ready)
	Remotes.Ready:FireServer(ready)
end

KartController.onUpdate = Hud.setKart
KartController.onTurbo = function(level)
	Hud.flash(if level == 0 then "ROCKET START!" elseif level == 3 then "ULTRA TURBO!" elseif level == 2 then "SUPER TURBO!" else "TURBO!", 0.8)
end

Remotes.Lobby.OnClientEvent:Connect(Hud.setLobby)
Remotes.RaceStart.OnClientEvent:Connect(Hud.raceStarted)
Remotes.RaceState.OnClientEvent:Connect(Hud.setRaceState)
Remotes.ItemState.OnClientEvent:Connect(Hud.setItem)
Remotes.Results.OnClientEvent:Connect(Hud.showResults)
Remotes.Notify.OnClientEvent:Connect(function(message)
	Hud.flash(message, 1.6)
end)

if UserInputService.TouchEnabled then
	Hud.addTouchButtons(KartController.setDrift, KartController.useItem)
end

-- Spin the item boxes (visual only; pickups are decided by the server).
RunService.RenderStepped:Connect(function(dt)
	Hud.updateLobby()
	Hud.updateRace()
	local items = workspace:FindFirstChild("Items")
	if items then
		for _, box in items:GetChildren() do
			if box:GetAttribute("ItemBox") and box:IsA("BasePart") then
				box.CFrame *= CFrame.Angles(0, dt * 2, 0)
			end
		end
	end
end)
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
</roblox>