      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">Voting</string>
          <string name="Source"><![CDATA[--!strict
-- Map voting: pick three track options each round, count votes, choose the
-- winner. Pure logic so it can be tested; the server owns the actual votes.

local Voting = {}

Voting.OptionCount = 3
Voting.VoteSeconds = 20
Voting.AnnounceSeconds = 5 -- winner reveal before the race loads

-- The fourth choice. It isn't a track: picking it casts your vote for one of
-- the offered tracks, chosen at random, and the cards show which one.
Voting.Random = "random"

-- Picks `count` different tracks from `pool` (a list of ids), avoiding the
-- track that was just raced when there are enough others. `random` returns 0..1.
function Voting.pickOptions(pool: { string }, count: number, random: () -> number, lastTrack: string?): { string }
	local candidates = {}
	for _, id in pool do
		if id ~= lastTrack then
			table.insert(candidates, id)
		end
	end
	if #candidates < count and lastTrack and table.find(pool, lastTrack) then
		table.insert(candidates, lastTrack)
	end
	-- Fisher-Yates shuffle, then take the first `count`.
	for i = #candidates, 2, -1 do
		local j = math.floor(random() * i) + 1
		candidates[i], candidates[j] = candidates[j], candidates[i]
	end
	local out = {}
	for i = 1, math.min(count, #candidates) do
		out[i] = candidates[i]
	end
	return out
end

-- votes: voter id -> track id. Only votes for listed options count.
function Voting.tally(options: { string }, votes: { [any]: string }): { [string]: number }
	local counts = {}
	for _, id in options do
		counts[id] = 0
	end
	for _, choice in votes do
		if counts[choice] ~= nil then
			counts[choice] += 1
		end
	end
	return counts
end

-- Highest vote count wins; ties (including nobody voting) are broken at random.
function Voting.winner(options: { string }, votes: { [any]: string }, random: () -> number): string
	assert(#options > 0, "no options to vote on")
	local counts = Voting.tally(options, votes)
	local best, tied = -1, {}
	for _, id in options do
		local n = counts[id]
		if n > best then
			best, tied = n, { id }
		elseif n == best then
			table.insert(tied, id)
		end
	end
	return tied[math.floor(random() * #tied) + 1]
end

-- The track a Random vote goes to: any of the offered options.
function Voting.randomPick(options: { string }, random: () -> number): string
	assert(#options > 0, "no options to vote on")
	return options[math.min(#options, math.floor(random() * #options) + 1)]
end

-- Who voted for what, for the voter icons on each option.
function Voting.votersFor(votes: { [any]: string }, option: string): { any }
	local out = {}
	for voter, choice in votes do
		if choice == option then
			table.insert(out, voter)
		end
	end
	return out
end

return Voting
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="24">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="25">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[-- Loads and saves player data (coins, unlocks, equipped kart, settings,
-- records, mastery, challenges) with retries. A failed load never breaks the
-- session: the player gets a fresh temporary profile, is told progress won't
-- save this time, and we never overwrite their real save with it.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TextService = game:GetService("TextService")

local PlayerData = require(ReplicatedStorage.Shared.PlayerData)

local Net = require(script.Parent.Net)

local DataService = {}

local STORE_NAME = "KartProfiles_v1"
local AUTOSAVE_SECONDS = 60

type Entry = { data: PlayerData.Data, canSave: boolean, dirty: boolean }

local store: DataStore? = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
	else
		warn("[DataService] DataStores unavailable; progress will not be saved:", result)
	end
end

local entries: { [Player]: Entry } = {}
local loaded = Instance.new("BindableEvent")
DataService.Loaded = loaded.Event

local function key(player: Player): string
	return `p{player.UserId}`
end

local function retry<T>(fn: () -> T): (boolean, any)
	local lastErr = nil
	for attempt = 1, 3 do
		local ok, result = pcall(fn)
		if ok then
			return true, result
		end
		lastErr = result
		task.wait(attempt)
	end
	return false, lastErr
end

function DataService.get(player: Player): PlayerData.Data?
	local e = entries[player]
	return e and e.data
end

-- Yields until the player's data is ready (or they leave).
function DataService.waitFor(player: Player): PlayerData.Data?
	while player.Parent and not entries[player] do
		loaded.Event:Wait()
	end
	return DataService.get(player)
end

function DataService.markDirty(player: Player)
	local e = entries[player]
	if e then
		e.dirty = true
	end
end

-- Sends the player their own data (for the garage, settings and coins).
function DataService.push(player: Player)
	local e = entries[player]
	if e then
		Net.Profile:FireClient(player, e.data, e.canSave)
	end
end

function DataService.save(player: Player)
	local e = entries[player]
	if not e or not e.canSave or not store then
		return
	end
	local data = e.data
	local ok, err = retry(function()
		return (store :: DataStore):UpdateAsync(key(player), function()
			return data
		end)
	end)
	if ok then
		e.dirty = false
	else
		warn(`[DataService] save failed for {player.Name}:`, err)
	end
end

-- Runs Roblox text filtering for kart names and plates others will see.
function DataService.filter(player: Player, text: string): string
	if text == "" then
		return ""
	end
	local ok, result = pcall(function()
		local filtered = TextService:FilterStringAsync(text, player.UserId)
		return filtered:GetNonChatStringForBroadcastAsync()
	end)
	if ok and type(result) == "string" then
		return result
	end
	-- In Studio without API access filtering fails; never show unfiltered text live.
	return if RunService:IsStudio() then text else ""
end

local function onPlayerAdded(player: Player)
	local data: PlayerData.Data
	local canSave = store ~= nil
	if store then
		local ok, result = retry(function()
			return (store :: DataStore):GetAsync(key(player))
		end)
		if ok then
			data = PlayerData.migrate(result)
		else
			warn(`[DataService] load failed for {player.Name}:`, result)
			data = PlayerData.new()
			canSave = false
			task.delay(3, function()
				if player.Parent then
					Net.Notify:FireClient(player, "Couldn't load your progress. This session won't be saved.")
				end
			end)
		end
	else
		data = PlayerData.new()
	end
	if not player.Parent then
		return
	end
	entries[player] = { data = data, canSave = canSave, dirty = false }
	loaded:Fire(player)
	DataService.push(player)
end

function DataService.start()
	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end
	Players.PlayerRemoving:Connect(function(player)
		DataService.save(player)
		entries[player] = nil
	end)
	task.spawn(function()
		while true do
			task.wait(AUTOSAVE_SECONDS)
			for player, e in entries do
				if e.dirty then
					task.spawn(DataService.save, player)
				end
			end
		end
	end)
	game:BindToClose(function()
		local pending = 0
		for player in entries do
			pending += 1
			task.spawn(function()
				DataService.save(player)
				pending -= 1
			end)
		end
		local deadline = os.clock() + 25
		while pending > 0 and os.clock() < deadline do
			task.wait(0.25)
		end
	end)
end

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">FortressBuilder</string>
          <string name="Source"><![CDATA[-- Original fortress course dressing. Masonry and lava stay outside the
-- drivable ribbon; arches leave a wide, camera-friendly clearance.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Track = require(ReplicatedStorage.Shared.Track)
local Shapes = require(ReplicatedStorage.Common.Shapes)
local FortressBuilder = {}
local stone = Color3.fromRGB(86, 79, 76)
local trim = Color3.fromRGB(145, 127, 105)
local dark = Color3.fromRGB(39, 34, 38)
local ember = Color3.fromRGB(245, 121, 39)
local function box(parent, size, cf, color, name, material)
 return Shapes.box(parent, size, cf, { color = color, material = material or Enum.Material.Cobblestone, name = name, collide = false })
end
function FortressBuilder.build(track, parent)
 local folder = Instance.new("Folder")
 folder.Name = "Citadel"
 folder.Parent = parent
 local half = track.def.width / 2
 for i = 0, 39 do
  local d = track.length * i / 40
  local p, tan = Track.at(track, d)
  local cf = CFrame.lookAt(Vector3.new(p.x, p.y, p.z), Vector3.new(p.x + tan.x, p.y, p.z + tan.z))
  for _, side in { -1, 1 } do
   -- Raised parapets and shallow lava canals outside the guard wall.
   box(folder, Vector3.new(8, 5, 24), cf * CFrame.new(side * (half + 12), 1, 0), stone, "Parapet")
   box(folder, Vector3.new(22, 0.5, 40), cf * CFrame.new(side * (half + 28), -3, 0), ember, "LavaCanal", Enum.Material.Neon)
   for k = -1, 1 do
    box(folder, Vector3.new(1.2, 0.12, 30), cf * CFrame.new(side * (half + 28) + k * 6, -2.65, 0), Color3.fromRGB(255, 177, 67), "LavaVein", Enum.Material.Neon)
   end
   if i % 4 == 0 then
    local torchCf = cf * CFrame.new(side * (half + 13), 6, 0)
    local torch = box(folder, Vector3.new(1, 4, 1), torchCf, dark, "Torch", Enum.Material.Metal)
    Shapes.ellipsoid(folder, Vector3.new(1.4, 2.6, 1.4), torchCf * CFrame.new(0, 3, 0), { color = ember, material = Enum.Material.Neon, name = "Flame" })
    local light = Instance.new("PointLight")
    light.Color = ember
    light.Range = 32
    light.Brightness = 0.8
    light.Parent = torch
   end
  end
 end
 for index, fraction in { 0.055, 0.29, 0.58, 0.89 } do
  local p, tan = Track.at(track, fraction * track.length)
  local cf = CFrame.lookAt(Vector3.new(p.x, p.y, p.z), Vector3.new(p.x + tan.x, p.y, p.z + tan.z))
  for _, side in { -1, 1 } do
   local towerCf = cf * CFrame.new(side * (half + 20), 0, 0)
   Shapes.pillar(folder, 22, 52, towerCf * CFrame.new(0, 26, 0), { color = stone, material = Enum.Material.Cobblestone, name = "GateTower" })
   Shapes.pillar(folder, 25, 3, towerCf * CFrame.new(0, 48, 0), { color = trim, material = Enum.Material.Slate })
   for k = 0, 7 do
    local angle = k * math.pi / 4
    box(folder, Vector3.new(4, 5, 4), towerCf * CFrame.new(math.cos(angle) * 10, 53, math.sin(angle) * 10), stone, "Battlement")
   end
   for y = 10, 40, 10 do
    box(folder, Vector3.new(2, 4, 0.3), towerCf * CFrame.new(0, y, -11.1), dark, "ArrowSlit", Enum.Material.Slate)
   end
  end
  Shapes.arch(folder, track.def.width + 16, 4, 8, cf * CFrame.new(0, 17, 0), { color = trim, material = Enum.Material.Cobblestone, name = "StoneArch" }, 20)
  box(folder, Vector3.new(track.def.width + 26, 7, 10), cf * CFrame.new(0, 51, 0), stone, "GateLintel")
  -- Clear road below; hanging crest is high above drivers and camera.
  Shapes.ellipsoid(folder, Vector3.new(9, 11, 2), cf * CFrame.new(0, 48, -6), { color = trim, material = Enum.Material.Metal, name = "CitadelCrest" })
 end
 -- Continuous outer curtain wall connects the gates into a fortress instead
 -- of leaving towers as isolated props. The inner lane stays open to lava.
 for i = 0, 63 do
  local a = Track.spot(track, i / 64 * track.length, -(half + 70))
  local b = Track.spot(track, ((i + 1) % 64) / 64 * track.length, -(half + 70))
  local av, bv = Vector3.new(a.x, a.y, a.z), Vector3.new(b.x, b.y, b.z)
  local cf = CFrame.lookAt((av + bv) / 2, bv)
  local length = (bv - av).Magnitude
  box(folder, Vector3.new(5, 24, length + 0.5), cf * CFrame.new(0, 12, 0), stone, "CurtainWall")
  box(folder, Vector3.new(6, 1.5, length + 0.5), cf * CFrame.new(0, 24, 0), trim, "WallCap", Enum.Material.Slate)
  for k = -1, 1 do
   box(folder, Vector3.new(5, 3, 4), cf * CFrame.new(0, 26, k * length / 3), stone, "WallCrenel")
  end
 end
 -- Distant basalt spires give depth without filling the road with obstacles.
 for i = 0, 23 do
  local p, tan = Track.at(track, i / 24 * track.length)
  local side = if i % 2 == 0 then 1 else -1
  local spot = Track.spot(track, i / 24 * track.length, side * (half + 150))
  local cf = CFrame.new(spot.x, p.y + 35, spot.z) * CFrame.Angles(0.06, i, -0.08)
  Shapes.ellipsoid(folder, Vector3.new(45, 95 + i % 4 * 15, 40), cf, { color = dark, material = Enum.Material.Basalt, name = "BasaltSpire" })
 end
end
return FortressBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="28">
        <Properties>
          <string name="Name">ItemService</string>
          <string name="Source"><![CDATA[-- Item boxes, rolling items and everything the six items do on the track.
-- All hits are decided here on the server, and every attack is readable:
--   Wind-up Rocket  rolls along the road, pops on the first kart it meets
--                   (racers ahead get a warning)
--   Popcorn Bomb    lobbed ahead (or dropped behind), blinks, then pops
--   Jelly Puddle    a sticky trap that slows whoever drives in
--   Bubble Shield   blocks one attack
--   Turbo Soda      a speed boost
--   Spring Mine     a trap that boings karts into the air
-- Traps expire, each racer has a trap limit, and the track has a cap on
-- active hazards so things never pile up.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Items = require(Shared.Items)
local KartPhysics = require(Shared.KartPhysics)
local Track = require(Shared.Track)
local Shapes = require(ReplicatedStorage.Common.Shapes)

local ItemService = {}

local PICKUP_RADIUS = 7
local HIT_RADIUS = 5
local WARN_RANGE = 110

-- Optional sound ids (rbxassetid://...). Empty = silent. See README "Assets to replace".
ItemService.Sounds = { pop = "", boing = "", splat = "", fizz = "", whoosh = "" }

type Hazard = {
	kind: string,
	model: Model,
	owner: any, -- Racer
	born: number,
	life: number,
	pos: Vector3,
	-- rocket: travels along the lap
	score: number?,
	direction: number?,
	lateral: number?,
	-- bomb: lands, then pops after a fuse
	from: Vector3?,
	landAt: number?,
	popAt: number?,
	hitsLeft: number?,
}

type Box = { part: BasePart, pos: Vector3, respawnAt: number? }

local boxes: { Box } = {}
local hazards: { Hazard } = {}
local folder: Folder? = nil

-- The clock is swappable so the smoke test can run items outside Roblox.
ItemService.clock = function(): number
	return Workspace:GetServerTimeNow()
end

local function now(): number
	return ItemService.clock()
end

local function cleanupLater(inst: Instance, seconds: number)
	task.delay(seconds, function()
		if inst.Parent then
			inst:Destroy()
		end
	end)
end

local function v3(p: Track.Vec): Vector3
	return Vector3.new(p.x, p.y, p.z)
end

local function rootOf(racer: any): BasePart?
	return racer.model and racer.model.PrimaryPart
end

local function forwardOf(racer: any): Vector3
	local yaw
	if racer.state then
		yaw = racer.state.yaw
	else
		local root = rootOf(racer)
		local look = if root then root.CFrame.LookVector else Vector3.new(0, 0, -1)
		yaw = math.atan2(-look.X, -look.Z)
	end
	local fx, fz = KartPhysics.forward(yaw)
	return Vector3.new(fx, 0, fz)
end

local function sound(parent: Instance, key: string)
	local id = ItemService.Sounds[key]
	if id and id ~= "" then
		local s = Instance.new("Sound")
		s.SoundId = id
		s.Volume = 0.8
		s.Parent = parent
		s:Play()
		cleanupLater(s, 3)
	end
end

-- A cartoon pop: a flash ball, sparks, a puff of smoke and a "POP!" word.
function ItemService.explode(pos: Vector3, word: string?, color: Color3?)
	local f = folder
	if not f then
		return
	end
	local flash = Shapes.ball(f, 6, CFrame.new(pos), { color = color or Color3.fromRGB(255, 220, 90), material = Enum.Material.Neon, transparency = 0.2 })
	flash.Name = "Pop"
	local sparks = Instance.new("ParticleEmitter")
	sparks.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	sparks.Color = ColorSequence.new(Color3.fromRGB(255, 240, 120), Color3.fromRGB(255, 120, 60))
	sparks.Size = NumberSequence.new(1.2, 0)
	sparks.Lifetime = NumberRange.new(0.3, 0.6)
	sparks.Speed = NumberRange.new(25, 45)
	sparks.SpreadAngle = Vector2.new(180, 180)
	sparks.Rate = 400
	sparks.LightEmission = 1
	sparks.Parent = flash
	local smoke = Instance.new("ParticleEmitter")
	smoke.Texture = "rbxasset://textures/particles/smoke_main.dds"
	smoke.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255))
	smoke.Size = NumberSequence.new(3, 7)
	smoke.Transparency = NumberSequence.new(0.3, 1)
	smoke.Lifetime = NumberRange.new(0.6, 0.9)
	smoke.Speed = NumberRange.new(4, 9)
	smoke.SpreadAngle = Vector2.new(180, 180)
	smoke.Rate = 60
	smoke.Parent = flash
	local tag = Instance.new("BillboardGui")
	tag.Size = UDim2.new(0, 120, 0, 50)
	tag.StudsOffset = Vector3.new(0, 6, 0)
	tag.AlwaysOnTop = true
	tag.MaxDistance = 220
	tag.Parent = flash
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(255, 230, 80)
	label.TextStrokeTransparency = 0
	label.Text = word or "POP!"
	label.Parent = tag
	sound(flash, "pop")
	task.delay(0.25, function()
		if not flash.Parent then
			return
		end
		sparks.Enabled = false
		smoke.Enabled = false
		flash.Transparency = 1
	end)
	cleanupLater(flash, 1.4)
end

function ItemService.clear()
	if folder then
		folder:Destroy()
	end
	folder = nil
	boxes = {}
	hazards = {}
end

function ItemService.setup(track: Track.Built)
	ItemService.clear()
	local f = Instance.new("Folder")
	f.Name = "Items"
	f.Parent = Workspace
	folder = f
	for _, spot in Track.itemBoxes(track) do
		local pos = v3(Track.spot(track, spot.distance, spot.lateral)) + Vector3.new(0, 3.5, 0)
		local part = Shapes.box(f, Vector3.new(4.5, 4.5, 4.5), CFrame.new(pos) * CFrame.Angles(math.rad(45), math.rad(45), 0), {
			color = Color3.fromRGB(150, 210, 255),
			material = Enum.Material.Glass,
			transparency = 0.2,
			name = "ItemBox",
		})
		part:SetAttribute("ItemBox", true)
		local core = Shapes.ball(f, 2.4, CFrame.new(pos), { color = Color3.fromRGB(255, 230, 120), material = Enum.Material.Neon, name = "ItemCore" })
		local gui = Instance.new("BillboardGui")
		gui.Size = UDim2.new(0, 44, 0, 44)
		gui.MaxDistance = 260
		gui.Parent = part
		local q = Instance.new("TextLabel")
		q.Size = UDim2.fromScale(1, 1)
		q.BackgroundTransparency = 1
		q.Font = Enum.Font.FredokaOne
		q.TextScaled = true
		q.TextColor3 = Color3.new(1, 1, 1)
		q.TextStrokeTransparency = 0
		q.Text = "?"
		q.Parent = gui
		part:SetAttribute("CoreName", core.Name)
		table.insert(boxes, { part = part, pos = pos, core = core } :: any)
	end
end

local function racerAtPlace(racers: { any }, place: number): any?
	for _, r in racers do
		if r.place == place then
			return r
		end
	end
	return nil
end

local function giveItem(racer: any, field: number, effects: any)
	local id = Items.roll(racer.place, field, math.random())
	racer.item = id
	racer.uses = Items.Defs[id].uses
	racer.itemReadyAt = now() + Items.RouletteTime
	racer.cpuUseAt = racer.itemReadyAt + 0.5 + math.random() * 3
	effects.itemChanged(racer)
end

-- Removes the oldest hazards when there are too many (per racer and overall).
local function makeRoom(owner: any, isTrap: boolean)
	if isTrap then
		local mine = {}
		for i, h in hazards do
			if h.owner == owner and (h.kind == "jellyPuddle" or h.kind == "springMine") then
				table.insert(mine, i)
			end
		end
		if #mine >= Items.MaxTrapsPerRacer then
			local h = table.remove(hazards, mine[1]) :: Hazard
			h.model:Destroy()
		end
	end
	while #hazards >= Items.MaxActiveHazards do
		local h = table.remove(hazards, 1) :: Hazard
		h.model:Destroy()
	end
end

local function newModel(name: string): Model
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = folder
	return m
end

local function place(model: Model, cf: CFrame)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			local offset = d:GetAttribute("Offset") :: CFrame?
			d.CFrame = cf * (offset or CFrame.new())
		end
	end
end

-- Builds a hazard model whose parts keep their offset from the hazard's centre.
local function part(model: Model, kind: string, size: Vector3, offset: CFrame, color: Color3, material: Enum.Material?, transparency: number?): BasePart
	local p: BasePart
	if kind == "ball" then
		p = Shapes.ball(model, size.X, offset, { color = color, material = material, transparency = transparency })
	elseif kind == "ellipsoid" then
		p = Shapes.ellipsoid(model, size, offset, { color = color, material = material, transparency = transparency })
	elseif kind == "disc" then
		p = Shapes.disc(model, size.X, size.Y, offset, { color = color, material = material, transparency = transparency })
	else
		p = Shapes.box(model, size, offset, { color = color, material = material, transparency = transparency })
	end
	p:SetAttribute("Offset", p.CFrame)
	return p
end

-- Tells racers a rocket is coming up behind them (at most every 1.5s).
local function warnAhead(racers: { any }, h: Hazard, effects: any)
	for _, r in racers do
		if r ~= h.owner then
			local gap = (r.score - (h.score :: number)) * (h.direction :: number)
			if gap > 0 and gap < WARN_RANGE and now() - (r.lastRocketWarn or 0) > 1.5 then
				r.lastRocketWarn = now()
				effects.warn(r, "🚀 Rocket incoming!")
			end
		end
	end
end

function ItemService.use(track: Track.Built, racers: { any }, racer: any, effects: any, aimBack: boolean?)
	local id = racer.item
	local root = rootOf(racer)
	if not id or not root or now() < racer.itemReadyAt or racer.finishTime then
		return
	end
	racer.uses -= 1
	if racer.uses <= 0 then
		racer.item = nil
	end
	effects.itemChanged(racer)

	local forward = forwardOf(racer)
	local ground = root.CFrame.Position - Vector3.new(0, 2, 0)

	if id == "turboSoda" then
		effects.boost(racer, Items.SodaBoost)
		sound(root, "fizz")
	elseif id == "bubbleShield" then
		effects.shield(racer, Items.ShieldTime)
	elseif id == "windupRocket" then
		makeRoom(racer, false)
		local m = newModel("Rocket")
		part(m, "ellipsoid", Vector3.new(2.6, 2.6, 6), CFrame.new(), Color3.fromRGB(240, 70, 70))
		part(m, "ellipsoid", Vector3.new(2, 2, 2.4), CFrame.new(0, 0, -2.8), Color3.fromRGB(255, 255, 255))
		part(m, "box", Vector3.new(4, 0.3, 1.4), CFrame.new(0, 0, 2.2), Color3.fromRGB(255, 210, 60))
		part(m, "disc", Vector3.new(1.4, 0.6, 1.4), CFrame.new(0, 1.6, 1) , Color3.fromRGB(255, 210, 60))
		local flame = part(m, "ball", Vector3.new(1.6, 1.6, 1.6), CFrame.new(0, 0, 3.4), Color3.fromRGB(255, 160, 40), Enum.Material.Neon)
		flame.Name = "Flame"
		place(m, CFrame.lookAt(root.CFrame.Position, root.CFrame.Position + forward))
		local proj = Track.project(track, Track.v(root.CFrame.Position.X, root.CFrame.Position.Y, root.CFrame.Position.Z), racer.progress.index)
		local direction = if aimBack then -1 else 1
		local h: Hazard = {
			kind = id,
			model = m,
			owner = racer,
			born = now(),
			life = Items.RocketLife,
			pos = root.CFrame.Position,
			score = racer.score + 7 * direction,
			direction = direction,
			lateral = proj.lateral,
		}
		table.insert(hazards, h)
		sound(flame, "whoosh")
	elseif id == "popcornBomb" then
		makeRoom(racer, false)
		local m = newModel("PopcornBomb")
		part(m, "ball", Vector3.new(4, 4, 4), CFrame.new(), Color3.fromRGB(255, 80, 80))
		part(m, "ball", Vector3.new(4.1, 4.1, 4.1), CFrame.new(0, 0.3, 0), Color3.fromRGB(255, 255, 255), nil, 0.6)
		for i = 1, 6 do
			local a = i * 1.05
			part(m, "ball", Vector3.new(1.4, 1.4, 1.4), CFrame.new(math.cos(a) * 1.2, 2.2, math.sin(a) * 1.2), Color3.fromRGB(255, 245, 210))
		end
		local fuse = part(m, "ball", Vector3.new(1, 1, 1), CFrame.new(0, 3.2, 0), Color3.fromRGB(255, 220, 60), Enum.Material.Neon)
		fuse.Name = "Fuse"
		place(m, CFrame.new(root.CFrame.Position + Vector3.new(0, 2, 0)))
		local target = if aimBack then ground - forward * 8 else ground + forward * Items.BombThrow + Vector3.new(0, 0, 0)
		local h: Hazard = {
			kind = id,
			model = m,
			owner = racer,
			born = now(),
			life = 6,
			pos = target,
			from = root.CFrame.Position + Vector3.new(0, 2, 0),
			landAt = now() + (if aimBack then 0.15 else 0.55),
			popAt = now() + (if aimBack then 0.15 else 0.55) + Items.BombFuse,
		}
		table.insert(hazards, h)
	elseif id == "jellyPuddle" or id == "springMine" then
		makeRoom(racer, true)
		local spot = ground - forward * 8
		local m: Model
		if id == "jellyPuddle" then
			m = newModel("JellyPuddle")
			part(m, "ellipsoid", Vector3.new(10, 1.6, 10), CFrame.new(0, 0.6, 0), Color3.fromRGB(255, 120, 190), Enum.Material.Glass, 0.25)
			part(m, "ellipsoid", Vector3.new(5, 2.2, 5), CFrame.new(1.2, 1.2, -0.8), Color3.fromRGB(255, 160, 210), Enum.Material.Glass, 0.2)
		else
			m = newModel("SpringMine")
			part(m, "disc", Vector3.new(6, 0.8, 6), CFrame.new(0, 0.4, 0), Color3.fromRGB(60, 60, 70))
			for k = 0, 3 do
				part(m, "disc", Vector3.new(4.2, 0.5, 4.2), CFrame.new(0, 1 + k * 0.7, 0), if k % 2 == 0 then Color3.fromRGB(255, 210, 60) else Color3.fromRGB(240, 70, 70))
			end
			part(m, "disc", Vector3.new(5, 0.6, 5), CFrame.new(0, 3.9, 0), Color3.fromRGB(240, 70, 70), Enum.Material.Neon)
		end
		place(m, CFrame.new(spot))
		table.insert(hazards, {
			kind = id,
			model = m,
			owner = racer,
			born = now(),
			life = if id == "jellyPuddle" then Items.JellyLife else Items.MineLife,
			pos = spot,
			hitsLeft = if id == "jellyPuddle" then Items.JellyHits else 1,
		})
		sound(m:FindFirstChildWhichIsA("BasePart") :: BasePart, if id == "jellyPuddle" then "splat" else "boing")
	end
end

local function touching(racer: any, pos: Vector3, radius: number): boolean
	local root = rootOf(racer)
	return root ~= nil and (root.CFrame.Position - pos).Magnitude <= radius
end

-- Returns false when the hazard is finished and should be removed.
local function stepHazard(h: Hazard, track: Track.Built, racers: { any }, dt: number, effects: any): boolean
	local t = now()
	if t - h.born > h.life then
		return false
	end
	local ownerSafe = t - h.born < 0.6

	if h.kind == "windupRocket" then
		h.score = (h.score :: number) + Items.RocketSpeed * dt * (h.direction :: number)
		local d = (h.score :: number) % track.length
		local spot = Track.spot(track, d, h.lateral :: number)
		local _, tan = Track.at(track, d)
		h.pos = v3(spot) + Vector3.new(0, 2, 0)
		local dir = Vector3.new(tan.x, 0, tan.z) * (h.direction :: number)
		local wobble = CFrame.Angles(0, 0, math.sin(t * 20) * 0.2)
		place(h.model, CFrame.lookAt(h.pos, h.pos + dir) * wobble)
		warnAhead(racers, h, effects)
		for _, r in racers do
			if not (ownerSafe and r == h.owner) and touching(r, h.pos, HIT_RADIUS) then
				effects.hit(r, "spin")
				ItemService.explode(h.pos, "POP!")
				return false
			end
		end
		return true
	elseif h.kind == "popcornBomb" then
		local landAt, popAt = h.landAt :: number, h.popAt :: number
		if t < landAt then
			-- Lobbed in an arc.
			local u = 1 - (landAt - t) / math.max(landAt - h.born, 0.01)
			local from = h.from :: Vector3
			local p = from:Lerp(h.pos, u) + Vector3.new(0, math.sin(u * math.pi) * 12, 0)
			place(h.model, CFrame.new(p + Vector3.new(0, 2, 0)))
			return true
		end
		place(h.model, CFrame.new(h.pos + Vector3.new(0, 2, 0)))
		-- Blink faster as the fuse runs down.
		local fuse = h.model:FindFirstChild("Fuse") :: BasePart?
		if fuse then
			local left = popAt - t
			local rate = if left < 0.6 then 14 else 5
			fuse.Transparency = if math.floor(t * rate) % 2 == 0 then 0 else 0.8
		end
		if t >= popAt then
			ItemService.explode(h.pos + Vector3.new(0, 2, 0), "POP!", Color3.fromRGB(255, 240, 200))
			for _, r in racers do
				if touching(r, h.pos + Vector3.new(0, 2, 0), Items.BombRadius) then
					effects.hit(r, "spin")
				end
			end
			return false
		end
		-- Warn anyone driving into the blast zone.
		for _, r in racers do
			if touching(r, h.pos, Items.BombRadius + 25) and t - (r.lastBombWarn or 0) > 1.2 then
				r.lastBombWarn = t
				effects.warn(r, "🍿 Bomb ahead!")
			end
		end
		return true
	elseif h.kind == "jellyPuddle" or h.kind == "springMine" then
		-- Jelly wobbles; mines bounce a little so they're easy to spot.
		local bob = if h.kind == "springMine" then math.abs(math.sin(t * 4)) * 0.6 else 0
		local squish = if h.kind == "jellyPuddle" then CFrame.Angles(0, t * 0.5, 0) else CFrame.new()
		place(h.model, CFrame.new(h.pos + Vector3.new(0, bob, 0)) * squish)
		for _, r in racers do
			if not (ownerSafe and r == h.owner) and touching(r, h.pos + Vector3.new(0, 2, 0), HIT_RADIUS + 1) then
				local kind = if h.kind == "jellyPuddle" then "slow" else "launch"
				if effects.hit(r, kind) then
					ItemService.explode(h.pos + Vector3.new(0, 2, 0), if kind == "slow" then "SPLAT!" else "BOING!", if kind == "slow" then Color3.fromRGB(255, 140, 200) else Color3.fromRGB(255, 220, 90))
					h.hitsLeft = (h.hitsLeft :: number) - 1
					if (h.hitsLeft :: number) <= 0 then
						return false
					end
				end
			end
		end
		return true
	end
	return false
end

function ItemService.tick(track: Track.Built, racers: { any }, dt: number, effects: any)
	local t = now()
	local field = #racers

	for _, box in boxes do
		local core = (box :: any).core :: BasePart
		if box.respawnAt then
			if t >= box.respawnAt then
				box.respawnAt = nil
				box.part.Transparency = 0.2
				core.Transparency = 0
			end
			continue
		end
		for _, r in racers do
			local root = rootOf(r)
			if root and not r.item and not r.finishTime and (root.CFrame.Position - box.pos).Magnitude <= PICKUP_RADIUS then
				giveItem(r, field, effects)
				box.respawnAt = t + Items.BoxRespawn
				box.part.Transparency = 1
				core.Transparency = 1
				break
			end
		end
	end

	for i = #hazards, 1, -1 do
		local h = hazards[i]
		local ok, keep = pcall(stepHazard, h, track, racers, dt, effects)
		if not ok or not keep then
			if not ok then
				warn("[ItemService] hazard failed:", keep)
			end
			h.model:Destroy()
			table.remove(hazards, i)
		end
	end

	-- CPU drivers use their items after a short, random delay. Traps and
	-- shields are used straight away; attacks wait for someone nearby.
	for _, r in racers do
		if r.state and r.item and t >= r.cpuUseAt then
			local id = r.item
			local ahead = racerAtPlace(racers, r.place - 1)
			local attackReady = id ~= "windupRocket" or (ahead ~= nil and ahead.score - r.score < 160)
			if attackReady then
				ItemService.use(track, racers, r, effects, false)
			end
			r.cpuUseAt = t + 0.8
		end
	end
end

return ItemService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="29">
        <Properties>
          <string name="Name">Landmarks</string>
          <string name="Source"><![CDATA[-- Big themed pieces for the oversized-world tracks: tunnels (the bed, garden
-- hose, cardboard box, hollow log), set pieces (toaster, cereal bowls, toy
-- train set, night lamp, flowerpots, sprinklers...), the moving crossers
-- (toy robot, toy train, beetles) and giant room walls for indoor tracks.
--
-- Built from rounded primitives (common/Shapes). Every one of these is a
-- good candidate for a custom mesh later; see README "Assets to replace".

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Track = require(Shared.Track)
local Shapes = require(ReplicatedStorage.Common.Shapes)

local Landmarks = {}

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

local function c3(t: { number }): Color3
	return Color3.fromRGB(t[1], t[2], t[3])
end

local function at(track: Track.Built, distance: number, lateral: number, height: number?): CFrame
	local p = Track.spot(track, distance, lateral)
	local _, tan = Track.at(track, distance)
	local pos = Vector3.new(p.x, p.y + (height or 0), p.z)
	return CFrame.lookAt(pos, pos + Vector3.new(tan.x, 0, tan.z))
end

---------------------------------------------------------------------------
-- Tunnels
---------------------------------------------------------------------------
local tunnelBuilders: { [string]: (Track.Built, number, number, any, Instance) -> () } = {}

-- A giant bed the road passes under: legs outside the walls, a puffy
-- mattress and blanket above, a pillow and a headboard at one end.
tunnelBuilders.bed = function(track, from, to, _theme, parent)
	local half = track.def.width / 2 + Track.ShoulderWidth + 6
	local mid = (from + to) / 2
	local length = to - from
	local cf = at(track, mid, 0, 0)
	local h = 34
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			Shapes.pillar(parent, 6, h, cf * CFrame.new(sx * half, h / 2, sz * length / 2), { color = rgb(120, 80, 50), collide = true })
		end
	end
	Shapes.roundedBox(parent, Vector3.new(half * 2 + 10, 6, length + 10), 4, cf * CFrame.new(0, h + 3, 0), { color = rgb(120, 80, 50), collide = true })
	Shapes.roundedBox(parent, Vector3.new(half * 2 + 8, 10, length + 6), 5, cf * CFrame.new(0, h + 11, 0), { color = rgb(245, 245, 255) })
	Shapes.ellipsoid(parent, Vector3.new(half * 2 + 16, 12, length * 0.75), cf * CFrame.new(0, h + 18, length * 0.1), { color = rgb(90, 120, 220) })
	Shapes.ellipsoid(parent, Vector3.new(half * 1.2, 10, 18), cf * CFrame.new(0, h + 20, -length / 2 + 10), { color = rgb(255, 255, 255) })
	Shapes.roundedBox(parent, Vector3.new(half * 2 + 12, 40, 6), 6, cf * CFrame.new(0, h + 10, -length / 2 - 6), { color = rgb(140, 95, 60), collide = true })
	-- Fairy lights under the bed so the tunnel isn't pitch black.
	for z = -length / 2 + 6, length / 2 - 6, 10 do
		local bulb = Shapes.ball(parent, 1.4, cf * CFrame.new(0, h - 1, z), { color = rgb(255, 220, 140), material = Enum.Material.Neon })
		local light = Instance.new("PointLight")
		light.Range = 22
		light.Brightness = 1.4
		light.Color = bulb.Color
		light.Parent = bulb
	end
end

-- Rings of a green garden hose with yellow stripes.
tunnelBuilders.hose = function(track, from, to, _theme, parent)
	local span = track.def.width + Track.ShoulderWidth * 2 + 10
	local i = 0
	for d = from, to, 7 do
		i += 1
		local cf = at(track, d, 0, -2)
		Shapes.arch(parent, span, 4, 6, cf, { color = if i % 3 == 0 then rgb(255, 210, 60) else rgb(60, 170, 80), collide = true }, 16)
	end
	local endCf = at(track, to, 0, -2)
	Shapes.tube(parent, 6, 40, endCf * CFrame.new(span / 2 + 18, 2, 6) * CFrame.Angles(0, math.rad(90), 0), { color = rgb(60, 170, 80) })
end

-- A cardboard box with the ends cut out.
tunnelBuilders.box = function(track, from, to, _theme, parent)
	local span = track.def.width + Track.ShoulderWidth * 2 + 6
	local mid = (from + to) / 2
	local length = to - from
	local cf = at(track, mid, 0, 0)
	local h = 30
	local cardboard = rgb(200, 160, 110)
	for _, sx in { -1, 1 } do
		Shapes.box(parent, Vector3.new(3, h, length), cf * CFrame.new(sx * span / 2, h / 2, 0), { color = cardboard, collide = true })
	end
	Shapes.box(parent, Vector3.new(span + 3, 3, length), cf * CFrame.new(0, h, 0), { color = cardboard, collide = true })
	Shapes.box(parent, Vector3.new(span * 0.3, 0.2, length + 0.2), cf * CFrame.new(0, h + 1.6, 0), { color = rgb(220, 200, 150) })
	for _, sz in { -1, 1 } do
		Shapes.box(parent, Vector3.new(span + 3, 8, 1), cf * CFrame.new(0, h - 4, sz * length / 2), { color = cardboard })
	end
end

-- A hollow log (half-rings of bark).
tunnelBuilders.log = function(track, from, to, _theme, parent)
	local span = track.def.width + 10
	for d = from, to, 4 do
		Shapes.arch(parent, span, 5, 4.5, at(track, d, 0, -3), { color = rgb(130, 90, 55), collide = true }, 16)
	end
end

tunnelBuilders.arch = function(track, from, to, theme, parent)
	local span = track.def.width + Track.ShoulderWidth * 2 + 6
	local i = 0
	for d = from, to, 10 do
		i += 1
		Shapes.arch(parent, span, 3, 3, at(track, d, 0, 0), { color = if i % 2 == 0 then c3(theme.accent) else c3(theme.wall), material = Enum.Material.Neon }, 14)
	end
end

function Landmarks.tunnel(track: Track.Built, style: string, from: number, to: number, theme: any, parent: Instance)
	local builder = tunnelBuilders[style]
	if builder then
		builder(track, from * track.length, to * track.length, theme, parent)
	end
end

---------------------------------------------------------------------------
-- Set pieces (placed by Scenery.setPieceSpots)
---------------------------------------------------------------------------
local pieces: { [string]: (CFrame, any, Instance) -> () } = {}

pieces.toaster = function(cf, _theme, parent)
	local body = rgb(220, 70, 60)
	Shapes.roundedBox(parent, Vector3.new(70, 50, 44), 12, cf * CFrame.new(0, 25, 0), { color = body, collide = true, reflectance = 0.1 })
	for _, x in { -14, 14 } do
		Shapes.roundedBox(parent, Vector3.new(14, 2, 34), 4, cf * CFrame.new(x, 50.5, 0), { color = rgb(40, 40, 45) })
		-- Toast popping out.
		Shapes.roundedBox(parent, Vector3.new(12, 22, 30), 5, cf * CFrame.new(x, 58, 0), { color = rgb(225, 170, 90) })
		Shapes.box(parent, Vector3.new(12.2, 18, 26), cf * CFrame.new(x, 58, 0), { color = rgb(245, 215, 150) })
	end
	Shapes.box(parent, Vector3.new(4, 4, 10), cf * CFrame.new(37, 30, 0), { color = rgb(40, 40, 45) })
	Shapes.ball(parent, 6, cf * CFrame.new(37, 22, -8), { color = rgb(240, 240, 240) })
end

pieces.cerealBowl = function(cf, _theme, parent)
	Shapes.pillar(parent, 50, 18, cf * CFrame.new(0, 9, 0), { color = rgb(255, 255, 255), collide = true })
	Shapes.pillar(parent, 56, 4, cf * CFrame.new(0, 19, 0), { color = rgb(90, 150, 230), collide = true })
	Shapes.pillar(parent, 48, 1, cf * CFrame.new(0, 19.6, 0), { color = rgb(250, 248, 240) })
	local colors = { rgb(255, 120, 60), rgb(255, 210, 70), rgb(140, 200, 80), rgb(200, 100, 200) }
	for i = 1, 22 do
		local a = i * 2.4
		local r = (i % 6) * 3.5
		Shapes.tube(parent, 5, 2, cf * CFrame.new(math.cos(a) * r, 21, math.sin(a) * r) * CFrame.Angles(0, a, math.rad(90)), { color = colors[i % 4 + 1] })
	end
end

pieces.mug = function(cf, _theme, parent)
	Shapes.pillar(parent, 30, 40, cf * CFrame.new(0, 20, 0), { color = rgb(255, 230, 90), collide = true })
	Shapes.pillar(parent, 26, 1, cf * CFrame.new(0, 39, 0), { color = rgb(110, 70, 40) })
	Shapes.arch(parent, 18, 4, 4, cf * CFrame.new(15, 20, 0) * CFrame.Angles(0, 0, math.rad(-90)), { color = rgb(255, 230, 90) }, 10)
end

pieces.fruitBowl = function(cf, _theme, parent)
	Shapes.ellipsoid(parent, Vector3.new(60, 22, 60), cf * CFrame.new(0, 8, 0), { color = rgb(170, 220, 255), material = Enum.Material.Glass, transparency = 0.3, collide = true })
	local fruit = { rgb(230, 50, 50), rgb(255, 160, 40), rgb(250, 220, 60), rgb(120, 200, 60) }
	for i = 1, 9 do
		local a = i * 2.1
		Shapes.ball(parent, 14, cf * CFrame.new(math.cos(a) * 12, 20 + (i % 3) * 5, math.sin(a) * 12), { color = fruit[i % 4 + 1] })
	end
end

pieces.trainSet = function(cf, _theme, parent)
	-- An oval of toy track with sleepers.
	for i = 0, 47 do
		local a = i / 48 * math.pi * 2
		local p = Vector3.new(math.cos(a) * 60, 0.6, math.sin(a) * 36)
		local tangent = Vector3.new(-math.sin(a) * 60, 0, math.cos(a) * 36).Unit
		local seg = CFrame.lookAt(p, p + tangent)
		Shapes.box(parent, Vector3.new(12, 1.2, 3), cf * seg, { color = rgb(160, 110, 70) })
		for _, side in { -1, 1 } do
			Shapes.box(parent, Vector3.new(1, 1.6, 9), cf * seg * CFrame.new(side * 4, 0.6, 0), { color = rgb(200, 200, 210) })
		end
	end
	-- A little station.
	Shapes.roundedBox(parent, Vector3.new(24, 16, 16), 3, cf * CFrame.new(0, 8, 0), { color = rgb(240, 90, 90), collide = true })
	Shapes.box(parent, Vector3.new(28, 3, 20), cf * CFrame.new(0, 17, 0), { color = rgb(80, 120, 220) })
end

pieces.nightLamp = function(cf, _theme, parent)
	Shapes.pillar(parent, 40, 6, cf * CFrame.new(0, 3, 0), { color = rgb(240, 240, 250), collide = true })
	Shapes.pillar(parent, 6, 70, cf * CFrame.new(0, 40, 0), { color = rgb(240, 240, 250), collide = true })
	local shade = Shapes.ellipsoid(parent, Vector3.new(56, 40, 56), cf * CFrame.new(0, 86, 0), { color = rgb(255, 220, 140), material = Enum.Material.Neon, transparency = 0.15 })
	local light = Instance.new("PointLight")
	light.Range = 120
	light.Brightness = 2.2
	light.Color = rgb(255, 210, 140)
	light.Shadows = true
	light.Parent = shade
end

pieces.toyChest = function(cf, _theme, parent)
	Shapes.roundedBox(parent, Vector3.new(80, 40, 50), 8, cf * CFrame.new(0, 20, 0), { color = rgb(80, 150, 230), collide = true })
	Shapes.ellipsoid(parent, Vector3.new(84, 20, 54), cf * CFrame.new(0, 42, 0), { color = rgb(255, 200, 60), collide = true })
	for i, color in { rgb(255, 90, 90), rgb(110, 220, 120), rgb(255, 255, 255) } do
		Shapes.ball(parent, 12, cf * CFrame.new((i - 2) * 20, 54, 0), { color = color })
	end
end

pieces.bookStack = function(cf, _theme, parent)
	local colors = { rgb(220, 70, 70), rgb(70, 130, 220), rgb(250, 200, 60), rgb(110, 190, 110) }
	for i = 0, 4 do
		Shapes.roundedBox(parent, Vector3.new(70 - i * 4, 9, 50 - i * 3), 3, cf * CFrame.new(i * 1.5, 4.5 + i * 9, 0) * CFrame.Angles(0, math.rad(i * 7), 0), { color = colors[i % 4 + 1], collide = true })
	end
end

pieces.flowerpot = function(cf, _theme, parent)
	Shapes.pillar(parent, 46, 34, cf * CFrame.new(0, 17, 0), { color = rgb(210, 110, 70), collide = true })
	Shapes.pillar(parent, 52, 6, cf * CFrame.new(0, 34, 0), { color = rgb(220, 120, 80), collide = true })
	Shapes.pillar(parent, 44, 1, cf * CFrame.new(0, 37, 0), { color = rgb(100, 70, 45) })
	Shapes.pillar(parent, 3, 50, cf * CFrame.new(0, 60, 0), { color = rgb(80, 160, 70) })
	for i = 0, 5 do
		local a = i / 6 * math.pi * 2
		Shapes.ellipsoid(parent, Vector3.new(16, 6, 9), cf * CFrame.new(math.cos(a) * 9, 86, math.sin(a) * 9) * CFrame.Angles(0, -a, 0), { color = rgb(255, 120, 170) })
	end
	Shapes.ball(parent, 10, cf * CFrame.new(0, 87, 0), { color = rgb(255, 220, 60) })
end

-- Sprinklers spray when their slippery zone is on (TrackAnimator toggles the water).
pieces.sprinkler = function(cf, _theme, parent)
	Shapes.pillar(parent, 10, 4, cf * CFrame.new(0, 2, 0), { color = rgb(70, 70, 80), collide = true })
	Shapes.pillar(parent, 3, 10, cf * CFrame.new(0, 9, 0), { color = rgb(200, 200, 210) })
	local head = Shapes.ellipsoid(parent, Vector3.new(6, 3, 6), cf * CFrame.new(0, 15, 0), { color = rgb(255, 210, 60) })
	head.Name = "SprinklerHead"
	local water = Instance.new("ParticleEmitter")
	water.Name = "Water"
	water.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	water.Color = ColorSequence.new(rgb(170, 220, 255))
	water.Size = NumberSequence.new(0.8, 0.3)
	water.Transparency = NumberSequence.new(0.2, 1)
	water.Lifetime = NumberRange.new(1.2, 1.6)
	water.Speed = NumberRange.new(45, 60)
	water.SpreadAngle = Vector2.new(25, 60)
	water.Acceleration = Vector3.new(0, -60, 0)
	water.Rate = 160
	water.Enabled = false
	water.Parent = head
end

pieces.log = function(_cf, _theme, _parent)
	-- The hollow log shortcut is built with the shortcut itself (see TrackBuilder).
end

pieces.wateringCan = function(cf, _theme, parent)
	Shapes.ellipsoid(parent, Vector3.new(50, 44, 40), cf * CFrame.new(0, 22, 0), { color = rgb(90, 180, 220), collide = true })
	Shapes.tube(parent, 6, 46, cf * CFrame.new(-34, 34, 0) * CFrame.Angles(0, 0, math.rad(35)), { color = rgb(90, 180, 220) })
	Shapes.pillar(parent, 10, 3, cf * CFrame.new(-52, 46, 0), { color = rgb(70, 150, 190) })
	Shapes.arch(parent, 30, 4, 4, cf * CFrame.new(10, 44, 0), { color = rgb(70, 150, 190) }, 10)
end

function Landmarks.setPiece(kind: string, cf: CFrame, theme: any, parent: Instance)
	local builder = pieces[kind]
	if builder then
		builder(cf, theme, parent)
	end
end

---------------------------------------------------------------------------
-- Crossers (moved by client/TrackAnimator; hits are checked by the server)
---------------------------------------------------------------------------
local crossers: { [string]: (Model) -> () } = {}

crossers.robot = function(m)
	local base = CFrame.new()
	local metal = rgb(180, 190, 210)
	Shapes.roundedBox(m, Vector3.new(9, 9, 7), 2, base * CFrame.new(0, 9, 0), { color = metal, anchored = true })
	Shapes.roundedBox(m, Vector3.new(7, 6, 6), 2, base * CFrame.new(0, 17, 0), { color = metal, anchored = true })
	for _, x in { -1.6, 1.6 } do
		Shapes.ball(m, 2.2, base * CFrame.new(x, 17.5, -3), { color = rgb(80, 220, 255), material = Enum.Material.Neon, anchored = true })
		Shapes.pillar(m, 2.4, 5, base * CFrame.new(x * 1.4, 2.5, 0), { color = rgb(120, 130, 150), anchored = true })
	end
	Shapes.pillar(m, 0.5, 4, base * CFrame.new(0, 22, 0), { color = rgb(120, 130, 150), anchored = true })
	Shapes.ball(m, 1.6, base * CFrame.new(0, 24.5, 0), { color = rgb(255, 80, 80), material = Enum.Material.Neon, anchored = true })
	for _, x in { -6, 6 } do
		Shapes.capsule(m, 2.4, 8, base * CFrame.new(x, 10, 0), { color = metal, anchored = true })
	end
end

crossers.train = function(m)
	local colors = { rgb(230, 60, 60), rgb(70, 130, 230), rgb(250, 200, 60) }
	for i = 0, 2 do
		local cf = CFrame.new(0, 0, (i - 1) * 13)
		Shapes.roundedBox(m, Vector3.new(9, 9, 11), 2, cf * CFrame.new(0, 6, 0), { color = colors[i + 1], anchored = true })
		for _, x in { -4.7, 4.7 } do
			for _, z in { -3.5, 3.5 } do
				Shapes.tube(m, 3.6, 1, cf * CFrame.new(x, 2, z), { color = rgb(40, 40, 45), anchored = true })
			end
		end
	end
	Shapes.pillar(m, 3, 5, CFrame.new(0, 12.5, -16), { color = rgb(40, 40, 45), anchored = true })
end

crossers.beetle = function(m)
	local shell = rgb(220, 40, 40)
	Shapes.ellipsoid(m, Vector3.new(12, 7, 15), CFrame.new(0, 5, 0), { color = shell, anchored = true, reflectance = 0.15 })
	Shapes.ellipsoid(m, Vector3.new(7, 5, 5), CFrame.new(0, 4, -8), { color = rgb(30, 30, 35), anchored = true })
	for _, x in { -2, 2 } do
		Shapes.ball(m, 1.6, CFrame.new(x, 5, -10), { color = rgb(255, 255, 255), anchored = true })
	end
	for i = 0, 5 do
		local a = i / 6 * math.pi * 2
		Shapes.ball(m, 2.2, CFrame.new(math.cos(a) * 3.5, 8.4, math.sin(a) * 4.5), { color = rgb(30, 30, 35), anchored = true })
	end
	for _, side in { -1, 1 } do
		for k = -1, 1 do
			Shapes.box(m, Vector3.new(6, 0.6, 0.6), CFrame.new(side * 7, 2, k * 4) * CFrame.Angles(0, 0, side * 0.5), { color = rgb(30, 30, 35), anchored = true })
		end
	end
end

function Landmarks.crosser(kind: string, index: number, parent: Instance, start: CFrame): Model
	local m = Instance.new("Model")
	m.Name = `Crosser{index}`
	local builder = crossers[kind]
	if builder then
		builder(m)
	end
	-- Pivot at the model's base so the animator can place it on the road.
	local origin = Instance.new("Part")
	origin.Name = "Origin"
	origin.Anchored = true
	origin.CanCollide = false
	origin.CanQuery = false
	origin.CanTouch = false
	origin.Transparency = 1
	origin.Size = Vector3.one
	origin.CFrame = CFrame.new()
	origin.Parent = m
	m.PrimaryPart = origin
	-- Built around the origin; move every part to the starting spot.
	for _, d in m:GetDescendants() do
		if d:IsA("BasePart") then
			d.CFrame = start * d.CFrame
		end
	end
	m:SetAttribute("CrosserIndex", index)
	m.Parent = parent
	return m
end

---------------------------------------------------------------------------
-- Room walls for indoor tracks (the bedroom, the kitchen)
---------------------------------------------------------------------------
function Landmarks.room(theme: any, minX: number, maxX: number, minZ: number, maxZ: number, floorY: number, parent: Instance)
	local room = theme.room
	if not room then
		return
	end
	local margin = 280
	local x0, x1, z0, z1 = minX - margin, maxX + margin, minZ - margin, maxZ + margin
	local h = room.height
	local wallColor, trim = c3(room.wall), c3(room.trim)
	local function wall(cx: number, cz: number, w: number, d: number)
		Shapes.box(parent, Vector3.new(w, h, d), CFrame.new(cx, floorY + h / 2, cz), { color = wallColor, collide = true })
		Shapes.box(parent, Vector3.new(w + 1, 14, d + 1), CFrame.new(cx, floorY + 7, cz), { color = trim })
	end
	wall((x0 + x1) / 2, z0, x1 - x0, 6)
	wall((x0 + x1) / 2, z1, x1 - x0, 6)
	wall(x0, (z0 + z1) / 2, 6, z1 - z0)
	wall(x1, (z0 + z1) / 2, 6, z1 - z0)

	-- A window in the far wall (moonlit for the bedroom, sunny for the kitchen).
	local night = theme.clock < 6 or theme.clock > 19
	local winCf = CFrame.new((x0 + x1) / 2, floorY + h * 0.55, z0 + 4)
	Shapes.roundedBox(parent, Vector3.new(180, 140, 2), 10, winCf, { color = trim })
	Shapes.box(parent, Vector3.new(164, 124, 2.2), winCf, { color = if night then rgb(30, 40, 90) else rgb(170, 220, 255), material = Enum.Material.Neon, transparency = if night then 0 else 0.3 })
	Shapes.box(parent, Vector3.new(6, 124, 2.4), winCf, { color = trim })
	Shapes.box(parent, Vector3.new(164, 6, 2.4), winCf, { color = trim })
	if night then
		Shapes.disc(parent, 34, 2.5, winCf * CFrame.new(40, 30, 0) * CFrame.Angles(math.rad(90), 0, 0), { color = rgb(255, 250, 220), material = Enum.Material.Neon })
		for i = 1, 14 do
			Shapes.ball(parent, 2.2, winCf * CFrame.new(-70 + (i * 37) % 140, -50 + (i * 23) % 100, 0.5), { color = rgb(255, 255, 230), material = Enum.Material.Neon })
		end
	end
	-- A big door on a side wall.
	local doorCf = CFrame.new(x1 - 4, floorY + 110, (z0 + z1) / 2) * CFrame.Angles(0, math.rad(90), 0)
	Shapes.roundedBox(parent, Vector3.new(120, 220, 3), 6, doorCf, { color = trim })
	Shapes.ball(parent, 10, doorCf * CFrame.new(42, -10, -3), { color = rgb(255, 210, 60), reflectance = 0.3 })
end

return Landmarks
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="30">
        <Properties>
          <string name="Name">LobbyBuilder</string>
          <string name="Source"><![CDATA[-- Compact indoor Kart HQ: soft lighting, four voting pads, garage,
-- trophy room and party bays. No practice hall or viewing lounge.
-- Clients draw the wall screens and animate proximity doors.
--
-- Realistic finish: concrete walls, a dark marble floor, brushed-metal
-- trim, fabric banners and glowing light fixtures (see `finish`), and a
-- panoramic window behind spawn looking out over a real terrain lake, pine
-- trees and snowy mountains (see `buildVista`).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Karts = require(Shared.Karts)
local LobbyLayout = require(Shared.LobbyLayout)
local KartRig = require(ReplicatedStorage.Common.KartRig)
local Shapes = require(ReplicatedStorage.Common.Shapes)
local Tracks = require(Shared.Tracks)

local Props = require(script.Parent.Props)
local TerrainBuilder = require(script.Parent.TerrainBuilder)


local LobbyBuilder = {}

-- Optional looping ambience (a soft machinery hum). Upload a sound to Roblox
-- and paste its id here, e.g. "rbxassetid://123456". Empty = silent.
LobbyBuilder.AmbientSoundId = ""

local C = {
	wall = Color3.fromRGB(68, 75, 86),
	wallLight = Color3.fromRGB(90, 99, 112),
	panel = Color3.fromRGB(28, 38, 72),
	floor = Color3.fromRGB(58, 63, 72),
	floorLine = Color3.fromRGB(44, 64, 110),
	navy = Color3.fromRGB(16, 22, 44),
	cyan = Color3.fromRGB(110, 165, 180),
	cyanSoft = Color3.fromRGB(155, 185, 195),
	white = Color3.fromRGB(240, 246, 255),
	lamp = Color3.fromRGB(190, 215, 245),
	steel = Color3.fromRGB(170, 185, 210),
	gold = Color3.fromRGB(255, 200, 60),
	silver = Color3.fromRGB(205, 215, 230),
	bronze = Color3.fromRGB(225, 145, 80),
	pink = Color3.fromRGB(255, 90, 170),
	screen = Color3.fromRGB(8, 12, 26),
	glass = Color3.fromRGB(150, 220, 255),
}
local NEON = Enum.Material.SmoothPlastic
local GLASS = Enum.Material.Glass

local O = LobbyLayout.Origin
local HW, HD = LobbyLayout.HalfWidth, LobbyLayout.HalfDepth
local HEIGHT, DECK = LobbyLayout.Height, LobbyLayout.DeckHeight
local WALL = 4 -- chamber wall thickness

local finish: (Instance) -> ()
local buildVista: () -> ()

local function rgb(t: { number }): Color3
	return Color3.fromRGB(t[1], t[2], t[3])
end

-- World position from chamber-relative x/z.
local function W(x: number, y: number, z: number): Vector3
	return Vector3.new(O.x + x, y, O.z + z)
end

local function at(spot: LobbyLayout.Spot, y: number?): CFrame
	return CFrame.new(spot.x, (y or 0) + spot.y, spot.z)
end

-- A CFrame at `pos` whose front face (-Z) looks along `dir`.
local function facing(pos: Vector3, dir: Vector3): CFrame
	return CFrame.lookAt(pos, pos + dir)
end

local function light(parent: BasePart, kind: string, range: number, brightness: number, color: Color3)
	local l = Instance.new(kind) :: any
	l.Range = range
	l.Brightness = brightness
	l.Color = color
	l.Shadows = false
	l.Parent = parent
	return l
end

-- Text on the front face of a part.
local function text(part: BasePart, value: string, color: Color3, pixelsPerStud: number?): TextLabel
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = pixelsPerStud or 20
	gui.LightInfluence = 0
	gui.Parent = part
	local l = Instance.new("TextLabel")
	l.Size = UDim2.fromScale(1, 1)
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.FredokaOne
	l.TextScaled = true
	l.TextWrapped = true
	l.TextColor3 = color
	l.TextStrokeTransparency = 0.5
	l.Text = value
	l.Parent = gui
	return l
end

local function prompt(parent: BasePart, action: string, object: string): ProximityPrompt
	local p = Instance.new("ProximityPrompt")
	p.ActionText = action
	p.ObjectText = object
	p.KeyboardKeyCode = Enum.KeyCode.E
	p.MaxActivationDistance = 14
	p.RequiresLineOfSight = false
	p.HoldDuration = 0.15
	p.Parent = parent
	return p
end

-- A disc with a glowing rim: a neon disc with a slightly smaller one on top.
local function rimDisc(parent: Instance, diameter: number, top: number, cf: CFrame, color: Color3, rim: Color3, rimWidth: number?)
	local w = rimWidth or 1
	Shapes.disc(parent, diameter, 0.4, cf * CFrame.new(0, top - 0.25, 0), { color = rim, material = NEON, collide = true })
	return Shapes.disc(parent, diameter - w * 2, 0.4, cf * CFrame.new(0, top - 0.2, 0), { color = color, collide = true })
end

---------------------------------------------------------------------------
-- Architecture pieces
---------------------------------------------------------------------------

-- A straight wall from floor point `a` to `b`, with rectangular openings.
-- Each opening is { at = distance from a, width, bottom, top }.
type Opening = { at: number, width: number, bottom: number, top: number }
local function wall(parent: Instance, a: Vector3, b: Vector3, height: number, thickness: number, openings: { Opening }, color: Color3?)
	local along = Vector3.new(b.X - a.X, 0, b.Z - a.Z)
	local length = along.Magnitude
	local u = along.Unit
	local style = { color = color or C.wall, collide = true }
	local function block(d0: number, d1: number, y0: number, y1: number)
		if d1 - d0 < 0.05 or y1 - y0 < 0.05 then
			return
		end
		local center = a + u * ((d0 + d1) / 2) + Vector3.new(0, (y0 + y1) / 2, 0)
		Shapes.box(parent, Vector3.new(thickness, y1 - y0, d1 - d0), facing(center, u), style)
	end
	table.sort(openings, function(x, y)
		return x.at < y.at
	end)
	local cursor = 0
	for _, o in openings do
		local s, e = o.at - o.width / 2, o.at + o.width / 2
		block(cursor, s, 0, height)
		block(s, e, o.top, height)
		block(s, e, 0, o.bottom)
		cursor = e
	end
	block(cursor, length, 0, height)
end

-- A beveled wall panel on a wall, facing out along cf's look direction.
local function wallPanel(parent: Instance, cf: CFrame, w: number, h: number, color: Color3?)
	Shapes.box(parent, Vector3.new(w, h, 0.6), cf, { color = color or C.panel })
	Shapes.box(parent, Vector3.new(w - 2.4, h - 2.4, 0.6), cf * CFrame.new(0, 0, -0.5), { color = C.wallLight })
	-- 45° chamfers along each edge catch the light like a bevel.
	for _, sy in { -1, 1 } do
		Shapes.box(parent, Vector3.new(w - 1.2, 0.9, 0.9), cf * CFrame.new(0, sy * (h / 2 - 1.1), -0.35) * CFrame.Angles(math.rad(45), 0, 0), { color = C.panel })
	end
	for _, sx in { -1, 1 } do
		Shapes.box(parent, Vector3.new(0.9, h - 1.2, 0.9), cf * CFrame.new(sx * (w / 2 - 1.1), 0, -0.35) * CFrame.Angles(0, math.rad(45), 0), { color = C.panel })
	end
end

-- A rail between two floor points: posts, a steel top tube, a cyan glow tube
-- under it and a glass panel. Works on slopes (stairs and ramps) too.
local RAIL_HEIGHT = 3.6
local function railing(parent: Instance, a: Vector3, b: Vector3, posts: boolean?)
	local length = (b - a).Magnitude
	if length < 0.1 then
		return
	end
	local up = Vector3.new(0, RAIL_HEIGHT, 0)
	local mid = (a + b) / 2
	local along = CFrame.lookAt(mid, b) * CFrame.Angles(0, math.rad(90), 0) -- local x runs a → b
	Shapes.tube(parent, 0.7, length + 0.6, along + up, { color = C.steel, collide = true })
	Shapes.tube(parent, 0.35, length, along + up * 0.82, { color = C.cyan, material = NEON })
	Shapes.box(parent, Vector3.new(length, RAIL_HEIGHT * 0.7, 0.2), along + up * 0.45, { color = C.glass, material = GLASS, transparency = 0.6, collide = true })
	if posts ~= false then
		local n = math.max(1, math.floor(length / 8 + 0.5))
		for i = 0, n do
			local p = a:Lerp(b, i / n)
			Shapes.pillar(parent, 0.7, RAIL_HEIGHT, CFrame.new(p + up / 2), { color = C.steel })
		end
	end
end

local function railPath(parent: Instance, points: { Vector3 })
	for i = 1, #points - 1 do
		railing(parent, points[i], points[i + 1], i == 1 or i == #points - 1 or (points[i + 1] - points[i]).Magnitude > 4)
	end
end

-- Quarter-circle corner points (for rounded railing ends).
local function arc(center: Vector3, radius: number, from: number, to: number, steps: number): { Vector3 }
	local out = {}
	for i = 0, steps do
		local a = from + (to - from) * i / steps
		table.insert(out, center + Vector3.new(math.cos(a) * radius, 0, math.sin(a) * radius))
	end
	return out
end

-- A rounded column with glowing rings and a lit panel facing `face`.
local function column(parent: Instance, base: Vector3, height: number, face: Vector3)
	Shapes.pillar(parent, 11, 2, CFrame.new(base + Vector3.new(0, 1, 0)), { color = C.wallLight, collide = true })
	Shapes.pillar(parent, 8, height, CFrame.new(base + Vector3.new(0, height / 2, 0)), { color = C.panel, collide = true })
	Shapes.pillar(parent, 11, 2.4, CFrame.new(base + Vector3.new(0, height - 1.2, 0)), { color = C.wallLight })
	for _, y in { 8, 40, 76 } do
		if y < height - 4 then
			Shapes.pillar(parent, 8.6, 0.8, CFrame.new(base + Vector3.new(0, y, 0)), { color = C.cyan, material = NEON })
		end
	end
	-- Illuminated panel strip on the side facing the room.
	local stripHeight = math.min(28, height - 20)
	local stripCf = facing(base + face.Unit * 4.05 + Vector3.new(0, 10 + stripHeight / 2, 0), face)
	Shapes.box(parent, Vector3.new(2.2, stripHeight, 0.3), stripCf, { color = C.cyanSoft, material = NEON })
	Shapes.box(parent, Vector3.new(3.4, stripHeight + 1.2, 0.2), stripCf * CFrame.new(0, 0, 0.15), { color = C.navy })
end

-- A hanging checkered racing banner with the HQ name.
local function banner(parent: Instance, top: Vector3, face: Vector3, accent: Color3)
	local cf = facing(top, face)
	Shapes.tube(parent, 0.6, 12, cf * CFrame.new(0, 0.3, 0), { color = C.steel })
	local cloth = Shapes.box(parent, Vector3.new(10, 26, 0.3), cf * CFrame.new(0, -13.3, 0), { color = C.navy })
	Shapes.box(parent, Vector3.new(10, 1.2, 0.35), cf * CFrame.new(0, -1.2, 0), { color = accent, material = NEON })
	for i = 0, 9 do
		local col, row = i % 5, math.floor(i / 5)
		Shapes.box(parent, Vector3.new(2, 2, 0.35), cf * CFrame.new(-4 + col * 2, -23.3 - row * 2, 0), { color = if (col + row) % 2 == 0 then C.white else C.navy })
	end
	Shapes.box(parent, Vector3.new(10, 0.6, 0.35), cf * CFrame.new(0, -21.8, 0), { color = accent, material = NEON })
	text(cloth, "KART\nHQ", C.white, 12)
end

-- Two-panel sliding door. Parts with a "Side" attribute slide apart on
-- clients (client/LobbyScreens); parts named "Glow" light up.
local function slidingDoor(parent: Instance, name: string, cf: CFrame, w: number, h: number, accent: Color3): Model
	local door = Instance.new("Model")
	door.Name = name
	door:SetAttribute("SlidingDoor", true)
	door:SetAttribute("Width", w)
	for _, side in { -1, 1 } do
		local panelCf = cf * CFrame.new(side * w / 4, h / 2, 0)
		local panel = Shapes.box(door, Vector3.new(w / 2, h, 0.8), panelCf, { color = C.wallLight, collide = true, name = `Panel{if side < 0 then 1 else 2}` })
		panel:SetAttribute("Side", side)
		local window = Shapes.box(door, Vector3.new(w / 2 - 3, h * 0.35, 0.9), panelCf * CFrame.new(0, h * 0.12, 0), { color = C.glass, material = GLASS, transparency = 0.45, name = "Window" })
		window:SetAttribute("Side", side)
		local stripe = Shapes.box(door, Vector3.new(w / 2 - 1, 0.5, 1), panelCf * CFrame.new(0, -h * 0.18, 0), { color = accent, material = NEON, name = "Glow" })
		stripe:SetAttribute("Side", side)
		local edge = Shapes.box(door, Vector3.new(0.4, h - 1, 1), panelCf * CFrame.new(-side * (w / 4 - 0.3), 0, 0), { color = accent, material = NEON, name = "Glow" })
		edge:SetAttribute("Side", side)
	end
	-- Frame: posts, header and a glowing outline.
	for _, side in { -1, 1 } do
		Shapes.box(door, Vector3.new(1.6, h + 1.6, 1.6), cf * CFrame.new(side * (w / 2 + 0.8), (h + 1.6) / 2, 0), { color = C.steel, collide = true })
		Shapes.box(door, Vector3.new(0.4, h + 1, 0.4), cf * CFrame.new(side * (w / 2 + 0.2), h / 2, -1.1), { color = accent, material = NEON, name = "Glow" })
	end
	Shapes.box(door, Vector3.new(w + 3.2, 1.6, 1.6), cf * CFrame.new(0, h + 0.8, 0), { color = C.steel, collide = true })
	Shapes.box(door, Vector3.new(w + 0.4, 0.4, 0.4), cf * CFrame.new(0, h + 0.2, -1.1), { color = accent, material = NEON, name = "Glow" })
	door.Parent = parent
	return door
end

-- Floor, ceiling, light and walls around a side room. The wall shared with
-- the chamber already exists, apart from any stretch beyond the chamber.
local function roomShell(parent: Instance, room: LobbyLayout.Room, height: number, lights: number)
	local b = room.box
	local x0, x1, z0, z1 = b.min.x, b.max.x, b.min.z, b.max.z
	local cx, cz = (x0 + x1) / 2, (z0 + z1) / 2
	local folder = Instance.new("Folder")
	folder.Name = room.id
	folder.Parent = parent
	Shapes.box(folder, Vector3.new(x1 - x0 + 4, 1, z1 - z0 + 4), CFrame.new(cx, -0.5, cz), { color = C.floor, collide = true, name = "Floor" })
	-- Spans stop inside the chamber wall on the near side, so nothing pokes in.
	local e0 = if room.side < 0 then x0 - 2 else x0 + 2
	local e1 = if room.side < 0 then x1 - 2 else x1 + 2
	Shapes.box(folder, Vector3.new(e1 - e0, 2, z1 - z0 + 4), CFrame.new((e0 + e1) / 2, height + 1, cz), { color = C.wall, collide = true })
	-- Walls: far side, both ends, and the chamber side outside the chamber.
	local farX = if room.side < 0 then x0 else x1
	local nearX = if room.side < 0 then x1 else x0
	wall(folder, Vector3.new(farX + room.side, 0, z0 - 2), Vector3.new(farX + room.side, 0, z1 + 2), height, 2, {})
	wall(folder, Vector3.new(e0, 0, z0 - 1), Vector3.new(e1, 0, z0 - 1), height, 2, {})
	wall(folder, Vector3.new(e0, 0, z1 + 1), Vector3.new(e1, 0, z1 + 1), height, 2, {})
	local chamberZ0, chamberZ1 = O.z - HD - WALL, O.z + HD + WALL
	if z0 < chamberZ0 then
		wall(folder, Vector3.new(nearX - room.side, 0, z0), Vector3.new(nearX - room.side, 0, chamberZ0), height, 2, {})
	end
	if z1 > chamberZ1 then
		wall(folder, Vector3.new(nearX - room.side, 0, chamberZ1), Vector3.new(nearX - room.side, 0, z1), height, 2, {})
	end
	-- Glowing skirting and recessed ceiling lights.
	for _, z in { z0 + 0.1, z1 - 0.1 } do
		Shapes.box(folder, Vector3.new(x1 - x0, 0.4, 0.2), CFrame.new(cx, 1, z), { color = C.cyan, material = NEON })
	end
	for i = 1, lights do
		local lx = x0 + (x1 - x0) * (i - 0.5) / lights
		local lamp = Shapes.box(folder, Vector3.new(math.min(24, (x1 - x0) / lights - 6), 0.4, math.min(24, z1 - z0 - 10)), CFrame.new(lx, height - 0.2, cz), { color = C.lamp, material = NEON })
		local holder = Shapes.box(folder, Vector3.new(1, 1, 1), CFrame.new(lx, height - 6, cz), { color = C.white, transparency = 1 })
		local _ = lamp
		light(holder, "PointLight", 60, 1.1, Color3.fromRGB(235, 242, 255))
	end
	return folder
end

---------------------------------------------------------------------------
-- Realistic finish and the view outside
---------------------------------------------------------------------------

-- Each palette colour gets a real material. Screens, glass and anything
-- already given a material keep theirs.
local FINISHES = {
	{ C.wall, Enum.Material.Concrete, 0 },
	{ C.wallLight, Enum.Material.Concrete, 0 },
	{ C.floor, Enum.Material.Marble, 0.04 },
	{ C.panel, Enum.Material.Metal, 0.05 },
	{ C.navy, Enum.Material.Fabric, 0 },
	{ C.steel, Enum.Material.Metal, 0.12 },
	{ C.gold, Enum.Material.Metal, 0.25 },
	{ C.silver, Enum.Material.Metal, 0.25 },
	{ C.bronze, Enum.Material.Metal, 0.2 },
	{ C.pink, Enum.Material.Fabric, 0 },
	{ C.lamp, Enum.Material.Neon, 0 }, -- light fixtures glow
}
finish = function(root: Instance)
	for _, p in root:GetDescendants() do
		if p:IsA("BasePart") and p.Material == Enum.Material.SmoothPlastic then
			for _, f in FINISHES do
				if p.Color == f[1] then
					p.Material = f[2]
					p.Reflectance = f[3]
					break
				end
			end
		end
	end
end

-- The landscape seen through the back window: a lake right outside, pine
-- trees round its shore, grassy hills and a ring of snowy peaks. Built in
-- Terrain next to the lobby, and rebuilt whenever a track's land replaces it.
buildVista = function()
	local lakeZ = O.z + HD + 240
	local vista = {
		spec = { ground = "Grass", bank = "Grass" },
		groundTop = -8, -- well under the lobby floors
		minX = O.x - 1000,
		maxX = O.x + 1000,
		minZ = O.z - 260,
		maxZ = O.z + HD + 1500,
		banks = {},
		bankAt = {},
		hills = {},
		mountains = {},
		caps = {},
		mesas = {},
		lakes = { { x = O.x, z = lakeZ, r = 150, surface = -9.4, shore = "Sand", liquid = "Water", bridged = false } },
	}
	for i, h in { { -330, 170, 110 }, { 340, 210, 130 }, { -520, 420, 150 }, { 500, 470, 140 }, { -160, 560, 120 }, { 220, 600, 130 } } do
		vista.hills[i] = { x = O.x + h[1], y = -8 - h[3] * 0.62, z = O.z + HD + h[2], r = h[3], material = "LeafyGrass" }
	end
	for _, m in { { -620, 900, 300 }, { -200, 1050, 360 }, { 260, 980, 330 }, { 680, 880, 290 }, { 20, 1250, 380 } } do
		local x, z, r = O.x + m[1], O.z + HD + m[2], m[3]
		table.insert(vista.mountains, { x = x, y = -8 - r * 0.35, z = z, r = r, material = "Rock" })
		table.insert(vista.mountains, { x = x + r * 0.7, y = -8 - r * 0.25, z = z + r * 0.2, r = r * 0.55, material = "Rock" })
		table.insert(vista.mountains, { x = x, y = -8 + r * 0.37, z = z, r = r * 0.45, material = "Rock" })
		table.insert(vista.caps, { x = x, y = -8 + r * 0.63, z = z, r = r * 0.3, material = "Snow" })
	end
	TerrainBuilder.apply(vista, true)

	-- Pines round the lake (parts, rebuilt with the land).
	local old = Workspace:FindFirstChild("LobbyVista")
	if old then
		old:Destroy()
	end
	local trees = Instance.new("Folder")
	trees.Name = "LobbyVista"
	local theme = Tracks.Themes.alpine
	for i = 0, 41 do
		local a = i / 42 * math.pi * 2
		local r = 180 + (i * 37 % 60)
		local x, z = O.x + math.cos(a) * r, lakeZ + math.sin(a) * r
		if z > O.z + HD + 30 then
			Props.build({ kind = "pine", x = x, y = -8, z = z, size = 1.1 + (i % 5) * 0.12, yaw = a }, theme, trees)
		end
	end
	trees.Parent = Workspace
end

---------------------------------------------------------------------------
-- Build
---------------------------------------------------------------------------
export type Handles = {
 setPodium: (rows: { any }) -> (), setKartDisplay: (slot: number, name: string?, kartId: string?, look: any?) -> (),
 setDeparture: (lit: boolean) -> (), celebrate: (place: number, character: Model) -> (),
 garagePrompt: ProximityPrompt, collectibles: { BasePart },
}

function LobbyBuilder.build(): Handles
 local old = Workspace:FindFirstChild("Lobby")
 if old then old:Destroy() end
 local practice = Workspace:FindFirstChild("PracticeTrack")
 if practice then practice:Destroy() end
 local lobby = Instance.new("Folder")
 lobby.Name = "Lobby"
 local shell = Instance.new("Folder")
 shell.Name = "Chamber"
 shell.Parent = lobby
 Shapes.box(shell, Vector3.new(HW * 2 + 8, 2, HD * 2 + 8), CFrame.new(W(0, -1, 0)), { color = C.floor, material = Enum.Material.Slate, collide = true, name = "Floor" })
 Shapes.box(shell, Vector3.new(HW * 2 + 8, 2, HD * 2 + 8), CFrame.new(W(0, HEIGHT + 1, 0)), { color = C.wall, collide = true })
 for _, side in { -1, 1 } do
  local openings = {}
  for _, room in LobbyLayout.Rooms do
   if room.side == side then table.insert(openings, { at = room.door.z - (O.z - HD), width = LobbyLayout.DoorWidth + 2, bottom = 0, top = LobbyLayout.DoorHeight + 1 }) end
  end
  wall(shell, W(side * HW, 0, -HD), W(side * HW, 0, HD), HEIGHT, WALL, openings)
 end
 -- Back wall with a panoramic window over the lake (behind the spawn deck).
 local windowW, windowBottom, windowTop = 96, DECK + 5, 34
 wall(shell, W(-HW, 0, HD), W(HW, 0, HD), HEIGHT, WALL, { { at = HW, width = windowW, bottom = windowBottom, top = windowTop } })
 local windowMid = (windowBottom + windowTop) / 2
 Shapes.box(shell, Vector3.new(windowW, windowTop - windowBottom, 0.3), CFrame.new(W(0, windowMid, HD)), { color = Color3.fromRGB(190, 215, 230), material = GLASS, transparency = 0.82, reflectance = 0.15, collide = true, name = "WindowGlass" })
 for x = -windowW / 2, windowW / 2, windowW / 6 do
  Shapes.box(shell, Vector3.new(1, windowTop - windowBottom, 1.4), CFrame.new(W(x, windowMid, HD)), { color = C.steel, collide = true, name = "Mullion" })
 end
 Shapes.box(shell, Vector3.new(windowW + 2, 1.2, 3), CFrame.new(W(0, windowBottom - 0.6, HD - 1)), { color = C.steel, collide = true, name = "Sill" })
 Shapes.box(shell, Vector3.new(windowW + 2, 1.2, 1.6), CFrame.new(W(0, windowTop + 0.6, HD)), { color = C.steel, name = "WindowHead" })
 wall(shell, W(-HW, 0, -HD), W(HW, 0, -HD), HEIGHT, WALL, {
  { at = HW - 54, width = 18, bottom = 0, top = 15 }, { at = HW + 54, width = 18, bottom = 0, top = 15 },
 })
 -- Recessed white fixtures, matte trims, and restrained local illumination.
 for _, x in { -38, 0, 38 } do
  for _, z in { -40, 35 } do
   Shapes.roundedBox(shell, Vector3.new(18, 0.5, 5), 0.7, CFrame.new(W(x, HEIGHT - 0.3, z)), { color = C.lamp })
   local lamp = Shapes.box(shell, Vector3.new(1, 1, 1), CFrame.new(W(x, HEIGHT - 3, z)), { color = C.white, transparency = 1 })
   light(lamp, "PointLight", 65, 0.7, Color3.fromRGB(255, 242, 222))
  end
 end
 for _, side in { -1, 1 } do
  for _, z in { -60, -5, 42 } do
   Shapes.capsule(shell, 4, HEIGHT, CFrame.new(W(side * (HW - 2), HEIGHT / 2, z)), { color = C.wallLight })
   wallPanel(shell, facing(W(side * (HW - 0.5), 26, z + 14), Vector3.new(-side, 0, 0)), 18, 16)
  end
 end
 local sc = LobbyLayout.Screen
 local screenCf = facing(Vector3.new(sc.center.x, sc.center.y, sc.center.z + 2.6), Vector3.zAxis)
 Shapes.roundedBox(shell, Vector3.new(sc.width + 4, sc.height + 4, 1), 1.3, screenCf * CFrame.new(0, 0, 0.8), { color = C.steel })
 Shapes.box(shell, Vector3.new(sc.width, sc.height, 0.4), screenCf, { color = C.screen, name = "VoteScreen" })
 Shapes.box(shell, Vector3.new(66, 6, 0.4), facing(Vector3.new(0, 39, O.z - 75), Vector3.zAxis), { color = C.screen, name = "StatusBoard" })
 local departure = Instance.new("Folder")
 departure.Name = "Departure"
 departure.Parent = lobby
 for i, spot in LobbyLayout.DepartureDoors do
  local door = slidingDoor(departure, `DepartureDoor{i}`, facing(Vector3.new(spot.x, 0, spot.z), Vector3.zAxis), 16, 14, C.cyan)
  door:SetAttribute("Departure", true)
  door:SetAttribute("Lit", false)
 end
 -- Raised spawn deck, broad stairs and accessible side ramps.
 Shapes.box(shell, Vector3.new(HW * 2, DECK, 30), CFrame.new(W(0, DECK / 2, 63)), { color = C.floor, collide = true })
 for i = 1, 4 do
  Shapes.box(shell, Vector3.new(28, i * 2, 5), CFrame.new(W(0, i, 25.5 + i * 5)), { color = C.wallLight, collide = true })
 end
 for _, ramp in LobbyLayout.Ramps do
  local wedge = Instance.new("WedgePart")
  wedge.Name = "AccessibleRamp"
  wedge.Anchored = true
  wedge.Size = Vector3.new(12, DECK, 48)
  wedge.CFrame = CFrame.new(ramp.from.x, DECK / 2, O.z + 24)
  wedge.Color = C.floor
  wedge.Material = Enum.Material.Slate
  wedge.Parent = shell
 end
 for _, side in { -1, 1 } do
  Shapes.box(shell, Vector3.new(10, 1, 114), CFrame.new(W(side * 63, DECK - 0.5, -9)), { color = C.floor, collide = true })
  railing(shell, W(side * 57, DECK, -66), W(side * 57, DECK, 48))
 end
 local spawn = Instance.new("SpawnLocation")
 spawn.Name = "LobbySpawn"
 spawn.Size = Vector3.new(12, 1, 10)
 spawn.CFrame = at(LobbyLayout.Spawn, 0.5)
 spawn.Anchored = true
 spawn.Neutral = true
 spawn.Transparency = 1
 spawn.Duration = 0
 spawn.Parent = shell
 local logo = Shapes.box(shell, Vector3.new(40, 6, 0.4), facing(W(0, 38.5, HD - 2.5), -Vector3.zAxis), { color = C.navy })
 text(logo, "KART HQ · RACE CLUB", C.white, 14)
 local pedestalCf = CFrame.new(W(0, 0, 7))
 local stepX, stepHeights = { 0, -10, 10 }, { 2.4, 1.6, 0.8 }
 for i = 1, 3 do
  rimDisc(shell, 8, stepHeights[i], pedestalCf * CFrame.new(stepX[i], 0, 0), C.wallLight, C.gold, 0.3)
 end
 for i, spot in LobbyLayout.VotePads do
  rimDisc(shell, 16, 0.25, at(spot), C.wallLight, rgb(LobbyLayout.PadColors[i]), 0.5)
  local sign = Shapes.box(shell, Vector3.new(18, 5, 0.3), facing(Vector3.new(spot.x, 5.5, spot.z - 9), Vector3.zAxis), { color = C.screen, name = `PadSign{i}` })
 end
 local displays = Instance.new("Folder")
 displays.Name = "KartDisplays"
 displays.Parent = lobby
 local displayYaw = { math.pi, math.pi, math.pi, math.pi / 2 }
 for _, spot in LobbyLayout.KartDisplays do rimDisc(shell, 12, 0.5, at(spot), C.navy, C.steel, 0.4) end
 local rooms = Instance.new("Folder")
 rooms.Name = "Rooms"
 rooms.Parent = lobby
 local roomFolders = {}
 for _, room in LobbyLayout.Rooms do
  local folder = roomShell(rooms, room, 24, 1)
  roomFolders[room.id] = folder
  local cf = facing(Vector3.new(room.door.x, 0, room.door.z), Vector3.new(-room.side, 0, 0))
  slidingDoor(folder, `Door_{room.id}`, cf, LobbyLayout.DoorWidth, LobbyLayout.DoorHeight, C.cyan)
  local sign = Shapes.box(folder, Vector3.new(18, 4, 0.4), cf * CFrame.new(0, 17, -2.5), { color = C.navy })
  text(sign, string.upper(room.name), C.white, 14)
 end
 -- Subtle floor inlays, wall pilasters and ceiling beams give the hall structure.
 for _, x in { -26, 26 } do
  Shapes.box(shell, Vector3.new(0.3, 0.04, 90), CFrame.new(W(x, 0.04, -5)), { color = C.steel, name = "FloorInlay" })
 end
 for z = -55, 55, 22 do
  Shapes.roundedBox(shell, Vector3.new(HW * 2 - 5, 2, 3), 0.7, CFrame.new(W(0, HEIGHT - 2, z)), { color = C.wallLight })
 end
 for _, side in { -1, 1 } do
  for _, z in { -58, 15 } do
   Shapes.roundedBox(shell, Vector3.new(4, 3, 4), 0.5, CFrame.new(W(side * 52, 1.5, z)), { color = C.wallLight, collide = true })
   Shapes.ellipsoid(shell, Vector3.new(5, 7, 5), CFrame.new(W(side * 52, 6, z)), { color = Color3.fromRGB(77, 112, 84) })
  end
 end
 local garage = LobbyLayout.roomById("garage")
 local g = roomFolders.garage
 local benchCf = CFrame.new(garage.box.min.x + 22, 0, garage.door.z)
 Shapes.roundedBox(g, Vector3.new(12, 4, 5), 0.6, benchCf * CFrame.new(0, 2, 0), { color = C.wallLight, collide = true })
 local garageSpot = Shapes.box(g, Vector3.one, benchCf * CFrame.new(0, 6, 0), { color = C.white, transparency = 1 })
 local garagePrompt = prompt(garageSpot, "Customize kart", "Garage")
 for i = 1, 5 do
  Shapes.pillar(g, 4, 1.5, CFrame.new(garage.box.min.x + 8, i * 1.5, garage.box.min.z + 9), { color = Color3.fromRGB(28, 28, 32), material = Enum.Material.SmoothPlastic })
 end
 local trophy = LobbyLayout.roomById("trophy")
 local podiumCf = CFrame.new(trophy.box.min.x + 22, 0, trophy.door.z) * CFrame.Angles(0, -math.pi / 2, 0)
 local podiumX, podiumH = { 0, -11, 11 }, { 3, 2, 1 }
 local podiumKarts = Instance.new("Folder")
 podiumKarts.Name = "PodiumKarts"
 podiumKarts.Parent = roomFolders.trophy
 for i = 1, 3 do rimDisc(roomFolders.trophy, 10, podiumH[i], podiumCf * CFrame.new(podiumX[i], 0, 0), C.wallLight, C.gold, 0.4) end
 local podiumSign = Shapes.box(roomFolders.trophy, Vector3.new(32, 5, 0.4), podiumCf * CFrame.new(0, 15, 9), { color = C.navy })
 local podiumText = text(podiumSign, "LAST RACE · NO RACES YET", C.white, 14)
 local party = LobbyLayout.roomById("party")
 for i = 1, 3 do
  local cf = CFrame.new(party.box.min.x + 20, 0, party.box.min.z + i * 14)
  Shapes.roundedBox(roomFolders.party, Vector3.new(16, 2, 5), 0.7, cf * CFrame.new(0, 1, 0), { color = C.wallLight, collide = true })
  Shapes.roundedBox(roomFolders.party, Vector3.new(16, 3, 1), 0.4, cf * CFrame.new(0, 3, 2), { color = C.wallLight, collide = true })
 end
 local tokens = {}
 local tokenFolder = Instance.new("Folder")
 tokenFolder.Name = "Tokens"
 tokenFolder.Parent = lobby
 for i, spot in LobbyLayout.Collectibles do
  local token = Shapes.tube(tokenFolder, 2.5, 0.6, at(spot, 1.5), { color = C.gold, material = Enum.Material.Metal, name = `Token{i}` })
  token:SetAttribute("Spin", 2)
  token:SetAttribute("TokenId", i)
  table.insert(tokens, token)
 end
 finish(lobby)
 lobby.Parent = Workspace
 TerrainBuilder.onCleared(buildVista)
	local function setKartDisplay(slot: number, name: string?, kartId: string?, look: any?)
		local existing = displays:FindFirstChild(`Slot{slot}`)
		if existing then
			existing:Destroy()
		end
		local spot = LobbyLayout.KartDisplays[slot]
		if not spot or not name then
			return
		end
		local kartCf = CFrame.new(spot.x, 1.3, spot.z) * CFrame.Angles(0, displayYaw[slot], 0)
		local kart = KartRig.build(kartId or Karts.Default, name, kartCf, displays, look)
		kart.Name = `Slot{slot}`
		kart.PrimaryPart.Anchored = true
		local tag = kart:FindFirstChild("NameTag")
		local label = tag and tag:FindFirstChildOfClass("TextLabel")
		if label then
			label.Text = name
		end
	end

	local function setPodium(rows: { any })
		podiumKarts:ClearAllChildren()
		local lines = {}
		for place = 1, math.min(3, #rows) do
			local row = rows[place]
			local kartCf = podiumCf * CFrame.new(podiumX[place], podiumH[place] + 0.1, 0)
			local kart = KartRig.build(row.kartId or Karts.Default, row.name, kartCf, podiumKarts, row.look)
			kart.PrimaryPart.Anchored = true
			table.insert(lines, `{place}. {row.name}`)
		end
		podiumText.Text = "🏆 LAST RACE\n" .. (if #lines > 0 then table.concat(lines, "   ") else "No races yet")
	end

	-- Departure doors light up (and open on clients) when a track is chosen.
	local function setDeparture(lit: boolean)
		for _, door in departure:GetChildren() do
			if door:GetAttribute("Departure") then
				door:SetAttribute("Lit", lit)
			end
		end
	end

	-- Top three players stand on the pedestals in the middle of the chamber,
	-- cheer, and get confetti.
	local function celebrate(place: number, character: Model)
		local h = stepHeights[place]
		if not h or not character.Parent then
			return
		end
		local spot = pedestalCf * CFrame.new(stepX[place], h + 3, 0) * CFrame.Angles(0, math.pi, 0)
		local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root then
			root.CFrame = spot
		end
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			pcall(function()
				humanoid:PlayEmote(if place == 1 then "cheer" else "wave")
			end)
		end
		local burst = Shapes.box(lobby, Vector3.new(1, 1, 1), spot * CFrame.new(0, 12, 0), { color = C.white, transparency = 1 })
		local confetti = Instance.new("ParticleEmitter")
		confetti.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		confetti.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, C.pink),
			ColorSequenceKeypoint.new(0.33, C.gold),
			ColorSequenceKeypoint.new(0.66, C.cyan),
			ColorSequenceKeypoint.new(1, C.white),
		})
		confetti.Size = NumberSequence.new(0.6)
		confetti.Lifetime = NumberRange.new(2, 3)
		confetti.Speed = NumberRange.new(20, 30)
		confetti.SpreadAngle = Vector2.new(60, 60)
		confetti.Acceleration = Vector3.new(0, -20, 0)
		confetti.Rotation = NumberRange.new(0, 360)
		confetti.RotSpeed = NumberRange.new(-200, 200)
		confetti.Rate = 120
		confetti.Parent = burst
		task.delay(1.5, function()
			confetti.Enabled = false
		end)
		task.delay(5, function()
			burst:Destroy()
		end)
	end

	return {
		setPodium = setPodium,
		setKartDisplay = setKartDisplay,
		setDeparture = setDeparture,
		celebrate = celebrate,
		garagePrompt = garagePrompt,
		collectibles = tokens,
	}
end

return LobbyBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="31">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Server entry point.

local DataService = require(script.Parent.DataService)
local RaceService = require(script.Parent.RaceService)
local RoundService = require(script.Parent.RoundService)

DataService.start()
RaceService.start()
RoundService.start()

print("[KartRacer] server ready - walk under the READY arch (or press READY) to race")
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="32">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[-- Creates the RemoteEvents listed in Shared.RemoteNames under ReplicatedStorage.Remotes.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RemoteNames = require(ReplicatedStorage.Shared.RemoteNames)

local folder = Instance.new("Folder")
folder.Name = "Remotes"

local Net: { [string]: RemoteEvent } = {}
for name in RemoteNames do
	local remote = Instance.new("RemoteEvent")
	remote.Name = name
	remote.Parent = folder
	Net[name] = remote
end

folder.Parent = ReplicatedStorage

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="33">
        <Properties>
          <string name="Name">PracticeService</string>
          <string name="Source"><![CDATA[-- Practice karts on the lobby loop. Anyone not in a race can take one out to
-- try drifting, the jump ramp and the boost tunnel. Practice karts are
-- client-driven like race karts but nothing is scored.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local LobbyLayout = require(Shared.LobbyLayout)
local Track = require(Shared.Track)
local KartRig = require(ReplicatedStorage.Common.KartRig)

local Net = require(script.Parent.Net)

local PracticeService = {}

local folder = Instance.new("Folder")
folder.Name = "PracticeKarts"
folder.Parent = Workspace

local practiceTrack = Track.build(LobbyLayout.PracticeTrack)
local karts: { [Player]: Model } = {}
local nextSlot = 0

function PracticeService.stop(player: Player)
	local kart = karts[player]
	karts[player] = nil
	if kart then
		local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid.Sit = false
		end
		kart:Destroy()
	end
end

function PracticeService.isPracticing(player: Player): boolean
	return karts[player] ~= nil
end

function PracticeService.start(player: Player, kartId: string, look: any)
	PracticeService.stop(player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	nextSlot = nextSlot % 8 + 1
	local pos, d = Track.gridSpot(practiceTrack, nextSlot)
	local _, tan = Track.at(practiceTrack, d)
	local yaw = math.atan2(-tan.x, -tan.z)
	local kart = KartRig.build(kartId, player.DisplayName, CFrame.new(pos.x, pos.y, pos.z) * CFrame.Angles(0, yaw, 0), folder, look)
	karts[player] = kart

	local seat = kart:FindFirstChild("DriverSeat") :: Seat
	humanoid.Sit = false
	character:PivotTo(seat.CFrame + Vector3.new(0, 2, 0))
	seat:Sit(humanoid)
	if kart.PrimaryPart and kart.PrimaryPart:CanSetNetworkOwnership() then
		kart.PrimaryPart:SetNetworkOwner(player)
	end
	-- Getting out of the seat ends practice.
	seat:GetPropertyChangedSignal("Occupant"):Connect(function()
		if seat.Occupant == nil then
			task.delay(0.5, function()
				if karts[player] == kart and seat.Occupant == nil then
					PracticeService.stop(player)
				end
			end)
		end
	end)
	Net.PracticeStart:FireClient(player, {
		trackId = LobbyLayout.PracticeTrack.id,
		theme = LobbyLayout.PracticeTrack.theme,
		kart = kart,
		kartId = kartId,
		yaw = yaw,
	})
end

function PracticeService.init()
	Net.LeavePractice.OnServerEvent:Connect(PracticeService.stop)
	Players.PlayerRemoving:Connect(PracticeService.stop)
end

return PracticeService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="34">
        <Properties>
          <string name="Name">Props</string>
          <string name="Source"><![CDATA[-- Scenery models built from parts. Scenery.luau decides where they go; this
-- decides what they look like. Each builder gets the prop, the track theme
-- and a parent, and makes anchored, non-colliding decoration (grandstands
-- and towers collide so nobody drives through them).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shapes = require(ReplicatedStorage.Common.Shapes)

local Props = {}

local function rgb(c: { number }): Color3
	return Color3.fromRGB(c[1], c[2], c[3])
end

local function part(parent: Instance, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material, shape: Enum.PartType?): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if shape then
		p.Shape = shape
	end
	p.Parent = parent
	return p
end

-- Varies a colour a little so rows of props don't look copy-pasted.
local function vary(c: Color3, amount: number, seed: number): Color3
	local h, s, v = c:ToHSV()
	local k = (math.sin(seed * 12.9898) * 43758.5453) % 1
	return Color3.fromHSV(h, s, math.clamp(v + (k - 0.5) * amount, 0, 1))
end

local builders: { [string]: (any, any, Instance) -> () } = {}

-- Realistic themes use textured materials (bark, leaves, rock, concrete);
-- the toy-world themes keep smooth plastic.
local function mat(theme: any, realistic: Enum.Material): Enum.Material
	return if theme.realistic then realistic else Enum.Material.SmoothPlastic
end

builders.tree = function(prop, theme, parent)
	local s = prop.size
	local base = CFrame.new(prop.x, prop.y, prop.z) * CFrame.Angles(0, prop.yaw, 0)
	local leafMaterial = mat(theme, Enum.Material.LeafyGrass)
	part(parent, Vector3.new(2, 14 * s, 2), base * CFrame.new(0, 7 * s, 0), Color3.fromRGB(96, 70, 48), mat(theme, Enum.Material.Wood))
	-- A couple of branches, then an uneven crown of overlapping leaf clumps.
	if theme.realistic then
		for k = 0, 1 do
			local a = k * math.pi + prop.yaw
			part(parent, Vector3.new(0.8, 6 * s, 0.8), base * CFrame.new(math.cos(a) * 1.6 * s, 11 * s, math.sin(a) * 1.6 * s) * CFrame.Angles(math.sin(a) * 0.6, 0, -math.cos(a) * 0.6), Color3.fromRGB(96, 70, 48), Enum.Material.Wood)
		end
	end
	-- A theme can list its own leaf colours (autumn reds and golds).
	local leaves = theme.leaves
	local tone = if leaves then rgb(leaves[math.floor(math.abs(prop.x * 7 + prop.z * 3)) % #leaves + 1]) elseif theme.realistic then Color3.fromRGB(66, 104, 44) else Color3.fromRGB(70, 150, 60)
	local leaf = vary(tone, 0.25, prop.x + prop.z)
	part(parent, Vector3.one * 12 * s, base * CFrame.new(0, 16 * s, 0), leaf, leafMaterial, Enum.PartType.Ball)
	part(parent, Vector3.one * 8 * s, base * CFrame.new(3 * s, 13 * s, 1 * s), leaf, leafMaterial, Enum.PartType.Ball)
	if theme.realistic then
		part(parent, Vector3.one * 9 * s, base * CFrame.new(-3 * s, 14 * s, -2 * s), vary(leaf, 0.15, prop.z), leafMaterial, Enum.PartType.Ball)
		part(parent, Vector3.one * 7 * s, base * CFrame.new(1 * s, 20 * s, -1 * s), vary(leaf, 0.15, prop.x), leafMaterial, Enum.PartType.Ball)
	end
end

-- A conifer: a tall trunk and stacked, narrowing tiers of needles.
builders.pine = function(prop, theme, parent)
	local s = prop.size
	local base = CFrame.new(prop.x, prop.y, prop.z) * CFrame.Angles(0, prop.yaw, 0)
	part(parent, Vector3.new(1.6, 26 * s, 1.6), base * CFrame.new(0, 13 * s, 0), Color3.fromRGB(84, 62, 46), mat(theme, Enum.Material.Wood))
	local needles = vary(Color3.fromRGB(38, 72, 46), 0.2, prop.x + prop.z)
	local tiers = 5
	for k = 0, tiers - 1 do
		local f = k / (tiers - 1)
		local width = (13 - f * 9) * s
		local tierCf = base * CFrame.new(0, (7 + k * 4.6) * s, 0) * CFrame.Angles(0, k * 0.7, 0)
		local p = part(parent, Vector3.new(width, 6.5 * s, width), tierCf, vary(needles, 0.1, k + prop.x), mat(theme, Enum.Material.Grass))
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = p
	end
	part(parent, Vector3.new(1.2, 3 * s, 1.2), base * CFrame.new(0, 29 * s, 0), needles, mat(theme, Enum.Material.Grass))
end

-- A cheap tree for the distant forest: two parts, no shadow. From the road
-- it reads as a dense treeline; up close it would look plain, so it is only
-- placed far away (Scenery rule `farTree`).
builders.farTree = function(prop, theme, parent)
	local s = prop.size
	local base = CFrame.new(prop.x, prop.y, prop.z)
	local leaves = theme.leaves
	local tone = if leaves and (math.floor(prop.x) % 3 ~= 0) then rgb(leaves[math.floor(math.abs(prop.z)) % #leaves + 1]) else Color3.fromRGB(40, 74, 46)
	local trunk = part(parent, Vector3.new(1.4, 10 * s, 1.4), base * CFrame.new(0, 5 * s, 0), Color3.fromRGB(84, 62, 46), mat(theme, Enum.Material.Wood))
	trunk.CastShadow = false
	local crown = part(parent, Vector3.new(11 * s, 22 * s, 11 * s), base * CFrame.new(0, 17 * s, 0), vary(tone, 0.2, prop.x), mat(theme, Enum.Material.Grass))
	crown.CastShadow = false
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = crown
end

builders.bush = function(prop, theme, parent)
	local s = prop.size
	local color = vary(if theme.realistic then Color3.fromRGB(70, 110, 48) else Color3.fromRGB(80, 160, 70), 0.2, prop.z)
	part(parent, Vector3.new(7, 5, 7) * s, CFrame.new(prop.x, prop.y + 1.5 * s, prop.z), color, mat(theme, Enum.Material.LeafyGrass), Enum.PartType.Ball)
end

builders.flag = function(prop, theme, parent)
	local base = CFrame.new(prop.x, prop.y, prop.z) * CFrame.Angles(0, prop.yaw, 0)
	part(parent, Vector3.new(0.4, 12, 0.4), base * CFrame.new(0, 6, 0), Color3.fromRGB(230, 230, 235), Enum.Material.SmoothPlastic)
	local colors = { rgb(theme.accent), rgb(theme.curb[1]), rgb(theme.curb[2]) }
	part(parent, Vector3.new(0.1, 3, 5), base * CFrame.new(0, 10.5, 2.5), colors[(math.floor(prop.x) % 3) + 1], Enum.Material.SmoothPlastic)
end

builders.billboard = function(prop, theme, parent)
	local base = CFrame.new(prop.x, prop.y, prop.z) * CFrame.Angles(0, prop.yaw, 0)
	for _, side in { -9, 9 } do
		part(parent, Vector3.new(1, 14, 1), base * CFrame.new(side, 7, 0), Color3.fromRGB(80, 80, 90), Enum.Material.SmoothPlastic)
	end
	local board = part(parent, Vector3.new(24, 9, 0.6), base * CFrame.new(0, 16, 0), Color3.fromRGB(20, 20, 30), Enum.Material.SmoothPlastic)
	local glow = theme.clock < 6 or theme.clock > 19
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 20
	gui.LightInfluence = if glow then 0 else 1
	gui.Parent = board
	local slogans = { "GO FAST", "TURBO!", "DRIFT KING", "KART RACER", "FULL SPEED", "NO BRAKES" }
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundColor3 = rgb(theme.accent)
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(20, 20, 30)
	label.Text = slogans[(math.floor(prop.x + prop.z) % #slogans) + 1]
	label.Parent = gui
	-- Same text on the back.
	local back = gui:Clone()
	back.Face = Enum.NormalId.Back
	back.Parent = board
end

builders.grandstand = function(prop, theme, parent)
	local base = CFrame.new(prop.x, prop.y, prop.z) * CFrame.Angles(0, prop.yaw, 0)
	local steps = 5
	for i = 0, steps - 1 do
		local step = part(parent, Vector3.new(60, 2.5, 5), base * CFrame.new(0, 1.25 + i * 2.5, i * 4.5), Color3.fromRGB(150, 150, 160), mat(theme, Enum.Material.Concrete))
		step.CanCollide = true
		-- Crowd: little coloured blocks.
		for c = -27, 27, 3 do
			local seed = c * 7 + i * 13 + prop.x
			local h = (math.sin(seed) * 43758.5453) % 1
			part(parent, Vector3.new(1.4, 2, 1.2), base * CFrame.new(c, 3.5 + i * 2.5, i * 4.5 - 0.5), Color3.fromHSV(h, 0.6, 0.9), Enum.Material.SmoothPlastic)
		end
	end
	local roof = part(parent, Vector3.new(64, 1, 26), base * CFrame.new(0, 20, 9) * CFrame.Angles(math.rad(-8), 0, 0), rgb(theme.accent), mat(theme, Enum.Material.Metal))
	roof.CanCollide = true
	for _, x in { -30, 30 } do
		part(parent, Vector3.new(1.2, 20, 1.2), base * CFrame.new(x, 10, 20), Color3.fromRGB(90, 90, 100), Enum.Material.SmoothPlastic)
	end
end

builders.rock = function(prop, theme, parent)
	local s = prop.size
	local tone = if theme.terrain and theme.terrain.colors and theme.terrain.colors.Rock then rgb(theme.terrain.colors.Rock) else rgb(theme.wall)
	local color = vary(tone, 0.2, prop.x)
	local material = mat(theme, Enum.Material.Rock)
	local base = CFrame.new(prop.x, prop.y, prop.z) * CFrame.Angles(0, prop.yaw, 0)
	-- Sunk a little into the ground so boulders sit rather than perch.
	part(parent, Vector3.new(10, 7, 8) * s, base * CFrame.new(0, 2 * s, 0) * CFrame.Angles(0.2, 0, 0.15), color, material)
	part(parent, Vector3.new(6, 5, 6) * s, base * CFrame.new(3 * s, 4 * s, 1 * s) * CFrame.Angles(-0.3, 0.6, 0.2), color, material)
	if theme.realistic then
		part(parent, Vector3.new(5, 3, 4) * s, base * CFrame.new(-4 * s, 1 * s, 2 * s) * CFrame.Angles(0.4, 1.1, -0.2), vary(color, 0.1, prop.z), material)
	end
end

builders.mesa = function(prop, theme, parent)
	local s = prop.size
	local base = CFrame.new(prop.x, prop.y, prop.z) * CFrame.Angles(0, prop.yaw, 0)
	local layers = { { 70, 18, 60 }, { 58, 16, 50 }, { 46, 14, 40 } }
	local y = 0
	for i, l in layers do
		local color = vary(rgb(theme.wall), 0.25, i + prop.x)
		local p = part(parent, Vector3.new(l[1], l[2], l[3]) * s, base * CFrame.new(0, (y + l[2] / 2) * s, 0), color, Enum.Material.SmoothPlastic)
		p.CanCollide = true
		y += l[2]
	end
end

builders.cactus = function(prop, _theme, parent)
	local s = prop.size
	local base = CFrame.new(prop.x, prop.y, prop.z) * CFrame.Angles(0, prop.yaw, 0)
	local green = Color3.fromRGB(70, 130, 70)
	part(parent, Vector3.new(2, 12, 2) * s, base * CFrame.new(0, 6 * s, 0), green, Enum.Material.SmoothPlastic)
	part(parent, Vector3.new(3, 1.4, 1.4) * s, base * CFrame.new(1.8 * s, 6 * s, 0), green, Enum.Material.SmoothPlastic)
	part(parent, Vector3.new(1.4, 4, 1.4) * s, base * CFrame.new(2.8 * s, 8 * s, 0), green, Enum.Material.SmoothPlastic)
end

builders.tower = function(prop, theme, parent)
	local s = prop.size
	local base = CFrame.new(prop.x, prop.y, prop.z) * CFrame.Angles(0, prop.yaw, 0)
	local h = 60 * s + (math.floor(prop.x * 7) % 5) * 20
	local w = 30 * math.min(s, 1.4)
	local tower = part(parent, Vector3.new(w, h, w), base * CFrame.new(0, h / 2, 0), Color3.fromRGB(22, 20, 36), Enum.Material.Glass)
	tower.CanCollide = true
	local colors = { rgb(theme.accent), rgb(theme.wall), Color3.fromRGB(255, 200, 60) }
	local color = colors[(math.floor(prop.z) % #colors) + 1]
	-- Glowing window bands.
	for y = 12, h - 6, 14 do
		part(parent, Vector3.new(w + 0.4, 1.2, w + 0.4), base * CFrame.new(0, y, 0), color, Enum.Material.Neon)
	end
	part(parent, Vector3.new(1, 10, 1), base * CFrame.new(0, h + 5, 0), Color3.fromRGB(255, 60, 60), Enum.Material.Neon)
end

builders.lamp = function(prop, theme, parent)
	local base = CFrame.new(prop.x, prop.y, prop.z) * CFrame.Angles(0, prop.yaw, 0)
	part(parent, Vector3.new(0.8, 16, 0.8), base * CFrame.new(0, 8, 0), Color3.fromRGB(60, 60, 80), Enum.Material.SmoothPlastic)
	local head = part(parent, Vector3.new(1.2, 1.2, 6), base * CFrame.new(0, 16, 2.5), rgb(theme.wall), Enum.Material.Neon)
	local light = Instance.new("PointLight")
	light.Color = rgb(theme.wall)
	light.Range = 30
	light.Brightness = 2
	light.Parent = head
end

---------------------------------------------------------------------------
-- Oversized-world props (toy room, kitchen, backyard)
---------------------------------------------------------------------------
local function base(prop: any): CFrame
	return CFrame.new(prop.x, prop.y, prop.z) * CFrame.Angles(0, prop.yaw, 0)
end

local function pick(list: { Color3 }, prop: any): Color3
	return list[(math.floor(math.abs(prop.x * 3 + prop.z * 7)) % #list) + 1]
end

local TOY_COLORS = { Color3.fromRGB(240, 80, 80), Color3.fromRGB(80, 150, 240), Color3.fromRGB(255, 210, 60), Color3.fromRGB(110, 210, 120), Color3.fromRGB(190, 110, 230) }

builders.toyBlock = function(prop, _theme, parent)
	local s = prop.size * 14
	local color = pick(TOY_COLORS, prop)
	local parts = Shapes.roundedBox(parent, Vector3.new(s, s, s), s * 0.12, base(prop) * CFrame.new(0, s / 2, 0), { color = color, collide = true })
	local _ = parts
	-- A raised letter panel on the front.
	local panel = Shapes.box(parent, Vector3.new(s * 0.7, s * 0.7, 0.4), base(prop) * CFrame.new(0, s / 2, -s / 2 - 0.2), { color = Color3.fromRGB(255, 255, 255) })
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 10
	gui.Parent = panel
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = color
	local letters = { "A", "B", "C", "K", "Z", "1", "2", "3" }
	label.Text = letters[(math.floor(math.abs(prop.x + prop.z)) % #letters) + 1]
	label.Parent = gui
end

builders.toyBall = function(prop, _theme, parent)
	local d = prop.size * 20
	local cf = base(prop) * CFrame.new(0, d / 2, 0)
	Shapes.ball(parent, d, cf, { color = pick(TOY_COLORS, prop), collide = true })
	Shapes.tube(parent, d * 1.01, d * 0.18, cf * CFrame.Angles(0, 0, math.rad(90)), { color = Color3.fromRGB(255, 255, 255) })
end

builders.crayon = function(prop, _theme, parent)
	local s = prop.size
	local color = pick(TOY_COLORS, prop)
	local cf = base(prop) * CFrame.new(0, 2.5 * s, 0)
	Shapes.tube(parent, 5 * s, 28 * s, cf, { color = color })
	Shapes.tube(parent, 5.3 * s, 6 * s, cf * CFrame.new(4 * s, 0, 0), { color = Color3.fromRGB(255, 255, 255) })
	Shapes.ellipsoid(parent, Vector3.new(7 * s, 4 * s, 4 * s), cf * CFrame.new(15 * s, 0, 0), { color = color })
end

builders.book = function(prop, _theme, parent)
	local s = prop.size
	local color = pick(TOY_COLORS, prop)
	Shapes.roundedBox(parent, Vector3.new(50 * s, 7 * s, 36 * s), 2 * s, base(prop) * CFrame.new(0, 3.5 * s, 0), { color = color, collide = true })
	Shapes.box(parent, Vector3.new(48 * s, 5.6 * s, 35 * s), base(prop) * CFrame.new(1 * s, 3.5 * s, 0), { color = Color3.fromRGB(250, 245, 230) })
end

local FRUIT = { Color3.fromRGB(230, 50, 50), Color3.fromRGB(255, 160, 40), Color3.fromRGB(250, 220, 60), Color3.fromRGB(120, 200, 60), Color3.fromRGB(150, 60, 160) }

builders.fruit = function(prop, _theme, parent)
	local d = prop.size * 16
	local cf = base(prop) * CFrame.new(0, d / 2, 0)
	Shapes.ellipsoid(parent, Vector3.new(d, d * 0.92, d), cf, { color = pick(FRUIT, prop), collide = true, reflectance = 0.08 })
	Shapes.pillar(parent, 0.8 * prop.size, 3 * prop.size, cf * CFrame.new(0, d * 0.5, 0), { color = Color3.fromRGB(110, 75, 45) })
	Shapes.ellipsoid(parent, Vector3.new(4, 1, 2.2) * prop.size, cf * CFrame.new(1.8 * prop.size, d * 0.5, 0), { color = Color3.fromRGB(90, 180, 70) })
end

builders.jar = function(prop, _theme, parent)
	local s = prop.size
	local cf = base(prop)
	Shapes.pillar(parent, 20 * s, 26 * s, cf * CFrame.new(0, 13 * s, 0), { color = Color3.fromRGB(200, 230, 255), material = Enum.Material.Glass, transparency = 0.4, collide = true })
	Shapes.pillar(parent, 18 * s, 18 * s, cf * CFrame.new(0, 10 * s, 0), { color = pick(FRUIT, prop) })
	Shapes.pillar(parent, 21 * s, 4 * s, cf * CFrame.new(0, 27.5 * s, 0), { color = Color3.fromRGB(220, 60, 60) })
end

builders.cookie = function(prop, _theme, parent)
	local s = prop.size
	local cf = base(prop) * CFrame.new(0, 1.2 * s, 0)
	Shapes.disc(parent, 16 * s, 2.4 * s, cf, { color = Color3.fromRGB(215, 160, 95) })
	for i = 1, 5 do
		local a = i * 1.3
		Shapes.ball(parent, 2.2 * s, cf * CFrame.new(math.cos(a) * 4.5 * s, 1.3 * s, math.sin(a) * 4.5 * s), { color = Color3.fromRGB(90, 55, 35) })
	end
end

builders.shaker = function(prop, _theme, parent)
	local s = prop.size
	local cf = base(prop)
	Shapes.pillar(parent, 8 * s, 18 * s, cf * CFrame.new(0, 9 * s, 0), { color = Color3.fromRGB(245, 245, 250), material = Enum.Material.Glass, transparency = 0.2, collide = true })
	Shapes.ellipsoid(parent, Vector3.new(8.4, 5, 8.4) * s, cf * CFrame.new(0, 18 * s, 0), { color = Color3.fromRGB(200, 205, 215), reflectance = 0.3 })
end

builders.grassBlade = function(prop, _theme, parent)
	local s = prop.size
	local green = Color3.fromRGB(80 + math.floor(prop.x) % 40, 170 + math.floor(prop.z) % 40, 60)
	local cf = base(prop)
	for k = 0, 2 do
		local lean = CFrame.Angles(math.rad(8 + k * 6), math.rad(k * 120), 0)
		Shapes.ellipsoid(parent, Vector3.new(2.4 * s, 30 * s, 1 * s), cf * lean * CFrame.new(0, 14 * s, 0), { color = green })
	end
end

builders.flower = function(prop, _theme, parent)
	local s = prop.size
	local cf = base(prop)
	Shapes.pillar(parent, 1.4 * s, 26 * s, cf * CFrame.new(0, 13 * s, 0), { color = Color3.fromRGB(80, 160, 70) })
	local petal = pick({ Color3.fromRGB(255, 120, 170), Color3.fromRGB(255, 255, 255), Color3.fromRGB(255, 200, 60), Color3.fromRGB(170, 120, 255) }, prop)
	for i = 0, 5 do
		local a = i / 6 * math.pi * 2
		Shapes.ellipsoid(parent, Vector3.new(7, 2, 4) * s, cf * CFrame.new(math.cos(a) * 4 * s, 27 * s, math.sin(a) * 4 * s) * CFrame.Angles(0, -a, 0), { color = petal })
	end
	Shapes.ball(parent, 4 * s, cf * CFrame.new(0, 27.5 * s, 0), { color = Color3.fromRGB(255, 210, 60) })
	Shapes.ellipsoid(parent, Vector3.new(7, 1, 3) * s, cf * CFrame.new(2.5 * s, 9 * s, 0) * CFrame.Angles(0, 0, 0.5), { color = Color3.fromRGB(90, 170, 70) })
end

builders.pebble = function(prop, _theme, parent)
	local s = prop.size
	local grey = 150 + math.floor(math.abs(prop.x)) % 50
	Shapes.ellipsoid(parent, Vector3.new(14, 7, 10) * s, base(prop) * CFrame.new(0, 2.5 * s, 0), { color = Color3.fromRGB(grey, grey - 5, grey - 15), collide = true })
end

builders.mushroom = function(prop, _theme, parent)
	local s = prop.size
	local cf = base(prop)
	Shapes.pillar(parent, 5 * s, 10 * s, cf * CFrame.new(0, 5 * s, 0), { color = Color3.fromRGB(245, 235, 215) })
	Shapes.ellipsoid(parent, Vector3.new(16, 9, 16) * s, cf * CFrame.new(0, 11 * s, 0), { color = Color3.fromRGB(230, 60, 60) })
	for i = 1, 5 do
		local a = i * 1.25
		Shapes.ball(parent, 2.4 * s, cf * CFrame.new(math.cos(a) * 4.5 * s, 14.2 * s, math.sin(a) * 4.5 * s), { color = Color3.fromRGB(255, 255, 255) })
	end
end

builders.clover = function(prop, _theme, parent)
	local s = prop.size
	local cf = base(prop)
	Shapes.pillar(parent, 0.8 * s, 6 * s, cf * CFrame.new(0, 3 * s, 0), { color = Color3.fromRGB(80, 160, 70) })
	for i = 0, 2 do
		local a = i / 3 * math.pi * 2
		Shapes.ellipsoid(parent, Vector3.new(5, 0.8, 5) * s, cf * CFrame.new(math.cos(a) * 2.4 * s, 6 * s, math.sin(a) * 2.4 * s), { color = Color3.fromRGB(90, 190, 80) })
	end
end

function Props.build(prop: any, theme: any, parent: Instance)
	local builder = builders[prop.kind]
	if builder then
		builder(prop, theme, parent)
	end
end

Props.Kinds = builders

return Props
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="35">
        <Properties>
          <string name="Name">RaceService</string>
          <string name="Source"><![CDATA[-- Runs one race: builds the track, puts karts on the grid, counts down,
-- tracks positions and laps, respawns fallen karts, drives the CPU karts,
-- runs items, and reports results. RoundService decides when races happen
-- and who is in them.
--
-- Players drive their own karts on their client. The server checks progress
-- (ordered sectors, so skipping the course never counts) and decides
-- placings, item hits and the finish.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local AIDriver = require(Shared.AIDriver)
local KartBodies = require(Shared.KartBodies)
local KartPhysics = require(Shared.KartPhysics)
local Karts = require(Shared.Karts)
local RaceRules = require(Shared.RaceRules)
local Track = require(Shared.Track)
local KartRig = require(ReplicatedStorage.Common.KartRig)
local Shapes = require(ReplicatedStorage.Common.Shapes)

local ItemService = require(script.Parent.ItemService)
local Net = require(script.Parent.Net)
local TrackBuilder = require(script.Parent.TrackBuilder)

local RaceService = {}

local LOAD_TIME = 3 -- time for clients to see the track before the countdown
local END_GRACE = 4 -- after the last player finishes
local FINISH_TIMEOUT = 30 -- once any player finishes, the rest get this long
local FALL_DEPTH = 18
local TICK = 1 / 20
local RESPAWN_COOLDOWN = 2

export type Entrant = {
	id: string,
	name: string,
	isCpu: boolean,
	player: Player?,
	kartId: string,
	look: KartBodies.Look,
	profile: AIDriver.Profile,
}

export type Racer = {
	entrant: Entrant,
	model: Model,
	state: KartPhysics.State?, -- CPU karts (and players who finished); players simulate their own
	stats: Karts.KartStats,
	progress: Track.Progress,
	score: number,
	place: number,
	finishTime: number?,
	invincibleUntil: number,
	protectUntil: number, -- brief immunity after any hit, so nobody gets juggled
	shieldUntil: number, -- Bubble Shield: blocks the next attack
	speedFactor: number,
	lastRespawn: number,
	-- Stats for results and awards
	worstPlace: number,
	hitsTaken: number,
	shortcutsTaken: number,
	onShortcut: boolean,
	jumps: number,
	airSince: number?, -- when the kart left the ground (server-measured)
	lapStart: number?,
	bestLap: number?,
	-- Items (managed by ItemService)
	item: string?,
	uses: number,
	itemReadyAt: number,
	cpuUseAt: number,
}

export type ResultRow = {
	place: number,
	id: string,
	name: string,
	isCpu: boolean,
	userId: number?,
	time: number?,
	finished: boolean,
	kartId: string,
	look: KartBodies.Look,
	worstPlace: number,
	hitsTaken: number,
	shortcutsTaken: number,
	jumps: number,
	bestLap: number?,
}

type Race = {
	trackId: string,
	track: Track.Built,
	racers: { Racer },
	goTime: number,
	endAt: number?,
	timeLimit: number,
	lastBroadcast: number,
	onEnded: (({ ResultRow }, string) -> ())?,
	ended: boolean,
}

local race: Race? = nil

local kartsFolder = Instance.new("Folder")
kartsFolder.Name = "Karts"
kartsFolder.Parent = Workspace

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function now(): number
	return Workspace:GetServerTimeNow()
end

local function vec(p: Vector3): Track.Vec
	return Track.v(p.X, p.Y, p.Z)
end

local function refreshRayFilter()
	local ignore: { Instance } = { kartsFolder }
	for _, name in { "Items", "PracticeKarts" } do
		local f = Workspace:FindFirstChild(name)
		if f then
			table.insert(ignore, f)
		end
	end
	for _, p in Players:GetPlayers() do
		if p.Character then
			table.insert(ignore, p.Character)
		end
	end
	rayParams.FilterDescendantsInstances = ignore
end

---------------------------------------------------------------------------
-- Effects (also used by ItemService)
---------------------------------------------------------------------------
local Effects = {}
RaceService.Effects = Effects

local HIT_PROTECTION = 2.5

local function removeBubble(racer: Racer)
	local bubble = racer.model:FindFirstChild("ShieldBubble")
	if bubble then
		bubble:Destroy()
	end
end

-- Bubble Shield: a see-through bubble around the kart that blocks one attack.
function Effects.shield(racer: Racer, seconds: number)
	local root = racer.model.PrimaryPart
	if not root then
		return
	end
	racer.shieldUntil = now() + seconds
	removeBubble(racer)
	local bubble = Shapes.ball(racer.model, 10, root.CFrame, {
		color = Color3.fromRGB(170, 220, 255),
		material = Enum.Material.Glass,
		transparency = 0.55,
		reflectance = 0.2,
		anchored = false,
		name = "ShieldBubble",
	})
	bubble.Massless = true
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = bubble
	weld.Parent = bubble
	task.delay(seconds, function()
		if now() >= racer.shieldUntil then
			removeBubble(racer)
		end
	end)
	Effects.warn(racer, "🫧 Shield up!")
end

-- Returns true if the hit landed. A Bubble Shield, Overdrive and the
-- post-hit grace period all block it.
function Effects.hit(racer: Racer, kind: string?): boolean
	local t = now()
	if t < racer.invincibleUntil or t < racer.protectUntil then
		return false
	end
	if t < racer.shieldUntil then
		racer.shieldUntil = 0
		racer.protectUntil = t + 0.8
		removeBubble(racer)
		local root = racer.model.PrimaryPart
		if root then
			ItemService.explode(root.Position + Vector3.new(0, 3, 0), "BLOCKED!", Color3.fromRGB(170, 220, 255))
		end
		Effects.warn(racer, "🫧 Shield blocked it!")
		return false
	end
	racer.protectUntil = t + HIT_PROTECTION
	racer.hitsTaken += 1
	local hitKind = kind or "spin"
	if racer.state then
		if hitKind == "slow" then
			KartPhysics.slow(racer.state, 2)
		else
			KartPhysics.hit(racer.state)
		end
		if hitKind == "launch" and racer.model.PrimaryPart then
			local root = racer.model.PrimaryPart
			root.AssemblyLinearVelocity += Vector3.new(0, 70, 0)
		end
	elseif racer.entrant.player then
		Net.KartEvent:FireClient(racer.entrant.player, hitKind)
	end
	return true
end

function Effects.boost(racer: Racer, seconds: number)
	if racer.state then
		KartPhysics.giveBoost(racer.state, seconds)
	elseif racer.entrant.player then
		Net.KartEvent:FireClient(racer.entrant.player, "boost", seconds)
	end
end

function Effects.overdrive(racer: Racer, seconds: number)
	racer.invincibleUntil = now() + seconds
	if racer.state then
		KartPhysics.overdrive(racer.state, seconds)
	elseif racer.entrant.player then
		Net.KartEvent:FireClient(racer.entrant.player, "overdrive", seconds)
	end
end

function Effects.warn(racer: Racer, text: string)
	if racer.entrant.player then
		Net.KartEvent:FireClient(racer.entrant.player, "warning", text)
	end
end

function Effects.itemChanged(racer: Racer)
	if racer.entrant.player then
		Net.ItemState:FireClient(racer.entrant.player, racer.item, racer.uses, racer.itemReadyAt)
	end
end

---------------------------------------------------------------------------
-- Helpers
---------------------------------------------------------------------------
local function yawFromTangent(tan: Track.Vec): number
	return math.atan2(-tan.x, -tan.z)
end

local function scaledStats(base: Karts.KartStats, factor: number): Karts.KartStats
	return { topSpeed = base.topSpeed * factor, accel = base.accel, handling = base.handling, weight = base.weight }
end

local function seatDriver(player: Player, model: Model)
	local character = player.Character
	if not character or not character.Parent then
		player:LoadCharacter()
		character = player.Character or player.CharacterAdded:Wait()
	end
	local humanoid = character:WaitForChild("Humanoid", 5) :: Humanoid?
	local seat = model:FindFirstChild("DriverSeat") :: Seat
	if humanoid and seat then
		humanoid.Sit = false
		character:PivotTo(seat.CFrame + Vector3.new(0, 2, 0))
		seat:Sit(humanoid)
	end
end

local function respawn(r: Race, racer: Racer)
	racer.lastRespawn = now()
	local d = racer.progress.distance
	local pos = Track.spot(r.track, d, 0)
	local _, tan = Track.at(r.track, d)
	local yaw = yawFromTangent(tan)
	KartRig.place(racer.model, CFrame.new(pos.x, pos.y, pos.z) * CFrame.Angles(0, yaw, 0))
	if racer.state then
		racer.state.speed = 0
		racer.state.yaw = yaw
		racer.state.drift = 0
		racer.state.charge = 0
	end
	if racer.entrant.player then
		Net.KartEvent:FireClient(racer.entrant.player, "respawn", yaw)
	end
	-- A moment of protection so nothing hits you while getting going again.
	racer.protectUntil = math.max(racer.protectUntil, now() + 2)
end

local function standings(r: Race): { Racer }
	local entries = {}
	local byId = {}
	for _, racer in r.racers do
		table.insert(entries, { id = racer.entrant.id, finished = racer.finishTime ~= nil, finishTime = racer.finishTime, score = racer.score })
		byId[racer.entrant.id] = racer
	end
	local ranked = RaceRules.rank(entries)
	local out = {}
	for place, e in ranked do
		local racer = byId[e.id]
		racer.place = place
		table.insert(out, racer)
	end
	return out
end

local function rowsOf(ranked: { Racer })
	local rows = {}
	for _, racer in ranked do
		table.insert(rows, {
			name = racer.entrant.name,
			isCpu = racer.entrant.isCpu,
			finished = racer.finishTime ~= nil,
			kart = racer.model.Name,
		})
	end
	return rows
end

local function raceStateFor(r: Race, ranked: { Racer }, me: Racer)
	return {
		place = me.place,
		field = #ranked,
		lap = math.clamp(me.progress.lap, 1, r.track.def.laps),
		laps = r.track.def.laps,
		finishTime = me.finishTime,
		rows = rowsOf(ranked),
		endAt = r.endAt,
	}
end

-- A player who has finished keeps cruising under CPU control while they spectate.
local function autopilot(racer: Racer)
	local root = racer.model.PrimaryPart
	if racer.state or not root then
		return
	end
	local look = root.CFrame.LookVector
	local s = KartPhysics.newState(math.atan2(-look.X, -look.Z))
	s.speed = math.max(0, root.AssemblyLinearVelocity:Dot(Vector3.new(look.X, 0, look.Z)))
	racer.state = s
	if root:CanSetNetworkOwnership() then
		root:SetNetworkOwner(nil)
	end
end

local function finishRace(r: Race)
	if r.ended then
		return
	end
	r.ended = true
	if race == r then
		race = nil
	end
	local ranked = standings(r)
	local rows: { ResultRow } = {}
	for place, racer in ranked do
		table.insert(rows, {
			place = place,
			id = racer.entrant.id,
			name = racer.entrant.name,
			isCpu = racer.entrant.isCpu,
			userId = racer.entrant.player and racer.entrant.player.UserId,
			time = racer.finishTime,
			finished = racer.finishTime ~= nil,
			kartId = racer.entrant.kartId,
			look = racer.entrant.look,
			worstPlace = racer.worstPlace,
			hitsTaken = racer.hitsTaken,
			shortcutsTaken = racer.shortcutsTaken,
			jumps = racer.jumps,
			bestLap = racer.bestLap,
		})
	end
	ItemService.clear()
	kartsFolder:ClearAllChildren()
	if r.onEnded then
		r.onEnded(rows, r.trackId)
	end
end

---------------------------------------------------------------------------
-- Public API
---------------------------------------------------------------------------

-- Starts a race. `onEnded(rows, trackId)` is called once with the final placings.
function RaceService.startRace(trackId: string, entrants: { Entrant }, onEnded: ({ ResultRow }, string) -> ())
	if race then
		finishRace(race)
	end
	local _, track = TrackBuilder.build(trackId)
	kartsFolder:ClearAllChildren()

	-- Grid: CPUs at the front, players at the back, so players get to overtake.
	local order = table.clone(entrants)
	table.sort(order, function(a, b)
		if a.isCpu ~= b.isCpu then
			return a.isCpu
		end
		return a.id < b.id
	end)

	local r: Race = {
		trackId = trackId,
		track = track,
		racers = {},
		goTime = now() + LOAD_TIME + RaceRules.CountdownSeconds,
		timeLimit = track.def.laps * 150,
		lastBroadcast = 0,
		onEnded = onEnded,
		ended = false,
	}

	for slot, entrant in order do
		local pos, gridD = Track.gridSpot(track, slot)
		local _, tan = Track.at(track, gridD)
		local yaw = yawFromTangent(tan)
		local cf = CFrame.new(pos.x, pos.y, pos.z) * CFrame.Angles(0, yaw, 0)
		local model = KartRig.build(entrant.kartId, entrant.name, cf, kartsFolder, entrant.look)
		model.PrimaryPart.Anchored = true
		local racer: Racer = {
			entrant = entrant,
			model = model,
			state = if entrant.isCpu then KartPhysics.newState(yaw) else nil,
			stats = Karts.get(entrant.kartId).stats,
			progress = Track.newProgress(track, gridD),
			score = 0,
			place = slot,
			finishTime = nil,
			invincibleUntil = 0,
			protectUntil = 0,
			shieldUntil = 0,
			speedFactor = 1,
			lastRespawn = 0,
			worstPlace = slot,
			hitsTaken = 0,
			shortcutsTaken = 0,
			onShortcut = false,
			jumps = 0,
			airSince = nil,
			lapStart = nil,
			bestLap = nil,
			item = nil,
			uses = 0,
			itemReadyAt = 0,
			cpuUseAt = 0,
		}
		racer.score = Track.score(track, racer.progress)
		table.insert(r.racers, racer)
	end

	race = r
	ItemService.setup(track)
	refreshRayFilter()

	for _, racer in r.racers do
		local player = racer.entrant.player
		if player then
			task.spawn(function()
				seatDriver(player, racer.model)
				Net.ItemState:FireClient(player, nil, 0, 0)
				Net.RaceStart:FireClient(player, {
					trackId = trackId,
					trackName = track.def.name,
					theme = track.def.theme,
					kart = racer.model,
					kartId = racer.entrant.kartId,
					yaw = racer.state and racer.state.yaw or yawFromTangent(select(2, Track.at(track, racer.progress.distance))),
					goTime = r.goTime,
					laps = track.def.laps,
				})
			end)
		end
	end

	task.delay(r.goTime - now(), function()
		if race ~= r then
			return
		end
		for _, racer in r.racers do
			local root = racer.model.PrimaryPart
			if root then
				root.Anchored = false
				local player = racer.entrant.player
				if player and player.Parent and not racer.state then
					root:SetNetworkOwner(player)
				else
					root:SetNetworkOwner(nil)
				end
			end
		end
	end)
end

function RaceService.isRunning(): boolean
	return race ~= nil
end

function RaceService.isRacing(player: Player): boolean
	if race then
		for _, racer in race.racers do
			if racer.entrant.player == player then
				return true
			end
		end
	end
	return false
end

-- What lobby spectators see: track name and live standings.
function RaceService.spectatorInfo()
	local r = race
	if not r then
		return nil
	end
	local ranked = {}
	for _, racer in r.racers do
		table.insert(ranked, racer)
	end
	table.sort(ranked, function(a, b)
		return a.place < b.place
	end)
	return {
		trackName = r.track.def.name,
		theme = r.track.def.theme,
		rows = rowsOf(ranked),
		goTime = r.goTime,
	}
end

function RaceService.abort()
	if race then
		finishRace(race)
	end
end

local function findRacer(player: Player): Racer?
	if race then
		for _, racer in race.racers do
			if racer.entrant.player == player then
				return racer
			end
		end
	end
	return nil
end

function RaceService.useItem(player: Player, aimBack: boolean?)
	local racer = findRacer(player)
	if racer and race and now() >= race.goTime and not racer.finishTime then
		ItemService.use(race.track, race.racers, racer, Effects, aimBack == true)
	end
end

-- Manual recovery: puts a stuck kart back on the road (with a short cooldown).
function RaceService.requestRespawn(player: Player)
	local racer = findRacer(player)
	if racer and race and now() >= race.goTime and now() - racer.lastRespawn > RESPAWN_COOLDOWN and not racer.finishTime then
		respawn(race, racer)
	end
end

function RaceService.removePlayer(player: Player)
	local racer = findRacer(player)
	if racer and race then
		racer.model:Destroy()
		table.remove(race.racers, table.find(race.racers, racer) :: number)
	end
end

---------------------------------------------------------------------------
-- Loops
---------------------------------------------------------------------------
local function stepCpus(dt: number)
	local r = race
	if not r or now() < r.goTime then
		return
	end
	local positions = {}
	for _, racer in r.racers do
		local p = racer.model.PrimaryPart
		if p then
			positions[racer] = { x = p.Position.X, z = p.Position.Z }
		end
	end
	for _, racer in r.racers do
		local s = racer.state
		local root = racer.model.PrimaryPart
		if not s or not root or root.Anchored then
			continue
		end
		local others = {}
		for other, p in positions do
			if other ~= racer then
				table.insert(others, p)
			end
		end
		local sensed = KartRig.sense(racer.model, rayParams)
		local pos = vec(root.Position)
		local proj = Track.project(r.track, pos, racer.progress.index)
		local input = AIDriver.input(r.track, proj, pos, s, racer.stats, racer.entrant.profile)
		local surface = Track.surfaceAt(r.track, proj, pos, now())
		input.surface = if surface == "wall" then "offroad" else surface
		input.grounded = sensed.grounded
		input.drafting = KartPhysics.isDrafting(root.Position.X, root.Position.Z, s.yaw, others)
		KartPhysics.step(scaledStats(racer.stats, racer.speedFactor), s, input, dt)
		KartRig.sync(racer.model, s)
		KartRig.apply(racer.model, s, sensed)
		KartRig.setEffects(racer.model, if s.drift ~= 0 then KartPhysics.chargeLevel(s.charge) else 0, s.boost > 0)
	end
end

local function tickRace(r: Race)
	local t = now()
	if t < r.goTime then
		return
	end
	local track = r.track
	local humansRacing, humansLeft = 0, 0

	for _, racer in r.racers do
		local root = racer.model.PrimaryPart
		if not root then
			continue
		end
		local player = racer.entrant.player
		local pos = vec(root.Position)
		local proj = Track.project(track, pos, racer.progress.index)
		local roadY = Track.spot(track, proj.distance, 0).y
		local onShortcut = Track.shortcutAt(track, pos) ~= nil
		if onShortcut and not racer.onShortcut then
			racer.shortcutsTaken += 1
		end
		racer.onShortcut = onShortcut
		local offTrack = proj.gap > track.def.width + Track.ShoulderWidth * 2 and not onShortcut
		if offTrack or root.Position.Y < roadY - FALL_DEPTH then
			respawn(r, racer)
		elseif Track.updateProgress(track, racer.progress, proj) then
			-- Lap times, measured line to line.
			if racer.lapStart and racer.progress.lap >= 2 then
				local lapTime = t - racer.lapStart
				racer.bestLap = math.min(racer.bestLap or math.huge, lapTime)
			end
			racer.lapStart = t
			if racer.progress.lap > track.def.laps and not racer.finishTime then
				racer.finishTime = t - r.goTime
				if player then
					Net.Notify:FireClient(player, "FINISH!")
					autopilot(racer)
					-- Once any player finishes, the rest have a limited time left.
					if not r.endAt then
						r.endAt = t + FINISH_TIMEOUT
					end
				end
			elseif player and racer.progress.lap == track.def.laps then
				Net.Notify:FireClient(player, "FINAL LAP!")
			elseif player and racer.progress.lap > 1 then
				Net.Notify:FireClient(player, `Lap {racer.progress.lap}`)
			end
		end
		racer.score = Track.score(track, racer.progress)

		-- Big jumps: well above the road for a while, then back down.
		local height = root.Position.Y - roadY - KartRig.BallRadius
		if height > 3 then
			racer.airSince = racer.airSince or t
		elseif racer.airSince then
			if t - racer.airSince > 0.45 then
				racer.jumps += 1
			end
			racer.airSince = nil
		end

		if player then
			if not player.Parent then
				continue
			end
			humansLeft += 1
			if not racer.finishTime then
				humansRacing += 1
			end
		end
	end

	local ranked = standings(r)
	for _, racer in ranked do
		racer.worstPlace = math.max(racer.worstPlace, racer.place)
	end

	-- CPU pace: catch up when far behind, ease off when running away from players.
	local leaderScore = ranked[1] and ranked[1].score or 0
	local bestHuman = -math.huge
	for _, racer in r.racers do
		if not racer.entrant.isCpu then
			bestHuman = math.max(bestHuman, racer.score)
		end
	end
	for _, racer in r.racers do
		if racer.entrant.isCpu then
			local lead = if bestHuman > -math.huge then racer.score - bestHuman else 0
			racer.speedFactor = RaceRules.cpuSpeedFactor(leaderScore - racer.score, lead, racer.entrant.profile.skill)
		end
	end

	-- Moving crossers (toy robot, train, beetles) bump anyone they touch.
	for _, cr in track.def.crossers or {} do
		local d, lat, active = Track.crosserAt(track, cr, t)
		if active then
			local p = Track.spot(track, d, lat)
			local hazard = Vector3.new(p.x, p.y, p.z)
			for _, racer in r.racers do
				local root = racer.model.PrimaryPart
				if root and (Vector3.new(root.Position.X, p.y, root.Position.Z) - hazard).Magnitude < cr.radius + 2.5 then
					if Effects.hit(racer, "spin") then
						Effects.warn(racer, "BONK!")
					end
				end
			end
		end
	end

	ItemService.tick(r.track, r.racers, TICK, Effects)

	if t - r.lastBroadcast >= 0.2 then
		r.lastBroadcast = t
		for _, racer in r.racers do
			local player = racer.entrant.player
			if player and player.Parent then
				Net.RaceState:FireClient(player, raceStateFor(r, ranked, racer))
			end
		end
	end

	if humansLeft == 0 then
		finishRace(r)
		return
	end
	if humansRacing == 0 then
		r.endAt = math.min(r.endAt or math.huge, t + END_GRACE)
	end
	if (r.endAt and t >= r.endAt) or t - r.goTime > r.timeLimit then
		finishRace(r)
	end
end

function RaceService.start()
	task.spawn(function()
		while true do
			task.wait(TICK)
			local r = race
			if r and not r.ended then
				local ok, err = pcall(tickRace, r)
				if not ok then
					warn("[RaceService] race tick failed:", err)
				end
			end
		end
	end)

	RunService.Heartbeat:Connect(function(dt)
		local ok, err = pcall(stepCpus, math.min(dt, 0.1))
		if not ok then
			warn("[RaceService] CPU step failed:", err)
		end
	end)

	Players.PlayerAdded:Connect(function(player)
		player.CharacterAdded:Connect(function()
			task.defer(refreshRayFilter)
		end)
	end)
	Players.PlayerRemoving:Connect(RaceService.removePlayer)
end

return RaceService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="36">
        <Properties>
          <string name="Name">RoadSurface</string>
          <string name="Source"><![CDATA[-- Builds the road and everything alongside it from one set of frames
-- (shared/RoadGeometry), so every piece meets the next exactly:
--   * road: a solid slab built from triangles (two wedges each), one piece
--     per two segments, so curves and hills have no gaps, steps or
--     overlapping, flickering slabs
--   * verges: the same triangle strips either side, out past the barrier,
--     grass (or the theme's material), gravel run-off on the outside of
--     corners, and a concrete deck on bridges
--   * curbs on corners, painted edge lines on straights, a dashed centre line
--   * barriers: one piece per segment, end to end, with gaps for shortcuts
--
-- Realistic themes get asphalt, concrete jersey barriers and red-and-white
-- concrete curbs; the toy-world themes keep their own colours.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RoadGeometry = require(ReplicatedStorage.Shared.RoadGeometry)
local Track = require(ReplicatedStorage.Shared.Track)

local RoadSurface = {}

-- The road is a 4-stud slab and the verge strips are as thick. Terrain is
-- planned at least 3 studs under the road (Landscape), so it stays hidden
-- inside these slabs even where its 4-stud voxels round upward.
RoadSurface.Thickness = 4
RoadSurface.VergeExtra = 3 -- the verge runs this far past the barrier line
local SHOULDER_DROP = 0.12 -- shoulders sit just under the road so edges read

export type Style = { color: Color3, material: Enum.Material, collide: boolean, surface: string? }

local function v3(p: any): Vector3
	return Vector3.new(p.x, p.y, p.z)
end

-- One solid triangle: two wedges filling a, b, c, with the slab hanging
-- `thickness` studs below the surface (so the top face is exactly abc).
local function triangle(parent: Instance, a: Vector3, b: Vector3, c: Vector3, thickness: number, style: Style, name: string)
	local ab, ac, bc = b - a, c - a, c - b
	local abd, acd, bcd = ab:Dot(ab), ac:Dot(ac), bc:Dot(bc)
	if abd > acd and abd > bcd then
		c, a = a, c
	elseif acd > bcd and acd > abd then
		a, b = b, a
	end
	ab, ac, bc = b - a, c - a, c - b
	local cross = ac:Cross(ab)
	if cross.Magnitude < 1e-4 or bc.Magnitude < 1e-4 then
		return
	end
	local right = cross.Unit
	local up = bc:Cross(right).Unit
	local back = bc.Unit
	local height = math.abs(ab:Dot(up))
	local down = if right.Y > 0 then -right else right
	local sink = down * (thickness / 2)
	for _, spec in {
		{ center = (a + b) / 2, right = right, back = back, length = math.abs(ab:Dot(back)) },
		{ center = (a + c) / 2, right = -right, back = -back, length = math.abs(ac:Dot(back)) },
	} do
		if spec.length > 1e-3 and height > 1e-3 then
			local wedge = Instance.new("WedgePart")
			wedge.Name = name
			wedge.Anchored = true
			wedge.Size = Vector3.new(thickness, height, spec.length)
			wedge.CFrame = CFrame.fromMatrix(spec.center + sink, spec.right, up, spec.back)
			wedge.Color = style.color
			wedge.Material = style.material
			wedge.CanCollide = style.collide
			wedge.CanQuery = style.collide
			wedge.CanTouch = false
			wedge.TopSurface = Enum.SurfaceType.Smooth
			wedge.BottomSurface = Enum.SurfaceType.Smooth
			if style.surface then
				wedge:SetAttribute("Surface", style.surface)
			end
			wedge.Parent = parent
		end
	end
end
RoadSurface.triangle = triangle

-- A box laid along the chord from a to b (lines, curbs, barriers).
local function chordBox(parent: Instance, a: Vector3, b: Vector3, width: number, height: number, lift: number, extend: number, style: Style, name: string): Part?
	local along = b - a
	if along.Magnitude < 0.05 then
		return nil
	end
	local mid = (a + b) / 2 + Vector3.new(0, lift + height / 2, 0)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = Vector3.new(width, height, along.Magnitude + extend)
	p.CFrame = CFrame.lookAt(mid, mid + along)
	p.Color = style.color
	p.Material = style.material
	p.CanCollide = style.collide
	p.CanQuery = style.collide
	p.CanTouch = false
	p.CastShadow = style.collide
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

-- Pieces span two segments; the last one stops at the start line, so with
-- an odd number of points no two pieces ever overlap (overlapping coplanar
-- pieces would flicker).
local function pairEnd(i: number, n: number): number
	return if i + 2 > n then 1 else i + 2
end

export type Options = {
	theme: any,
	walled: boolean,
	plan: any?, -- Landscape plan (terrain verges where plan.bankAt[i])
	wallOpen: (side: number, distance: number, length: number) -> boolean,
}

function RoadSurface.build(track: any, frames: { any }, parent: Instance, opts: Options)
	local theme = opts.theme
	local def = track.def
	local half = def.width / 2
	local sw = Track.ShoulderWidth
	local n = #frames
	local realistic = theme.realistic == true
	local function rgb(c: { number }): Color3
		return Color3.fromRGB(c[1], c[2], c[3])
	end
	local neon = def.theme == "neon"

	local surface = Instance.new("Folder")
	surface.Name = "RoadSurface"
	surface.Parent = parent
	local verge = Instance.new("Folder")
	verge.Name = "Shoulders"
	verge.Parent = parent
	local markings = parent:FindFirstChild("Markings") or Instance.new("Folder")
	markings.Name = "Markings"
	markings.Parent = parent
	local barriers = Instance.new("Folder")
	barriers.Name = "Barriers"
	barriers.Parent = parent

	local roadMaterial = theme.roadMaterial and Enum.Material[theme.roadMaterial] or (if realistic then Enum.Material.Asphalt else Enum.Material.SmoothPlastic)
	local road: Style = { color = rgb(theme.road), material = roadMaterial, collide = true, surface = "road" }
	local shoulder: Style = {
		color = rgb(theme.shoulder),
		material = theme.shoulderMaterial and Enum.Material[theme.shoulderMaterial] or (if realistic then Enum.Material.Ground else Enum.Material.SmoothPlastic),
		collide = true,
		surface = "offroad",
	}
	-- Bridge decks (raised road with nothing under it) are concrete in realistic themes.
	local deck: Style = { color = Color3.fromRGB(150, 148, 142), material = Enum.Material.Concrete, collide = true, surface = "offroad" }
	-- Gravel run-off on the outside of corners: lighter than grass, reads as "slow".
	local gravel: Style = { color = Color3.fromRGB(150, 140, 120), material = Enum.Material.Pebble, collide = true, surface = "offroad" }
	local paint = if neon then Enum.Material.Neon else Enum.Material.SmoothPlastic
	local curbStyles: { Style } = {
		{ color = rgb(theme.curb[1]), material = if realistic then Enum.Material.Concrete else paint, collide = false },
		{ color = rgb(theme.curb[2]), material = if realistic then Enum.Material.Concrete else paint, collide = false },
	}
	local line: Style = { color = rgb(theme.line), material = paint, collide = false }

	local th = RoadSurface.Thickness
	for i = 1, n do
		local j = i % n + 1
		local a, b = frames[i], frames[j]
		-- The road slab spans two segments per piece, with the same corner
		-- points as the verges, so the two always meet.
		if i % 2 == 1 then
			local c = frames[pairEnd(i, n)]
			local aL, aR = v3(RoadGeometry.edge(a, -half)), v3(RoadGeometry.edge(a, half))
			local cL, cR = v3(RoadGeometry.edge(c, -half)), v3(RoadGeometry.edge(c, half))
			triangle(surface, aL, aR, cL, th, road, "Road")
			triangle(surface, aR, cR, cL, th, road, "Road")
		end

		-- Curbs on corners (both sides), edge lines on straights.
		local corner = RoadGeometry.isCorner(a) and RoadGeometry.isCorner(b)
		for _, side in { -1, 1 } do
			if corner and opts.walled then
				local p0 = v3(RoadGeometry.edge(a, side * (half - 1.5)))
				local p1 = v3(RoadGeometry.edge(b, side * (half - 1.5)))
				chordBox(markings, p0, p1, 3, 0.14, 0, 0, curbStyles[i % 2 + 1], "Curb")
			else
				local p0 = v3(RoadGeometry.edge(a, side * (half - 1.4)))
				local p1 = v3(RoadGeometry.edge(b, side * (half - 1.4)))
				chordBox(markings, p0, p1, 0.8, 0.06, 0, 0, line, "EdgeLine")
			end
		end
		if i % 4 < 2 then
			chordBox(markings, v3(RoadGeometry.edge(a, 0)), v3(RoadGeometry.edge(b, 0)), 0.6, 0.06, 0, 0, line, "CentreLine")
		end
	end

	-- Verges on both sides, out past the barrier, covering the terrain. One
	-- piece spans two segments (half the parts; on a 300-stud bend the chord
	-- strays about 0.25 studs), and the inner edge tucks 1 stud under the
	-- road so no gap can open at the road's edge.
	if opts.walled then
		local plan = opts.plan
		local outer = half + sw + RoadSurface.VergeExtra
		for i = 1, n, 2 do
			local mid = i % n + 1
			local j = pairEnd(i, n)
			local a, b = frames[i], frames[j]
			local onBridge = plan and not (plan.bankAt[i] and plan.bankAt[mid] and plan.bankAt[j])
			-- Turning right (turn > 0) puts the outside of the bend on the left.
			local outside = if a.turn > 0 then -1 else 1
			local corner = RoadGeometry.isCorner(a) and RoadGeometry.isCorner(b)
			for _, side in { -1, 1 } do
				local style = shoulder
				if realistic and onBridge then
					style = deck
				elseif realistic and corner and side == outside then
					style = gravel
				end
				local ai = v3(RoadGeometry.edge(a, side * (half - 1), -SHOULDER_DROP))
				local ao = v3(RoadGeometry.edge(a, side * outer, -SHOULDER_DROP))
				local bi = v3(RoadGeometry.edge(b, side * (half - 1), -SHOULDER_DROP))
				local bo = v3(RoadGeometry.edge(b, side * outer, -SHOULDER_DROP))
				triangle(verge, ai, ao, bi, th, style, "Shoulder")
				triangle(verge, ao, bo, bi, th, style, "Shoulder")
			end
		end
	end

	-- Barriers, one piece per two segments (like the verges), skipping
	-- shortcut gaps and the rare inside-of-a-hairpin stretch that would run
	-- backwards.
	if opts.walled then
		local wallAt = half + sw + 0.9
		local folded = {}
		for _, side in { -1, 1 } do
			folded[side] = {}
			for _, i in RoadGeometry.folds(frames, side * wallAt) do
				folded[side][i] = true
			end
		end
		local wallColor = rgb(theme.wall)
		local wallMaterial = theme.wallMaterial and Enum.Material[theme.wallMaterial] or (if neon then Enum.Material.Neon else Enum.Material.SmoothPlastic)
		for i = 1, n, 2 do
			local j = pairEnd(i, n)
			local a, b = frames[i], frames[j]
			local segLen = (v3(b) - v3(a)).Magnitude
			local distance = track.cum[i] + segLen / 2
			for _, side in { -1, 1 } do
				local foldedHere = folded[side][i] or folded[side][i % n + 1]
				if not foldedHere and not opts.wallOpen(side, distance, segLen) then
					local p0 = v3(RoadGeometry.edge(a, side * wallAt))
					local p1 = v3(RoadGeometry.edge(b, side * wallAt))
					if realistic then
						-- Concrete jersey barrier: wide foot, narrow top, a painted band.
						chordBox(barriers, p0, p1, 2, 1.2, -0.2, 0.5, { color = wallColor, material = Enum.Material.Concrete, collide = true }, "Wall")
						chordBox(barriers, p0, p1, 1.1, 2.4, 1, 0.5, { color = wallColor, material = Enum.Material.Concrete, collide = true }, "Wall")
						if i % 2 == 0 then
							-- Red band on alternate pieces; the bare concrete between reads as white.
							chordBox(barriers, p0, p1, 1.16, 0.35, 2.6, 0.5, { color = rgb(theme.curb[1]), material = Enum.Material.SmoothPlastic, collide = false }, "WallBand")
						end
					else
						chordBox(barriers, p0, p1, 1, 4, -0.5, 0.5, { color = wallColor, material = wallMaterial, collide = true }, "Wall")
					end
				end
			end
		end
	end
	return surface
end

return RoadSurface
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="37">
        <Properties>
          <string name="Name">RoundService</string>
          <string name="Source"><![CDATA[-- The round loop:
--   lobby → (someone readies up) → ready countdown → map voting (20s)
--   → winner announced (departure doors light up) → race → results → lobby
--
-- Players explore Kart HQ freely. Only players who ready up race and vote
-- (the READY button, or stepping onto a vote pad); everyone else can keep
-- practising or watch. A Random vote counts for one of the offered tracks,
-- picked at random once, and every screen shows which one. Late joiners spawn in
-- the lobby and can ready up for the next race. Empty grid slots are filled
-- with CPU drivers, so one player can race alone.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Cosmetics = require(Shared.Cosmetics)
local KartBodies = require(Shared.KartBodies)
local Karts = require(Shared.Karts)
local PlayerData = require(Shared.PlayerData)
local Rewards = require(Shared.Rewards)
local Track = require(Shared.Track)
local LobbyLayout = require(Shared.LobbyLayout)
local RaceRules = require(Shared.RaceRules)
local Tracks = require(Shared.Tracks)
local Voting = require(Shared.Voting)

local DataService = require(script.Parent.DataService)
local LobbyBuilder = require(script.Parent.LobbyBuilder)
local Net = require(script.Parent.Net)
local PracticeService = require(script.Parent.PracticeService)
local RaceService = require(script.Parent.RaceService)
local TerrainBuilder = require(script.Parent.TerrainBuilder)

local RoundService = {}

local READY_WAIT = 10 -- seconds after the first ready-up before voting opens
local RESULTS_TIME = 10
local TICK = 0.25

type Choice = { ready: boolean }

local phase: "lobby" | "voting" | "announce" | "racing" | "results" = "lobby"
local deadline: number? = nil
local choices: { [Player]: Choice } = {}
local options: { string } = {}
local votes: { [number]: string } = {} -- UserId -> track id
local voters: { [Player]: boolean } = {}
local randomVoters: { [number]: boolean } = {} -- UserIds whose vote came from Random
local onPad: { [Player]: number } = {} -- the vote pad each player stood on last tick
local lastTrack: string? = nil
local lastResults: { any } = {}
local winner: string? = nil
local handles: LobbyBuilder.Handles
local dirty = true

local function now(): number
	return Workspace:GetServerTimeNow()
end

local function choiceOf(player: Player): Choice
	local c = choices[player]
	if not c then
		c = { ready = false }
		choices[player] = c
	end
	return c
end

-- The player's equipped kart class and look (from their saved data).
local function kartOf(player: Player): (string, any)
	local data = DataService.get(player)
	if not data then
		return Karts.Default, KartBodies.sanitize(nil)
	end
	return data.equipped.kart, PlayerData.look(data)
end

local function rootOf(player: Player): BasePart?
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

---------------------------------------------------------------------------
-- State for clients and signs
---------------------------------------------------------------------------
local function optionInfo(id: string)
	local def = Tracks.get(id)
	local voterIds = Voting.votersFor(votes, id)
	return {
		id = id,
		name = def.name,
		icon = def.icon or "🏁",
		difficulty = def.difficulty or "Medium",
		feature = def.feature or "",
		theme = def.theme,
		votes = #voterIds,
		voters = voterIds,
	}
end

local function roundState()
	local players = {}
	for player, c in choices do
		if player.Parent then
			table.insert(players, {
				userId = player.UserId,
				name = player.DisplayName,
				ready = c.ready,
				racing = RaceService.isRacing(player),
				voter = voters[player] == true,
			})
		end
	end
	local opts = {}
	for _, id in options do
		table.insert(opts, optionInfo(id))
	end
	local randomIds = {}
	for userId in randomVoters do
		table.insert(randomIds, userId)
	end
	return {
		phase = phase,
		deadline = deadline,
		players = players,
		options = opts,
		randomVoters = randomIds,
		winner = winner,
		spectate = RaceService.spectatorInfo(),
		lastResults = lastResults,
	}
end

local function countReady(): (number, number)
	local total, ready = 0, 0
	for player, c in choices do
		if player.Parent then
			total += 1
			if c.ready and not RaceService.isRacing(player) then
				ready += 1
			end
		end
	end
	return total, ready
end

local function broadcast()
	dirty = false
	Net.Round:FireAllClients(roundState())
end

local function refreshDisplays()
	local slot = 0
	for player in choices do
		if player.Parent then
			slot += 1
			if slot <= #LobbyLayout.KartDisplays then
				local kartId, look = kartOf(player)
				handles.setKartDisplay(slot, player.DisplayName, kartId, look)
			end
		end
	end
	for s = slot + 1, #LobbyLayout.KartDisplays do
		handles.setKartDisplay(s, nil)
	end
end

---------------------------------------------------------------------------
-- Phases
---------------------------------------------------------------------------
local function toLobby()
	phase = "lobby"
	deadline = nil
	options = {}
	votes = {}
	voters = {}
	randomVoters = {}
	winner = nil
	handles.setDeparture(false)
	dirty = true
end

local function startVoting()
	phase = "voting"
	deadline = now() + Voting.VoteSeconds
	votes = {}
	voters = {}
	randomVoters = {}
	options = Voting.pickOptions(Tracks.VotePool, Voting.OptionCount, math.random, lastTrack)
	for player, c in choices do
		if c.ready and player.Parent then
			voters[player] = true
		end
	end
	for player in voters do
		Net.Notify:FireClient(player, "Vote for a track!")
	end
	dirty = true
end

local function onRaceEnded(rows: { any }, trackId: string)
	phase = "results"
	deadline = now() + RESULTS_TIME
	lastTrack = trackId
	lastResults = {}
	for i, row in rows do
		if i <= 3 then
			table.insert(lastResults, { name = row.name, kartId = row.kartId, look = row.look })
		end
	end
	handles.setPodium(lastResults)

	local def = Tracks.get(trackId)
	local trackLength = Track.build(def).length
	local out = {}
	local statRows = {}
	for _, row in rows do
		table.insert(out, {
			place = row.place,
			name = row.name,
			isCpu = row.isCpu,
			userId = row.userId,
			time = row.time,
			finished = row.finished,
			bestLap = row.bestLap,
		})
		table.insert(statRows, {
			id = row.id,
			name = row.name,
			place = row.place,
			finished = row.finished,
			time = row.time,
			bestLap = row.bestLap,
			worstPlace = row.worstPlace,
			hitsTaken = row.hitsTaken,
			shortcutsTaken = row.shortcutsTaken,
			jumps = row.jumps,
			isCpu = row.isCpu,
		})
	end

	-- Awards for everyone to see; coins only go to players.
	local awards = Rewards.awards(statRows)
	local awardLines = {}
	local nameOf = {}
	for _, r in statRows do
		nameOf[r.id] = r.name
	end
	for _, a in awards do
		table.insert(awardLines, { icon = a.icon, name = a.name, winner = nameOf[a.winner] })
	end

	for i, row in rows do
		local player = row.userId and Players:GetPlayerByUserId(row.userId)
		if player then
			local data = DataService.get(player)
			local mine = nil
			if data then
				local myAwards = {}
				for _, a in awards do
					if a.winner == row.id then
						table.insert(myAwards, a.id)
					end
				end
				mine = PlayerData.applyRace(data, trackId, trackLength, #Tracks.VotePool, statRows[i], myAwards)
				DataService.markDirty(player)
				DataService.push(player)
			end
			Net.Results:FireClient(player, { trackName = def.name, rows = out, awards = awardLines, me = mine })
		end
	end
	-- Everyone else in the lobby sees the results too (no personal rewards).
	for _, player in Players:GetPlayers() do
		local raced = false
		for _, row in rows do
			if row.userId == player.UserId then
				raced = true
			end
		end
		if not raced then
			Net.Results:FireClient(player, { trackName = def.name, rows = out, awards = awardLines })
		end
	end

	-- Racers go back to the lobby; they ready up again for the next race.
	-- The top three players stand on the podium and celebrate.
	for _, row in rows do
		if row.userId then
			local player = Players:GetPlayerByUserId(row.userId)
			if player then
				choiceOf(player).ready = false
				task.defer(function()
					if not player.Parent then
						return
					end
					player:LoadCharacter()
					if row.place <= 3 then
						local character = player.Character or player.CharacterAdded:Wait()
						task.wait(0.3)
						handles.celebrate(row.place, character)
					end
				end)
			end
		end
	end
	dirty = true
end

-- Voting is over: reveal the winner on every screen and light the
-- departure doors for a few seconds before the race loads.
local function finishVoting()
	-- Highest vote wins; ties are broken at random.
	winner = Voting.winner(options, votes, math.random)
	phase = "announce"
	deadline = now() + Voting.AnnounceSeconds
	handles.setDeparture(true)
	dirty = true
	-- Start shaping the winning track's land now, during the reveal, so the
	-- race usually loads straight away (TrackBuilder waits for it if not).
	local trackId = winner :: string
	task.spawn(TerrainBuilder.ensure, trackId)
end

local function startRace()
	local trackId = winner :: string
	handles.setDeparture(false)
	local entrants = {}
	for player in voters do
		if player.Parent then
			local kartId, look = kartOf(player)
			PracticeService.stop(player)
			table.insert(entrants, {
				id = `u{player.UserId}`,
				name = player.DisplayName,
				isCpu = false,
				player = player,
				kartId = kartId,
				look = look,
				profile = { lane = 0, skill = 1 },
			})
		end
	end
	if #entrants == 0 then
		toLobby()
		return
	end
	local cpuIndex = 0
	while #entrants < RaceRules.MaxRacers do
		cpuIndex += 1
		local driver = Karts.CpuDrivers[cpuIndex]
		table.insert(entrants, {
			id = `cpu{cpuIndex}`,
			name = driver.name,
			isCpu = true,
			kartId = driver.kart,
			look = KartBodies.cpuLook(cpuIndex),
			profile = { lane = ((cpuIndex % 3) - 1) * 0.6, skill = 0.45 + (cpuIndex % 4) * 0.15 },
		})
	end
	phase = "racing"
	deadline = nil
	-- Voters are now racers; their ready flag is spent.
	for player in voters do
		choiceOf(player).ready = false
	end
	voters = {}
	dirty = true
	local ok, err = pcall(RaceService.startRace, trackId, entrants, onRaceEnded)
	if not ok then
		warn("[RoundService] could not start the race:", err)
		RaceService.abort()
		toLobby()
	end
end

local function setReady(player: Player, isReady: boolean)
	if RaceService.isRacing(player) then
		return
	end
	local c = choiceOf(player)
	if c.ready == isReady then
		return
	end
	c.ready = isReady
	if phase == "voting" then
		if isReady then
			voters[player] = true
		else
			voters[player] = nil
			votes[player.UserId] = nil
			randomVoters[player.UserId] = nil
		end
	end
	Net.Notify:FireClient(player, if isReady then "You're in the next race!" else "You left the next race.")
	dirty = true
end

-- A vote for an offered track, or Voting.Random. Random rolls once and keeps
-- its pick until you choose something else, so standing on the pad is stable.
local function castVote(player: Player, choice: string)
	if phase ~= "voting" or not voters[player] then
		return
	end
	local userId = player.UserId
	if choice == Voting.Random then
		if randomVoters[userId] and votes[userId] then
			return
		end
		local pick = Voting.randomPick(options, math.random)
		votes[userId] = pick
		randomVoters[userId] = true
		Net.Notify:FireClient(player, `🎲 Random picked {Tracks.get(pick).name} for you`)
		dirty = true
	elseif table.find(options, choice) and (votes[userId] ~= choice or randomVoters[userId]) then
		votes[userId] = choice
		randomVoters[userId] = nil
		dirty = true
	end
end

local function step()
	local t = now()

	-- Stepping onto a vote pad joins the next race, so voting is one walk
	-- down the stairs from spawn.
	for _, player in Players:GetPlayers() do
		local root = rootOf(player)
		local pad = if root then LobbyLayout.padAt(root.Position.X, root.Position.Z) else nil
		local was = onPad[player]
		onPad[player] = pad
		if pad and pad ~= was and (phase == "lobby" or phase == "voting") and not choiceOf(player).ready then
			setReady(player, true)
		end
	end

	local _, ready = countReady()

	if phase == "lobby" then
		if ready == 0 then
			if deadline then
				deadline = nil
				dirty = true
			end
		else
			if not deadline then
				deadline = t + READY_WAIT
				dirty = true
			end
			-- Everyone in the server ready? No need to wait.
			local total = 0
			for player in choices do
				if player.Parent and not RaceService.isRacing(player) then
					total += 1
				end
			end
			if t >= (deadline :: number) or ready == total then
				startVoting()
			end
		end
	elseif phase == "voting" then
		-- Standing on a vote pad counts as a vote (pad 4 is Random).
		for player in voters do
			local pad = onPad[player]
			if pad == LobbyLayout.RandomPad then
				castVote(player, Voting.Random)
			elseif pad and options[pad] then
				castVote(player, options[pad])
			end
		end
		local anyVoter = next(voters) ~= nil
		if not anyVoter then
			toLobby()
		elseif t >= (deadline :: number) then
			finishVoting()
		end
	elseif phase == "announce" then
		if t >= (deadline :: number) then
			startRace()
		end
	elseif phase == "racing" then
		if not RaceService.isRunning() and phase == "racing" then
			-- The race ended without results (everyone left).
			toLobby()
		end
	elseif phase == "results" then
		if t >= (deadline :: number) then
			toLobby()
		end
	end

	-- Hidden golden tokens in the lobby (saved, paid once each).
	for _, player in Players:GetPlayers() do
		local root = rootOf(player)
		local data = DataService.get(player)
		if root and data then
			for _, token in handles.collectibles do
				local id = tostring(token:GetAttribute("TokenId"))
				if not data.tokens[id] and (token.Position - root.Position).Magnitude < 7 then
					local coins, all = PlayerData.foundToken(data, id, #handles.collectibles)
					local count = 0
					for _ in data.tokens do
						count += 1
					end
					Net.Notify:FireClient(player, `Golden token! +{coins} 🪙 ({count}/{#handles.collectibles})` .. (if all then " All found!" else ""))
					DataService.markDirty(player)
					DataService.push(player)
				end
			end
		end
	end
end

---------------------------------------------------------------------------
-- Remotes and setup
---------------------------------------------------------------------------
function RoundService.start()
	handles = LobbyBuilder.build()
	PracticeService.init()

	local function onPlayer(player: Player)
		choiceOf(player)
		dirty = true
		task.spawn(function()
			DataService.waitFor(player)
			refreshDisplays()
		end)
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		onPlayer(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		choices[player] = nil
		voters[player] = nil
		votes[player.UserId] = nil
		randomVoters[player.UserId] = nil
		onPad[player] = nil
		dirty = true
		task.defer(refreshDisplays)
	end)

	Net.Ready.OnServerEvent:Connect(function(player, isReady)
		setReady(player, isReady == true)
	end)
	Net.Vote.OnServerEvent:Connect(function(player, choice)
		if type(choice) == "string" then
			castVote(player, choice)
		end
	end)
	-- Garage: everything is checked here; the client only asks.
	local textCooldown: { [Player]: number } = {}
	Net.GarageAction.OnServerEvent:Connect(function(player, action, kind, value)
		local data = DataService.get(player)
		if not data or type(action) ~= "string" or type(kind) ~= "string" then
			return
		end
		local ok, err = false, nil
		if action == "buy" then
			ok, err = PlayerData.buy(data, kind, tostring(value))
			if ok then
				ok, err = PlayerData.equip(data, kind, tostring(value))
			end
		elseif action == "equip" then
			if RaceService.isRacing(player) then
				return
			end
			ok, err = PlayerData.equip(data, kind, value)
		elseif action == "text" and (kind == "plate" or kind == "name") then
			if os.clock() - (textCooldown[player] or 0) < 2 then
				return
			end
			textCooldown[player] = os.clock()
			local maxLength = if kind == "plate" then Cosmetics.PlateMaxLength else Cosmetics.NameMaxLength
			local clean = Cosmetics.cleanText(value, maxLength)
			data.equipped[kind] = DataService.filter(player, clean)
			ok = true
		elseif action == "setting" then
			ok = PlayerData.setSetting(data, kind, value == true)
		end
		if ok then
			DataService.markDirty(player)
			refreshDisplays()
		elseif err then
			Net.Notify:FireClient(player, err)
		end
		DataService.push(player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		textCooldown[player] = nil
	end)

	-- Horns: anyone can honk; everyone nearby sees (and hears) it.
	local honkCooldown: { [Player]: number } = {}
	Net.HonkRequest.OnServerEvent:Connect(function(player)
		if os.clock() - (honkCooldown[player] or 0) < 1.5 then
			return
		end
		honkCooldown[player] = os.clock()
		local data = DataService.get(player)
		local horn = Cosmetics.find("horn", data and data.equipped.horn or "beep")
		Net.Honk:FireAllClients(player.DisplayName, horn and horn.id or "beep", player.UserId)
	end)
	Net.UseItem.OnServerEvent:Connect(function(player, aimBack)
		RaceService.useItem(player, aimBack == true)
	end)
	Net.Respawn.OnServerEvent:Connect(RaceService.requestRespawn)

	handles.garagePrompt.Triggered:Connect(function(player)
		Net.OpenGarage:FireClient(player)
	end)

	task.spawn(function()
		local lastSecond = -1
		while true do
			task.wait(TICK)
			local ok, err = pcall(step)
			if not ok then
				warn("[RoundService]", err)
			end
			-- Rebroadcast on changes, and once a second as a safety net.
			local second = math.floor(now())
			if dirty or second ~= lastSecond then
				lastSecond = second
				local ok2, err2 = pcall(broadcast)
				if not ok2 then
					warn("[RoundService] broadcast failed:", err2)
				end
			end
		end
	end)
end

return RoundService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="38">
        <Properties>
          <string name="Name">TerrainBuilder</string>
          <string name="Source"><![CDATA[-- Turns a Landscape plan into Roblox Terrain: grass or sand ground, earth
-- banks under raised road, hills, lakes of real water with sandy shores,
-- mesas and snow-capped mountains. Terrain is smooth, textured and lit by
-- Future lighting, which is what makes the outdoor tracks look realistic.
--
-- Only one track's land exists at a time. `ensure` builds it once (the round
-- calls it as soon as the winning track is announced, so the land is usually
-- ready before the race loads); calling it again for the same track is free.
-- Anything registered with `onCleared` (the lobby's view) is rebuilt after.

local Workspace = game:GetService("Workspace")

local TerrainBuilder = {}

local current: string? = nil
local building: string? = nil
local keepers: { () -> () } = {}

local function material(name: string?): Enum.Material
	local ok, value = pcall(function()
		return (Enum.Material :: any)[name or "Grass"]
	end)
	return if ok and value then value else Enum.Material.Grass
end

local function terrainOf(): Terrain?
	local terrain = Workspace:FindFirstChildOfClass("Terrain")
	-- Lune's test DOM has no Terrain methods; skip building there.
	if not terrain or typeof((terrain :: any).FillBlock) ~= "function" then
		return nil
	end
	return terrain
end

-- Things that must survive a track change (the lobby's window view).
function TerrainBuilder.onCleared(rebuild: () -> ())
	table.insert(keepers, rebuild)
	rebuild()
end

-- Counts fills by kind; the smoke test checks these without real Terrain.
TerrainBuilder.lastCounts = {} :: { [string]: number }

-- `additive` adds to the land already there (the lobby's view) instead of
-- replacing it.
function TerrainBuilder.apply(plan: any, additive: boolean?)
	local counts = { slab = 0, bank = 0, hill = 0, mountain = 0, cap = 0, mesa = 0, lake = 0 }
	if not additive then
		TerrainBuilder.lastCounts = counts
	end
	local terrain = terrainOf()
	local spec = plan.spec
	-- Big fills take time; yield now and then so the server keeps ticking
	-- (the lobby, countdowns and other players) while the land is shaped.
	local fills = 0
	local function breathe()
		fills += 1
		if terrain and fills % 6 == 0 then
			task.wait()
		end
	end
	local ground = material(spec.ground)
	local bankMaterial = material(spec.bank or spec.ground)
	local function fillBlock(cf: CFrame, size: Vector3, m: Enum.Material, kind: string)
		counts[kind] += 1
		if terrain then
			terrain:FillBlock(cf, size, m)
			breathe()
		end
	end
	local function fillBall(b: any, kind: string)
		counts[kind] += 1
		if terrain then
			terrain:FillBall(Vector3.new(b.x, b.y, b.z), b.r, material(b.material))
			breathe()
		end
	end
	local function fillCylinder(cf: CFrame, height: number, radius: number, m: Enum.Material)
		if terrain then
			terrain:FillCylinder(cf, height, radius, m)
			breathe()
		end
	end

	if terrain then
		-- Animated grass blades stand 1-2 studs tall and poke through road
		-- and floors laid just above the ground, so they stay off.
		pcall(function()
			(terrain :: any).Decoration = false
		end)
	end
	if terrain and not additive then
		terrain:Clear()
		for name, c in spec.colors or {} do
			pcall(function()
				terrain:SetMaterialColor(material(name), Color3.fromRGB(c[1], c[2], c[3]))
			end)
		end
		local water = spec.water
		if water then
			terrain.WaterColor = Color3.fromRGB(water.color[1], water.color[2], water.color[3])
			terrain.WaterTransparency = water.transparency or 0.4
			terrain.WaterReflectance = water.reflectance or 0.5
			terrain.WaterWaveSize = water.waveSize or 0.12
			terrain.WaterWaveSpeed = water.waveSpeed or 8
		end
	end

	-- Ground: a slab whose top is just under the lowest road.
	local top = plan.groundTop
	local sx, sz = plan.maxX - plan.minX, plan.maxZ - plan.minZ
	fillBlock(CFrame.new((plan.minX + plan.maxX) / 2, top - 8, (plan.minZ + plan.maxZ) / 2), Vector3.new(sx, 16, sz), ground, "slab")

	-- Banks follow the road's slope (the block is pitched along the segment).
	for _, bank in plan.banks do
		local a = Vector3.new(bank.ax, bank.ay, bank.az)
		local b = Vector3.new(bank.bx, bank.by, bank.bz)
		local length = (b - a).Magnitude
		if length > 0.1 then
			local cf = CFrame.lookAt((a + b) / 2, b) * CFrame.new(0, -bank.depth / 2, 0)
			fillBlock(cf, Vector3.new(bank.width, bank.depth, length + 4), bankMaterial, "bank")
		end
	end

	for _, hill in plan.hills do
		fillBall(hill, "hill")
	end
	for _, m in plan.mesas do
		counts.mesa += 1
		local height = m.top - m.bottom
		fillCylinder(CFrame.new(m.x, m.bottom + height / 2, m.z), height, m.r, material(m.material))
		if m.band then
			-- A darker rock band two thirds of the way up, slightly proud.
			fillCylinder(CFrame.new(m.x, m.bottom + height * 0.66, m.z), height * 0.12, m.r + 1.5, material(m.band))
		end
		-- A softer skirt of fallen sand round the foot.
		fillCylinder(CFrame.new(m.x, top - 1, m.z), 6, m.r * 1.25, ground)
	end
	for _, mountain in plan.mountains do
		fillBall(mountain, "mountain")
	end
	for _, cap in plan.caps do
		fillBall(cap, "cap")
	end

	-- Lakes: a sandy shore, the basin dug out, then water and a muddy bed.
	for _, lake in plan.lakes do
		counts.lake += 1
		local shore = material(lake.shore)
		fillCylinder(CFrame.new(lake.x, top - 2, lake.z), 4.2, lake.r + 12, shore)
		fillCylinder(CFrame.new(lake.x, top + 4, lake.z), 24, lake.r, Enum.Material.Air)
		fillCylinder(CFrame.new(lake.x, top - 11, lake.z), 2, lake.r + 2, Enum.Material.Mud)
		local depth = 9
		fillCylinder(CFrame.new(lake.x, lake.surface - depth / 2, lake.z), depth, lake.r, material(lake.liquid))
	end

	if not additive then
		for _, rebuild in keepers do
			local ok, err = pcall(rebuild)
			if not ok then
				warn("[TerrainBuilder] keeper failed:", err)
			end
		end
	end
end

-- Builds the land for a track once; safe to call from several threads.
function TerrainBuilder.ensure(trackId: string, plan: any?)
	if current == trackId then
		return
	end
	while building do
		task.wait(0.1)
		if current == trackId then
			return
		end
	end
	building = trackId
	local ok, err = pcall(function()
		local p = plan
		if not p then
			local ReplicatedStorage = game:GetService("ReplicatedStorage")
			local Landscape = require(ReplicatedStorage.Shared.Landscape)
			local Track = require(ReplicatedStorage.Shared.Track)
			local Tracks = require(ReplicatedStorage.Shared.Tracks)
			p = Landscape.plan(Track.build(Tracks.get(trackId)))
		end
		if p then
			TerrainBuilder.apply(p)
		end
	end)
	building = nil
	if ok then
		current = trackId
	else
		warn("[TerrainBuilder]", err)
	end
end

return TerrainBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="39">
        <Properties>
          <string name="Name">TrackBuilder</string>
          <string name="Source"><![CDATA[-- Builds a track from its centerline: the road and everything along it
-- (RoadSurface), the land (Landscape + TerrainBuilder for realistic themes, a
-- flat floor otherwise), bridge pillars, boost pads, the start line, zones,
-- shortcuts, landmarks and scenery (see Scenery.luau / Props.luau). Lighting is applied on
-- each client (common/Atmos), so lobby players keep the lobby's look.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Landscape = require(Shared.Landscape)
local RoadGeometry = require(Shared.RoadGeometry)
local Scenery = require(Shared.Scenery)
local Track = require(Shared.Track)
local Tracks = require(Shared.Tracks)

local Landmarks = require(script.Parent.Landmarks)
local Props = require(script.Parent.Props)
local RoadSurface = require(script.Parent.RoadSurface)
local TerrainBuilder = require(script.Parent.TerrainBuilder)
local Shapes = require(ReplicatedStorage.Common.Shapes)

local TrackBuilder = {}

local function rgb(c: { number }): Color3
	return Color3.fromRGB(c[1], c[2], c[3])
end

local function v3(p: Track.Vec): Vector3
	return Vector3.new(p.x, p.y, p.z)
end

local function part(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

export type Options = {
	folderName: string?, -- default "Track"; the lobby practice loop uses its own folder
	ground: boolean?, -- build ground under the track (default true)
	scenery: boolean?, -- place scenery props (default true)
}

function TrackBuilder.build(trackId: string, options: Options?): (Folder, Track.Built)
	local opts = options or {}
	local def = Tracks.get(trackId)
	local track = Track.build(def)
	local theme = Tracks.Themes[def.theme]
	local roadColor, wallColor = rgb(theme.road), rgb(theme.wall)
	local walled = def.walls ~= false

	local folderName = opts.folderName or "Track"
	local old = Workspace:FindFirstChild(folderName)
	if old then
		old:Destroy()
	end
	local folder = Instance.new("Folder")
	folder.Name = folderName
	folder:SetAttribute("TrackId", trackId)

	local half = def.width / 2
	local sw = Track.ShoulderWidth
	local pts = track.points
	local n = #pts
	local minY, minX, maxX, minZ, maxZ = math.huge, math.huge, -math.huge, math.huge, -math.huge
	local markings = Instance.new("Folder")
	markings.Name = "Markings"
	markings.Parent = folder

	-- Wall openings where shortcuts leave and rejoin the road.
	local openings = {}
	for _, sc in def.shortcuts or {} do
		table.insert(openings, { side = sc.side, at = sc.from * track.length, half = sc.width / 2 + 6 })
		table.insert(openings, { side = sc.side, at = sc.to * track.length, half = sc.width / 2 + 6 })
	end
	local function wallOpen(side: number, distance: number, segLen: number): boolean
		for _, o in openings do
			local d = (distance - o.at + track.length / 2) % track.length - track.length / 2
			if o.side == side and math.abs(d) < o.half + segLen / 2 then
				return true
			end
		end
		return false
	end

	for _, p in pts do
		minY = math.min(minY, p.y)
		minX, maxX = math.min(minX, p.x), math.max(maxX, p.x)
		minZ, maxZ = math.min(minZ, p.z), math.max(maxZ, p.z)
	end

	-- Land: realistic themes get Terrain (hills, lakes, mountains, banks under
	-- raised road); the toy-world themes keep a flat part floor.
	local plan = if opts.ground ~= false then Landscape.plan(track) else nil
	if plan then
		TerrainBuilder.ensure(trackId, plan)
	end

	-- Road, curbs, lines, shoulders and barriers from one set of frames.
	local frames = RoadGeometry.frames(track)
	RoadSurface.build(track, frames, folder, { theme = theme, walled = walled, plan = plan, wallOpen = wallOpen })

	-- Pillars under raised road that has no earth bank, skipped where they
	-- would land on the road below.
	local overpass = RoadGeometry.overpasses(track, half + sw + 6, 8)
	local pillarColor = if theme.realistic then Color3.fromRGB(150, 148, 142) else wallColor
	local pillarMaterial = if theme.realistic then Enum.Material.Concrete else Enum.Material.SmoothPlastic
	for i = 1, n, 6 do
		local p = pts[i]
		local banked = plan and plan.bankAt[i]
		if p.y - minY > 8 and not banked and not overpass[i] then
			local h = p.y - minY + 4
			part(folder, "Pillar", Vector3.new(6, h, 6), CFrame.new(p.x, p.y - 1 - h / 2, p.z), pillarColor, pillarMaterial)
		end
	end

	-- Flat floor under everything (themes without terrain).
	if opts.ground ~= false and not plan then
		local margin = 300
		local sizeX, sizeZ = maxX - minX + margin * 2, maxZ - minZ + margin * 2
		local tile = 1000
		for x = minX - margin, minX - margin + sizeX, tile do
			for z = minZ - margin, minZ - margin + sizeZ, tile do
				local g = part(folder, "Ground", Vector3.new(tile, 2, tile), CFrame.new(x + tile / 2, minY - 1.6, z + tile / 2), rgb(theme.ground), Enum.Material.SmoothPlastic)
				g:SetAttribute("Surface", "offroad")
			end
		end
	end

	-- Boost pads (visual; the surface is worked out from Track.surfaceAt).
	for _, pad in Track.pads(track) do
		local pos = v3(Track.spot(track, pad.distance, pad.lateral))
		local _, tan = Track.at(track, pad.distance)
		local cf = CFrame.lookAt(pos, pos + v3(tan))
		local p = part(folder, "BoostPad", Vector3.new(Track.PadWidth, 0.2, Track.PadLength), cf * CFrame.new(0, 0.05, 0), rgb(theme.accent), Enum.Material.Neon)
		p.CanCollide = false
		p.CanQuery = false
		for k = -1, 1 do
			local arrow = part(folder, "Arrow", Vector3.new(6, 0.25, 2), cf * CFrame.new(0, 0.12, k * 7) * CFrame.Angles(0, math.rad(45), 0), Color3.new(1, 1, 1), Enum.Material.Neon)
			arrow.CanCollide = false
			arrow.CanQuery = false
		end
	end

	-- Checkered start/finish line.
	local start, tan = Track.at(track, 0)
	local lineCf = CFrame.lookAt(v3(start), v3(start) + v3(tan))
	local squares = 8
	for k = 0, squares - 1 do
		for row = 0, 1 do
			local sq = part(folder, "Finish", Vector3.new(def.width / squares, 0.2, 3), lineCf * CFrame.new(-half + (k + 0.5) * def.width / squares, 0.06, (row - 0.5) * 3), if (k + row) % 2 == 0 then Color3.new(1, 1, 1) else Color3.new(0.05, 0.05, 0.05), Enum.Material.SmoothPlastic)
			sq.CanCollide = false
			sq.CanQuery = false
		end
	end
	-- Banner over the line.
	for _, side in { -1, 1 } do
		part(folder, "BannerPost", Vector3.new(1.5, 18, 1.5), lineCf * CFrame.new(side * (half + 4), 9, 0), wallColor, Enum.Material.SmoothPlastic)
	end
	part(folder, "Banner", Vector3.new(def.width + 10, 3, 1), lineCf * CFrame.new(0, 17, 0), rgb(theme.accent), Enum.Material.Neon)

	-- Surface patches: syrup, water, conveyor belts, launch pads.
	local zoneStyle = {
		sticky = { color = Color3.fromRGB(150, 85, 30), material = Enum.Material.Glass, transparency = 0.1 },
		slippery = { color = Color3.fromRGB(120, 190, 255), material = Enum.Material.Glass, transparency = 0.35 },
		conveyor = { color = Color3.fromRGB(70, 72, 82), material = Enum.Material.SmoothPlastic, transparency = 0 },
		launch = { color = Color3.fromRGB(255, 80, 80), material = Enum.Material.Neon, transparency = 0 },
	}
	for zi, zone in def.zones or {} do
		local style = zoneStyle[zone.kind]
		if style then
			local width = zone.width or def.width
			local offset = (zone.offset or 0) * (half - width / 2)
			local from = zone.t * track.length - zone.length / 2
			local steps = math.max(1, math.ceil(zone.length / 10))
			for k = 0, steps - 1 do
				local d = from + (k + 0.5) * zone.length / steps
				local p = v3(Track.spot(track, d, offset))
				local _, tan = Track.at(track, d)
				local zcf = CFrame.lookAt(p, p + v3(tan))
				local patch = part(markings, "Zone", Vector3.new(width, 0.12, zone.length / steps + 0.4), zcf * CFrame.new(0, 0.07, 0), style.color, style.material)
				patch.Transparency = style.transparency
				patch.CanCollide = false
				patch.CanQuery = false
				patch:SetAttribute("ZoneIndex", zi)
				if zone.kind == "conveyor" and k % 2 == 0 then
					local arrow = part(markings, "ConveyorArrow", Vector3.new(width * 0.5, 0.15, 2), zcf * CFrame.new(0, 0.1, 0) * CFrame.Angles(0, math.rad(45), 0), Color3.fromRGB(255, 210, 60), Enum.Material.Neon)
					arrow.CanCollide = false
					arrow.CanQuery = false
				end
			end
		end
	end

	-- Shortcut paths: a narrow road through the gap in the wall.
	local shortcutMaterial = if theme.realistic then Enum.Material.Asphalt else Enum.Material.SmoothPlastic
	for _, sc in def.shortcuts or {} do
		local sa, sb = Track.shortcutEnds(track, sc)
		local pa, pb = v3(sa), v3(sb)
		local length = (pb - pa).Magnitude + sc.width
		local scCf = CFrame.lookAt((pa + pb) / 2, pb)
		-- As thick as the main road, so terrain under it stays hidden.
		local road = part(folder, "ShortcutRoad", Vector3.new(sc.width, 4, length), scCf * CFrame.new(0, -2, 0), roadColor:Lerp(rgb(theme.accent), 0.25), shortcutMaterial)
		road:SetAttribute("Surface", sc.surface or "road")
		-- Connect each end to the road edge across the grass shoulder.
		for _, endpoint in { { at = sc.from, p = pa }, { at = sc.to, p = pb } } do
			local edge = v3(Track.spot(track, endpoint.at * track.length, sc.side * half))
			local link = (endpoint.p - edge)
			part(folder, "ShortcutLink", Vector3.new(sc.width, 4, link.Magnitude + sc.width), CFrame.lookAt((edge + endpoint.p) / 2, endpoint.p) * CFrame.new(0, -1.99, 0), roadColor:Lerp(rgb(theme.accent), 0.25), shortcutMaterial)
		end
		-- Posts either side of the entry hint the way in (shortcut blue on
		-- realistic tracks, the theme's glow elsewhere).
		local postColor = if theme.realistic then Color3.fromRGB(60, 150, 255) else rgb(theme.accent)
		local postMaterial = if theme.realistic then Enum.Material.SmoothPlastic else Enum.Material.Neon
		for _, side in { -1, 1 } do
			Shapes.box(folder, Vector3.new(0.8, 6, 0.8), scCf * CFrame.new(side * (sc.width / 2 + 1), 3, -length / 2 + 2), { color = postColor, material = postMaterial })
		end
		if def.theme == "backyard" then
			-- The shortcut runs through a hollow log.
			local logLen = math.min(length * 0.5, 60)
			for z = -logLen / 2, logLen / 2, 4 do
				Shapes.arch(folder, sc.width + 6, 3, 4.5, scCf * CFrame.new(0, -2, z), { color = Color3.fromRGB(130, 90, 55), collide = true }, 14)
			end
		end
	end

	-- Tunnels, landmarks and moving crossers.
	local landmarks = Instance.new("Folder")
	landmarks.Name = "Landmarks"
	landmarks.Parent = folder
	for _, tn in def.tunnels or {} do
		Landmarks.tunnel(track, tn.style, tn.from, tn.to, theme, landmarks)
	end
	for _, spot in Scenery.setPieceSpots(track) do
		Landmarks.setPiece(spot.kind, CFrame.new(spot.x, spot.y, spot.z) * CFrame.Angles(0, spot.yaw, 0), theme, landmarks)
	end
	local crossersFolder = Instance.new("Folder")
	crossersFolder.Name = "Crossers"
	crossersFolder.Parent = folder
	for ci, cr in def.crossers or {} do
		local p = Track.spot(track, cr.t * track.length, -(half + sw))
		Landmarks.crosser(cr.kind, ci, crossersFolder, CFrame.new(p.x, p.y, p.z))
	end
	if theme.room then
		Landmarks.room(theme, minX, maxX, minZ, maxZ, minY, landmarks)
	end

	-- Jump ramps. The low edge faces oncoming karts; the tall back edge launches them.
	for _, ramp in def.ramps or {} do
		local d = ramp.t * track.length
		local pos = v3(Track.spot(track, d, ramp.offset * (half - ramp.width / 2)))
		local _, rampTan = Track.at(track, d)
		local cf = CFrame.lookAt(pos, pos - v3(rampTan))
		local wedge = Instance.new("WedgePart")
		wedge.Name = "Ramp"
		wedge.Anchored = true
		wedge.Size = Vector3.new(ramp.width, 5, 18)
		wedge.CFrame = cf * CFrame.new(0, 2.5, 0)
		wedge.Color = rgb(theme.accent)
		wedge.Material = Enum.Material.SmoothPlastic
		wedge.TopSurface = Enum.SurfaceType.Smooth
		wedge:SetAttribute("Surface", "ramp")
		wedge.Parent = folder
		for k = -1, 1, 2 do
			local stripe = part(folder, "RampStripe", Vector3.new(1.2, 0.2, 18.6), cf * CFrame.new(k * (ramp.width / 2 - 1.5), 2.6, 0) * CFrame.Angles(-math.atan2(5, 18), 0, 0), Color3.new(1, 1, 1), Enum.Material.Neon)
			stripe.CanCollide = false
			stripe.CanQuery = false
		end
	end

	-- Scenery around the track.
	if opts.scenery ~= false then
		local scenery = Instance.new("Folder")
		scenery.Name = "Scenery"
		scenery.Parent = folder
		for _, prop in Scenery.place(track) do
			if plan then
				-- Stand props on the land; skip any that would be in a lake.
				local y = Landscape.groundAt(plan, prop.x, prop.z)
				if y then
					prop.y = y
					Props.build(prop, theme, scenery)
				end
			else
				Props.build(prop, theme, scenery)
			end
		end
	end

	if def.theme == "fortress" then
		require(script.Parent.FortressBuilder).build(track, folder)
	end

	folder.Parent = Workspace
	return folder, track
end

return TrackBuilder
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="40">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">80</float>
      <token name="DevCameraOcclusionMode">1</token>
      <float name="HealthDisplayDistance">0</float>
      <float name="NameDisplayDistance">45</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="41">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="42">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">GarageUI</string>
            <string name="Source"><![CDATA[-- The garage: a live 3D preview of your kart plus tabs for kart type (stats),
-- body, paint, wheels, stickers, horn, trail, name & plate, records and
-- settings. Locked items show their coin price; tap to unlock. Every change
-- goes to the server, which checks it, saves it and sends your data back.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Cosmetics = require(Shared:WaitForChild("Cosmetics"))
local KartBodies = require(Shared:WaitForChild("KartBodies"))
local Karts = require(Shared:WaitForChild("Karts"))
local Rewards = require(Shared:WaitForChild("Rewards"))
local Track = require(Shared:WaitForChild("Track"))
local Tracks = require(Shared:WaitForChild("Tracks"))
local KartRig = require(ReplicatedStorage:WaitForChild("Common"):WaitForChild("KartRig"))

local UI = require(script.Parent.UI)

local GarageUI = {}

-- Set by Main: (action, kind, value) sent to the server.
GarageUI.onAction = nil :: ((string, string, any) -> ())?

local data: any = nil
local canSave = true
local tab = "kart"

local panel = UI.panel(UI.Screen, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0, 860, 0, 560), Visible = false })
UI.fit(panel, Vector2.new(860, 560))
UI.label(panel, { Position = UDim2.new(0, 20, 0, 10), Size = UDim2.new(0, 260, 0, 44), Text = "🔧 GARAGE", TextColor3 = UI.Colors.yellow, TextXAlignment = Enum.TextXAlignment.Left })
local coinsLabel = UI.label(panel, { Position = UDim2.new(0, 280, 0, 14), Size = UDim2.new(0, 200, 0, 36), Text = "🪙 0", TextXAlignment = Enum.TextXAlignment.Left })
local saveNote = UI.label(panel, { Position = UDim2.new(0, 480, 0, 18), Size = UDim2.new(0, 280, 0, 28), Text = "", TextColor3 = UI.Colors.red })
UI.button(panel, "✕", UI.Colors.red, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 12), Size = UDim2.new(0, 52, 0, 46) }, function()
	GarageUI.close()
end)

-- Preview ------------------------------------------------------------------
local viewport = Instance.new("ViewportFrame")
viewport.Position = UDim2.new(0, 20, 0, 66)
viewport.Size = UDim2.new(0, 300, 0, 300)
viewport.BackgroundColor3 = Color3.fromRGB(60, 56, 100)
viewport.Ambient = Color3.fromRGB(170, 170, 190)
viewport.LightColor = Color3.fromRGB(255, 250, 240)
viewport.LightDirection = Vector3.new(-1, -2, -1)
viewport.Parent = panel
local vpCorner = Instance.new("UICorner")
vpCorner.CornerRadius = UDim.new(0, 18)
vpCorner.Parent = viewport
local world = Instance.new("WorldModel")
world.Parent = viewport
local vpCamera = Instance.new("Camera")
vpCamera.FieldOfView = 40
vpCamera.CFrame = CFrame.lookAt(Vector3.new(11, 7, -13), Vector3.new(0, 1.6, 0))
vpCamera.Parent = viewport
viewport.CurrentCamera = vpCamera
local floor = Instance.new("Part")
floor.Anchored = true
floor.Shape = Enum.PartType.Cylinder
floor.Size = Vector3.new(0.4, 16, 16)
floor.CFrame = CFrame.new(0, -0.2, 0) * CFrame.Angles(0, 0, math.rad(90))
floor.Color = Color3.fromRGB(230, 225, 240)
floor.Parent = world
local previewKart: Model? = nil
local nameLabel = UI.label(panel, { Position = UDim2.new(0, 20, 0, 372), Size = UDim2.new(0, 300, 0, 30), Text = "" })
local statsLabel = UI.label(panel, { Position = UDim2.new(0, 20, 0, 404), Size = UDim2.new(0, 300, 0, 60), TextScaled = false, TextSize = 16, Text = "", TextColor3 = UI.Colors.muted })

local function rebuildPreview()
	if previewKart then
		previewKart:Destroy()
		previewKart = nil
	end
	if not data then
		return
	end
	local e = data.equipped
	local look = { body = e.body, main = e.main, accent = e.accent, wheels = e.wheels, sticker = e.sticker, trail = "none", plate = e.plate }
	local ok, kart = pcall(KartRig.build, e.kart, if e.name ~= "" then e.name else "My Kart", CFrame.new(0, 0, 0), world, look)
	if ok then
		previewKart = kart
		local tag = kart:FindFirstChild("NameTag")
		if tag then
			tag:Destroy()
		end
	end
	nameLabel.Text = if e.name ~= "" then `"{e.name}"` else KartBodies.get(e.body).name
	local stats = Karts.get(e.kart)
	statsLabel.Text = `{stats.name} engine · {stats.blurb}`
end

RunService.RenderStepped:Connect(function()
	if previewKart and panel.Visible then
		local yaw = os.clock() * 0.6
		local pivot = CFrame.new(0, 0, 0) * CFrame.Angles(0, yaw, 0)
		previewKart:PivotTo(pivot + Vector3.new(0, KartRig.BallRadius + 0.2, 0))
	end
end)

-- Tabs -----------------------------------------------------------------------
local TABS = {
	{ id = "kart", name = "Engine" },
	{ id = "body", name = "Body" },
	{ id = "paint", name = "Paint" },
	{ id = "wheels", name = "Wheels" },
	{ id = "sticker", name = "Stickers" },
	{ id = "horn", name = "Horn" },
	{ id = "trail", name = "Trail" },
	{ id = "name", name = "Name & Plate" },
	{ id = "records", name = "Records" },
	{ id = "settings", name = "Settings" },
}
local tabBar = Instance.new("Frame")
tabBar.BackgroundTransparency = 1
tabBar.Position = UDim2.new(0, 340, 0, 66)
tabBar.Size = UDim2.new(1, -360, 0, 92)
tabBar.Parent = panel
local tabGrid = Instance.new("UIGridLayout")
tabGrid.CellSize = UDim2.new(0, 96, 0, 40)
tabGrid.CellPadding = UDim2.new(0, 6, 0, 6)
tabGrid.SortOrder = Enum.SortOrder.LayoutOrder
tabGrid.Parent = tabBar
local tabButtons: { [string]: TextButton } = {}
for i, t in TABS do
	tabButtons[t.id] = UI.button(tabBar, t.name, UI.Colors.panelLight, { LayoutOrder = i, TextScaled = true }, function()
		tab = t.id
		GarageUI.render()
	end)
end

local content = Instance.new("ScrollingFrame")
content.BackgroundTransparency = 1
content.BorderSizePixel = 0
content.Position = UDim2.new(0, 340, 0, 168)
content.Size = UDim2.new(1, -360, 1, -184)
content.ScrollBarThickness = 8
content.AutomaticCanvasSize = Enum.AutomaticSize.Y
content.CanvasSize = UDim2.new()
content.Parent = panel

local function clear()
	for _, child in content:GetChildren() do
		child:Destroy()
	end
end

local function grid(cell: UDim2)
	local g = Instance.new("UIGridLayout")
	g.CellSize = cell
	g.CellPadding = UDim2.new(0, 8, 0, 8)
	g.SortOrder = Enum.SortOrder.LayoutOrder
	g.Parent = content
end

local function act(action: string, kind: string, value: any)
	if GarageUI.onAction then
		GarageUI.onAction(action, kind, value)
	end
end

-- A tile for one cosmetic: equipped (highlighted), owned (tap to equip) or locked (tap to buy).
local function itemTile(kind: string, item: any, order: number)
	local owned = data.owned[kind] and data.owned[kind][item.id]
	local equipped = data.equipped[kind] == item.id
	local price = item.price or 0
	local color = if equipped then UI.Colors.green elseif owned then UI.Colors.panelLight else Color3.fromRGB(70, 60, 90)
	local tile = UI.button(content, "", color, { LayoutOrder = order }, function()
		if owned then
			act("equip", kind, item.id)
		else
			act("buy", kind, item.id)
		end
	end)
	UI.label(tile, { Size = UDim2.new(1, 0, 0.55, 0), Text = item.icon or "🏎️" })
	UI.label(tile, { Position = UDim2.new(0, 0, 0.55, 0), Size = UDim2.new(1, 0, 0.25, 0), Text = item.name })
	UI.label(tile, {
		Position = UDim2.new(0, 0, 0.8, 0),
		Size = UDim2.new(1, 0, 0.2, 0),
		Text = if equipped then "Equipped" elseif owned then "Owned" else `🪙 {price}`,
		TextColor3 = if owned then UI.Colors.muted else UI.Colors.yellow,
	})
	UI.highlight(tile, equipped)
end

local function textRow(order: number, title: string, kind: string, maxLength: number)
	local row = Instance.new("Frame")
	row.BackgroundTransparency = 1
	row.Size = UDim2.new(1, -10, 0, 56)
	row.LayoutOrder = order
	row.Parent = content
	UI.label(row, { Size = UDim2.new(0, 120, 1, 0), Text = title, TextXAlignment = Enum.TextXAlignment.Left })
	local box = Instance.new("TextBox")
	box.Position = UDim2.new(0, 130, 0, 6)
	box.Size = UDim2.new(1, -260, 0, 44)
	box.BackgroundColor3 = Color3.fromRGB(245, 245, 250)
	box.TextColor3 = Color3.fromRGB(40, 40, 60)
	box.Font = UI.Font
	box.TextScaled = true
	box.ClearTextOnFocus = false
	box.PlaceholderText = `up to {maxLength} letters`
	box.Text = data.equipped[kind] or ""
	box.Parent = row
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = box
	box:GetPropertyChangedSignal("Text"):Connect(function()
		if #box.Text > maxLength then
			box.Text = string.sub(box.Text, 1, maxLength)
		end
	end)
	UI.button(row, "SAVE", UI.Colors.green, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 6), Size = UDim2.new(0, 110, 0, 44) }, function()
		act("text", kind, box.Text)
	end)
end

function GarageUI.render()
	for id, b in tabButtons do
		b.BackgroundColor3 = if id == tab then UI.Colors.purple else UI.Colors.panelLight
	end
	clear()
	if not data then
		return
	end
	coinsLabel.Text = `🪙 {data.coins}`
	saveNote.Text = if canSave then "" else "⚠ Progress isn't saving this session"

	if tab == "kart" then
		grid(UDim2.new(0, 150, 0, 150))
		for i, def in Karts.List do
			local equipped = data.equipped.kart == def.id
			local tile = UI.button(content, "", if equipped then UI.Colors.green else UI.Colors.panelLight, { LayoutOrder = i }, function()
				act("equip", "kart", def.id)
			end)
			UI.label(tile, { Size = UDim2.new(1, 0, 0, 30), Text = def.name })
			UI.label(tile, { Position = UDim2.new(0, 0, 0, 34), Size = UDim2.new(1, 0, 1, -34), TextScaled = false, TextSize = 14, TextWrapped = true, Text = def.blurb, TextColor3 = UI.Colors.muted })
			UI.highlight(tile, equipped)
		end
	elseif tab == "body" then
		grid(UDim2.new(0, 112, 0, 112))
		for i, body in KartBodies.List do
			itemTile("body", { id = body.id, name = body.name, icon = (body :: any).icon or "🏎️", price = (body :: any).price or 0 }, i)
		end
	elseif tab == "paint" then
		UI.list(content, false, 8)
		for section, key in { "Paint", "Trim" } do
			local title = if key == "Paint" then "main" else "accent"
			UI.label(content, { LayoutOrder = section * 2 - 1, Size = UDim2.new(1, -10, 0, 30), Text = key, TextColor3 = UI.Colors.yellow, TextXAlignment = Enum.TextXAlignment.Left })
			local row = Instance.new("Frame")
			row.BackgroundTransparency = 1
			row.LayoutOrder = section * 2
			row.Size = UDim2.new(1, -10, 0, 108)
			row.Parent = content
			local g = Instance.new("UIGridLayout")
			g.CellSize = UDim2.new(0, 46, 0, 46)
			g.CellPadding = UDim2.new(0, 8, 0, 8)
			g.SortOrder = Enum.SortOrder.LayoutOrder
			g.Parent = row
			for i, c in KartBodies.Palette do
				local b = UI.button(row, "", Color3.fromRGB(c[1], c[2], c[3]), { LayoutOrder = i }, function()
					act("equip", title, i)
				end)
				UI.highlight(b, data.equipped[title] == i)
			end
		end
	elseif tab == "wheels" or tab == "sticker" or tab == "horn" or tab == "trail" then
		grid(UDim2.new(0, 112, 0, 112))
		for i, item in Cosmetics.Lists[tab] do
			itemTile(tab, item, i)
		end
	elseif tab == "name" then
		UI.list(content, false, 10)
		textRow(1, "Kart name", "name", Cosmetics.NameMaxLength)
		textRow(2, "Plate", "plate", Cosmetics.PlateMaxLength)
		UI.label(content, { LayoutOrder = 3, Size = UDim2.new(1, -10, 0, 40), TextScaled = false, TextSize = 15, Text = "Names and plates are checked by Roblox's text filter before others see them.", TextColor3 = UI.Colors.muted })
	elseif tab == "records" then
		UI.list(content, false, 6)
		local order = 0
		local function line(text: string, color: Color3?)
			order += 1
			UI.label(content, { LayoutOrder = order, Size = UDim2.new(1, -10, 0, 28), TextScaled = false, TextSize = 17, TextXAlignment = Enum.TextXAlignment.Left, Text = text, TextColor3 = color or UI.Colors.text })
		end
		line("Track mastery", UI.Colors.yellow)
		for _, def in Tracks.List do
			local m = data.mastery[def.id]
			local length = Track.build(def).length
			local badge = if m then Rewards.badge(m, length) else 0
			local icon = if badge > 0 then Rewards.BadgeIcons[badge] else "▫️"
			local best = if m and m.bestLap then UI.time(m.bestLap) else "--"
			local wins = if m then m.wins else 0
			line(`{icon} {def.name}   best lap {best}   wins {wins}   gold lap {UI.time(Rewards.goldLap(length))}`)
		end
		line(" ")
		line("Challenges", UI.Colors.yellow)
		for _, c in Rewards.Challenges do
			local done = data.challenges[c.id]
			line(`{if done then "✅" else "⬜"} {c.name}   (+{c.reward} 🪙)`, if done then UI.Colors.muted else nil)
		end
		local tokens = 0
		for _ in data.tokens do
			tokens += 1
		end
		line(" ")
		line(`Golden tokens found: {tokens}   Races: {data.stats.races}   Wins: {data.stats.wins}`)
	elseif tab == "settings" then
		UI.list(content, false, 10)
		local options = {
			{ key = "autoAccelerate", name = "Auto-accelerate (great on phones)" },
			{ key = "reducedEffects", name = "Fewer effects (faster on older devices)" },
			{ key = "cameraFar", name = "Camera further back" },
		}
		for i, o in options do
			local on = data.settings[o.key]
			UI.button(content, `{if on then "✅" else "⬜"}  {o.name}`, if on then UI.Colors.green else UI.Colors.panelLight, { LayoutOrder = i, Size = UDim2.new(1, -10, 0, 52) }, function()
				act("setting", o.key, not on)
			end)
		end
	end
end

function GarageUI.setData(newData: any, saving: boolean?)
	data = newData
	canSave = saving ~= false
	if panel.Visible then
		GarageUI.render()
		rebuildPreview()
	end
end

function GarageUI.open()
	panel.Visible = true
	UI.pop(panel)
	GarageUI.render()
	rebuildPreview()
end

function GarageUI.close()
	panel.Visible = false
end

function GarageUI.toggle()
	if panel.Visible then
		GarageUI.close()
	else
		GarageUI.open()
	end
end

return GarageUI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">Hud</string>
            <string name="Source"><![CDATA[-- In-race screens: place, lap, item slot with roulette, standings, countdown,
-- warnings, speed, touch buttons, and the results screen after each race.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Items = require(Shared:WaitForChild("Items"))

local UI = require(script.Parent.UI)

local Hud = {}

local PLACE_COLORS = { Color3.fromRGB(255, 210, 60), Color3.fromRGB(210, 220, 235), Color3.fromRGB(240, 150, 80) }

local race = Instance.new("Frame")
race.Name = "Race"
race.BackgroundTransparency = 1
race.Size = UDim2.fromScale(1, 1)
race.Visible = false
race.Parent = UI.Screen

local placeLabel = UI.label(race, { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -24, 1, -20), Size = UDim2.new(0, 210, 0, 110), Text = "" })
local lapPanel = UI.panel(race, { Position = UDim2.new(0, 16, 0, 14), Size = UDim2.new(0, 220, 0, 74) })
local lapLabel = UI.label(lapPanel, { Position = UDim2.new(0, 12, 0, 6), Size = UDim2.new(1, -24, 0, 40), Text = "", TextXAlignment = Enum.TextXAlignment.Left })
local trackLabel = UI.label(lapPanel, { Position = UDim2.new(0, 12, 0, 46), Size = UDim2.new(1, -24, 0, 20), Text = "", TextColor3 = UI.Colors.muted, TextXAlignment = Enum.TextXAlignment.Left })

local itemSlot = UI.panel(race, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 12), Size = UDim2.new(0, 230, 0, 92) })
local itemIcon = UI.label(itemSlot, { Position = UDim2.new(0, 10, 0, 8), Size = UDim2.new(0, 64, 0, 64), Text = "" })
local itemLabel = UI.label(itemSlot, { Position = UDim2.new(0, 80, 0, 10), Size = UDim2.new(1, -90, 0, 36), Text = "", TextXAlignment = Enum.TextXAlignment.Left })
local itemHint = UI.label(itemSlot, { Position = UDim2.new(0, 80, 0, 50), Size = UDim2.new(1, -90, 0, 30), Text = "", TextColor3 = UI.Colors.muted, TextXAlignment = Enum.TextXAlignment.Left })

local standings = UI.panel(race, { Position = UDim2.new(0, 16, 0, 98), Size = UDim2.new(0, 200, 0, 8 * 24 + 16) })
local standingRows: { TextLabel } = {}
for i = 1, 8 do
	standingRows[i] = UI.label(standings, {
		Position = UDim2.new(0, 12, 0, 8 + (i - 1) * 24),
		Size = UDim2.new(1, -24, 0, 22),
		TextScaled = false,
		TextSize = 17,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = "",
	})
end
local bigText = UI.label(race, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.36), Size = UDim2.new(0, 520, 0, 130), Text = "", TextColor3 = UI.Colors.yellow, TextStrokeTransparency = 0.2 })
local speedLabel = UI.label(race, { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -24, 1, -132), Size = UDim2.new(0, 210, 0, 32), Text = "" })
local warnLabel = UI.label(race, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 112), Size = UDim2.new(0, 420, 0, 42), Text = "", TextColor3 = UI.Colors.red, TextStrokeTransparency = 0.3 })
local timeoutLabel = UI.label(race, { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -24), Size = UDim2.new(0, 420, 0, 30), Text = "", TextColor3 = UI.Colors.yellow })

local raceInfo: any = nil
local raceState: any = nil
local item: { id: string?, uses: number, readyAt: number } = { id = nil, uses = 0, readyAt = 0 }
local flashUntil, flashText = 0, ""
local warnUntil, warnText = 0, ""

function Hud.raceStarted(info: any)
	raceInfo = info
	raceState = nil
	item = { id = nil, uses = 0, readyAt = 0 }
	race.Visible = true
	trackLabel.Text = info.trackName or ""
	lapLabel.Text = `LAP 1/{info.laps or 3}`
end

function Hud.raceEnded()
	race.Visible = false
	raceInfo = nil
end

function Hud.isRacing(): boolean
	return raceInfo ~= nil
end

function Hud.setRaceState(s: any)
	raceState = s
	lapLabel.Text = if s.finishTime then `🏁 {UI.time(s.finishTime)}` else `LAP {s.lap}/{s.laps}`
	placeLabel.Text = UI.ordinal(s.place)
	placeLabel.TextColor3 = PLACE_COLORS[s.place] or UI.Colors.text
	for i, row in standingRows do
		local r = s.rows[i]
		row.Text = if r then `{i}. {r.name}{if r.finished then "  🏁" else ""}` else ""
		row.TextColor3 = if r and not r.isCpu then UI.Colors.yellow else UI.Colors.text
	end
end

function Hud.setItem(id: string?, uses: number, readyAt: number)
	item = { id = id, uses = uses, readyAt = readyAt }
end

function Hud.flash(message: string, seconds: number?)
	flashText = message
	flashUntil = os.clock() + (seconds or 1.5)
end

function Hud.warn(message: string, seconds: number?)
	warnText = message
	warnUntil = os.clock() + (seconds or 1.5)
end

function Hud.setKart(info: any)
	if info.countdown and info.countdown > 0 then
		local n = math.ceil(info.countdown)
		bigText.Text = if n <= 3 then tostring(n) else "GET READY"
	elseif os.clock() < flashUntil then
		bigText.Text = flashText
	else
		bigText.Text = ""
	end
	speedLabel.Text = `{math.floor(math.abs(info.speed or 0) * 0.6 + 0.5)} km/h`
	if os.clock() < warnUntil then
		warnLabel.Text = warnText
	else
		warnLabel.Text = if info.wrongWay then "WRONG WAY!" elseif info.drafting then "💨 SLIPSTREAM" else ""
		warnLabel.TextColor3 = if info.wrongWay then UI.Colors.red else UI.Colors.blue
	end
end

function Hud.update()
	if not raceInfo then
		return
	end
	local t = Workspace:GetServerTimeNow()
	if raceInfo.goTime and t >= raceInfo.goTime and t < raceInfo.goTime + 1 and os.clock() >= flashUntil then
		bigText.Text = "GO!"
	end
	if raceState and raceState.endAt and not raceState.finishTime then
		timeoutLabel.Text = `⏱ Race ends in {math.max(0, math.ceil(raceState.endAt - t))}s`
	else
		timeoutLabel.Text = ""
	end
	if item.id then
		local def = Items.Defs[item.id]
		if t < item.readyAt then
			-- Roulette: flick through items until it lands.
			local i = math.floor(t * 14) % #Items.Order + 1
			local spin = Items.Defs[Items.Order[i]]
			itemIcon.Text = spin.icon or "?"
			itemLabel.Text = spin.name
			itemHint.Text = ""
		else
			itemIcon.Text = def.icon or "?"
			itemLabel.Text = if item.uses > 1 then `{def.name} x{item.uses}` else def.name
			itemHint.Text = "E / X / ITEM · hold S to aim back"
		end
	else
		itemIcon.Text = "❔"
		itemLabel.Text = "No item"
		itemHint.Text = "Drive through a ? box"
	end
end

---------------------------------------------------------------------------
-- Results
---------------------------------------------------------------------------
local results = UI.panel(UI.Screen, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0, 520, 0, 580), Visible = false })
UI.fit(results, Vector2.new(520, 580))
local resultsTitle = UI.label(results, { Position = UDim2.new(0, 20, 0, 12), Size = UDim2.new(1, -40, 0, 40), TextColor3 = UI.Colors.yellow, Text = "" })
local resultsBody = UI.label(results, {
	Position = UDim2.new(0, 24, 0, 62),
	Size = UDim2.new(1, -48, 1, -130),
	TextScaled = false,
	TextSize = 17,
	TextXAlignment = Enum.TextXAlignment.Left,
	TextYAlignment = Enum.TextYAlignment.Top,
	RichText = true,
	Text = "",
})
UI.button(results, "OK", UI.Colors.green, { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -14), Size = UDim2.new(0, 160, 0, 50) }, function()
	results.Visible = false
end)

function Hud.showResults(info: any)
	Hud.raceEnded()
	resultsTitle.Text = `🏁 {info.trackName}`
	local lines = {}
	for _, r in info.rows do
		local name = if r.isCpu then r.name else `<font color="#FFD23C">{r.name}</font>`
		local medal = ({ "🥇", "🥈", "🥉" })[r.place] or `{r.place}.`
		table.insert(lines, `{medal}  {name}   {if r.finished then UI.time(r.time) else "DNF"}`)
	end
	for _, line in info.extra or {} do
		table.insert(lines, line)
	end
	resultsBody.Text = table.concat(lines, "\n")
	results.Visible = true
	UI.pop(results)
	task.delay(14, function()
		results.Visible = false
	end)
end

---------------------------------------------------------------------------
-- Touch buttons
---------------------------------------------------------------------------
-- Touch controls live in their own layer so they also work on the practice loop.
local touch = Instance.new("Frame")
touch.Name = "Touch"
touch.BackgroundTransparency = 1
touch.Size = UDim2.fromScale(1, 1)
touch.Visible = false
touch.Parent = UI.Screen

function Hud.setDriving(on: boolean)
	touch.Visible = on
end

function Hud.addTouchButtons(onDrift: (boolean) -> (), onItem: () -> (), onReset: () -> ())
	local drift = UI.button(touch, "DRIFT", UI.Colors.pink, { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -24, 1, -176), Size = UDim2.new(0, 120, 0, 90) })
	drift.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch then
			onDrift(true)
		end
	end)
	drift.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch then
			onDrift(false)
		end
	end)
	UI.button(touch, "ITEM", UI.Colors.blue, { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -154, 1, -176), Size = UDim2.new(0, 100, 0, 90) }, onItem)
	UI.button(touch, "↺", UI.Colors.panelLight, { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -264, 1, -196), Size = UDim2.new(0, 60, 0, 60) }, onReset)
end

return Hud
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">KartController</string>
            <string name="Source"><![CDATA[-- Drives your kart: reads input, runs KartPhysics on this client (you own the
-- kart's physics), handles drift / items / rocket starts, and runs the chase
-- camera.
--
-- Two modes: "race" (server tracks laps, respawns and items) and "practice"
-- (the lobby loop; nothing is scored and resets happen here on the client).
--
-- Controls: W/S or stick to drive, A/D steer, Space or Shift to drift,
-- E to use your item (hold S to aim it behind you), R to reset a stuck kart.
-- Gamepad: R2/L2 gas and brake, R1 drift, X item, Y reset.

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local KartPhysics = require(Shared:WaitForChild("KartPhysics"))
local Karts = require(Shared:WaitForChild("Karts"))
local RaceRules = require(Shared:WaitForChild("RaceRules"))
local Track = require(Shared:WaitForChild("Track"))
local Tracks = require(Shared:WaitForChild("Tracks"))
local KartRig = require(ReplicatedStorage:WaitForChild("Common"):WaitForChild("KartRig"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local KartVisuals = require(script.Parent.KartVisuals)

local KartController = {}

local STUCK_SECONDS = 4 -- pressing the gas but not moving this long resets the kart

-- Player settings (from saved data): auto-accelerate and camera distance.
KartController.settings = { autoAccelerate = false, cameraFar = false }

local player = Players.LocalPlayer
local camera = Workspace.CurrentCamera
local controls = require(player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule")):GetControls()

type Session = {
	mode: string, -- "race" | "practice"
	kart: Model,
	track: Track.Built,
	stats: Karts.KartStats,
	state: KartPhysics.State,
	goTime: number,
	hint: number?,
	throttleDownAt: number?,
	started: boolean,
	camYaw: number,
	camY: number,
	stuckFor: number,
}

local session: Session? = nil
local driftHeld = false
local driftPressed = false -- set on the frame drift goes down (tricks)
local gasHeld, brakeHeld = false, false
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

-- Hooks set by Main so the HUD can show speed, drift charge and warnings.
KartController.onUpdate = nil :: ((info: any) -> ())?
KartController.onTurbo = nil :: ((level: number) -> ())?
KartController.onWarning = nil :: ((text: string) -> ())?
KartController.onStopped = nil :: ((mode: string) -> ())?

local function refreshRayFilter()
	local ignore: { Instance } = {}
	for _, name in { "Karts", "Items", "PracticeKarts" } do
		local f = Workspace:FindFirstChild(name)
		if f then
			table.insert(ignore, f)
		end
	end
	for _, p in Players:GetPlayers() do
		if p.Character then
			table.insert(ignore, p.Character)
		end
	end
	rayParams.FilterDescendantsInstances = ignore
end

local function setRacingControls(racing: boolean)
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.JumpHeight = if racing then 0 else 7.2
		humanoid.JumpPower = if racing then 0 else 50
	end
	if racing then
		-- Bound above the default controls so Space drifts instead of jumping out.
		ContextActionService:BindActionAtPriority("KartDrift", function(_, inputState)
			driftHeld = inputState == Enum.UserInputState.Begin
			if driftHeld then
				driftPressed = true
			end
			return Enum.ContextActionResult.Sink
		end, false, Enum.ContextActionPriority.High.Value, Enum.KeyCode.Space, Enum.KeyCode.LeftShift, Enum.KeyCode.ButtonR1)
		ContextActionService:BindActionAtPriority("KartItem", function(_, inputState)
			if inputState == Enum.UserInputState.Begin then
				KartController.useItem()
			end
			return Enum.ContextActionResult.Sink
		end, false, Enum.ContextActionPriority.High.Value, Enum.KeyCode.E, Enum.KeyCode.ButtonX)
		ContextActionService:BindActionAtPriority("KartReset", function(_, inputState)
			if inputState == Enum.UserInputState.Begin then
				KartController.reset()
			end
			return Enum.ContextActionResult.Sink
		end, false, Enum.ContextActionPriority.High.Value, Enum.KeyCode.R, Enum.KeyCode.ButtonY)
		ContextActionService:BindActionAtPriority("KartPedals", function(action, inputState, input)
			local down = inputState ~= Enum.UserInputState.End
			if input.KeyCode == Enum.KeyCode.ButtonR2 then
				gasHeld = down
			else
				brakeHeld = down
			end
			return Enum.ContextActionResult.Sink
		end, false, Enum.ContextActionPriority.High.Value, Enum.KeyCode.ButtonR2, Enum.KeyCode.ButtonL2)
	else
		ContextActionService:UnbindAction("KartDrift")
		ContextActionService:UnbindAction("KartItem")
		ContextActionService:UnbindAction("KartPedals")
		ContextActionService:UnbindAction("KartReset")
		driftHeld, gasHeld, brakeHeld = false, false, false
	end
end

-- Touch buttons call these.
function KartController.setDrift(on: boolean)
	if on and not driftHeld then
		driftPressed = true
	end
	driftHeld = on
end
local readInput: () -> (number, number)

function KartController.useItem()
	local s = session
	if not s or s.mode ~= "race" then
		return
	end
	-- Holding brake/back while using an item throws or drops it behind you.
	local throttle = readInput()
	Remotes.UseItem:FireServer(throttle < -0.3)
end

function KartController.isRacing(): boolean
	return session ~= nil and session.mode == "race"
end

function KartController.mode(): string?
	return session and session.mode
end

-- Puts the kart back on the road. In races the server does it (with a short
-- cooldown); on the practice loop the client does it directly.
function KartController.reset()
	local s = session
	if not s or not s.kart.PrimaryPart then
		return
	end
	if s.mode == "race" then
		Remotes.Respawn:FireServer()
		return
	end
	local root = s.kart.PrimaryPart
	local proj = Track.project(s.track, Track.v(root.Position.X, root.Position.Y, root.Position.Z))
	local pos = Track.spot(s.track, proj.distance, 0)
	local _, tan = Track.at(s.track, proj.distance)
	local yaw = math.atan2(-tan.x, -tan.z)
	KartRig.place(s.kart, CFrame.new(pos.x, pos.y, pos.z) * CFrame.Angles(0, yaw, 0))
	s.state.speed = 0
	s.state.yaw = yaw
	s.state.drift = 0
	s.state.charge = 0
	s.camYaw = yaw
	s.hint = nil
end

local function stop()
	local mode = session and session.mode
	session = nil
	KartVisuals.setOwn(nil, 0, 0)
	setRacingControls(false)
	camera.CameraType = Enum.CameraType.Custom
	camera.FieldOfView = 70
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		camera.CameraSubject = humanoid
	end
	if mode and KartController.onStopped then
		KartController.onStopped(mode)
	end
end

-- Stops driving without touching the camera (used when a racer finishes and
-- switches to spectating while the server drives their kart home).
function KartController.handOff()
	if session then
		session = nil
		KartVisuals.setOwn(nil, 0, 0)
		setRacingControls(false)
		camera.FieldOfView = 70
	end
end

local function begin(info: any, mode: string)
	local kart: Model = info.kart
	local deadline = os.clock() + 10
	while (not kart or not kart.PrimaryPart) and os.clock() < deadline do
		task.wait()
	end
	if not kart or not kart.PrimaryPart then
		warn("[KartController] kart never arrived")
		return
	end
	session = {
		mode = mode,
		kart = kart,
		track = Track.build(Tracks.get(info.trackId)),
		stats = Karts.get(info.kartId).stats,
		state = KartPhysics.newState(info.yaw),
		goTime = info.goTime or (Workspace:GetServerTimeNow() - 1),
		hint = nil,
		throttleDownAt = nil,
		started = mode ~= "race",
		camYaw = info.yaw,
		camY = kart.PrimaryPart.Position.Y,
		stuckFor = 0,
	}
	refreshRayFilter()
	setRacingControls(true)
	camera.CameraType = Enum.CameraType.Scriptable
end

function readInput(): (number, number)
	local move = controls:GetMoveVector()
	local steer = math.clamp(move.X, -1, 1)
	local throttle = math.clamp(-move.Z, -1, 1)
	if gasHeld then
		throttle = 1
	elseif brakeHeld then
		throttle = -1
	elseif KartController.settings.autoAccelerate and throttle >= 0 then
		-- Auto-accelerate: always on the gas unless you pull back to brake.
		throttle = 1
	end
	return throttle, steer
end

local function updateCamera(s: Session, dt: number)
	local root = s.kart.PrimaryPart
	if not root then
		return
	end
	-- The camera follows travel direction, so drifts show the kart sliding.
	local diff = (s.state.yaw - s.camYaw + math.pi) % (2 * math.pi) - math.pi
	s.camYaw += diff * math.min(1, dt * 6)
	local fx, fz = KartPhysics.forward(s.camYaw)
	local forward = Vector3.new(fx, 0, fz)
	-- Height follows more lazily in the air, so jumps feel big and the view stays steady.
	local airborne = s.state.air > 0.1
	s.camY += (root.Position.Y - s.camY) * math.min(1, dt * (if airborne then 2.5 else 8))
	local base = Vector3.new(root.Position.X, s.camY, root.Position.Z)
	local back = if KartController.settings.cameraFar then 23 else 17
	local target = base + Vector3.new(0, if KartController.settings.cameraFar then 8.5 else 6.5, 0) - forward * back
	local look = base + forward * 10 + Vector3.new(0, 2, 0)
	camera.CFrame = camera.CFrame:Lerp(CFrame.lookAt(target, look), math.min(1, dt * 10))
	local fov = if s.state.boost > 0 then 84 else 70
	camera.FieldOfView += (fov - camera.FieldOfView) * math.min(1, dt * 5)
end

local function step(dt: number)
	local s = session
	if not s then
		return
	end
	if not s.kart.Parent or not s.kart.PrimaryPart then
		stop()
		return
	end
	local root = s.kart.PrimaryPart :: BasePart
	local t = Workspace:GetServerTimeNow()
	local throttle, steer = readInput()

	if t < s.goTime then
		-- Countdown: remember when the gas went down for the rocket start.
		if throttle > 0.5 then
			s.throttleDownAt = s.throttleDownAt or (t - s.goTime)
		else
			s.throttleDownAt = nil
		end
		if KartController.onUpdate then
			KartController.onUpdate({ speed = 0, drift = 0, wrongWay = false, countdown = s.goTime - t })
		end
		return
	end
	if not s.started then
		s.started = true
		local boost = RaceRules.startBoost(s.throttleDownAt)
		if boost > 0 then
			KartPhysics.giveBoost(s.state, boost)
			if KartController.onTurbo then
				KartController.onTurbo(0)
			end
		end
	end
	if root.Anchored then
		return
	end
	-- Off the edge of the practice area: put the kart back.
	if s.mode == "practice" and root.Position.Y < -25 then
		KartController.reset()
		return
	end

	local sensed = KartRig.sense(s.kart, rayParams)
	local pos = Track.v(root.Position.X, root.Position.Y, root.Position.Z)
	local proj = Track.project(s.track, pos, s.hint)
	s.hint = proj.index
	local surface = Track.surfaceAt(s.track, proj, pos, t)
	if s.mode == "practice" and (surface == "offroad" or surface == "wall") then
		surface = "road" -- the practice area is open tarmac
	end

	-- Slipstream: tucked in behind any other kart?
	local others = {}
	local folder = Workspace:FindFirstChild(if s.mode == "race" then "Karts" else "PracticeKarts")
	if folder then
		for _, other in folder:GetChildren() do
			local p = other:IsA("Model") and other ~= s.kart and other.PrimaryPart
			if p then
				table.insert(others, { x = p.Position.X, z = p.Position.Z })
			end
		end
	end
	local drafting = KartPhysics.isDrafting(root.Position.X, root.Position.Z, s.state.yaw, others)

	local _, released = KartPhysics.step(s.stats, s.state, {
		throttle = throttle,
		steer = steer,
		drift = driftHeld,
		grounded = sensed.grounded,
		surface = if surface == "wall" then "offroad" else surface,
		trick = driftPressed,
		drafting = drafting,
	}, dt)
	driftPressed = false
	KartVisuals.setOwn(s.kart, steer, KartPhysics.trickRoll(s.state))

	-- Stuck against something with the gas held down? Put the kart back.
	if throttle > 0.5 and math.abs(s.state.speed) < 4 and s.state.spin <= 0 then
		s.stuckFor += dt
		if s.stuckFor > STUCK_SECONDS then
			s.stuckFor = 0
			KartController.reset()
		end
	else
		s.stuckFor = 0
	end
	KartRig.sync(s.kart, s.state)
	KartRig.apply(s.kart, s.state, sensed)
	local level = if s.state.drift ~= 0 then KartPhysics.chargeLevel(s.state.charge) else 0
	KartRig.setEffects(s.kart, level, s.state.boost > 0)
	if released > 0 and KartController.onTurbo then
		KartController.onTurbo(released)
	end

	if KartController.onUpdate then
		local fx, fz = KartPhysics.forward(s.state.yaw)
		KartController.onUpdate({
			speed = s.state.speed,
			drift = level,
			boosting = s.state.boost > 0,
			invincible = s.state.invincible > 0,
			drafting = drafting and s.state.draft > 0.2,
			wrongWay = s.mode == "race" and s.state.speed > 15 and Track.wrongWay(s.track, proj, fx, fz),
		})
	end
end

local function onKartEvent(kind: string, value: any)
	local s = session
	if not s then
		return
	end
	if kind == "warning" then
		if KartController.onWarning then
			KartController.onWarning(tostring(value))
		end
	elseif kind == "hit" or kind == "spin" then
		KartPhysics.hit(s.state)
	elseif kind == "slow" then
		KartPhysics.slow(s.state, 2)
	elseif kind == "launch" then
		KartPhysics.hit(s.state)
		local root = s.kart.PrimaryPart
		if root then
			root.AssemblyLinearVelocity += Vector3.new(0, 70, 0)
		end
	elseif kind == "boost" then
		KartPhysics.giveBoost(s.state, tonumber(value) or 1)
	elseif kind == "overdrive" then
		KartPhysics.overdrive(s.state, tonumber(value) or 6)
	elseif kind == "respawn" then
		s.state.speed = 0
		s.state.yaw = tonumber(value) or s.state.yaw
		s.state.drift = 0
		s.state.charge = 0
		s.camYaw = s.state.yaw
		s.hint = nil
	end
end

function KartController.start()
	driftPressed = false
	Remotes.RaceStart.OnClientEvent:Connect(function(info)
		task.spawn(begin, info, "race")
	end)
	Remotes.PracticeStart.OnClientEvent:Connect(function(info)
		task.spawn(begin, info, "practice")
	end)
	Remotes.KartEvent.OnClientEvent:Connect(onKartEvent)
	Remotes.Results.OnClientEvent:Connect(function()
		if session and session.mode == "race" then
			stop()
		end
	end)
	RunService.Heartbeat:Connect(function(dt)
		local ok, err = pcall(step, math.min(dt, 0.1))
		if not ok then
			warn("[KartController]", err)
		end
	end)
	-- Camera runs every rendered frame so it stays smooth.
	RunService:BindToRenderStep("KartCamera", Enum.RenderPriority.Camera.Value + 1, function(dt)
		if session and session.kart.PrimaryPart then
			updateCamera(session, dt)
		end
	end)
	player.CharacterAdded:Connect(function()
		if session then
			task.defer(refreshRayFilter)
		end
	end)
end

return KartController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">KartVisuals</string>
            <string name="Source"><![CDATA[-- Makes every nearby kart look alive, on this client only: the body leans into
-- turns, dips under braking, bounces on bumps and squashes on landing; front
-- wheels steer; all wheels spin; exhaust puffs harder when accelerating. Your
-- own kart also shows the trick barrel roll.
--
-- It only sets Motor6D.Transform, which is purely visual and never affects
-- the physics.

local Workspace = game:GetService("Workspace")

local KartVisuals = {}

-- "Fewer effects" setting: quieter exhaust and no trails on other karts.
KartVisuals.reduced = false

type Anim = { spin: number, lastSpeed: number, lastVy: number, squash: number, lean: number, pitch: number, steer: number, toast: number, seed: number }
local anims: { [Model]: Anim } = setmetatable({}, { __mode = "k" }) :: any

local FOLDERS = { "Karts", "PracticeKarts" }
local RANGE = 260

-- Set by KartController for the local player's kart.
local ownKart: Model? = nil
local ownSteer = 0
local ownTrickRoll = 0

function KartVisuals.setOwn(kart: Model?, steer: number, trickRoll: number)
	ownKart = kart
	ownSteer = steer
	ownTrickRoll = trickRoll
end

local function approach(a: number, b: number, rate: number): number
	return a + (b - a) * math.min(1, rate)
end

local function animate(kart: Model, dt: number, t: number)
	local root = kart.PrimaryPart
	if not root then
		return
	end
	local anim = anims[kart]
	if not anim then
		anim = { spin = 0, lastSpeed = 0, lastVy = 0, squash = 0, lean = 0, pitch = 0, steer = 0, toast = 0, seed = math.random() * 10 }
		anims[kart] = anim
	end
	local vel = root.AssemblyLinearVelocity
	local look = root.CFrame.LookVector
	local speed = vel.X * look.X + vel.Z * look.Z
	local yawRate = root.AssemblyAngularVelocity.Y
	local accel = (speed - anim.lastSpeed) / math.max(dt, 1e-3)

	-- Landing squash: falling fast last frame, stopped now.
	if anim.lastVy < -25 and vel.Y > -5 then
		anim.squash = math.clamp(-anim.lastVy / 120, 0.1, 0.5)
	end
	anim.squash = math.max(0, anim.squash - dt * 2.5)
	anim.lastSpeed = speed
	anim.lastVy = vel.Y

	local isOwn = kart == ownKart
	-- Positive yaw rate is a left turn. Lean into the turn (positive Z roll
	-- dips the left side), lift the nose when accelerating, dip it when braking.
	local leanTarget = math.clamp(yawRate * speed * 0.0035, -0.2, 0.2)
	local pitchTarget = math.clamp(accel * 0.0012, -0.09, 0.09)
	anim.lean = approach(anim.lean, leanTarget, dt * 8)
	anim.pitch = approach(anim.pitch, pitchTarget, dt * 6)
	-- Steer is "right = positive", matching player input.
	local steerTarget = if isOwn then ownSteer * 0.45 else math.clamp(-yawRate * 0.25, -0.45, 0.45)
	anim.steer = approach(anim.steer, steerTarget, dt * 12)

	local speedFrac = math.clamp(math.abs(speed) / 100, 0, 1)
	local bob = math.sin(t * 21 + root.Position.X) * 0.035 * speedFrac - anim.squash * 0.5
	local trick = if isOwn then ownTrickRoll else 0

	local bodyJoint = root:FindFirstChild("BodyJoint") :: Motor6D?
	if bodyJoint then
		bodyJoint.Transform = CFrame.new(0, bob, 0) * CFrame.Angles(anim.pitch, 0, anim.lean + trick)
	end

	local radius = kart:GetAttribute("WheelRadius") or 0.8
	anim.spin = (anim.spin + speed / radius * dt) % (math.pi * 2)
	for _, joint in root:GetChildren() do
		if joint:IsA("Motor6D") and joint.Name == "WheelJoint" then
			local steer = if joint:GetAttribute("Front") then anim.steer else 0
			-- Rolling forward (-z) turns the wheel's top toward the front.
			local spin = anim.spin * (joint:GetAttribute("SpinScale") or 1)
			joint.Transform = CFrame.Angles(0, -steer, 0) * CFrame.Angles(-spin, 0, 0)
		end
	end

	-- Character parts: blinking eyes, popping toast, flapping wings and more.
	local bodyRoot = kart:FindFirstChild("BodyRoot")
	if bodyRoot then
		local boosting = kart:GetAttribute("Boosting") == true or speed > 104
		anim.toast += ((if boosting then 1 else 0) - anim.toast) * math.min(1, dt * 10)
		local airborne = math.abs(vel.Y) > 6
		local blinking = ((t + anim.seed) % 3.2) < 0.14
		for _, joint in bodyRoot:GetChildren() do
			if joint:IsA("Motor6D") and joint.Name == "Anim" then
				local kind = joint:GetAttribute("AnimKind")
				local side = joint:GetAttribute("Side") or 1
				local cf = CFrame.new()
				if kind == "blink" then
					cf = CFrame.new(0, if blinking then -0.55 else 0, 0)
				elseif kind == "toast" then
					cf = CFrame.new(0, anim.toast * 1.3 + math.abs(math.sin(t * 9)) * 0.15 * anim.toast, 0)
				elseif kind == "flap" then
					local rate = if airborne then 14 else 3
					local amp = if airborne then 0.6 else 0.12
					cf = CFrame.Angles(0, 0, side * math.sin(t * rate + anim.seed) * amp)
				elseif kind == "flutter" then
					cf = CFrame.Angles(math.sin(t * 18 + side) * 0.35 * speedFrac + 0.05, 0, 0)
				elseif kind == "claw" then
					cf = CFrame.Angles(0, side * math.max(0, math.sin(t * 5 + anim.seed)) ^ 4 * 0.5, 0)
				elseif kind == "wobble" then
					local k = 1 + speedFrac + anim.squash * 4
					cf = CFrame.new(0, math.sin(t * 9) * 0.05 * k, 0) * CFrame.Angles(math.sin(t * 7) * 0.05 * k, 0, math.cos(t * 6) * 0.05 * k)
				elseif kind == "rattle" then
					cf = CFrame.Angles(math.sin(t * 30 + anim.seed) * 0.06 * speedFrac - anim.squash * 0.4, 0, 0)
				elseif kind == "engine" then
					-- An exposed motor rumbles at idle and shakes harder on the throttle.
					local k = 0.5 + math.clamp(accel / 40, 0, 1) * 0.8 + speedFrac * 0.3
					cf = CFrame.new(0, math.sin(t * 47 + anim.seed) * 0.03 * k, 0) * CFrame.Angles(0, 0, math.sin(t * 39 + anim.seed) * 0.015 * k)
				elseif kind == "orbit" then
					cf = CFrame.Angles(0, t * 2.5, 0)
				end
				joint.Transform = cf
			end
		end
	end

	local exhaust = kart:FindFirstChild("Exhaust")
	local puff = exhaust and exhaust:FindFirstChild("ExhaustPuff") :: ParticleEmitter?
	if puff then
		puff.Rate = if KartVisuals.reduced then 0 elseif accel > 5 then 22 elseif math.abs(speed) > 5 then 8 else 4
	end
	local trail = kart:FindFirstChild("KartTrail", true) :: Trail?
	if trail then
		trail.Enabled = not KartVisuals.reduced or isOwn
	end
end

function KartVisuals.step(dt: number)
	local t = os.clock()
	local camera = Workspace.CurrentCamera
	local camPos = camera and camera.CFrame.Position or Vector3.zero
	for _, name in FOLDERS do
		local folder = Workspace:FindFirstChild(name)
		if folder then
			for _, kart in folder:GetChildren() do
				if kart:IsA("Model") and kart.PrimaryPart and (kart.PrimaryPart.Position - camPos).Magnitude < RANGE then
					animate(kart, dt, t)
				end
			end
		end
	end
end

return KartVisuals
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">LobbyScreens</string>
            <string name="Source"><![CDATA[-- Local wall displays and proximity doors for Kart HQ. SurfaceGuis belong
-- to PlayerGui; the server supplies round data and departure authorization.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local UI = require(script.Parent.UI)
local TrackPreview = require(script.Parent.TrackPreview)
local Tracks = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Tracks"))

local LobbyScreens = {}
local state: any = nil
local lobby: Instance? = nil
local surfaces = {}
local doors = {}
local faces = {}
local nextScan, nextFaces = 0, 0
local featured: string? = nil
local randomFeatured: string? = nil
local displayKey = ""
local gold = Color3.fromRGB(255, 200, 60)

local function clear(display)
	for _, preview in display.previews do
		preview:destroy()
	end
	display.previews = {}
	for _, child in display.root:GetChildren() do
		child:Destroy()
	end
end

local function label(parent, text, x, y, w, h, color)
	return UI.label(parent, {
		Text = text, Position = UDim2.fromScale(x, y), Size = UDim2.fromScale(w, h),
		TextColor3 = color or UI.Colors.text,
	})
end

local function preview(display, parent, id, x, y, w, h)
	local holder = Instance.new("Frame")
	holder.BackgroundTransparency = 1
	holder.Position = UDim2.fromScale(x, y)
	holder.Size = UDim2.fromScale(w, h)
	holder.Parent = parent
	table.insert(display.previews, TrackPreview.new(holder, id))
end

local function addFaces(parent, ids, x, y, w, h)
	local count = math.min(#ids, 6)
	for i = 1, count do
		local face = Instance.new("ImageLabel")
		face.Name = "Voter"
		face.BackgroundColor3 = UI.Colors.panelLight
		face.Size = UDim2.fromScale(w / 7, h)
		face.Position = UDim2.fromScale(x + (i - 1) * w / 7, y)
		face.Image = UI.headshot(ids[i], true)
		face.Parent = parent
		local aspect = Instance.new("UIAspectRatioConstraint")
		aspect.Parent = face
		table.insert(faces, { image = face, id = ids[i] })
	end
	if #ids > count then
		label(parent, `+{#ids - count}`, x + count * w / 7, y, w / 7, h)
	end
end

local function standings(display, title, rows, limit)
	label(display.root, title, 0.03, 0.02, 0.94, 0.13, gold)
	local count = math.min(#rows, limit)
	if count == 0 then
		label(display.root, "No race yet · ready up to race", 0.05, 0.35, 0.9, 0.25)
		return
	end
	local height = math.min(0.2, 0.76 / count)
	for i = 1, count do
		local row = rows[i]
		local suffix = if row.finished then " · FINISHED" elseif row.isCpu then " · CPU" else ""
		label(display.root, `{i}. {row.name}{suffix}`, 0.05, 0.19 + (i - 1) * height, 0.9, height * 0.86,
			if i <= 3 then gold else UI.Colors.text)
	end
end

local function trackTitle(id)
	return Tracks.get(id).name
end

local function featuredTrack(display, id, announcing)
	preview(display, display.root, id, 0.04, 0.04, 0.92, 0.69)
	label(display.root, trackTitle(id), 0.03, 0.75, 0.94, 0.13, gold)
	label(display.root, if announcing then "TRACK CHOSEN · head to departure" else "Step onto a pad to race",
		0.03, 0.9, 0.94, 0.08)
end

local function render()
	faces = {}
	local s = state or { phase = "lobby", options = {}, players = {} }
	for key, display in surfaces do
		clear(display)
		if key == "vote" then
			if s.phase == "voting" then
				for i = 1, 4 do
					local opt = (s.options or {})[i]
					local ids = if i == 4 then s.randomVoters or {} else (opt and opt.voters or {})
					local x = (i - 1) / 4 + 0.012
					local card = UI.panel(display.root, { Position = UDim2.fromScale(x, 0.025), Size = UDim2.fromScale(0.226, 0.95) })
					if opt and i < 4 then
						preview(display, card, opt.id, 0.04, 0.04, 0.92, 0.52)
					elseif i == 4 and s.options and s.options[1] then
						preview(display, card, randomFeatured or s.options[1].id, 0.04, 0.04, 0.92, 0.52)
						label(card, "? ? ?", 0.05, 0.15, 0.9, 0.25, UI.Colors.purple)
					else
						label(card, "—", 0.05, 0.12, 0.9, 0.34, UI.Colors.purple)
					end
					label(card, if i == 4 then "RANDOM" else (opt and opt.name or "Waiting"), 0.04, 0.59, 0.92, 0.13)
					local votes = if i == 4 then #ids else (opt and opt.votes or 0)
					label(card, `{votes} vote{if votes == 1 then "" else "s"}`, 0.04, 0.75, 0.92, 0.08, gold)
					addFaces(card, ids, 0.04, 0.86, 0.92, 0.1)
				end
			elseif s.phase == "announce" and s.winner then
				featuredTrack(display, s.winner, true)
			elseif s.phase == "racing" then
				standings(display, `LIVE · {if s.spectate then s.spectate.trackName else "Race"}`, s.spectate and s.spectate.rows or {}, 8)
			elseif s.phase == "results" then
				standings(display, "RACE RESULTS · TOP 3", s.lastResults or {}, 3)
			else
				featuredTrack(display, featured or Tracks.VotePool[1], false)
			end
		elseif key == "status" then
			display.title = label(display.root, "KART HQ", 0.02, 0.06, 0.96, 0.45, gold)
			display.detail = label(display.root, "", 0.02, 0.56, 0.96, 0.36)
		else
			local index = tonumber(string.match(key, "%d+"))
			local opt = (s.options or {})[index]
			local votes = if index == 4 then #(s.randomVoters or {}) else (opt and opt.votes or 0)
			label(display.root, `{index} · {if index == 4 then "RANDOM" else (opt and opt.name or "TRACK")}`, 0.02, 0.05, 0.96, 0.55)
			label(display.root, if s.phase == "voting" then `{votes} votes` else "Step on pad to race", 0.02, 0.66, 0.96, 0.27, gold)
		end
	end
end

local function surface(key, part)
	if not part or not part:IsA("BasePart") then return end
	local gui = Instance.new("SurfaceGui")
	gui.Name = `LobbyScreen_{key}`
	gui.Adornee = part
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
	gui.CanvasSize = Vector2.new(1920, math.floor(1920 * part.Size.Y / part.Size.X))
	gui.LightInfluence = 0
	gui.AlwaysOnTop = false
	gui.ResetOnSpawn = false
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	local root = Instance.new("Frame")
	root.Size = UDim2.fromScale(1, 1)
	root.BackgroundColor3 = UI.Colors.panel
	root.BorderSizePixel = 0
	root.Parent = gui
	surfaces[key] = { gui = gui, root = root, previews = {} }
end

local function discover()
	local found = Workspace:FindFirstChild("Lobby")
	local chamber = found and found:FindFirstChild("Chamber")
	-- Wait for complete replication without blocking the Round event handler.
	if not chamber or not chamber:FindFirstChild("PadSign4")  then return end
	if found == lobby then return end
	for _, display in surfaces do
		clear(display)
		display.gui:Destroy()
	end
	surfaces, doors = {}, {}
	lobby = found
	surface("vote", chamber:FindFirstChild("VoteScreen"))
	surface("status", chamber:FindFirstChild("StatusBoard"))
	for i = 1, 4 do surface(`pad{i}`, chamber:FindFirstChild(`PadSign{i}`)) end

	for _, model in found:GetDescendants() do
		if model:IsA("Model") and model:GetAttribute("SlidingDoor") then
			local parts, glows = {}, {}
			local center = nil
			for _, part in model:GetDescendants() do
				if part:IsA("BasePart") then
					if part:GetAttribute("Side") then
						table.insert(parts, { part = part, closed = part.CFrame, side = part:GetAttribute("Side") })
					end
					if part.Name == "Glow" then table.insert(glows, { part = part, color = part.Color }) end
					if part.Name == "Panel1" or part.Name == "Panel2" then
						local foot = part.CFrame.Position - Vector3.new(0, part.Size.Y / 2, 0)
						center = if center then (center + foot) / 2 else foot
					end
				end
			end
			if center then table.insert(doors, { model = model, parts = parts, glows = glows, center = center, amount = 0 }) end
		end
	end
	render()
end

-- Round snapshots arrive regularly even when no visible content changed.
-- Preserve the expensive viewport models and faces until display data changes.
function LobbyScreens.setState(s)
	state = s
	local key = { s.phase, s.winner or "", s.spectate and s.spectate.trackName or "" }
	for _, opt in s.options or {} do
		table.insert(key, `{opt.id}:{opt.name}:{opt.votes}`)
		for _, id in opt.voters or {} do table.insert(key, tostring(id)) end
		table.insert(key, "/")
	end
	for _, id in s.randomVoters or {} do table.insert(key, `random:{id}`) end
	for _, row in s.spectate and s.spectate.rows or {} do
		table.insert(key, `{row.name}:{row.finished}:{row.isCpu}`)
	end
	for _, row in s.lastResults or {} do table.insert(key, `result:{row.name}`) end
	local nextKey = table.concat(key, "|")
	if displayKey ~= nextKey then
		displayKey = nextKey
		randomFeatured = nil
		render()
	end
end

function LobbyScreens.step(dt: number)
	local t = Workspace:GetServerTimeNow()
	if t >= nextScan then
		nextScan = t + 0.5
		discover()
	end
	if not lobby or not lobby.Parent then return end
	if not state or state.phase == "lobby" then
		local id = Tracks.VotePool[math.floor(t / 8) % #Tracks.VotePool + 1]
		if featured ~= id then
			featured = id
			render()
		end
	elseif state.phase == "voting" and state.options and #state.options > 0 then
		local id = state.options[math.floor(t / 4) % #state.options + 1].id
		if randomFeatured ~= id then
			randomFeatured = id
			render()
		end
	end
	local board = surfaces.status
	if board and state then
		local ready, voted = 0, 0
		local voters = {}
		for _, p in state.players or {} do if p.ready then ready += 1 end end
		for _, opt in state.options or {} do
			for _, id in opt.voters or {} do voters[id] = true end
		end
		for _, id in state.randomVoters or {} do voters[id] = true end
		for _ in voters do voted += 1 end
		local left = if state.deadline then ` · {math.max(0, math.ceil(state.deadline - t))}s` else ""
		board.title.Text = string.upper(state.phase) .. left
		board.detail.Text = `{ready} ready · {voted} voted`
	end
	for _, display in surfaces do for _, p in display.previews do p:step(t) end end
	if t >= nextFaces then
		nextFaces = t + 0.5
		for _, face in faces do face.image.Image = UI.headshot(face.id, true) end
	end
	local character = Players.LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	for _, door in doors do
		if not door.model.Parent then continue end
		local departure = door.model:GetAttribute("Departure") == true
		local lit = door.model:GetAttribute("Lit") == true
		local nearby = root ~= nil and (root.Position - door.center).Magnitude <= 18
		local open = nearby and (not departure or lit)
		door.amount += ((if open then 1 else 0) - door.amount) * (1 - math.exp(-10 * dt))
		local travel = (door.model:GetAttribute("Width") / 2 - 0.8) * door.amount
		for _, item in door.parts do item.part.CFrame = item.closed * CFrame.new(item.side * travel, 0, 0) end
		for _, glow in door.glows do
			glow.part.Color = if departure and lit then gold:Lerp(Color3.fromRGB(230, 205, 160), (math.sin(t * 2) + 1) * 0.12) else glow.color
		end
	end
end

return LobbyScreens
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">LobbyUI</string>
            <string name="Source"><![CDATA[-- Lobby screens: the status bar (phase + countdown, always visible), coins,
-- GARAGE / WATCH buttons, the READY button, the map voting row (three track
-- cards + Random), the winner reveal, the practice "leave kart" button and
-- spectator controls.
--
-- Layout keeps the bottom-left (thumbstick) and bottom-right (jump) corners
-- free on phones: side buttons sit top-left, and the vote row is centred.
-- The vote row matches the chamber's wall screen and pads (same colours,
-- numbers and previews), and both draw from the same round state.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local LobbyLayout = require(Shared:WaitForChild("LobbyLayout"))
local Voting = require(Shared:WaitForChild("Voting"))

local TrackPreview = require(script.Parent.TrackPreview)
local UI = require(script.Parent.UI)

local LobbyUI = {}

LobbyUI.onReady = nil :: ((boolean) -> ())?
LobbyUI.onVote = nil :: ((string) -> ())?
LobbyUI.onGarage = nil :: (() -> ())?
LobbyUI.onWatch = nil :: (() -> ())?
LobbyUI.onLeavePractice = nil :: (() -> ())?
LobbyUI.onSpectateNext = nil :: ((number) -> ())?
LobbyUI.onStopSpectating = nil :: (() -> ())?

local me = Players.LocalPlayer
local state: any = nil
local hidden = false -- hidden while racing

local CYAN = Color3.fromRGB(0, 225, 255)
local function rgb(c: { number }): Color3
	return Color3.fromRGB(c[1], c[2], c[3])
end
local PAD_COLORS = {}
for i, c in LobbyLayout.PadColors do
	PAD_COLORS[i] = rgb(c)
end
local DIFFICULTY_COLORS = { Easy = UI.Colors.green, Medium = UI.Colors.yellow, Hard = UI.Colors.red }

local root = Instance.new("Frame")
root.Name = "Lobby"
root.BackgroundTransparency = 1
root.Size = UDim2.fromScale(1, 1)
root.Parent = UI.Screen

-- Status bar ---------------------------------------------------------------
local status = UI.panel(root, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 10), Size = UDim2.new(0, 460, 0, 70) })
UI.stroke(status, CYAN, 2, 0.4)
local statusTitle = UI.label(status, { Position = UDim2.new(0, 14, 0, 4), Size = UDim2.new(1, -28, 0, 36), Text = "KART HQ", TextColor3 = UI.Colors.yellow })
local statusSub = UI.label(status, { Position = UDim2.new(0, 14, 0, 40), Size = UDim2.new(1, -28, 0, 24), Text = "", TextColor3 = UI.Colors.muted })

-- Left column: coins, garage, watch ------------------------------------------
local coinPanel = UI.panel(root, { Position = UDim2.new(0, 14, 0, 14), Size = UDim2.new(0, 150, 0, 50) })
local coinLabel = UI.label(coinPanel, { Position = UDim2.new(0, 10, 0, 6), Size = UDim2.new(1, -20, 1, -12), Text = "🪙 0" })

function LobbyUI.setCoins(coins: number)
	coinLabel.Text = `🪙 {coins}`
end

local garageButton = UI.button(root, "🔧 GARAGE", UI.Colors.blue, { Position = UDim2.new(0, 14, 0, 74), Size = UDim2.new(0, 150, 0, 50) }, function()
	if LobbyUI.onGarage then
		LobbyUI.onGarage()
	end
end)
local watchButton = UI.button(root, "📺 WATCH", UI.Colors.purple, { Position = UDim2.new(0, 14, 0, 132), Size = UDim2.new(0, 150, 0, 50), Visible = false }, function()
	if LobbyUI.onWatch then
		LobbyUI.onWatch()
	end
end)

-- Bottom centre: ready / leave kart ------------------------------------------
local isReady = false
local readyButton = UI.button(root, "READY UP", UI.Colors.green, { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -18), Size = UDim2.new(0, 260, 0, 66) }, function()
	if LobbyUI.onReady then
		LobbyUI.onReady(not isReady)
	end
end)
local leaveButton = UI.button(root, "🚪 LEAVE KART", UI.Colors.red, { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -92), Size = UDim2.new(0, 220, 0, 52), Visible = false }, function()
	if LobbyUI.onLeavePractice then
		LobbyUI.onLeavePractice()
	end
end)

-- Vote row: three tracks + Random -------------------------------------------
local CARD_W, CARD_H, GAP = 152, 196, 12
local ROW_W = CARD_W * 4 + GAP * 3 + 20
local votePanel = UI.panel(root, { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -12), Size = UDim2.new(0, ROW_W, 0, CARD_H + 64), Visible = false })
UI.stroke(votePanel, CYAN, 2, 0.35)
local voteTitle = UI.label(votePanel, { Position = UDim2.new(0, 14, 0, 6), Size = UDim2.new(0, 300, 0, 30), Text = "VOTE FOR A TRACK", TextColor3 = UI.Colors.yellow, TextXAlignment = Enum.TextXAlignment.Left })
UI.label(votePanel, { Position = UDim2.new(0, 14, 0, 36), Size = UDim2.new(1, -130, 0, 18), Text = "Tap a card or stand on its pad · 🎲 Random votes for one of these three, picked for you", TextColor3 = UI.Colors.muted, TextXAlignment = Enum.TextXAlignment.Left })
local leaveRace = UI.button(votePanel, "Leave race", UI.Colors.panelLight, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 8), Size = UDim2.new(0, 110, 0, 34) }, function()
	if LobbyUI.onReady then
		LobbyUI.onReady(false)
	end
end)
local cardHolder = Instance.new("Frame")
cardHolder.BackgroundTransparency = 1
cardHolder.Position = UDim2.new(0, 10, 0, 58)
cardHolder.Size = UDim2.new(1, -20, 0, CARD_H)
cardHolder.Parent = votePanel
UI.list(cardHolder, true, GAP)

type Card = {
	index: number,
	button: TextButton,
	art: Frame,
	badge: TextLabel,
	mine: TextLabel,
	name: TextLabel,
	chip: TextLabel,
	votes: TextLabel,
	faces: Frame,
	choice: string?,
	preview: TrackPreview.Preview?,
}

local function makeCard(index: number): Card
	local card: Card = { index = index } :: any
	card.button = UI.button(cardHolder, "", UI.Colors.panelLight, { Size = UDim2.new(0, CARD_W, 1, 0), LayoutOrder = index, AutoButtonColor = true }, function()
		if card.choice and LobbyUI.onVote then
			LobbyUI.onVote(card.choice)
		end
	end)
	card.art = Instance.new("Frame")
	card.art.Name = "Art"
	card.art.Position = UDim2.new(0, -4, 0, -2)
	card.art.Size = UDim2.new(1, 8, 0, 84)
	card.art.BackgroundColor3 = Color3.fromRGB(14, 18, 36)
	card.art.BorderSizePixel = 0
	card.art.Parent = card.button
	local artCorner = Instance.new("UICorner")
	artCorner.CornerRadius = UDim.new(0, 10)
	artCorner.Parent = card.art
	card.badge = UI.label(card.button, { Position = UDim2.new(0, -6, 0, -6), Size = UDim2.new(0, 28, 0, 28), Text = if index == LobbyLayout.RandomPad then "?" else tostring(index), BackgroundTransparency = 0, BackgroundColor3 = PAD_COLORS[index], TextColor3 = Color3.fromRGB(16, 22, 44), TextStrokeTransparency = 1, ZIndex = 3 })
	local badgeCorner = Instance.new("UICorner")
	badgeCorner.CornerRadius = UDim.new(1, 0)
	badgeCorner.Parent = card.badge
	card.mine = UI.label(card.button, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 62), Size = UDim2.new(0.86, 0, 0, 20), Text = "✓ YOUR VOTE", BackgroundTransparency = 0, BackgroundColor3 = UI.Colors.yellow, TextColor3 = Color3.fromRGB(30, 30, 40), TextStrokeTransparency = 1, Visible = false, ZIndex = 3 })
	local mineCorner = Instance.new("UICorner")
	mineCorner.CornerRadius = UDim.new(1, 0)
	mineCorner.Parent = card.mine
	card.name = UI.label(card.button, { Position = UDim2.new(0, 0, 0, 86), Size = UDim2.new(1, 0, 0, 24), Text = "" })
	card.chip = UI.label(card.button, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 112), Size = UDim2.new(0.62, 0, 0, 18), Text = "", BackgroundTransparency = 0, TextColor3 = Color3.fromRGB(30, 30, 40), TextStrokeTransparency = 1 })
	local chipCorner = Instance.new("UICorner")
	chipCorner.CornerRadius = UDim.new(1, 0)
	chipCorner.Parent = card.chip
	card.votes = UI.label(card.button, { Position = UDim2.new(0, 0, 0, 134), Size = UDim2.new(1, 0, 0, 20), Text = "" })
	card.faces = Instance.new("Frame")
	card.faces.BackgroundTransparency = 1
	card.faces.Position = UDim2.new(0, 0, 1, -28)
	card.faces.Size = UDim2.new(1, 0, 0, 24)
	card.faces.Parent = card.button
	UI.list(card.faces, true, 3, true)
	return card
end

local cards: { Card } = {}
for i = 1, 4 do
	cards[i] = makeCard(i)
end
-- The Random card's art: a big die on the Random colour.
local dice = UI.label(cards[4].art, { Size = UDim2.fromScale(1, 1), Text = "🎲", TextScaled = true })
local diceGradient = Instance.new("UIGradient")
diceGradient.Color = ColorSequence.new(PAD_COLORS[4], Color3.fromRGB(60, 40, 120))
diceGradient.Rotation = 90
diceGradient.Parent = cards[4].art
cards[4].art.BackgroundColor3 = Color3.new(1, 1, 1)

-- Winner reveal ----------------------------------------------------------------
local announce = UI.panel(root, { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -12), Size = UDim2.new(0, 460, 0, 268), Visible = false })
UI.stroke(announce, UI.Colors.yellow, 3, 0.1)
UI.label(announce, { Position = UDim2.new(0, 0, 0, 6), Size = UDim2.new(1, 0, 0, 26), Text = "NEXT TRACK", TextColor3 = UI.Colors.yellow })
local announceArt = Instance.new("Frame")
announceArt.BackgroundTransparency = 1
announceArt.Position = UDim2.new(0, 14, 0, 36)
announceArt.Size = UDim2.new(1, -28, 0, 168)
announceArt.Parent = announce
local announceName = UI.label(announce, { Position = UDim2.new(0, 10, 0, 206), Size = UDim2.new(1, -20, 0, 34), Text = "" })
local announceSub = UI.label(announce, { Position = UDim2.new(0, 10, 0, 240), Size = UDim2.new(1, -20, 0, 20), Text = "Head for the departure doors!", TextColor3 = UI.Colors.muted })
local announcePreview: TrackPreview.Preview? = nil

-- Spectator controls ---------------------------------------------------------
local spectateBar = UI.panel(root, { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -18), Size = UDim2.new(0, 460, 0, 70), Visible = false })
local spectateLabel = UI.label(spectateBar, { Position = UDim2.new(0, 80, 0, 10), Size = UDim2.new(1, -240, 0, 50), Text = "" })
UI.button(spectateBar, "◀", UI.Colors.panelLight, { Position = UDim2.new(0, 10, 0, 10), Size = UDim2.new(0, 60, 0, 50) }, function()
	if LobbyUI.onSpectateNext then
		LobbyUI.onSpectateNext(-1)
	end
end)
UI.button(spectateBar, "▶", UI.Colors.panelLight, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -150, 0, 10), Size = UDim2.new(0, 60, 0, 50) }, function()
	if LobbyUI.onSpectateNext then
		LobbyUI.onSpectateNext(1)
	end
end)
UI.button(spectateBar, "EXIT", UI.Colors.red, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 10), Size = UDim2.new(0, 130, 0, 50) }, function()
	if LobbyUI.onStopSpectating then
		LobbyUI.onStopSpectating()
	end
end)

-- Toasts (short messages while in the lobby) ---------------------------------
local toastHolder = Instance.new("Frame")
toastHolder.BackgroundTransparency = 1
toastHolder.AnchorPoint = Vector2.new(0.5, 0)
toastHolder.Position = UDim2.new(0.5, 0, 0, 90)
toastHolder.Size = UDim2.new(0, 420, 0, 200)
toastHolder.Parent = UI.Screen
UI.list(toastHolder, false, 6, true)

function LobbyUI.toast(text: string)
	local t = UI.panel(toastHolder, { Size = UDim2.new(1, 0, 0, 44) })
	UI.label(t, { Position = UDim2.new(0, 12, 0, 6), Size = UDim2.new(1, -24, 1, -12), Text = text })
	UI.pop(t)
	task.delay(3.5, function()
		t:Destroy()
	end)
end

---------------------------------------------------------------------------
-- Updates
---------------------------------------------------------------------------
local practicing = false
local spectating = false

function LobbyUI.setPracticing(on: boolean)
	practicing = on
	LobbyUI.refresh()
end

function LobbyUI.setSpectating(on: boolean, name: string?)
	spectating = on
	spectateLabel.Text = if name then `Watching {name}` else ""
	LobbyUI.refresh()
end

function LobbyUI.setHidden(on: boolean)
	hidden = on
	LobbyUI.refresh()
end

local function myEntry(): any?
	if not state then
		return nil
	end
	for _, p in state.players do
		if p.userId == me.UserId then
			return p
		end
	end
	return nil
end

function LobbyUI.setState(s: any)
	state = s
	local mine = myEntry()
	isReady = mine ~= nil and mine.ready
	LobbyUI.refresh()
end

local function setFaces(holder: Frame, userIds: { number }, max: number)
	for _, child in holder:GetChildren() do
		if child:IsA("ImageLabel") or child:IsA("TextLabel") then
			child:Destroy()
		end
	end
	for n, userId in userIds do
		if n > max then
			UI.label(holder, { Size = UDim2.new(0, 26, 0, 24), Text = `+{#userIds - max}`, LayoutOrder = n })
			break
		end
		local face = Instance.new("ImageLabel")
		face.Size = UDim2.new(0, 24, 0, 24)
		face.BackgroundColor3 = Color3.new(1, 1, 1)
		face.Image = UI.headshot(userId)
		face.LayoutOrder = n
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(1, 0)
		corner.Parent = face
		face.Parent = holder
	end
end

local function optionById(s: any, id: string?): any?
	for _, opt in s.options do
		if opt.id == id then
			return opt
		end
	end
	return nil
end

function LobbyUI.refresh()
	local s = state
	local mine = myEntry()
	local racing = mine and mine.racing
	root.Visible = not hidden
	if not s then
		return
	end

	local voter = mine ~= nil and mine.voter
	local voting = s.phase == "voting" and voter and not spectating
	local announcing = s.phase == "announce" and not racing and not spectating

	readyButton.Visible = not racing and not spectating and not voting and not announcing and s.phase ~= "results"
	readyButton.Text = if isReady then "✓ READY (tap to cancel)" else "READY UP"
	readyButton.BackgroundColor3 = if isReady then UI.Colors.yellow else UI.Colors.green
	readyButton.TextColor3 = if isReady then Color3.fromRGB(40, 40, 50) else UI.Colors.text
	garageButton.Visible = not spectating
	watchButton.Visible = s.phase == "racing" and s.spectate ~= nil and not racing and not spectating
	leaveButton.Visible = practicing and not spectating and not voting
	spectateBar.Visible = spectating

	-- Vote row.
	if voting ~= votePanel.Visible then
		votePanel.Visible = voting
		if voting then
			UI.pop(votePanel)
		end
	end
	leaveRace.Visible = voting
	if voting then
		local myVote = nil
		for _, opt in s.options do
			if table.find(opt.voters, me.UserId) then
				myVote = opt.id
			end
		end
		local myRandom = table.find(s.randomVoters or {}, me.UserId) ~= nil
		for i = 1, 3 do
			local card = cards[i]
			local opt = s.options[i]
			card.button.Visible = opt ~= nil
			if opt then
				card.choice = opt.id
				if not card.preview or card.preview.trackId ~= opt.id then
					if card.preview then
						card.preview:destroy()
					end
					card.preview = TrackPreview.new(card.art, opt.id)
				end
				card.button.BackgroundColor3 = UI.Colors.panelLight
				card.name.Text = `{opt.icon} {opt.name}`
				card.chip.Text = opt.difficulty
				card.chip.BackgroundColor3 = DIFFICULTY_COLORS[opt.difficulty] or UI.Colors.muted
				card.votes.Text = `{opt.votes} vote{if opt.votes == 1 then "" else "s"}`
				local selected = opt.id == myVote and not myRandom
				card.mine.Visible = selected
				UI.highlight(card.button, selected)
				card.button.BackgroundColor3 = if selected then PAD_COLORS[i]:Lerp(Color3.new(0, 0, 0), 0.55) else UI.Colors.panelLight
				setFaces(card.faces, opt.voters, 4)
			end
		end
		local random = cards[4]
		random.choice = Voting.Random
		random.name.Text = "RANDOM"
		random.chip.Text = "Surprise!"
		random.chip.BackgroundColor3 = PAD_COLORS[4]
		local picked = if myRandom then optionById(s, myVote) else nil
		random.votes.Text = if picked then `🎲 → {picked.name}` else "One of these 3"
		random.votes.TextColor3 = if picked then UI.Colors.yellow else UI.Colors.muted
		random.mine.Visible = myRandom
		UI.highlight(random.button, myRandom)
		random.button.BackgroundColor3 = if myRandom then PAD_COLORS[4]:Lerp(Color3.new(0, 0, 0), 0.55) else UI.Colors.panelLight
		setFaces(random.faces, s.randomVoters or {}, 4)
	end

	-- Winner reveal (everyone in the lobby sees it, like the wall screen).
	if announcing ~= announce.Visible then
		announce.Visible = announcing
		if announcing then
			UI.pop(announce)
		end
	end
	if announcing and s.winner then
		local opt = optionById(s, s.winner)
		if not announcePreview or announcePreview.trackId ~= s.winner then
			if announcePreview then
				announcePreview:destroy()
			end
			announcePreview = TrackPreview.new(announceArt, s.winner)
			-- The winning preview grows into place.
			local grow = Instance.new("UIScale")
			grow.Scale = 0.55
			grow.Parent = announcePreview.frame
			TweenService:Create(grow, TweenInfo.new(0.6, Enum.EasingStyle.Back), { Scale = 1 }):Play()
		end
		announceName.Text = if opt then `{opt.icon} {opt.name}!` else ""
		announceSub.Text = if voter then "Head for the departure doors!" else "Ready up to race the next one"
	end
end

-- Called every frame for countdowns and animated previews.
function LobbyUI.update()
	local s = state
	if not s then
		return
	end
	local t = Workspace:GetServerTimeNow()
	local left = if s.deadline then math.max(0, math.ceil(s.deadline - t)) else nil
	local readyCount = 0
	for _, p in s.players do
		if p.ready then
			readyCount += 1
		end
	end
	if s.phase == "lobby" then
		if left then
			statusTitle.Text = `RACE STARTING · {left}s`
			statusSub.Text = `{readyCount} ready · voting opens soon`
		else
			statusTitle.Text = "KART HQ"
			statusSub.Text = "Press READY or step onto a vote pad to race"
		end
	elseif s.phase == "voting" then
		statusTitle.Text = `VOTING · {left or 0}s`
		local mine = myEntry()
		statusSub.Text = if mine and mine.voter then "Pick a track below or stand on its pad" else "Step onto a pad to join this race"
		voteTitle.Text = `VOTE FOR A TRACK · {left or 0}s`
	elseif s.phase == "announce" then
		local opt = optionById(s, s.winner)
		statusTitle.Text = "TRACK LOCKED IN!"
		statusSub.Text = if opt then `{opt.name} · starting in {left or 0}s` else ""
	elseif s.phase == "racing" then
		statusTitle.Text = "RACE IN PROGRESS"
		statusSub.Text = if s.spectate then `{s.spectate.trackName} · ready up for the next race` else ""
	elseif s.phase == "results" then
		statusTitle.Text = "RESULTS"
		statusSub.Text = `Next round in {left or 0}s`
	end

	if votePanel.Visible then
		for _, card in cards do
			if card.preview and card.button.Visible then
				card.preview:step(os.clock())
			end
		end
	end
	if announce.Visible and announcePreview then
		announcePreview:step(os.clock())
	end
end

return LobbyUI
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="49">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- Client entry point: wires remotes to the lobby screens, garage, race HUD,
-- kart controller, spectator camera and lighting.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local Atmos = require(ReplicatedStorage:WaitForChild("Common"):WaitForChild("Atmos"))

local GarageUI = require(script.Parent.GarageUI)
local Hud = require(script.Parent.Hud)
local KartVisuals = require(script.Parent.KartVisuals)
local KartController = require(script.Parent.KartController)
local LobbyUI = require(script.Parent.LobbyUI)
local LobbyScreens = require(script.Parent.LobbyScreens)
local Spectate = require(script.Parent.Spectate)
local TrackAnimator = require(script.Parent.TrackAnimator)

local roundState: any = nil

Atmos.apply("hq")
KartController.start()

local function namesOf(rows: { any }): { string }
	local names = {}
	for _, r in rows do
		table.insert(names, r.kart or r.name)
	end
	return names
end

local function stopSpectating()
	Spectate.stop()
	LobbyUI.setSpectating(false)
	if not KartController.isRacing() then
		Atmos.apply("hq")
	end
end

local function startSpectating(rows: { any }, theme: string?)
	if theme then
		Atmos.apply(theme)
	end
	GarageUI.close()
	Spectate.start(namesOf(rows), function(name)
		LobbyUI.setSpectating(true, name)
	end)
end

-- Lobby ----------------------------------------------------------------------
LobbyUI.onReady = function(ready)
	Remotes.Ready:FireServer(ready)
end
LobbyUI.onVote = function(trackId)
	Remotes.Vote:FireServer(trackId)
end
LobbyUI.onGarage = GarageUI.toggle
LobbyUI.onWatch = function()
	if roundState and roundState.spectate then
		startSpectating(roundState.spectate.rows, roundState.spectate.theme)
	end
end
LobbyUI.onLeavePractice = function()
	Remotes.LeavePractice:FireServer()
end
LobbyUI.onSpectateNext = Spectate.cycle
LobbyUI.onStopSpectating = stopSpectating

GarageUI.onAction = function(action, kind, value)
	Remotes.GarageAction:FireServer(action, kind, value)
end

-- Your saved data: garage, settings, and which golden tokens you've found.
local Cosmetics = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Cosmetics"))
Remotes.Profile.OnClientEvent:Connect(function(data, canSave)
	GarageUI.setData(data, canSave)
	KartController.settings.autoAccelerate = data.settings.autoAccelerate
	KartController.settings.cameraFar = data.settings.cameraFar
	KartVisuals.reduced = data.settings.reducedEffects
	LobbyUI.setCoins(data.coins)
	local lobby = Workspace:FindFirstChild("Lobby")
	local tokens = lobby and lobby:FindFirstChild("Tokens")
	if tokens then
		for _, token in tokens:GetChildren() do
			local id = tostring(token:GetAttribute("TokenId"))
			if data.tokens[id] and token:IsA("BasePart") then
				token.LocalTransparencyModifier = 1
			end
		end
	end
end)

-- Horns: a bubble over whoever honked (and their sound, if one is set).
local Players = game:GetService("Players")
Remotes.Honk.OnClientEvent:Connect(function(_name, hornId, userId)
	local horn = Cosmetics.find("horn", hornId)
	local who = Players:GetPlayerByUserId(userId)
	local character = who and who.Character
	local head = character and character:FindFirstChild("Head")
	if not head or not horn then
		return
	end
	local bubble = Instance.new("BillboardGui")
	bubble.Size = UDim2.new(0, 160, 0, 50)
	bubble.StudsOffset = Vector3.new(0, 4, 0)
	bubble.AlwaysOnTop = true
	bubble.MaxDistance = 150
	bubble.Parent = head
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(255, 220, 60)
	label.TextStrokeTransparency = 0
	label.Text = `{horn.icon} {horn.text}`
	label.Parent = bubble
	if horn.soundId ~= "" then
		local sound = Instance.new("Sound")
		sound.SoundId = horn.soundId
		sound.Parent = head
		sound:Play()
		task.delay(3, function()
			sound:Destroy()
		end)
	end
	task.delay(1.6, function()
		bubble:Destroy()
	end)
end)
UserInputService.InputBegan:Connect(function(input, processed)
	if not processed and (input.KeyCode == Enum.KeyCode.H or input.KeyCode == Enum.KeyCode.DPadUp) then
		Remotes.HonkRequest:FireServer()
	end
end)

Remotes.Round.OnClientEvent:Connect(function(state)
	roundState = state
	LobbyUI.setState(state)
	LobbyScreens.setState(state)
	if Spectate.isActive() and not KartController.isRacing() then
		if state.spectate then
			Spectate.setOrder(namesOf(state.spectate.rows))
		elseif state.phase ~= "racing" then
			stopSpectating()
		end
	end
end)
Remotes.OpenGarage.OnClientEvent:Connect(GarageUI.open)
Remotes.Spectate.OnClientEvent:Connect(LobbyUI.onWatch)

-- Racing ---------------------------------------------------------------------
Remotes.RaceStart.OnClientEvent:Connect(function(info)
	stopSpectating()
	GarageUI.close()
	LobbyUI.setHidden(true)
	Hud.raceStarted(info)
	Hud.setDriving(true)
	Atmos.apply(info.theme or "sunny")
end)
Remotes.PracticeStart.OnClientEvent:Connect(function()
	GarageUI.close()
	LobbyUI.setPracticing(true)
	Hud.setDriving(true)
	LobbyUI.toast("Practice! Drift, jump and boost. R resets the kart.")
end)
KartController.onStopped = function(mode)
	Hud.setDriving(false)
	if mode == "practice" then
		LobbyUI.setPracticing(false)
	end
end

Remotes.RaceState.OnClientEvent:Connect(function(s)
	Hud.setRaceState(s)
	-- Finished: the server drives your kart home while you watch the others.
	if s.finishTime and KartController.isRacing() then
		KartController.handOff()
		Hud.setDriving(false)
		startSpectating(s.rows)
	elseif Spectate.isActive() then
		Spectate.setOrder(namesOf(s.rows))
	end
end)
Remotes.ItemState.OnClientEvent:Connect(Hud.setItem)
Remotes.Results.OnClientEvent:Connect(function(info)
	-- Awards for everyone, plus your own coins, badges and challenges.
	local extra = {}
	if info.awards and #info.awards > 0 then
		table.insert(extra, "")
		for _, a in info.awards do
			table.insert(extra, `{a.icon} {a.name}: {a.winner}`)
		end
	end
	if info.me then
		table.insert(extra, "")
		for _, line in info.me.lines do
			table.insert(extra, line)
		end
		table.insert(extra, `<b>Total: +{info.me.coins} 🪙</b>`)
	end
	info.extra = extra
	stopSpectating()
	Hud.setDriving(false)
	Hud.showResults(info)
	LobbyUI.setHidden(false)
	Atmos.apply("hq")
end)
Remotes.Notify.OnClientEvent:Connect(function(message)
	if Hud.isRacing() then
		Hud.flash(message, 1.6)
	else
		LobbyUI.toast(message)
	end
end)

KartController.onUpdate = Hud.setKart
KartController.onWarning = function(text)
	Hud.warn(text, 1.5)
end
KartController.onTurbo = function(level)
	local text = if level == 0 then "ROCKET START!"
		elseif level == 3 then "ULTRA TURBO!"
		elseif level == 2 then "SUPER TURBO!"
		elseif level == 10 then "TRICK!"
		elseif level == 11 then "SLIPSTREAM!"
		else "TURBO!"
	Hud.flash(text, 0.8)
end

if UserInputService.TouchEnabled then
	Hud.addTouchButtons(KartController.setDrift, KartController.useItem, KartController.reset)
end

-- Spinning things (Ferris wheel, golden tokens, item boxes) turn on each client.
local spinners: { Instance } = {}
local function track(inst: Instance)
	if inst:GetAttribute("Spin") then
		table.insert(spinners, inst)
	end
end
for _, d in Workspace:GetDescendants() do
	track(d)
end
Workspace.DescendantAdded:Connect(track)

RunService.RenderStepped:Connect(function(dt)
	LobbyUI.update()
	LobbyScreens.step(dt)
	Hud.update()
	KartVisuals.step(dt)
	TrackAnimator.step()
	for i = #spinners, 1, -1 do
		local inst = spinners[i]
		if not inst.Parent then
			table.remove(spinners, i)
			continue
		end
		local rate = inst:GetAttribute("Spin") or 0
		if inst:IsA("Model") then
			inst:PivotTo(inst:GetPivot() * CFrame.Angles(rate * dt, 0, 0))
		elseif inst:IsA("BasePart") then
			inst.CFrame *= CFrame.Angles(0, rate * dt, 0)
		end
	end
	local items = Workspace:FindFirstChild("Items")
	if items then
		for _, box in items:GetChildren() do
			if box:GetAttribute("ItemBox") and box:IsA("BasePart") then
				box.CFrame *= CFrame.Angles(0, dt * 2, 0)
			end
		end
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">Spectate</string>
            <string name="Source"><![CDATA[-- Spectator camera: follows a racer's kart from behind. Used by lobby players
-- watching a race and by racers who have already finished.

local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Spectate = {}

local camera = Workspace.CurrentCamera
local active = false
local order: { string } = {} -- kart (driver) names in race order
local index = 1
local onTargetChanged: ((string?) -> ())? = nil

local function karts(): Instance?
	return Workspace:FindFirstChild("Karts")
end

local function target(): Model?
	local folder = karts()
	if not folder or #order == 0 then
		return nil
	end
	index = (index - 1) % #order + 1
	local m = folder:FindFirstChild(order[index])
	return if m and m:IsA("Model") then m else nil
end

function Spectate.isActive(): boolean
	return active
end

-- `names` is the race order (leader first).
function Spectate.setOrder(names: { string })
	local current = order[index]
	order = names
	local found = table.find(order, current)
	index = found or 1
end

function Spectate.start(names: { string }?, changed: ((string?) -> ())?)
	active = true
	onTargetChanged = changed
	if names then
		order = names
		index = 1
	end
	camera.CameraType = Enum.CameraType.Scriptable
	if onTargetChanged then
		onTargetChanged(order[index])
	end
end

function Spectate.cycle(step: number)
	if #order == 0 then
		return
	end
	index = (index - 1 + step) % #order + 1
	if onTargetChanged then
		onTargetChanged(order[index])
	end
end

function Spectate.stop()
	if not active then
		return
	end
	active = false
	camera.CameraType = Enum.CameraType.Custom
	local character = game:GetService("Players").LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		camera.CameraSubject = humanoid
	end
end

RunService:BindToRenderStep("SpectateCamera", Enum.RenderPriority.Camera.Value + 2, function(dt)
	if not active then
		return
	end
	local m = target()
	local root = m and m.PrimaryPart
	if not root then
		return
	end
	local look = root.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	if flat.Magnitude < 0.1 then
		flat = Vector3.zAxis
	end
	flat = flat.Unit
	local goal = CFrame.lookAt(root.Position - flat * 20 + Vector3.new(0, 8, 0), root.Position + flat * 8)
	camera.CFrame = camera.CFrame:Lerp(goal, math.min(1, dt * 6))
end)

return Spectate
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">TrackAnimator</string>
            <string name="Source"><![CDATA[-- Animates the current track on this client: crossers (toy robot, toy train,
-- beetles) walk across the road, sprinklers spray while their wet zone is
-- on, and wet patches only show while they are slippery. Everything is
-- computed from the shared server clock (Track.crosserAt / Track.zoneActive),
-- so what you see matches what the server uses for hits.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Track = require(Shared:WaitForChild("Track"))
local Tracks = require(Shared:WaitForChild("Tracks"))

local TrackAnimator = {}

local current: { folder: Instance, track: Track.Built, sprinklers: { { emitter: ParticleEmitter, zone: any } }, patches: { { part: BasePart, zone: any } } }? = nil

local function setup(folder: Instance)
	local id = folder:GetAttribute("TrackId")
	if type(id) ~= "string" then
		return nil
	end
	local ok, def = pcall(Tracks.get, id)
	if not ok then
		return nil
	end
	local track = Track.build(def)

	-- Pair each sprinkler with the nearest slippery zone.
	local zones = {}
	for _, z in def.zones or {} do
		if z.kind == "slippery" then
			local p = Track.spot(track, z.t * track.length, 0)
			table.insert(zones, { zone = z, pos = Vector3.new(p.x, p.y, p.z) })
		end
	end
	local sprinklers = {}
	for _, d in folder:GetDescendants() do
		if d:IsA("ParticleEmitter") and d.Name == "Water" and d.Parent and d.Parent:IsA("BasePart") then
			local best, bestDist = nil, math.huge
			for _, z in zones do
				local dist = ((d.Parent :: BasePart).Position - z.pos).Magnitude
				if dist < bestDist then
					best, bestDist = z.zone, dist
				end
			end
			if best then
				table.insert(sprinklers, { emitter = d, zone = best })
			end
		end
	end
	local patches = {}
	for _, d in folder:GetDescendants() do
		local zi = d:GetAttribute("ZoneIndex")
		if zi and d:IsA("BasePart") then
			local zone = (def.zones :: any)[zi]
			if zone and zone.period then
				table.insert(patches, { part = d, zone = zone })
			end
		end
	end
	return { folder = folder, track = track, sprinklers = sprinklers, patches = patches }
end

function TrackAnimator.step()
	local folder = Workspace:FindFirstChild("Track")
	if not folder then
		current = nil
		return
	end
	if not current or current.folder ~= folder then
		current = setup(folder)
		if not current then
			return
		end
	end
	local c = current :: any
	local t = Workspace:GetServerTimeNow()
	local def = c.track.def

	local crossers = folder:FindFirstChild("Crossers")
	if crossers then
		for _, model in crossers:GetChildren() do
			local index = model:GetAttribute("CrosserIndex")
			local cr = index and (def.crossers :: any)[index]
			if cr and model:IsA("Model") then
				local d, lat = Track.crosserAt(c.track, cr, t)
				local _, latAhead = Track.crosserAt(c.track, cr, t + 0.1)
				local p = Track.spot(c.track, d, lat)
				local _, tan = Track.at(c.track, d)
				-- Face the way it is walking (across the road).
				local right = Vector3.new(-tan.z, 0, tan.x).Unit
				local facing = if latAhead >= lat then right else -right
				local bob = math.abs(math.sin(t * 8)) * (if cr.kind == "beetle" then 0.6 else 0.3)
				local pos = Vector3.new(p.x, p.y + bob, p.z)
				model:PivotTo(CFrame.lookAt(pos, pos + facing))
			end
		end
	end

	for _, s in c.sprinklers do
		s.emitter.Enabled = Track.zoneActive(s.zone, t)
	end
	for _, p in c.patches do
		p.part.Transparency = if Track.zoneActive(p.zone, t) then 0.25 else 0.85
	end
end

return TrackAnimator
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">TrackPreview</string>
            <string name="Source"><![CDATA[-- Animated mini-map of a track, drawn from the same track data the race
-- uses: the road as a ribbon on a little plate in a ViewportFrame, slowly
-- turning, with a glowing kart dot running laps. Used on the vote cards and
-- the chamber's wall screen in place of uploaded track images.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Track = require(Shared:WaitForChild("Track"))
local Tracks = require(Shared:WaitForChild("Tracks"))

local TrackPreview = {}

local FIT = 40 -- the track is scaled to fit a plate this many studs across
local built: { [string]: any } = {}

local function rgb(c: { number }): Color3
	return Color3.fromRGB(c[1], c[2], c[3])
end

local function part(parent: Instance, size: Vector3, cf: CFrame, color: Color3, neon: boolean?): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = if neon then Enum.Material.Neon else Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

export type Preview = {
	frame: ViewportFrame,
	trackId: string,
	step: (self: Preview, t: number) -> (),
	destroy: (self: Preview) -> (),
}

-- Fills `parent` with a preview of `trackId`. Call :step(time) every frame.
function TrackPreview.new(parent: GuiObject, trackId: string): Preview
	local def = Tracks.get(trackId)
	local theme = Tracks.Themes[def.theme] or Tracks.Themes.hq
	local track = built[trackId]
	if not track then
		track = Track.build(def)
		built[trackId] = track
	end

	-- Fit the layout onto the plate.
	local minX, maxX, minZ, maxZ, minY = math.huge, -math.huge, math.huge, -math.huge, math.huge
	for _, p in track.points do
		minX, maxX = math.min(minX, p.x), math.max(maxX, p.x)
		minZ, maxZ = math.min(minZ, p.z), math.max(maxZ, p.z)
		minY = math.min(minY, p.y)
	end
	local cx, cz = (minX + maxX) / 2, (minZ + maxZ) / 2
	local s = FIT / math.max(maxX - minX, maxZ - minZ, 1)
	local function map(p: Track.Vec): Vector3
		-- Hills are exaggerated a little so they read at this size.
		return Vector3.new((p.x - cx) * s, (p.y - minY) * s * 1.6 + 0.4, (p.z - cz) * s)
	end

	local frame = Instance.new("ViewportFrame")
	frame.Name = "TrackPreview"
	frame.Size = UDim2.fromScale(1, 1)
	frame.BackgroundColor3 = rgb(theme.ground):Lerp(Color3.fromRGB(10, 14, 30), 0.55)
	frame.BorderSizePixel = 0
	frame.Ambient = Color3.fromRGB(170, 175, 195)
	frame.LightColor = Color3.fromRGB(255, 250, 240)
	frame.LightDirection = Vector3.new(-1, -2, -0.6)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = frame

	local model = Instance.new("Model")
	model.Parent = frame
	local plate = part(model, Vector3.new(0.8, FIT + 10, FIT + 10), CFrame.new(0, -0.4, 0) * CFrame.Angles(0, 0, math.rad(90)), rgb(theme.ground))
	plate.Shape = Enum.PartType.Cylinder
	local rim = part(model, Vector3.new(0.6, FIT + 11, FIT + 11), CFrame.new(0, -0.6, 0) * CFrame.Angles(0, 0, math.rad(90)), rgb(theme.accent), true)
	rim.Shape = Enum.PartType.Cylinder

	-- Road ribbon (about 90 pieces) with a thin edge colour underneath.
	local roadWidth = math.max(1.4, (def.width or 30) * s)
	local n = #track.points
	local stride = math.max(1, math.floor(n / 90))
	for i = 1, n, stride do
		local a = map(track.points[i])
		local b = map(track.points[(i + stride - 1) % n + 1])
		local length = (b - a).Magnitude
		if length > 0.01 then
			local cf = CFrame.lookAt((a + b) / 2, b)
			part(model, Vector3.new(roadWidth, 0.4, length + roadWidth * 0.35), cf, rgb(theme.road))
			part(model, Vector3.new(roadWidth + 0.6, 0.3, length + roadWidth * 0.35), cf * CFrame.new(0, -0.12, 0), rgb(theme.wall))
		end
	end
	-- Start line and the running kart.
	local p0, t0 = Track.at(track, 0)
	local start = map(p0)
	part(model, Vector3.new(roadWidth, 0.45, 0.5), CFrame.lookAt(start, start + Vector3.new(t0.x, 0, t0.z)) * CFrame.new(0, 0.05, 0), Color3.new(1, 1, 1))
	local dot = part(model, Vector3.one * math.max(1.4, roadWidth * 0.8), CFrame.new(start), rgb(theme.accent), true)
	dot.Shape = Enum.PartType.Ball

	local camera = Instance.new("Camera")
	camera.FieldOfView = 34
	camera.Parent = frame
	frame.CurrentCamera = camera
	frame.Parent = parent

	local lapSeconds = 9
	local offset = math.random() * 10 -- previews side by side don't move in step
	local preview = {
		frame = frame,
		trackId = trackId,
	} :: any

	function preview.step(_self: Preview, t: number)
		local time = t + offset
		local d = (time / lapSeconds % 1) * track.length
		local p = Track.at(track, d)
		dot.CFrame = CFrame.new(map(p) + Vector3.new(0, 0.7, 0))
		local a = time * 0.18
		camera.CFrame = CFrame.lookAt(Vector3.new(math.sin(a) * 58, 46, math.cos(a) * 58), Vector3.new(0, -2, 0))
	end

	function preview.destroy(_self: Preview)
		frame:Destroy()
	end

	preview:step(0)
	return preview
end

return TrackPreview
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">UI</string>
            <string name="Source"><![CDATA[-- Shared look for every screen: rounded panels, chunky buttons sized for
-- thumbs, a friendly rounded font, soft outlines and gentle gradients.

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local UI = {}

UI.Font = Enum.Font.FredokaOne
UI.Colors = {
	panel = Color3.fromRGB(28, 26, 48),
	panelLight = Color3.fromRGB(48, 44, 80),
	text = Color3.fromRGB(255, 255, 255),
	muted = Color3.fromRGB(190, 190, 215),
	yellow = Color3.fromRGB(255, 210, 60),
	pink = Color3.fromRGB(255, 95, 140),
	green = Color3.fromRGB(70, 200, 120),
	red = Color3.fromRGB(230, 80, 90),
	blue = Color3.fromRGB(80, 150, 255),
	purple = Color3.fromRGB(150, 100, 240),
}

local screen = Instance.new("ScreenGui")
screen.Name = "KartUI"
screen.ResetOnSpawn = false
screen.IgnoreGuiInset = false
screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
screen.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
UI.Gui = screen

-- Every screen is laid out in "design pixels" for a 1600x900 window and
-- scaled to fit: crisp and roomy at 1080p, compact on phones. The root frame
-- is grown by 1/scale so scale-based sizes (full-screen frames) still fill
-- the window after the UIScale shrinks or grows them.
UI.DesignSize = Vector2.new(1600, 900)
UI.MinScale = 0.72 -- below this, buttons get too small for thumbs
UI.MaxScale = 1.3
UI.scale = 1

local root = Instance.new("Frame")
root.Name = "Root"
root.BackgroundTransparency = 1
root.Size = UDim2.fromScale(1, 1)
root.Parent = screen
local rootScale = Instance.new("UIScale")
rootScale.Parent = root
UI.Screen = root

-- Panels that must fit the window (garage, results) get their own scale.
type Fit = { gui: GuiObject, size: Vector2 }
local fits: { Fit } = {}

local function fitScaleOf(fit: Fit): number
	local available = screen.AbsoluteSize / UI.scale
	if available.X <= 0 or available.Y <= 0 then
		return 1
	end
	return math.min(1, available.X * 0.96 / fit.size.X, available.Y * 0.94 / fit.size.Y)
end

local function rescale()
	local size = screen.AbsoluteSize
	if size.X <= 0 or size.Y <= 0 then
		return
	end
	local s = math.min(size.X / UI.DesignSize.X, size.Y / UI.DesignSize.Y)
	s = math.clamp(s, UI.MinScale, UI.MaxScale)
	UI.scale = s
	rootScale.Scale = s
	root.Size = UDim2.fromScale(1 / s, 1 / s)
	for _, fit in fits do
		local f = fitScaleOf(fit)
		fit.gui:SetAttribute("FitScale", f)
		local scale = fit.gui:FindFirstChildOfClass("UIScale")
		if scale then
			scale.Scale = f
		end
	end
end
screen:GetPropertyChangedSignal("AbsoluteSize"):Connect(rescale)
task.defer(rescale)

-- Keeps a fixed-size panel inside the window (it shrinks, never grows).
function UI.fit(gui: GuiObject, designSize: Vector2)
	local fit = { gui = gui, size = designSize }
	table.insert(fits, fit)
	local scale = gui:FindFirstChildOfClass("UIScale") or Instance.new("UIScale")
	scale.Parent = gui
	local f = fitScaleOf(fit)
	scale.Scale = f
	gui:SetAttribute("FitScale", f)
end

-- True on phones and tablets (touch with no keyboard): keep the thumbstick
-- and jump corners clear.
function UI.isTouch(): boolean
	local UserInputService = game:GetService("UserInputService")
	return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
end

local function round(gui: GuiObject, radius: number)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius)
	c.Parent = gui
end

local function stroke(gui: GuiObject, color: Color3, thickness: number, transparency: number?)
	local s = Instance.new("UIStroke")
	s.Color = color
	s.Thickness = thickness
	s.Transparency = transparency or 0
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = gui
	return s
end
UI.stroke = stroke

local function apply(gui: Instance, props: { [string]: any }?)
	for k, v in props or {} do
		(gui :: any)[k] = v
	end
end

function UI.panel(parent: Instance, props: { [string]: any }?): Frame
	local f = Instance.new("Frame")
	f.BackgroundColor3 = UI.Colors.panel
	f.BackgroundTransparency = 0.08
	f.BorderSizePixel = 0
	round(f, 18)
	stroke(f, Color3.new(1, 1, 1), 2, 0.75)
	local g = Instance.new("UIGradient")
	g.Rotation = 90
	g.Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(200, 200, 220))
	g.Parent = f
	apply(f, props)
	f.Parent = parent
	return f
end

function UI.label(parent: Instance, props: { [string]: any }?): TextLabel
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Font = UI.Font
	l.TextColor3 = UI.Colors.text
	l.TextScaled = true
	l.TextWrapped = true
	l.TextStrokeTransparency = 0.7
	apply(l, props)
	l.Parent = parent
	return l
end

-- A chunky rounded button with a little press bounce.
function UI.button(parent: Instance, text: string, color: Color3, props: { [string]: any }?, onClick: (() -> ())?): TextButton
	local b = Instance.new("TextButton")
	b.Font = UI.Font
	b.TextScaled = true
	b.TextColor3 = UI.Colors.text
	b.TextStrokeTransparency = 0.6
	b.BackgroundColor3 = color
	b.BorderSizePixel = 0
	b.AutoButtonColor = true
	b.Text = text
	round(b, 14)
	stroke(b, Color3.new(1, 1, 1), 2, 0.6)
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 6)
	pad.PaddingBottom = UDim.new(0, 6)
	pad.PaddingLeft = UDim.new(0, 10)
	pad.PaddingRight = UDim.new(0, 10)
	pad.Parent = b
	apply(b, props)
	b.Parent = parent
	if onClick then
		b.Activated:Connect(function()
			local scale = b:FindFirstChildOfClass("UIScale") or Instance.new("UIScale")
			scale.Parent = b
			scale.Scale = 0.92
			TweenService:Create(scale, TweenInfo.new(0.18, Enum.EasingStyle.Back), { Scale = 1 }):Play()
			onClick()
		end)
	end
	return b
end

function UI.list(parent: Instance, horizontal: boolean, padding: number, center: boolean?): UIListLayout
	local l = Instance.new("UIListLayout")
	l.FillDirection = if horizontal then Enum.FillDirection.Horizontal else Enum.FillDirection.Vertical
	l.Padding = UDim.new(0, padding)
	l.SortOrder = Enum.SortOrder.LayoutOrder
	if center then
		l.HorizontalAlignment = Enum.HorizontalAlignment.Center
		l.VerticalAlignment = Enum.VerticalAlignment.Center
	end
	l.Parent = parent
	return l
end

function UI.highlight(gui: GuiObject, on: boolean)
	local s = gui:FindFirstChild("Highlight") :: UIStroke?
	if not s then
		s = stroke(gui, UI.Colors.yellow, 4)
		s.Name = "Highlight"
	end
	s.Enabled = on
end

-- Pops a panel in with a quick scale bounce (respecting UI.fit).
function UI.pop(gui: GuiObject)
	local scale = gui:FindFirstChildOfClass("UIScale") or Instance.new("UIScale")
	scale.Parent = gui
	local target = gui:GetAttribute("FitScale") or 1
	scale.Scale = target * 0.85
	TweenService:Create(scale, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Scale = target }):Play()
end

local thumbs: { [string]: string } = {}
-- Avatar headshot for a user (cached). Empty string until it loads. `big`
-- fetches a sharper one for the wall screen.
function UI.headshot(userId: number, big: boolean?): string
	local key = `{userId}:{if big then 150 else 48}`
	if thumbs[key] then
		return thumbs[key]
	end
	thumbs[key] = ""
	task.spawn(function()
		local size = if big then Enum.ThumbnailSize.Size150x150 else Enum.ThumbnailSize.Size48x48
		local ok, content = pcall(Players.GetUserThumbnailAsync, Players, userId, Enum.ThumbnailType.HeadShot, size)
		if ok then
			thumbs[key] = content
		end
	end)
	return ""
end

function UI.ordinal(n: number): string
	local suffix = "th"
	if n % 100 < 11 or n % 100 > 13 then
		suffix = ({ "st", "nd", "rd" })[n % 10] or "th"
	end
	return `{n}{suffix}`
end

function UI.time(t: number?): string
	if not t then
		return "--"
	end
	local m = math.floor(t / 60)
	return string.format("%d:%05.2f", m, t - m * 60)
end

return UI
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="54">
    <Properties>
      <string name="Name">Workspace</string>
      <float name="Gravity">150</float>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">false</bool>
    </Properties>
