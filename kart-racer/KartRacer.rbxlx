      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">Voting</string>
          <string name="Source"><![CDATA[--!strict
-- Map voting: pick three track options each round, count votes, choose the
-- winner. Pure logic so it can be tested; the server owns the actual votes.

local Voting = {}

Voting.OptionCount = 3
Voting.VoteSeconds = 20

-- Picks `count` different tracks from `pool` (a list of ids), avoiding the
-- track that was just raced when there are enough others. `random` returns 0..1.
function Voting.pickOptions(pool: { string }, count: number, random: () -> number, lastTrack: string?): { string }
	local candidates = {}
	for _, id in pool do
		if id ~= lastTrack then
			table.insert(candidates, id)
		end
	end
	if #candidates < count and lastTrack and table.find(pool, lastTrack) then
		table.insert(candidates, lastTrack)
	end
	-- Fisher-Yates shuffle, then take the first `count`.
	for i = #candidates, 2, -1 do
		local j = math.floor(random() * i) + 1
		candidates[i], candidates[j] = candidates[j], candidates[i]
	end
	local out = {}
	for i = 1, math.min(count, #candidates) do
		out[i] = candidates[i]
	end
	return out
end

-- votes: voter id -> track id. Only votes for listed options count.
function Voting.tally(options: { string }, votes: { [any]: string }): { [string]: number }
	local counts = {}
	for _, id in options do
		counts[id] = 0
	end
	for _, choice in votes do
		if counts[choice] ~= nil then
			counts[choice] += 1
		end
	end
	return counts
end

-- Highest vote count wins; ties (including nobody voting) are broken at random.
function Voting.winner(options: { string }, votes: { [any]: string }, random: () -> number): string
	assert(#options > 0, "no options to vote on")
	local counts = Voting.tally(options, votes)
	local best, tied = -1, {}
	for _, id in options do
		local n = counts[id]
		if n > best then
			best, tied = n, { id }
		elseif n == best then
			table.insert(tied, id)
		end
	end
	return tied[math.floor(random() * #tied) + 1]
end

-- Who voted for what, for the voter icons on each option.
function Voting.votersFor(votes: { [any]: string }, option: string): { any }
	local out = {}
	for voter, choice in votes do
		if choice == option then
			table.insert(out, voter)
		end
	end
	return out
end

return Voting
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="19">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="20">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">ItemService</string>
          <string name="Source"><![CDATA[-- Item boxes, rolling items and everything the six items do on the track.
-- All hits are decided here on the server, and every attack is readable:
--   Wind-up Rocket  rolls along the road, pops on the first kart it meets
--                   (racers ahead get a warning)
--   Popcorn Bomb    lobbed ahead (or dropped behind), blinks, then pops
--   Jelly Puddle    a sticky trap that slows whoever drives in
--   Bubble Shield   blocks one attack
--   Turbo Soda      a speed boost
--   Spring Mine     a trap that boings karts into the air
-- Traps expire, each racer has a trap limit, and the track has a cap on
-- active hazards so things never pile up.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Items = require(Shared.Items)
local KartPhysics = require(Shared.KartPhysics)
local Track = require(Shared.Track)
local Shapes = require(ReplicatedStorage.Common.Shapes)

local ItemService = {}

local PICKUP_RADIUS = 7
local HIT_RADIUS = 5
local WARN_RANGE = 110

-- Optional sound ids (rbxassetid://...). Empty = silent. See README "Assets to replace".
ItemService.Sounds = { pop = "", boing = "", splat = "", fizz = "", whoosh = "" }

type Hazard = {
	kind: string,
	model: Model,
	owner: any, -- Racer
	born: number,
	life: number,
	pos: Vector3,
	-- rocket: travels along the lap
	score: number?,
	direction: number?,
	lateral: number?,
	-- bomb: lands, then pops after a fuse
	from: Vector3?,
	landAt: number?,
	popAt: number?,
	hitsLeft: number?,
}

type Box = { part: BasePart, pos: Vector3, respawnAt: number? }

local boxes: { Box } = {}
local hazards: { Hazard } = {}
local folder: Folder? = nil

-- The clock is swappable so the smoke test can run items outside Roblox.
ItemService.clock = function(): number
	return Workspace:GetServerTimeNow()
end

local function now(): number
	return ItemService.clock()
end

local function cleanupLater(inst: Instance, seconds: number)
	task.delay(seconds, function()
		if inst.Parent then
			inst:Destroy()
		end
	end)
end

local function v3(p: Track.Vec): Vector3
	return Vector3.new(p.x, p.y, p.z)
end

local function rootOf(racer: any): BasePart?
	return racer.model and racer.model.PrimaryPart
end

local function forwardOf(racer: any): Vector3
	local yaw
	if racer.state then
		yaw = racer.state.yaw
	else
		local root = rootOf(racer)
		local look = if root then root.CFrame.LookVector else Vector3.new(0, 0, -1)
		yaw = math.atan2(-look.X, -look.Z)
	end
	local fx, fz = KartPhysics.forward(yaw)
	return Vector3.new(fx, 0, fz)
end

local function sound(parent: Instance, key: string)
	local id = ItemService.Sounds[key]
	if id and id ~= "" then
		local s = Instance.new("Sound")
		s.SoundId = id
		s.Volume = 0.8
		s.Parent = parent
		s:Play()
		cleanupLater(s, 3)
	end
end

-- A cartoon pop: a flash ball, sparks, a puff of smoke and a "POP!" word.
function ItemService.explode(pos: Vector3, word: string?, color: Color3?)
	local f = folder
	if not f then
		return
	end
	local flash = Shapes.ball(f, 6, CFrame.new(pos), { color = color or Color3.fromRGB(255, 220, 90), material = Enum.Material.Neon, transparency = 0.2 })
	flash.Name = "Pop"
	local sparks = Instance.new("ParticleEmitter")
	sparks.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	sparks.Color = ColorSequence.new(Color3.fromRGB(255, 240, 120), Color3.fromRGB(255, 120, 60))
	sparks.Size = NumberSequence.new(1.2, 0)
	sparks.Lifetime = NumberRange.new(0.3, 0.6)
	sparks.Speed = NumberRange.new(25, 45)
	sparks.SpreadAngle = Vector2.new(180, 180)
	sparks.Rate = 400
	sparks.LightEmission = 1
	sparks.Parent = flash
	local smoke = Instance.new("ParticleEmitter")
	smoke.Texture = "rbxasset://textures/particles/smoke_main.dds"
	smoke.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255))
	smoke.Size = NumberSequence.new(3, 7)
	smoke.Transparency = NumberSequence.new(0.3, 1)
	smoke.Lifetime = NumberRange.new(0.6, 0.9)
	smoke.Speed = NumberRange.new(4, 9)
	smoke.SpreadAngle = Vector2.new(180, 180)
	smoke.Rate = 60
	smoke.Parent = flash
	local tag = Instance.new("BillboardGui")
	tag.Size = UDim2.new(0, 120, 0, 50)
	tag.StudsOffset = Vector3.new(0, 6, 0)
	tag.AlwaysOnTop = true
	tag.MaxDistance = 220
	tag.Parent = flash
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(255, 230, 80)
	label.TextStrokeTransparency = 0
	label.Text = word or "POP!"
	label.Parent = tag
	sound(flash, "pop")
	task.delay(0.25, function()
		sparks.Enabled = false
		smoke.Enabled = false
		flash.Transparency = 1
	end)
	cleanupLater(flash, 1.4)
end

function ItemService.clear()
	if folder then
		folder:Destroy()
	end
	folder = nil
	boxes = {}
	hazards = {}
end

function ItemService.setup(track: Track.Built)
	ItemService.clear()
	local f = Instance.new("Folder")
	f.Name = "Items"
	f.Parent = Workspace
	folder = f
	for _, spot in Track.itemBoxes(track) do
		local pos = v3(Track.spot(track, spot.distance, spot.lateral)) + Vector3.new(0, 3.5, 0)
		local part = Shapes.box(f, Vector3.new(4.5, 4.5, 4.5), CFrame.new(pos) * CFrame.Angles(math.rad(45), math.rad(45), 0), {
			color = Color3.fromRGB(150, 210, 255),
			material = Enum.Material.Glass,
			transparency = 0.2,
			name = "ItemBox",
		})
		part:SetAttribute("ItemBox", true)
		local core = Shapes.ball(f, 2.4, CFrame.new(pos), { color = Color3.fromRGB(255, 230, 120), material = Enum.Material.Neon, name = "ItemCore" })
		local gui = Instance.new("BillboardGui")
		gui.Size = UDim2.new(0, 44, 0, 44)
		gui.MaxDistance = 260
		gui.Parent = part
		local q = Instance.new("TextLabel")
		q.Size = UDim2.fromScale(1, 1)
		q.BackgroundTransparency = 1
		q.Font = Enum.Font.FredokaOne
		q.TextScaled = true
		q.TextColor3 = Color3.new(1, 1, 1)
		q.TextStrokeTransparency = 0
		q.Text = "?"
		q.Parent = gui
		part:SetAttribute("CoreName", core.Name)
		table.insert(boxes, { part = part, pos = pos, core = core } :: any)
	end
end

local function racerAtPlace(racers: { any }, place: number): any?
	for _, r in racers do
		if r.place == place then
			return r
		end
	end
	return nil
end

local function giveItem(racer: any, field: number, effects: any)
	local id = Items.roll(racer.place, field, math.random())
	racer.item = id
	racer.uses = Items.Defs[id].uses
	racer.itemReadyAt = now() + Items.RouletteTime
	racer.cpuUseAt = racer.itemReadyAt + 0.5 + math.random() * 3
	effects.itemChanged(racer)
end

-- Removes the oldest hazards when there are too many (per racer and overall).
local function makeRoom(owner: any, isTrap: boolean)
	if isTrap then
		local mine = {}
		for i, h in hazards do
			if h.owner == owner and (h.kind == "jellyPuddle" or h.kind == "springMine") then
				table.insert(mine, i)
			end
		end
		if #mine >= Items.MaxTrapsPerRacer then
			local h = table.remove(hazards, mine[1]) :: Hazard
			h.model:Destroy()
		end
	end
	while #hazards >= Items.MaxActiveHazards do
		local h = table.remove(hazards, 1) :: Hazard
		h.model:Destroy()
	end
end

local function newModel(name: string): Model
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = folder
	return m
end

local function place(model: Model, cf: CFrame)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			local offset = d:GetAttribute("Offset") :: CFrame?
			d.CFrame = cf * (offset or CFrame.new())
		end
	end
end

-- Builds a hazard model whose parts keep their offset from the hazard's centre.
local function part(model: Model, kind: string, size: Vector3, offset: CFrame, color: Color3, material: Enum.Material?, transparency: number?): BasePart
	local p: BasePart
	if kind == "ball" then
		p = Shapes.ball(model, size.X, offset, { color = color, material = material, transparency = transparency })
	elseif kind == "ellipsoid" then
		p = Shapes.ellipsoid(model, size, offset, { color = color, material = material, transparency = transparency })
	elseif kind == "disc" then
		p = Shapes.disc(model, size.X, size.Y, offset, { color = color, material = material, transparency = transparency })
	else
		p = Shapes.box(model, size, offset, { color = color, material = material, transparency = transparency })
	end
	p:SetAttribute("Offset", p.CFrame)
	return p
end

-- Tells racers a rocket is coming up behind them (at most every 1.5s).
local function warnAhead(racers: { any }, h: Hazard, effects: any)
	for _, r in racers do
		if r ~= h.owner then
			local gap = (r.score - (h.score :: number)) * (h.direction :: number)
			if gap > 0 and gap < WARN_RANGE and now() - (r.lastRocketWarn or 0) > 1.5 then
				r.lastRocketWarn = now()
				effects.warn(r, "🚀 Rocket incoming!")
			end
		end
	end
end

function ItemService.use(track: Track.Built, racers: { any }, racer: any, effects: any, aimBack: boolean?)
	local id = racer.item
	local root = rootOf(racer)
	if not id or not root or now() < racer.itemReadyAt or racer.finishTime then
		return
	end
	racer.uses -= 1
	if racer.uses <= 0 then
		racer.item = nil
	end
	effects.itemChanged(racer)

	local forward = forwardOf(racer)
	local ground = root.CFrame.Position - Vector3.new(0, 2, 0)

	if id == "turboSoda" then
		effects.boost(racer, Items.SodaBoost)
		sound(root, "fizz")
	elseif id == "bubbleShield" then
		effects.shield(racer, Items.ShieldTime)
	elseif id == "windupRocket" then
		makeRoom(racer, false)
		local m = newModel("Rocket")
		part(m, "ellipsoid", Vector3.new(2.6, 2.6, 6), CFrame.new(), Color3.fromRGB(240, 70, 70))
		part(m, "ellipsoid", Vector3.new(2, 2, 2.4), CFrame.new(0, 0, -2.8), Color3.fromRGB(255, 255, 255))
		part(m, "box", Vector3.new(4, 0.3, 1.4), CFrame.new(0, 0, 2.2), Color3.fromRGB(255, 210, 60))
		part(m, "disc", Vector3.new(1.4, 0.6, 1.4), CFrame.new(0, 1.6, 1) , Color3.fromRGB(255, 210, 60))
		local flame = part(m, "ball", Vector3.new(1.6, 1.6, 1.6), CFrame.new(0, 0, 3.4), Color3.fromRGB(255, 160, 40), Enum.Material.Neon)
		flame.Name = "Flame"
		place(m, CFrame.lookAt(root.CFrame.Position, root.CFrame.Position + forward))
		local proj = Track.project(track, Track.v(root.CFrame.Position.X, root.CFrame.Position.Y, root.CFrame.Position.Z), racer.progress.index)
		local direction = if aimBack then -1 else 1
		local h: Hazard = {
			kind = id,
			model = m,
			owner = racer,
			born = now(),
			life = Items.RocketLife,
			pos = root.CFrame.Position,
			score = racer.score + 7 * direction,
			direction = direction,
			lateral = proj.lateral,
		}
		table.insert(hazards, h)
		sound(flame, "whoosh")
	elseif id == "popcornBomb" then
		makeRoom(racer, false)
		local m = newModel("PopcornBomb")
		part(m, "ball", Vector3.new(4, 4, 4), CFrame.new(), Color3.fromRGB(255, 80, 80))
		part(m, "ball", Vector3.new(4.1, 4.1, 4.1), CFrame.new(0, 0.3, 0), Color3.fromRGB(255, 255, 255), nil, 0.6)
		for i = 1, 6 do
			local a = i * 1.05
			part(m, "ball", Vector3.new(1.4, 1.4, 1.4), CFrame.new(math.cos(a) * 1.2, 2.2, math.sin(a) * 1.2), Color3.fromRGB(255, 245, 210))
		end
		local fuse = part(m, "ball", Vector3.new(1, 1, 1), CFrame.new(0, 3.2, 0), Color3.fromRGB(255, 220, 60), Enum.Material.Neon)
		fuse.Name = "Fuse"
		place(m, CFrame.new(root.CFrame.Position + Vector3.new(0, 2, 0)))
		local target = if aimBack then ground - forward * 8 else ground + forward * Items.BombThrow + Vector3.new(0, 0, 0)
		local h: Hazard = {
			kind = id,
			model = m,
			owner = racer,
			born = now(),
			life = 6,
			pos = target,
			from = root.CFrame.Position + Vector3.new(0, 2, 0),
			landAt = now() + (if aimBack then 0.15 else 0.55),
			popAt = now() + (if aimBack then 0.15 else 0.55) + Items.BombFuse,
		}
		table.insert(hazards, h)
	elseif id == "jellyPuddle" or id == "springMine" then
		makeRoom(racer, true)
		local spot = ground - forward * 8
		local m: Model
		if id == "jellyPuddle" then
			m = newModel("JellyPuddle")
			part(m, "ellipsoid", Vector3.new(10, 1.6, 10), CFrame.new(0, 0.6, 0), Color3.fromRGB(255, 120, 190), Enum.Material.Glass, 0.25)
			part(m, "ellipsoid", Vector3.new(5, 2.2, 5), CFrame.new(1.2, 1.2, -0.8), Color3.fromRGB(255, 160, 210), Enum.Material.Glass, 0.2)
		else
			m = newModel("SpringMine")
			part(m, "disc", Vector3.new(6, 0.8, 6), CFrame.new(0, 0.4, 0), Color3.fromRGB(60, 60, 70))
			for k = 0, 3 do
				part(m, "disc", Vector3.new(4.2, 0.5, 4.2), CFrame.new(0, 1 + k * 0.7, 0), if k % 2 == 0 then Color3.fromRGB(255, 210, 60) else Color3.fromRGB(240, 70, 70))
			end
			part(m, "disc", Vector3.new(5, 0.6, 5), CFrame.new(0, 3.9, 0), Color3.fromRGB(240, 70, 70), Enum.Material.Neon)
		end
		place(m, CFrame.new(spot))
		table.insert(hazards, {
			kind = id,
			model = m,
			owner = racer,
			born = now(),
			life = if id == "jellyPuddle" then Items.JellyLife else Items.MineLife,
			pos = spot,
			hitsLeft = if id == "jellyPuddle" then Items.JellyHits else 1,
		})
		sound(m:FindFirstChildWhichIsA("BasePart") :: BasePart, if id == "jellyPuddle" then "splat" else "boing")
	end
end

local function touching(racer: any, pos: Vector3, radius: number): boolean
	local root = rootOf(racer)
	return root ~= nil and (root.CFrame.Position - pos).Magnitude <= radius
end

-- Returns false when the hazard is finished and should be removed.
local function stepHazard(h: Hazard, track: Track.Built, racers: { any }, dt: number, effects: any): boolean
	local t = now()
	if t - h.born > h.life then
		return false
	end
	local ownerSafe = t - h.born < 0.6

	if h.kind == "windupRocket" then
		h.score = (h.score :: number) + Items.RocketSpeed * dt * (h.direction :: number)
		local d = (h.score :: number) % track.length
		local spot = Track.spot(track, d, h.lateral :: number)
		local _, tan = Track.at(track, d)
		h.pos = v3(spot) + Vector3.new(0, 2, 0)
		local dir = Vector3.new(tan.x, 0, tan.z) * (h.direction :: number)
		local wobble = CFrame.Angles(0, 0, math.sin(t * 20) * 0.2)
		place(h.model, CFrame.lookAt(h.pos, h.pos + dir) * wobble)
		warnAhead(racers, h, effects)
		for _, r in racers do
			if not (ownerSafe and r == h.owner) and touching(r, h.pos, HIT_RADIUS) then
				effects.hit(r, "spin")
				ItemService.explode(h.pos, "POP!")
				return false
			end
		end
		return true
	elseif h.kind == "popcornBomb" then
		local landAt, popAt = h.landAt :: number, h.popAt :: number
		if t < landAt then
			-- Lobbed in an arc.
			local u = 1 - (landAt - t) / math.max(landAt - h.born, 0.01)
			local from = h.from :: Vector3
			local p = from:Lerp(h.pos, u) + Vector3.new(0, math.sin(u * math.pi) * 12, 0)
			place(h.model, CFrame.new(p + Vector3.new(0, 2, 0)))
			return true
		end
		place(h.model, CFrame.new(h.pos + Vector3.new(0, 2, 0)))
		-- Blink faster as the fuse runs down.
		local fuse = h.model:FindFirstChild("Fuse") :: BasePart?
		if fuse then
			local left = popAt - t
			local rate = if left < 0.6 then 14 else 5
			fuse.Transparency = if math.floor(t * rate) % 2 == 0 then 0 else 0.8
		end
		if t >= popAt then
			ItemService.explode(h.pos + Vector3.new(0, 2, 0), "POP!", Color3.fromRGB(255, 240, 200))
			for _, r in racers do
				if touching(r, h.pos + Vector3.new(0, 2, 0), Items.BombRadius) then
					effects.hit(r, "spin")
				end
			end
			return false
		end
		-- Warn anyone driving into the blast zone.
		for _, r in racers do
			if touching(r, h.pos, Items.BombRadius + 25) and t - (r.lastBombWarn or 0) > 1.2 then
				r.lastBombWarn = t
				effects.warn(r, "🍿 Bomb ahead!")
			end
		end
		return true
	elseif h.kind == "jellyPuddle" or h.kind == "springMine" then
		-- Jelly wobbles; mines bounce a little so they're easy to spot.
		local bob = if h.kind == "springMine" then math.abs(math.sin(t * 4)) * 0.6 else 0
		local squish = if h.kind == "jellyPuddle" then CFrame.Angles(0, t * 0.5, 0) else CFrame.new()
		place(h.model, CFrame.new(h.pos + Vector3.new(0, bob, 0)) * squish)
		for _, r in racers do
			if not (ownerSafe and r == h.owner) and touching(r, h.pos + Vector3.new(0, 2, 0), HIT_RADIUS + 1) then
				local kind = if h.kind == "jellyPuddle" then "slow" else "launch"
				if effects.hit(r, kind) then
					ItemService.explode(h.pos + Vector3.new(0, 2, 0), if kind == "slow" then "SPLAT!" else "BOING!", if kind == "slow" then Color3.fromRGB(255, 140, 200) else Color3.fromRGB(255, 220, 90))
					h.hitsLeft = (h.hitsLeft :: number) - 1
					if (h.hitsLeft :: number) <= 0 then
						return false
					end
				end
			end
		end
		return true
	end
	return false
end

function ItemService.tick(track: Track.Built, racers: { any }, dt: number, effects: any)
	local t = now()
	local field = #racers

	for _, box in boxes do
		local core = (box :: any).core :: BasePart
		if box.respawnAt then
			if t >= box.respawnAt then
				box.respawnAt = nil
				box.part.Transparency = 0.2
				core.Transparency = 0
			end
			continue
		end
		for _, r in racers do
			local root = rootOf(r)
			if root and not r.item and not r.finishTime and (root.CFrame.Position - box.pos).Magnitude <= PICKUP_RADIUS then
				giveItem(r, field, effects)
				box.respawnAt = t + Items.BoxRespawn
				box.part.Transparency = 1
				core.Transparency = 1
				break
			end
		end
	end

	for i = #hazards, 1, -1 do
		local h = hazards[i]
		local ok, keep = pcall(stepHazard, h, track, racers, dt, effects)
		if not ok or not keep then
			if not ok then
				warn("[ItemService] hazard failed:", keep)
			end
			h.model:Destroy()
			table.remove(hazards, i)
		end
	end

	-- CPU drivers use their items after a short, random delay. Traps and
	-- shields are used straight away; attacks wait for someone nearby.
	for _, r in racers do
		if r.state and r.item and t >= r.cpuUseAt then
			local id = r.item
			local ahead = racerAtPlace(racers, r.place - 1)
			local attackReady = id ~= "windupRocket" or (ahead ~= nil and ahead.score - r.score < 160)
			if attackReady then
				ItemService.use(track, racers, r, effects, false)
			end
			r.cpuUseAt = t + 0.8
		end
	end
end

return ItemService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">Landmarks</string>
          <string name="Source"><![CDATA[-- Big themed pieces for the oversized-world tracks: tunnels (the bed, garden
-- hose, cardboard box, hollow log), set pieces (toaster, cereal bowls, toy
-- train set, night lamp, flowerpots, sprinklers...), the moving crossers
-- (toy robot, toy train, beetles) and giant room walls for indoor tracks.
--
-- Built from rounded primitives (common/Shapes). Every one of these is a
-- good candidate for a custom mesh later; see README "Assets to replace".

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Track = require(Shared.Track)
local Shapes = require(ReplicatedStorage.Common.Shapes)

local Landmarks = {}

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

local function c3(t: { number }): Color3
	return Color3.fromRGB(t[1], t[2], t[3])
end

local function at(track: Track.Built, distance: number, lateral: number, height: number?): CFrame
	local p = Track.spot(track, distance, lateral)
	local _, tan = Track.at(track, distance)
	local pos = Vector3.new(p.x, p.y + (height or 0), p.z)
	return CFrame.lookAt(pos, pos + Vector3.new(tan.x, 0, tan.z))
end

---------------------------------------------------------------------------
-- Tunnels
---------------------------------------------------------------------------
local tunnelBuilders: { [string]: (Track.Built, number, number, any, Instance) -> () } = {}

-- A giant bed the road passes under: legs outside the walls, a puffy
-- mattress and blanket above, a pillow and a headboard at one end.
tunnelBuilders.bed = function(track, from, to, _theme, parent)
	local half = track.def.width / 2 + Track.ShoulderWidth + 6
	local mid = (from + to) / 2
	local length = to - from
	local cf = at(track, mid, 0, 0)
	local h = 34
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			Shapes.pillar(parent, 6, h, cf * CFrame.new(sx * half, h / 2, sz * length / 2), { color = rgb(120, 80, 50), collide = true })
		end
	end
	Shapes.roundedBox(parent, Vector3.new(half * 2 + 10, 6, length + 10), 4, cf * CFrame.new(0, h + 3, 0), { color = rgb(120, 80, 50), collide = true })
	Shapes.roundedBox(parent, Vector3.new(half * 2 + 8, 10, length + 6), 5, cf * CFrame.new(0, h + 11, 0), { color = rgb(245, 245, 255) })
	Shapes.ellipsoid(parent, Vector3.new(half * 2 + 16, 12, length * 0.75), cf * CFrame.new(0, h + 18, length * 0.1), { color = rgb(90, 120, 220) })
	Shapes.ellipsoid(parent, Vector3.new(half * 1.2, 10, 18), cf * CFrame.new(0, h + 20, -length / 2 + 10), { color = rgb(255, 255, 255) })
	Shapes.roundedBox(parent, Vector3.new(half * 2 + 12, 40, 6), 6, cf * CFrame.new(0, h + 10, -length / 2 - 6), { color = rgb(140, 95, 60), collide = true })
	-- Fairy lights under the bed so the tunnel isn't pitch black.
	for z = -length / 2 + 6, length / 2 - 6, 10 do
		local bulb = Shapes.ball(parent, 1.4, cf * CFrame.new(0, h - 1, z), { color = rgb(255, 220, 140), material = Enum.Material.Neon })
		local light = Instance.new("PointLight")
		light.Range = 22
		light.Brightness = 1.4
		light.Color = bulb.Color
		light.Parent = bulb
	end
end

-- Rings of a green garden hose with yellow stripes.
tunnelBuilders.hose = function(track, from, to, _theme, parent)
	local span = track.def.width + Track.ShoulderWidth * 2 + 10
	local i = 0
	for d = from, to, 7 do
		i += 1
		local cf = at(track, d, 0, -2)
		Shapes.arch(parent, span, 4, 6, cf, { color = if i % 3 == 0 then rgb(255, 210, 60) else rgb(60, 170, 80), collide = true }, 16)
	end
	local endCf = at(track, to, 0, -2)
	Shapes.tube(parent, 6, 40, endCf * CFrame.new(span / 2 + 18, 2, 6) * CFrame.Angles(0, math.rad(90), 0), { color = rgb(60, 170, 80) })
end

-- A cardboard box with the ends cut out.
tunnelBuilders.box = function(track, from, to, _theme, parent)
	local span = track.def.width + Track.ShoulderWidth * 2 + 6
	local mid = (from + to) / 2
	local length = to - from
	local cf = at(track, mid, 0, 0)
	local h = 30
	local cardboard = rgb(200, 160, 110)
	for _, sx in { -1, 1 } do
		Shapes.box(parent, Vector3.new(3, h, length), cf * CFrame.new(sx * span / 2, h / 2, 0), { color = cardboard, collide = true })
	end
	Shapes.box(parent, Vector3.new(span + 3, 3, length), cf * CFrame.new(0, h, 0), { color = cardboard, collide = true })
	Shapes.box(parent, Vector3.new(span * 0.3, 0.2, length + 0.2), cf * CFrame.new(0, h + 1.6, 0), { color = rgb(220, 200, 150) })
	for _, sz in { -1, 1 } do
		Shapes.box(parent, Vector3.new(span + 3, 8, 1), cf * CFrame.new(0, h - 4, sz * length / 2), { color = cardboard })
	end
end

-- A hollow log (half-rings of bark).
tunnelBuilders.log = function(track, from, to, _theme, parent)
	local span = track.def.width + 10
	for d = from, to, 4 do
		Shapes.arch(parent, span, 5, 4.5, at(track, d, 0, -3), { color = rgb(130, 90, 55), collide = true }, 16)
	end
end

tunnelBuilders.arch = function(track, from, to, theme, parent)
	local span = track.def.width + Track.ShoulderWidth * 2 + 6
	local i = 0
	for d = from, to, 10 do
		i += 1
		Shapes.arch(parent, span, 3, 3, at(track, d, 0, 0), { color = if i % 2 == 0 then c3(theme.accent) else c3(theme.wall), material = Enum.Material.Neon }, 14)
	end
end

function Landmarks.tunnel(track: Track.Built, style: string, from: number, to: number, theme: any, parent: Instance)
	local builder = tunnelBuilders[style]
	if builder then
		builder(track, from * track.length, to * track.length, theme, parent)
	end
end

---------------------------------------------------------------------------
-- Set pieces (placed by Scenery.setPieceSpots)
---------------------------------------------------------------------------
local pieces: { [string]: (CFrame, any, Instance) -> () } = {}

pieces.toaster = function(cf, _theme, parent)
	local body = rgb(220, 70, 60)
	Shapes.roundedBox(parent, Vector3.new(70, 50, 44), 12, cf * CFrame.new(0, 25, 0), { color = body, collide = true, reflectance = 0.1 })
	for _, x in { -14, 14 } do
		Shapes.roundedBox(parent, Vector3.new(14, 2, 34), 4, cf * CFrame.new(x, 50.5, 0), { color = rgb(40, 40, 45) })
		-- Toast popping out.
		Shapes.roundedBox(parent, Vector3.new(12, 22, 30), 5, cf * CFrame.new(x, 58, 0), { color = rgb(225, 170, 90) })
		Shapes.box(parent, Vector3.new(12.2, 18, 26), cf * CFrame.new(x, 58, 0), { color = rgb(245, 215, 150) })
	end
	Shapes.box(parent, Vector3.new(4, 4, 10), cf * CFrame.new(37, 30, 0), { color = rgb(40, 40, 45) })
	Shapes.ball(parent, 6, cf * CFrame.new(37, 22, -8), { color = rgb(240, 240, 240) })
end

pieces.cerealBowl = function(cf, _theme, parent)
	Shapes.pillar(parent, 50, 18, cf * CFrame.new(0, 9, 0), { color = rgb(255, 255, 255), collide = true })
	Shapes.pillar(parent, 56, 4, cf * CFrame.new(0, 19, 0), { color = rgb(90, 150, 230), collide = true })
	Shapes.pillar(parent, 48, 1, cf * CFrame.new(0, 19.6, 0), { color = rgb(250, 248, 240) })
	local colors = { rgb(255, 120, 60), rgb(255, 210, 70), rgb(140, 200, 80), rgb(200, 100, 200) }
	for i = 1, 22 do
		local a = i * 2.4
		local r = (i % 6) * 3.5
		Shapes.tube(parent, 5, 2, cf * CFrame.new(math.cos(a) * r, 21, math.sin(a) * r) * CFrame.Angles(0, a, math.rad(90)), { color = colors[i % 4 + 1] })
	end
end

pieces.mug = function(cf, _theme, parent)
	Shapes.pillar(parent, 30, 40, cf * CFrame.new(0, 20, 0), { color = rgb(255, 230, 90), collide = true })
	Shapes.pillar(parent, 26, 1, cf * CFrame.new(0, 39, 0), { color = rgb(110, 70, 40) })
	Shapes.arch(parent, 18, 4, 4, cf * CFrame.new(15, 20, 0) * CFrame.Angles(0, 0, math.rad(-90)), { color = rgb(255, 230, 90) }, 10)
end

pieces.fruitBowl = function(cf, _theme, parent)
	Shapes.ellipsoid(parent, Vector3.new(60, 22, 60), cf * CFrame.new(0, 8, 0), { color = rgb(170, 220, 255), material = Enum.Material.Glass, transparency = 0.3, collide = true })
	local fruit = { rgb(230, 50, 50), rgb(255, 160, 40), rgb(250, 220, 60), rgb(120, 200, 60) }
	for i = 1, 9 do
		local a = i * 2.1
		Shapes.ball(parent, 14, cf * CFrame.new(math.cos(a) * 12, 20 + (i % 3) * 5, math.sin(a) * 12), { color = fruit[i % 4 + 1] })
	end
end

pieces.trainSet = function(cf, _theme, parent)
	-- An oval of toy track with sleepers.
	for i = 0, 47 do
		local a = i / 48 * math.pi * 2
		local p = Vector3.new(math.cos(a) * 60, 0.6, math.sin(a) * 36)
		local tangent = Vector3.new(-math.sin(a) * 60, 0, math.cos(a) * 36).Unit
		local seg = CFrame.lookAt(p, p + tangent)
		Shapes.box(parent, Vector3.new(12, 1.2, 3), cf * seg, { color = rgb(160, 110, 70) })
		for _, side in { -1, 1 } do
			Shapes.box(parent, Vector3.new(1, 1.6, 9), cf * seg * CFrame.new(side * 4, 0.6, 0), { color = rgb(200, 200, 210) })
		end
	end
	-- A little station.
	Shapes.roundedBox(parent, Vector3.new(24, 16, 16), 3, cf * CFrame.new(0, 8, 0), { color = rgb(240, 90, 90), collide = true })
	Shapes.box(parent, Vector3.new(28, 3, 20), cf * CFrame.new(0, 17, 0), { color = rgb(80, 120, 220) })
end

pieces.nightLamp = function(cf, _theme, parent)
	Shapes.pillar(parent, 40, 6, cf * CFrame.new(0, 3, 0), { color = rgb(240, 240, 250), collide = true })
	Shapes.pillar(parent, 6, 70, cf * CFrame.new(0, 40, 0), { color = rgb(240, 240, 250), collide = true })
	local shade = Shapes.ellipsoid(parent, Vector3.new(56, 40, 56), cf * CFrame.new(0, 86, 0), { color = rgb(255, 220, 140), material = Enum.Material.Neon, transparency = 0.15 })
	local light = Instance.new("PointLight")
	light.Range = 120
	light.Brightness = 2.2
	light.Color = rgb(255, 210, 140)
	light.Shadows = true
	light.Parent = shade
end

pieces.toyChest = function(cf, _theme, parent)
	Shapes.roundedBox(parent, Vector3.new(80, 40, 50), 8, cf * CFrame.new(0, 20, 0), { color = rgb(80, 150, 230), collide = true })
	Shapes.ellipsoid(parent, Vector3.new(84, 20, 54), cf * CFrame.new(0, 42, 0), { color = rgb(255, 200, 60), collide = true })
	for i, color in { rgb(255, 90, 90), rgb(110, 220, 120), rgb(255, 255, 255) } do
		Shapes.ball(parent, 12, cf * CFrame.new((i - 2) * 20, 54, 0), { color = color })
	end
end

pieces.bookStack = function(cf, _theme, parent)
	local colors = { rgb(220, 70, 70), rgb(70, 130, 220), rgb(250, 200, 60), rgb(110, 190, 110) }
	for i = 0, 4 do
		Shapes.roundedBox(parent, Vector3.new(70 - i * 4, 9, 50 - i * 3), 3, cf * CFrame.new(i * 1.5, 4.5 + i * 9, 0) * CFrame.Angles(0, math.rad(i * 7), 0), { color = colors[i % 4 + 1], collide = true })
	end
end

pieces.flowerpot = function(cf, _theme, parent)
	Shapes.pillar(parent, 46, 34, cf * CFrame.new(0, 17, 0), { color = rgb(210, 110, 70), collide = true })
	Shapes.pillar(parent, 52, 6, cf * CFrame.new(0, 34, 0), { color = rgb(220, 120, 80), collide = true })
	Shapes.pillar(parent, 44, 1, cf * CFrame.new(0, 37, 0), { color = rgb(100, 70, 45) })
	Shapes.pillar(parent, 3, 50, cf * CFrame.new(0, 60, 0), { color = rgb(80, 160, 70) })
	for i = 0, 5 do
		local a = i / 6 * math.pi * 2
		Shapes.ellipsoid(parent, Vector3.new(16, 6, 9), cf * CFrame.new(math.cos(a) * 9, 86, math.sin(a) * 9) * CFrame.Angles(0, -a, 0), { color = rgb(255, 120, 170) })
	end
	Shapes.ball(parent, 10, cf * CFrame.new(0, 87, 0), { color = rgb(255, 220, 60) })
end

-- Sprinklers spray when their slippery zone is on (TrackAnimator toggles the water).
pieces.sprinkler = function(cf, _theme, parent)
	Shapes.pillar(parent, 10, 4, cf * CFrame.new(0, 2, 0), { color = rgb(70, 70, 80), collide = true })
	Shapes.pillar(parent, 3, 10, cf * CFrame.new(0, 9, 0), { color = rgb(200, 200, 210) })
	local head = Shapes.ellipsoid(parent, Vector3.new(6, 3, 6), cf * CFrame.new(0, 15, 0), { color = rgb(255, 210, 60) })
	head.Name = "SprinklerHead"
	local water = Instance.new("ParticleEmitter")
	water.Name = "Water"
	water.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	water.Color = ColorSequence.new(rgb(170, 220, 255))
	water.Size = NumberSequence.new(0.8, 0.3)
	water.Transparency = NumberSequence.new(0.2, 1)
	water.Lifetime = NumberRange.new(1.2, 1.6)
	water.Speed = NumberRange.new(45, 60)
	water.SpreadAngle = Vector2.new(25, 60)
	water.Acceleration = Vector3.new(0, -60, 0)
	water.Rate = 160
	water.Enabled = false
	water.Parent = head
end

pieces.log = function(_cf, _theme, _parent)
	-- The hollow log shortcut is built with the shortcut itself (see TrackBuilder).
end

pieces.wateringCan = function(cf, _theme, parent)
	Shapes.ellipsoid(parent, Vector3.new(50, 44, 40), cf * CFrame.new(0, 22, 0), { color = rgb(90, 180, 220), collide = true })
	Shapes.tube(parent, 6, 46, cf * CFrame.new(-34, 34, 0) * CFrame.Angles(0, 0, math.rad(35)), { color = rgb(90, 180, 220) })
	Shapes.pillar(parent, 10, 3, cf * CFrame.new(-52, 46, 0), { color = rgb(70, 150, 190) })
	Shapes.arch(parent, 30, 4, 4, cf * CFrame.new(10, 44, 0), { color = rgb(70, 150, 190) }, 10)
end

function Landmarks.setPiece(kind: string, cf: CFrame, theme: any, parent: Instance)
	local builder = pieces[kind]
	if builder then
		builder(cf, theme, parent)
	end
end

---------------------------------------------------------------------------
-- Crossers (moved by client/TrackAnimator; hits are checked by the server)
---------------------------------------------------------------------------
local crossers: { [string]: (Model) -> () } = {}

crossers.robot = function(m)
	local base = CFrame.new()
	local metal = rgb(180, 190, 210)
	Shapes.roundedBox(m, Vector3.new(9, 9, 7), 2, base * CFrame.new(0, 9, 0), { color = metal, anchored = true })
	Shapes.roundedBox(m, Vector3.new(7, 6, 6), 2, base * CFrame.new(0, 17, 0), { color = metal, anchored = true })
	for _, x in { -1.6, 1.6 } do
		Shapes.ball(m, 2.2, base * CFrame.new(x, 17.5, -3), { color = rgb(80, 220, 255), material = Enum.Material.Neon, anchored = true })
		Shapes.pillar(m, 2.4, 5, base * CFrame.new(x * 1.4, 2.5, 0), { color = rgb(120, 130, 150), anchored = true })
	end
	Shapes.pillar(m, 0.5, 4, base * CFrame.new(0, 22, 0), { color = rgb(120, 130, 150), anchored = true })
	Shapes.ball(m, 1.6, base * CFrame.new(0, 24.5, 0), { color = rgb(255, 80, 80), material = Enum.Material.Neon, anchored = true })
	for _, x in { -6, 6 } do
		Shapes.capsule(m, 2.4, 8, base * CFrame.new(x, 10, 0), { color = metal, anchored = true })
	end
end

crossers.train = function(m)
	local colors = { rgb(230, 60, 60), rgb(70, 130, 230), rgb(250, 200, 60) }
	for i = 0, 2 do
		local cf = CFrame.new(0, 0, (i - 1) * 13)
		Shapes.roundedBox(m, Vector3.new(9, 9, 11), 2, cf * CFrame.new(0, 6, 0), { color = colors[i + 1], anchored = true })
		for _, x in { -4.7, 4.7 } do
			for _, z in { -3.5, 3.5 } do
				Shapes.tube(m, 3.6, 1, cf * CFrame.new(x, 2, z), { color = rgb(40, 40, 45), anchored = true })
			end
		end
	end
	Shapes.pillar(m, 3, 5, CFrame.new(0, 12.5, -16), { color = rgb(40, 40, 45), anchored = true })
end

crossers.beetle = function(m)
	local shell = rgb(220, 40, 40)
	Shapes.ellipsoid(m, Vector3.new(12, 7, 15), CFrame.new(0, 5, 0), { color = shell, anchored = true, reflectance = 0.15 })
	Shapes.ellipsoid(m, Vector3.new(7, 5, 5), CFrame.new(0, 4, -8), { color = rgb(30, 30, 35), anchored = true })
	for _, x in { -2, 2 } do
		Shapes.ball(m, 1.6, CFrame.new(x, 5, -10), { color = rgb(255, 255, 255), anchored = true })
	end
	for i = 0, 5 do
		local a = i / 6 * math.pi * 2
		Shapes.ball(m, 2.2, CFrame.new(math.cos(a) * 3.5, 8.4, math.sin(a) * 4.5), { color = rgb(30, 30, 35), anchored = true })
	end
	for _, side in { -1, 1 } do
		for k = -1, 1 do
			Shapes.box(m, Vector3.new(6, 0.6, 0.6), CFrame.new(side * 7, 2, k * 4) * CFrame.Angles(0, 0, side * 0.5), { color = rgb(30, 30, 35), anchored = true })
		end
	end
end

function Landmarks.crosser(kind: string, index: number, parent: Instance, start: CFrame): Model
	local m = Instance.new("Model")
	m.Name = `Crosser{index}`
	local builder = crossers[kind]
	if builder then
		builder(m)
	end
	-- Pivot at the model's base so the animator can place it on the road.
	local origin = Instance.new("Part")
	origin.Name = "Origin"
	origin.Anchored = true
	origin.CanCollide = false
	origin.CanQuery = false
	origin.CanTouch = false
	origin.Transparency = 1
	origin.Size = Vector3.one
	origin.CFrame = CFrame.new()
	origin.Parent = m
	m.PrimaryPart = origin
	-- Built around the origin; move every part to the starting spot.
	for _, d in m:GetDescendants() do
		if d:IsA("BasePart") then
			d.CFrame = start * d.CFrame
		end
	end
	m:SetAttribute("CrosserIndex", index)
	m.Parent = parent
	return m
end

---------------------------------------------------------------------------
-- Room walls for indoor tracks (the bedroom, the kitchen)
---------------------------------------------------------------------------
function Landmarks.room(theme: any, minX: number, maxX: number, minZ: number, maxZ: number, floorY: number, parent: Instance)
	local room = theme.room
	if not room then
		return
	end
	local margin = 280
	local x0, x1, z0, z1 = minX - margin, maxX + margin, minZ - margin, maxZ + margin
	local h = room.height
	local wallColor, trim = c3(room.wall), c3(room.trim)
	local function wall(cx: number, cz: number, w: number, d: number)
		Shapes.box(parent, Vector3.new(w, h, d), CFrame.new(cx, floorY + h / 2, cz), { color = wallColor, collide = true })
		Shapes.box(parent, Vector3.new(w + 1, 14, d + 1), CFrame.new(cx, floorY + 7, cz), { color = trim })
	end
	wall((x0 + x1) / 2, z0, x1 - x0, 6)
	wall((x0 + x1) / 2, z1, x1 - x0, 6)
	wall(x0, (z0 + z1) / 2, 6, z1 - z0)
	wall(x1, (z0 + z1) / 2, 6, z1 - z0)

	-- A window in the far wall (moonlit for the bedroom, sunny for the kitchen).
	local night = theme.clock < 6 or theme.clock > 19
	local winCf = CFrame.new((x0 + x1) / 2, floorY + h * 0.55, z0 + 4)
	Shapes.roundedBox(parent, Vector3.new(180, 140, 2), 10, winCf, { color = trim })
	Shapes.box(parent, Vector3.new(164, 124, 2.2), winCf, { color = if night then rgb(30, 40, 90) else rgb(170, 220, 255), material = Enum.Material.Neon, transparency = if night then 0 else 0.3 })
	Shapes.box(parent, Vector3.new(6, 124, 2.4), winCf, { color = trim })
	Shapes.box(parent, Vector3.new(164, 6, 2.4), winCf, { color = trim })
	if night then
		Shapes.disc(parent, 34, 2.5, winCf * CFrame.new(40, 30, 0) * CFrame.Angles(math.rad(90), 0, 0), { color = rgb(255, 250, 220), material = Enum.Material.Neon })
		for i = 1, 14 do
			Shapes.ball(parent, 2.2, winCf * CFrame.new(-70 + (i * 37) % 140, -50 + (i * 23) % 100, 0.5), { color = rgb(255, 255, 230), material = Enum.Material.Neon })
		end
	end
	-- A big door on a side wall.
	local doorCf = CFrame.new(x1 - 4, floorY + 110, (z0 + z1) / 2) * CFrame.Angles(0, math.rad(90), 0)
	Shapes.roundedBox(parent, Vector3.new(120, 220, 3), 6, doorCf, { color = trim })
	Shapes.ball(parent, 10, doorCf * CFrame.new(42, -10, -3), { color = rgb(255, 210, 60), reflectance = 0.3 })
end

return Landmarks
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">LobbyBuilder</string>
          <string name="Source"><![CDATA[-- Builds the Kart Carnival lobby from LobbyLayout: spawn plaza, status board,
-- map voting pads with miniature track displays, ready arch, garage with kart
-- display pedestals, podium, spectator screen, photo spot, Ferris wheel,
-- practice loop (drift circle, jump ramp, boost tunnel) and hidden tokens.
-- Returns handles RoundService uses to update signs and displays.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Karts = require(Shared.Karts)
local LobbyLayout = require(Shared.LobbyLayout)
local Track = require(Shared.Track)
local Tracks = require(Shared.Tracks)
local KartRig = require(ReplicatedStorage.Common.KartRig)
local Shapes = require(ReplicatedStorage.Common.Shapes)

local TrackBuilder = require(script.Parent.TrackBuilder)

local LobbyBuilder = {}

local PALETTE = {
	pink = Color3.fromRGB(255, 95, 140),
	yellow = Color3.fromRGB(255, 205, 60),
	sky = Color3.fromRGB(90, 190, 255),
	mint = Color3.fromRGB(110, 220, 170),
	purple = Color3.fromRGB(160, 110, 240),
	white = Color3.fromRGB(250, 250, 252),
	cream = Color3.fromRGB(255, 240, 215),
	grass = Color3.fromRGB(120, 200, 110),
	tile = Color3.fromRGB(235, 225, 210),
	dark = Color3.fromRGB(40, 42, 56),
	gold = Color3.fromRGB(255, 200, 40),
}
local PAD_COLORS = { PALETTE.pink, PALETTE.sky, PALETTE.mint }

local function cf(spot: LobbyLayout.Spot, y: number?): CFrame
	return CFrame.new(spot.x, (y or 0) + spot.y, spot.z)
end

local function facing(spot: LobbyLayout.Spot, target: LobbyLayout.Spot, y: number): CFrame
	local from = Vector3.new(spot.x, y, spot.z)
	return CFrame.lookAt(from, Vector3.new(target.x, y, target.z))
end

-- A sign with a SurfaceGui on its front. Returns the title and body labels.
local function sign(parent: Instance, size: Vector3, at: CFrame, color: Color3, title: string): (TextLabel, TextLabel)
	local parts = Shapes.roundedBox(parent, size, 1.2, at, { color = color, collide = true })
	local face = Shapes.box(parent, Vector3.new(size.X - 2, size.Y - 2, 0.2), at * CFrame.new(0, 0, -size.Z / 2 - 0.1), { color = PALETTE.dark })
	local _ = parts
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 24
	gui.LightInfluence = 0
	gui.Parent = face
	local titleLabel = Instance.new("TextLabel")
	titleLabel.Size = UDim2.fromScale(1, 0.32)
	titleLabel.BackgroundTransparency = 1
	titleLabel.Font = Enum.Font.FredokaOne
	titleLabel.TextScaled = true
	titleLabel.TextColor3 = PALETTE.yellow
	titleLabel.Text = title
	titleLabel.Parent = gui
	local body = Instance.new("TextLabel")
	body.Position = UDim2.fromScale(0.04, 0.34)
	body.Size = UDim2.fromScale(0.92, 0.62)
	body.BackgroundTransparency = 1
	body.Font = Enum.Font.FredokaOne
	body.TextScaled = true
	body.TextWrapped = true
	body.TextColor3 = PALETTE.white
	body.Text = ""
	body.Parent = gui
	return titleLabel, body
end

local function prompt(parent: BasePart, action: string, object: string, key: Enum.KeyCode?): ProximityPrompt
	local p = Instance.new("ProximityPrompt")
	p.ActionText = action
	p.ObjectText = object
	p.KeyboardKeyCode = key or Enum.KeyCode.E
	p.MaxActivationDistance = 16
	p.RequiresLineOfSight = false
	p.HoldDuration = 0.15
	p.Parent = parent
	return p
end

---------------------------------------------------------------------------
-- Decorations
---------------------------------------------------------------------------
local function balloonCluster(parent: Instance, at: CFrame)
	local colors = { PALETTE.pink, PALETTE.yellow, PALETTE.sky, PALETTE.mint, PALETTE.purple }
	for i = 1, 5 do
		local a = i / 5 * math.pi * 2
		local offset = Vector3.new(math.cos(a) * 2.2, 14 + (i % 2) * 2.5, math.sin(a) * 2.2)
		Shapes.ellipsoid(parent, Vector3.new(3.4, 4.2, 3.4), at + offset, { color = colors[i], reflectance = 0.15 })
		Shapes.box(parent, Vector3.new(0.08, offset.Y - 2, 0.08), at + Vector3.new(offset.X / 2, (offset.Y - 2) / 2, offset.Z / 2), { color = PALETTE.white })
	end
end

local function tent(parent: Instance, at: CFrame, color: Color3, size: number)
	local s = size
	Shapes.pillar(parent, 16 * s, 8 * s, at * CFrame.new(0, 4 * s, 0), { color = PALETTE.cream, collide = true })
	for i = 0, 3 do
		local d = (16 - i * 3.6) * s
		Shapes.pillar(parent, d, 2 * s, at * CFrame.new(0, (9 + i * 2) * s, 0), { color = if i % 2 == 0 then color else PALETTE.white })
	end
	Shapes.ball(parent, 1.6 * s, at * CFrame.new(0, 17.4 * s, 0), { color = PALETTE.yellow })
	Shapes.box(parent, Vector3.new(0.2, 4 * s, 3 * s), at * CFrame.new(0, 20 * s, 1.5 * s), { color = color })
end

local function stringLights(parent: Instance, a: Vector3, b: Vector3)
	local colors = { PALETTE.yellow, PALETTE.pink, PALETTE.sky, PALETTE.mint }
	local n = math.floor((b - a).Magnitude / 4)
	for i = 0, n do
		local t = i / n
		local sag = math.sin(t * math.pi) * 3
		Shapes.ball(parent, 0.9, CFrame.new(a:Lerp(b, t) - Vector3.new(0, sag, 0)), { color = colors[i % #colors + 1], material = Enum.Material.Neon })
	end
end

local function ferrisWheel(parent: Instance, spot: LobbyLayout.Spot)
	local base = cf(spot) * CFrame.Angles(0, math.rad(30), 0)
	for _, side in { -1, 1 } do
		Shapes.box(parent, Vector3.new(2, 48, 2), base * CFrame.new(side * 14, 22, -6) * CFrame.Angles(0, 0, math.rad(side * -16)), { color = PALETTE.white, collide = true })
		Shapes.box(parent, Vector3.new(2, 48, 2), base * CFrame.new(side * 14, 22, 6) * CFrame.Angles(0, 0, math.rad(side * -16)), { color = PALETTE.white, collide = true })
	end
	-- The wheel turns on each client (Main.client spins models with a "Spin" attribute).
	local wheel = Instance.new("Model")
	wheel.Name = "FerrisWheel"
	local hubCf = base * CFrame.new(0, 44, 0)
	local hub = Shapes.tube(wheel, 5, 14, hubCf * CFrame.Angles(0, math.rad(90), 0), { color = PALETTE.yellow })
	wheel.PrimaryPart = hub
	local radius = 34
	local cabins = 10
	for i = 0, 35 do
		local a = i / 36 * math.pi * 2
		Shapes.ball(wheel, 1.4, hubCf * CFrame.new(math.cos(a) * radius, math.sin(a) * radius, 0), { color = PALETTE.pink, material = Enum.Material.Neon })
	end
	for i = 0, cabins - 1 do
		local a = i / cabins * math.pi * 2
		local p = Vector3.new(math.cos(a) * radius, math.sin(a) * radius, 0)
		Shapes.box(wheel, Vector3.new(0.8, radius, 0.8), hubCf * CFrame.new(p / 2) * CFrame.Angles(0, 0, a + math.pi / 2), { color = PALETTE.white })
		local colors = { PALETTE.pink, PALETTE.sky, PALETTE.mint, PALETTE.purple, PALETTE.yellow }
		Shapes.ellipsoid(wheel, Vector3.new(6, 5, 5), hubCf * CFrame.new(p - Vector3.new(0, 3, 0)), { color = colors[i % #colors + 1] })
	end
	wheel:SetAttribute("Spin", 0.12)
	wheel.Parent = parent
end

-- Little themed model for each track on the voting pads.
local function miniature(parent: Instance, trackId: string, at: CFrame)
	local def = Tracks.get(trackId)
	local theme = Tracks.Themes[def.theme]
	local function c(t: { number }): Color3
		return Color3.fromRGB(t[1], t[2], t[3])
	end
	local folder = Instance.new("Model")
	folder.Name = `Mini_{trackId}`
	Shapes.disc(folder, 14, 1, at * CFrame.new(0, 0.5, 0), { color = c(theme.ground) })
	-- A loop of road on the base.
	for i = 0, 15 do
		local a = i / 16 * math.pi * 2
		Shapes.box(folder, Vector3.new(2.6, 0.3, 2.4), at * CFrame.new(math.cos(a) * 4.5, 1.1, math.sin(a) * 4.5) * CFrame.Angles(0, -a, 0), { color = c(theme.road) })
	end
	if def.theme == "sunny" then
		Shapes.pillar(folder, 0.8, 4, at * CFrame.new(0, 3, 0), { color = Color3.fromRGB(140, 95, 60) })
		Shapes.ball(folder, 4, at * CFrame.new(0, 5.6, 0), { color = Color3.fromRGB(90, 180, 80) })
	elseif def.theme == "canyon" then
		for i, w in { 6, 4.6, 3.2 } do
			Shapes.pillar(folder, w, 1.4, at * CFrame.new(0, 1.2 + i * 1.4, 0), { color = c(theme.wall):Lerp(Color3.new(1, 1, 1), i * 0.08) })
		end
	elseif def.theme == "neon" then
		for i, h in { 6, 9, 4.5 } do
			local x = (i - 2) * 2
			Shapes.box(folder, Vector3.new(1.6, h, 1.6), at * CFrame.new(x, 1 + h / 2, 0), { color = Color3.fromRGB(30, 26, 50) })
			Shapes.box(folder, Vector3.new(1.7, 0.3, 1.7), at * CFrame.new(x, 1 + h * 0.7, 0), { color = c(theme.accent), material = Enum.Material.Neon })
		end
	elseif def.theme == "toyroom" then
		-- A wobbly tower of toy blocks and a ball.
		local colors = { Color3.fromRGB(240, 80, 80), Color3.fromRGB(80, 150, 240), Color3.fromRGB(255, 210, 60) }
		for i = 0, 2 do
			Shapes.box(folder, Vector3.new(2.6, 2.6, 2.6), at * CFrame.new(0.3 * i, 2.5 + i * 2.6, 0) * CFrame.Angles(0, i * 0.4, 0), { color = colors[i + 1] })
		end
		Shapes.ball(folder, 2.4, at * CFrame.new(3.5, 2.4, 1), { color = Color3.fromRGB(110, 210, 120) })
	elseif def.theme == "kitchen" then
		-- A little fridge with its door swung open.
		Shapes.roundedBox(folder, Vector3.new(4, 8, 3.4), 0.6, at * CFrame.new(0, 5, 0), { color = Color3.fromRGB(240, 245, 250) })
		Shapes.box(folder, Vector3.new(3.4, 7.4, 0.2), at * CFrame.new(0, 5, -1.75), { color = Color3.fromRGB(180, 230, 255), material = Enum.Material.Neon })
		Shapes.box(folder, Vector3.new(0.3, 7.6, 3.4), at * CFrame.new(-3.7, 5, -2.6) * CFrame.Angles(0, math.rad(70), 0), { color = Color3.fromRGB(240, 245, 250) })
		Shapes.ball(folder, 1.2, at * CFrame.new(0.8, 6.5, -1.2), { color = Color3.fromRGB(230, 60, 60) })
	elseif def.theme == "backyard" then
		-- A flowerpot with a ladybug on the rim.
		Shapes.pillar(folder, 4, 3.5, at * CFrame.new(0, 2.8, 0), { color = Color3.fromRGB(210, 110, 70) })
		Shapes.pillar(folder, 0.4, 4, at * CFrame.new(0, 6, 0), { color = Color3.fromRGB(80, 160, 70) })
		Shapes.ball(folder, 2.2, at * CFrame.new(0, 8.3, 0), { color = Color3.fromRGB(255, 120, 170) })
		Shapes.ellipsoid(folder, Vector3.new(1.4, 0.9, 1.8), at * CFrame.new(1.8, 4.8, 0), { color = Color3.fromRGB(230, 40, 40) })
	else
		Shapes.ball(folder, 4, at * CFrame.new(0, 3.5, 0), { color = c(theme.accent) })
	end
	folder.Parent = parent
end

---------------------------------------------------------------------------
-- Build
---------------------------------------------------------------------------
export type Handles = {
	setStatus: (title: string, body: string) -> (),
	setVoteOption: (index: number, info: any?) -> (),
	setPodium: (rows: { any }) -> (),
	setSpectator: (title: string, body: string) -> (),
	setKartDisplay: (slot: number, name: string?, kartId: string?, look: any?) -> (),
	readyPrompt: ProximityPrompt,
	garagePrompt: ProximityPrompt,
	spectatePrompt: ProximityPrompt,
	practicePrompt: ProximityPrompt,
	collectibles: { BasePart },
}

function LobbyBuilder.build(): Handles
	local old = Workspace:FindFirstChild("Lobby")
	if old then
		old:Destroy()
	end
	local lobby = Instance.new("Folder")
	lobby.Name = "Lobby"
	local O = LobbyLayout.Origin
	local spawnSpot = LobbyLayout.Spawn

	-- Ground: soft grass everywhere, a tiled plaza, paths to each area.
	Shapes.box(lobby, Vector3.new(900, 2, 1000), CFrame.new(O.x, -1, O.z + 120), { color = PALETTE.grass, collide = true, name = "Ground" })
	Shapes.disc(lobby, LobbyLayout.PlazaRadius * 2, 0.4, cf(spawnSpot, 0.2), { color = PALETTE.tile, collide = true })
	Shapes.disc(lobby, LobbyLayout.PlazaRadius * 2 - 6, 0.42, cf(spawnSpot, 0.21), { color = PALETTE.cream, collide = true })
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2
		Shapes.disc(lobby, 8, 0.45, cf(spawnSpot, 0.23) * CFrame.new(math.cos(a) * 34, 0, math.sin(a) * 34), { color = PAD_COLORS[i % 3 + 1] })
	end
	local spawn = Instance.new("SpawnLocation")
	spawn.Anchored = true
	spawn.Size = Vector3.new(14, 0.5, 14)
	spawn.CFrame = cf(spawnSpot, 0.5)
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Parent = lobby
	local fountain = Shapes.pillar(lobby, 10, 3, cf(spawnSpot, 1.5) * CFrame.new(0, 0, 18), { color = PALETTE.white, collide = true })
	local _ = fountain
	Shapes.disc(lobby, 8.6, 0.4, cf(spawnSpot, 3.1) * CFrame.new(0, 0, 18), { color = PALETTE.sky, material = Enum.Material.Glass, transparency = 0.2 })
	Shapes.ellipsoid(lobby, Vector3.new(5, 7, 5), cf(spawnSpot, 6) * CFrame.new(0, 0, 18), { color = PALETTE.yellow, reflectance = 0.2 })

	local function path(a: LobbyLayout.Spot, b: LobbyLayout.Spot, width: number)
		local pa, pb = Vector3.new(a.x, 0.15, a.z), Vector3.new(b.x, 0.15, b.z)
		Shapes.box(lobby, Vector3.new(width, 0.3, (pb - pa).Magnitude), CFrame.lookAt((pa + pb) / 2, pb), { color = PALETTE.tile, collide = true })
	end
	path(spawnSpot, LobbyLayout.VotePads[2], 20)
	path(spawnSpot, LobbyLayout.Garage, 16)
	path(spawnSpot, LobbyLayout.ReadyArch, 16)
	path(spawnSpot, LobbyLayout.SpectatorScreen, 14)
	path(spawnSpot, LobbyLayout.Podium, 14)
	path(spawnSpot, { x = spawnSpot.x, y = 0, z = spawnSpot.z + 170 }, 18)

	-- Status board: what's happening and the countdown, readable from spawn.
	local boardCf = facing(LobbyLayout.StatusBoard, spawnSpot, 22)
	for _, side in { -1, 1 } do
		Shapes.pillar(lobby, 3, 24, boardCf * CFrame.new(side * 26, -10, 1.5), { color = PALETTE.white, collide = true })
	end
	local statusTitle, statusBody = sign(lobby, Vector3.new(52, 20, 3), boardCf, PALETTE.pink, "KART CARNIVAL")

	-- Voting pads with miniature track displays and info signs.
	local voteTitles, voteBodies = {}, {}
	for i, pad in LobbyLayout.VotePads do
		Shapes.disc(lobby, LobbyLayout.VotePadSize, 0.6, cf(pad, 0.3), { color = PAD_COLORS[i], collide = true, name = `VotePad{i}` })
		Shapes.disc(lobby, LobbyLayout.VotePadSize - 4, 0.62, cf(pad, 0.31), { color = PALETTE.white, collide = true })
		Shapes.disc(lobby, LobbyLayout.VotePadSize - 8, 0.64, cf(pad, 0.32), { color = PAD_COLORS[i], collide = true })
		local displayCf = cf(pad, 0) * CFrame.new(0, 0, -20)
		Shapes.pillar(lobby, 16, 5, displayCf * CFrame.new(0, 2.5, 0), { color = PALETTE.cream, collide = true })
		local title, body = sign(lobby, Vector3.new(22, 14, 2), facing({ x = pad.x, y = 0, z = pad.z - 30 }, spawnSpot, 16), PAD_COLORS[i], `OPTION {i}`)
		voteTitles[i], voteBodies[i] = title, body
	end
	local miniFolder = Instance.new("Folder")
	miniFolder.Name = "Miniatures"
	miniFolder.Parent = lobby

	-- Ready arch.
	local arch = LobbyLayout.ReadyArch
	local archCf = cf(arch, 0) * CFrame.Angles(0, math.rad(90), 0)
	Shapes.arch(lobby, 22, 3, 4, archCf, { color = PALETTE.yellow, collide = true }, 14)
	Shapes.disc(lobby, 20, 0.5, cf(arch, 0.25), { color = PALETTE.mint, collide = true })
	local readySign = Shapes.box(lobby, Vector3.new(4, 4, 4), cf(arch, 2), { color = PALETTE.mint, transparency = 1, collide = false })
	local readyPrompt = prompt(readySign, "Ready up", "Join the next race")
	local readyTitle, readyBody = sign(lobby, Vector3.new(14, 6, 1.5), cf(arch, 14.5) * CFrame.Angles(0, math.rad(90), 0), PALETTE.mint, "READY UP")
	readyBody.Text = "Walk in or press E"
	local _ = readyTitle

	-- Garage with kart display pedestals.
	local garageSpot = LobbyLayout.Garage
	-- Turned so the door (local front) faces the plaza to the west.
	local garageCf = cf(garageSpot, 0) * CFrame.Angles(0, math.rad(90), 0)
	Shapes.roundedBox(lobby, Vector3.new(60, 26, 40), 6, garageCf * CFrame.new(0, 13, 0), { color = PALETTE.sky, collide = true })
	Shapes.ellipsoid(lobby, Vector3.new(62, 16, 42), garageCf * CFrame.new(0, 26, 0), { color = PALETTE.white })
	Shapes.arch(lobby, 22, 2.4, 2, garageCf * CFrame.new(0, 0, -20.5), { color = PALETTE.yellow }, 12)
	Shapes.box(lobby, Vector3.new(20, 11, 0.6), garageCf * CFrame.new(0, 5.5, -20.2), { color = PALETTE.dark })
	local garageDoor = Shapes.box(lobby, Vector3.new(6, 6, 6), garageCf * CFrame.new(0, 3, -24), { color = PALETTE.dark, transparency = 1 })
	local garagePrompt = prompt(garageDoor, "Customize kart", "Garage")
	local gTitle = sign(lobby, Vector3.new(26, 7, 1.5), garageCf * CFrame.new(0, 31, -20), PALETTE.yellow, "GARAGE")
	local _ = gTitle
	local displays = Instance.new("Folder")
	displays.Name = "KartDisplays"
	displays.Parent = lobby
	for _, spot in LobbyLayout.KartDisplays do
		Shapes.disc(lobby, 12, 1.2, cf(spot, 0.6), { color = PALETTE.white, collide = true })
		Shapes.disc(lobby, 10, 1.25, cf(spot, 0.62), { color = PALETTE.purple, collide = true })
	end

	-- Podium for the last race's top three.
	local podium = LobbyLayout.Podium
	local podiumCf = facing(podium, spawnSpot, 0)
	local stepHeights = { 7, 4.5, 2.5 }
	local stepX = { 0, -11, 11 }
	local stepColors = { PALETTE.gold, Color3.fromRGB(200, 210, 225), Color3.fromRGB(230, 150, 80) }
	for place = 1, 3 do
		local h = stepHeights[place]
		Shapes.roundedBox(lobby, Vector3.new(10, h, 10), 1.5, podiumCf * CFrame.new(stepX[place], h / 2, 0), { color = stepColors[place], collide = true })
	end
	local podiumKarts = Instance.new("Folder")
	podiumKarts.Name = "PodiumKarts"
	podiumKarts.Parent = lobby
	local podiumTitle, podiumBody = sign(lobby, Vector3.new(30, 8, 1.5), podiumCf * CFrame.new(0, 20, 6), PALETTE.gold, "LAST RACE")
	local _ = podiumTitle
	podiumBody.Text = "No races yet"

	-- Spectator screen.
	local screenSpot = LobbyLayout.SpectatorScreen
	local screenCf = facing(screenSpot, spawnSpot, 16)
	for _, side in { -1, 1 } do
		Shapes.pillar(lobby, 2.5, 18, screenCf * CFrame.new(side * 17, -7, 1), { color = PALETTE.dark, collide = true })
	end
	local spectatorTitle, spectatorBody = sign(lobby, Vector3.new(34, 18, 2), screenCf, PALETTE.purple, "LIVE RACE")
	spectatorBody.Text = "No race running"
	local spectateSpot = Shapes.box(lobby, Vector3.new(4, 4, 4), screenCf * CFrame.new(0, -13, -8), { color = PALETTE.dark, transparency = 1 })
	local spectatePrompt = prompt(spectateSpot, "Watch race", "Spectator screen")

	-- Photo spot: a backdrop with a marker to stand on.
	local photo = LobbyLayout.PhotoSpot
	local photoCf = facing(photo, spawnSpot, 0)
	Shapes.arch(lobby, 30, 3, 3, photoCf * CFrame.new(0, 0, 8), { color = PALETTE.pink, collide = true }, 14)
	Shapes.box(lobby, Vector3.new(30, 16, 1), photoCf * CFrame.new(0, 8, 9.5), { color = PALETTE.cream, collide = true })
	local photoTitle, photoBody = sign(lobby, Vector3.new(22, 6, 1), photoCf * CFrame.new(0, 10, 8.5), PALETTE.pink, "KART CARNIVAL")
	local _ = photoTitle
	photoBody.Text = "Say cheese!"
	Shapes.disc(lobby, 8, 0.4, photoCf * CFrame.new(0, 0.2, -4), { color = PALETTE.yellow, collide = true })
	for i = 1, 14 do
		local a = i * 2.39
		local colors = { PALETTE.pink, PALETTE.yellow, PALETTE.sky, PALETTE.mint }
		Shapes.ball(lobby, 1.2, photoCf * CFrame.new(math.cos(a) * 11, 6 + (i % 5) * 2, 9) , { color = colors[i % 4 + 1] })
	end

	-- Decorations.
	ferrisWheel(lobby, LobbyLayout.FerrisWheel)
	local tentColors = { PALETTE.pink, PALETTE.sky, PALETTE.purple, PALETTE.mint }
	for i, offset in { { -150, 10 }, { -165, 130 }, { 175, -100 }, { 60, -170 }, { -60, -175 } } do
		tent(lobby, CFrame.new(O.x + offset[1], 0, O.z + offset[2]), tentColors[i % 4 + 1], 1 + (i % 2) * 0.3)
	end
	for _, offset in { { 36, 30 }, { -36, 30 }, { 36, -30 }, { -36, -30 } } do
		balloonCluster(lobby, CFrame.new(O.x + offset[1], 0, O.z + offset[2]))
		Shapes.pillar(lobby, 1, 16, CFrame.new(O.x + offset[1], 8, O.z + offset[2]), { color = PALETTE.white, collide = true })
	end
	stringLights(lobby, Vector3.new(O.x + 36, 16, O.z + 30), Vector3.new(O.x - 36, 16, O.z + 30))
	stringLights(lobby, Vector3.new(O.x + 36, 16, O.z - 30), Vector3.new(O.x - 36, 16, O.z - 30))
	stringLights(lobby, Vector3.new(O.x + 36, 16, O.z - 30), Vector3.new(O.x + 36, 16, O.z + 30))
	stringLights(lobby, Vector3.new(O.x - 36, 16, O.z - 30), Vector3.new(O.x - 36, 16, O.z + 30))

	-- Practice loop: open track with boost tunnel, jump ramp and drift circle.
	local area = LobbyLayout.PracticeArea
	Shapes.box(lobby, Vector3.new(area.max.x - area.min.x, 0.3, area.max.z - area.min.z), CFrame.new((area.min.x + area.max.x) / 2, 0.1, (area.min.z + area.max.z) / 2), { color = Color3.fromRGB(150, 210, 140), collide = true })
	local _, practice = TrackBuilder.build(LobbyLayout.PracticeTrack.id, { folderName = "PracticeTrack", ground = false, scenery = false })
	local drift = LobbyLayout.DriftCircle
	Shapes.disc(lobby, drift.radius * 2, 0.35, cf(drift.center, 0.12), { color = PALETTE.white, collide = true })
	Shapes.disc(lobby, drift.radius * 2 - 4, 0.37, cf(drift.center, 0.13), { color = Color3.fromRGB(70, 72, 90), collide = true })
	Shapes.disc(lobby, 10, 0.4, cf(drift.center, 0.14), { color = PALETTE.pink, collide = true })
	local dTitle, dBody = sign(lobby, Vector3.new(16, 6, 1), cf(drift.center, 6) * CFrame.new(0, 0, -drift.radius - 4), PALETTE.purple, "DRIFT CIRCLE")
	local _ = dTitle
	dBody.Text = "Hold drift and go round!"
	-- Boost tunnel arches over the boost pads.
	local padDistances = {}
	for _, pad in Track.pads(practice) do
		table.insert(padDistances, pad.distance)
	end
	if #padDistances > 0 then
		local from, to = math.min(table.unpack(padDistances)) - 20, math.max(table.unpack(padDistances)) + 20
		for d = from, to, 8 do
			local p, tan = Track.at(practice, d)
			-- Arches are built across the local x/y plane, so facing along the road spans it.
			local at = CFrame.lookAt(Vector3.new(p.x, p.y, p.z), Vector3.new(p.x + tan.x, p.y, p.z + tan.z))
			local ring = math.floor(d / 8) % 2
			Shapes.arch(lobby, LobbyLayout.PracticeTrack.width + 6, 2, 3, at, { color = if ring == 0 then PALETTE.pink else PALETTE.yellow, collide = false }, 12)
		end
	end
	local practiceStart = Track.spot(practice, practice.length - 30, 0)
	local practiceSign = Shapes.box(lobby, Vector3.new(4, 4, 4), CFrame.new(practiceStart.x, 2, practiceStart.z - 30), { color = PALETTE.dark, transparency = 1 })
	local practicePrompt = prompt(practiceSign, "Drive practice kart", "Practice loop")
	local pTitle, pBody = sign(lobby, Vector3.new(18, 7, 1.5), CFrame.lookAt(Vector3.new(practiceStart.x, 9, practiceStart.z - 32), Vector3.new(spawnSpot.x, 9, spawnSpot.z)), PALETTE.sky, "PRACTICE")
	local _ = pTitle
	pBody.Text = "Press E to drive"

	-- Hidden collectibles: spinning golden tokens.
	local tokens = {}
	local tokenFolder = Instance.new("Folder")
	tokenFolder.Name = "Tokens"
	tokenFolder.Parent = lobby
	for i, spot in LobbyLayout.Collectibles do
		local token = Shapes.tube(tokenFolder, 4, 0.8, cf(spot, 1.5) * CFrame.Angles(0, 0, 0), { color = PALETTE.gold, material = Enum.Material.Neon, name = `Token{i}` })
		token:SetAttribute("Spin", 2)
		token:SetAttribute("TokenId", i)
		table.insert(tokens, token)
	end

	lobby.Parent = Workspace

	-- Handles -------------------------------------------------------------
	local function setKartDisplay(slot: number, name: string?, kartId: string?, look: any?)
		local existing = displays:FindFirstChild(`Slot{slot}`)
		if existing then
			existing:Destroy()
		end
		local spot = LobbyLayout.KartDisplays[slot]
		if not spot or not name then
			return
		end
		local at = CFrame.new(spot.x, 1.3, spot.z) * CFrame.Angles(0, math.rad(90), 0) -- face the plaza
		local kart = KartRig.build(kartId or Karts.Default, name, at, displays, look)
		kart.Name = `Slot{slot}`
		kart.PrimaryPart.Anchored = true
		local tag = kart:FindFirstChild("NameTag")
		local label = tag and tag:FindFirstChildOfClass("TextLabel")
		if label then
			label.Text = name
		end
	end

	local function setPodium(rows: { any })
		podiumKarts:ClearAllChildren()
		local lines = {}
		for place = 1, math.min(3, #rows) do
			local row = rows[place]
			local h = stepHeights[place]
			local at = podiumCf * CFrame.new(stepX[place], h + 0.1, 0)
			local kart = KartRig.build(row.kartId or Karts.Default, row.name, at, podiumKarts, row.look)
			kart.PrimaryPart.Anchored = true
			table.insert(lines, `{place}. {row.name}`)
		end
		podiumBody.Text = if #lines > 0 then table.concat(lines, "   ") else "No races yet"
	end

	local function setVoteOption(index: number, info: any?)
		local title, body = voteTitles[index], voteBodies[index]
		local mini = miniFolder:FindFirstChild(`Pad{index}`)
		if mini then
			mini:Destroy()
		end
		if not info then
			title.Text = `OPTION {index}`
			body.Text = "Voting opens when someone is ready"
			return
		end
		title.Text = `{info.icon or ""} {info.name}`
		body.Text = `{info.difficulty}\n{info.feature}\n{info.votes} vote{if info.votes == 1 then "" else "s"}`
		local holder = Instance.new("Folder")
		holder.Name = `Pad{index}`
		holder.Parent = miniFolder
		local pad = LobbyLayout.VotePads[index]
		miniature(holder, info.id, cf(pad, 5) * CFrame.new(0, 0, -20))
	end

	for i = 1, #LobbyLayout.VotePads do
		setVoteOption(i, nil)
	end

	return {
		setStatus = function(title: string, body: string)
			statusTitle.Text = title
			statusBody.Text = body
		end,
		setVoteOption = setVoteOption,
		setPodium = setPodium,
		setSpectator = function(title: string, body: string)
			spectatorTitle.Text = title
			spectatorBody.Text = body
		end,
		setKartDisplay = setKartDisplay,
		readyPrompt = readyPrompt,
		garagePrompt = garagePrompt,
		spectatePrompt = spectatePrompt,
		practicePrompt = practicePrompt,
		collectibles = tokens,
	}
end

return LobbyBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="24">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Server entry point.

local RaceService = require(script.Parent.RaceService)
local RoundService = require(script.Parent.RoundService)

RaceService.start()
RoundService.start()

print("[KartRacer] server ready - walk under the READY arch (or press READY) to race")
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[-- Creates the RemoteEvents listed in Shared.RemoteNames under ReplicatedStorage.Remotes.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RemoteNames = require(ReplicatedStorage.Shared.RemoteNames)

local folder = Instance.new("Folder")
folder.Name = "Remotes"

local Net: { [string]: RemoteEvent } = {}
for name in RemoteNames do
	local remote = Instance.new("RemoteEvent")
	remote.Name = name
	remote.Parent = folder
	Net[name] = remote
end

folder.Parent = ReplicatedStorage

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">PracticeService</string>
          <string name="Source"><![CDATA[-- Practice karts on the lobby loop. Anyone not in a race can take one out to
-- try drifting, the jump ramp and the boost tunnel. Practice karts are
-- client-driven like race karts but nothing is scored.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local LobbyLayout = require(Shared.LobbyLayout)
local Track = require(Shared.Track)
local KartRig = require(ReplicatedStorage.Common.KartRig)

local Net = require(script.Parent.Net)

local PracticeService = {}

local folder = Instance.new("Folder")
folder.Name = "PracticeKarts"
folder.Parent = Workspace

local practiceTrack = Track.build(LobbyLayout.PracticeTrack)
local karts: { [Player]: Model } = {}
local nextSlot = 0

function PracticeService.stop(player: Player)
	local kart = karts[player]
	karts[player] = nil
	if kart then
		local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid.Sit = false
		end
		kart:Destroy()
	end
end

function PracticeService.isPracticing(player: Player): boolean
	return karts[player] ~= nil
end

function PracticeService.start(player: Player, kartId: string, look: any)
	PracticeService.stop(player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	nextSlot = nextSlot % 8 + 1
	local pos, d = Track.gridSpot(practiceTrack, nextSlot)
	local _, tan = Track.at(practiceTrack, d)
	local yaw = math.atan2(-tan.x, -tan.z)
	local kart = KartRig.build(kartId, player.DisplayName, CFrame.new(pos.x, pos.y, pos.z) * CFrame.Angles(0, yaw, 0), folder, look)
	karts[player] = kart

	local seat = kart:FindFirstChild("DriverSeat") :: Seat
	humanoid.Sit = false
	character:PivotTo(seat.CFrame + Vector3.new(0, 2, 0))
	seat:Sit(humanoid)
	if kart.PrimaryPart and kart.PrimaryPart:CanSetNetworkOwnership() then
		kart.PrimaryPart:SetNetworkOwner(player)
	end
	-- Getting out of the seat ends practice.
	seat:GetPropertyChangedSignal("Occupant"):Connect(function()
		if seat.Occupant == nil then
			task.delay(0.5, function()
				if karts[player] == kart and seat.Occupant == nil then
					PracticeService.stop(player)
				end
			end)
		end
	end)
	Net.PracticeStart:FireClient(player, {
		trackId = LobbyLayout.PracticeTrack.id,
		theme = LobbyLayout.PracticeTrack.theme,
		kart = kart,
		kartId = kartId,
		yaw = yaw,
	})
end

function PracticeService.init()
	Net.LeavePractice.OnServerEvent:Connect(PracticeService.stop)
	Players.PlayerRemoving:Connect(PracticeService.stop)
end

return PracticeService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">Props</string>
          <string name="Source"><![CDATA[-- Scenery models built from parts. Scenery.luau decides where they go; this
-- decides what they look like. Each builder gets the prop, the track theme
-- and a parent, and makes anchored, non-colliding decoration (grandstands
-- and towers collide so nobody drives through them).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shapes = require(ReplicatedStorage.Common.Shapes)

local Props = {}

local function rgb(c: { number }): Color3
	return Color3.fromRGB(c[1], c[2], c[3])
end

local function part(parent: Instance, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material, shape: Enum.PartType?): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if shape then
		p.Shape = shape
	end
	p.Parent = parent
	return p
end

-- Varies a colour a little so rows of props don't look copy-pasted.
local function vary(c: Color3, amount: number, seed: number): Color3
	local h, s, v = c:ToHSV()
	local k = (math.sin(seed * 12.9898) * 43758.5453) % 1
	return Color3.fromHSV(h, s, math.clamp(v + (k - 0.5) * amount, 0, 1))
end

local builders: { [string]: (any, any, Instance) -> () } = {}

builders.tree = function(prop, _theme, parent)
	local s = prop.size
	local base = CFrame.new(prop.x, prop.y, prop.z) * CFrame.Angles(0, prop.yaw, 0)
	part(parent, Vector3.new(2, 14 * s, 2) , base * CFrame.new(0, 7 * s, 0), Color3.fromRGB(110, 75, 45), Enum.Material.SmoothPlastic)
	local leaf = vary(Color3.fromRGB(70, 150, 60), 0.25, prop.x + prop.z)
	part(parent, Vector3.one * 12 * s, base * CFrame.new(0, 16 * s, 0), leaf, Enum.Material.SmoothPlastic, Enum.PartType.Ball)
	part(parent, Vector3.one * 8 * s, base * CFrame.new(3 * s, 13 * s, 1 * s), leaf, Enum.Material.SmoothPlastic, Enum.PartType.Ball)
end

builders.bush = function(prop, _theme, parent)
	local s = prop.size
	part(parent, Vector3.new(7, 5, 7) * s, CFrame.new(prop.x, prop.y + 1.5 * s, prop.z), vary(Color3.fromRGB(80, 160, 70), 0.2, prop.z), Enum.Material.SmoothPlastic, Enum.PartType.Ball)
end

builders.flag = function(prop, theme, parent)
	local base = CFrame.new(prop.x, prop.y, prop.z) * CFrame.Angles(0, prop.yaw, 0)
	part(parent, Vector3.new(0.4, 12, 0.4), base * CFrame.new(0, 6, 0), Color3.fromRGB(230, 230, 235), Enum.Material.SmoothPlastic)
	local colors = { rgb(theme.accent), rgb(theme.curb[1]), rgb(theme.curb[2]) }
	part(parent, Vector3.new(0.1, 3, 5), base * CFrame.new(0, 10.5, 2.5), colors[(math.floor(prop.x) % 3) + 1], Enum.Material.SmoothPlastic)
end

builders.billboard = function(prop, theme, parent)
	local base = CFrame.new(prop.x, prop.y, prop.z) * CFrame.Angles(0, prop.yaw, 0)
	for _, side in { -9, 9 } do
		part(parent, Vector3.new(1, 14, 1), base * CFrame.new(side, 7, 0), Color3.fromRGB(80, 80, 90), Enum.Material.SmoothPlastic)
	end
	local board = part(parent, Vector3.new(24, 9, 0.6), base * CFrame.new(0, 16, 0), Color3.fromRGB(20, 20, 30), Enum.Material.SmoothPlastic)
	local glow = theme.clock < 6 or theme.clock > 19
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 20
	gui.LightInfluence = if glow then 0 else 1
	gui.Parent = board
	local slogans = { "GO FAST", "TURBO!", "DRIFT KING", "KART RACER", "FULL SPEED", "NO BRAKES" }
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundColor3 = rgb(theme.accent)
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(20, 20, 30)
	label.Text = slogans[(math.floor(prop.x + prop.z) % #slogans) + 1]
	label.Parent = gui
	-- Same text on the back.
	local back = gui:Clone()
	back.Face = Enum.NormalId.Back
	back.Parent = board
end

builders.grandstand = function(prop, theme, parent)
	local base = CFrame.new(prop.x, prop.y, prop.z) * CFrame.Angles(0, prop.yaw, 0)
	local steps = 5
	for i = 0, steps - 1 do
		local step = part(parent, Vector3.new(60, 2.5, 5), base * CFrame.new(0, 1.25 + i * 2.5, i * 4.5), Color3.fromRGB(150, 150, 160), Enum.Material.SmoothPlastic)
		step.CanCollide = true
		-- Crowd: little coloured blocks.
		for c = -27, 27, 3 do
			local seed = c * 7 + i * 13 + prop.x
			local h = (math.sin(seed) * 43758.5453) % 1
			part(parent, Vector3.new(1.4, 2, 1.2), base * CFrame.new(c, 3.5 + i * 2.5, i * 4.5 - 0.5), Color3.fromHSV(h, 0.6, 0.9), Enum.Material.SmoothPlastic)
		end
	end
	local roof = part(parent, Vector3.new(64, 1, 26), base * CFrame.new(0, 20, 9) * CFrame.Angles(math.rad(-8), 0, 0), rgb(theme.accent), Enum.Material.SmoothPlastic)
	roof.CanCollide = true
	for _, x in { -30, 30 } do
		part(parent, Vector3.new(1.2, 20, 1.2), base * CFrame.new(x, 10, 20), Color3.fromRGB(90, 90, 100), Enum.Material.SmoothPlastic)
	end
end

builders.rock = function(prop, theme, parent)
	local s = prop.size
	local color = vary(rgb(theme.wall), 0.2, prop.x)
	local base = CFrame.new(prop.x, prop.y, prop.z) * CFrame.Angles(0, prop.yaw, 0)
	part(parent, Vector3.new(10, 7, 8) * s, base * CFrame.new(0, 2.5 * s, 0) * CFrame.Angles(0.2, 0, 0.15), color, Enum.Material.SmoothPlastic)
	part(parent, Vector3.new(6, 5, 6) * s, base * CFrame.new(3 * s, 4.5 * s, 1 * s) * CFrame.Angles(-0.3, 0.6, 0.2), color, Enum.Material.SmoothPlastic)
end

builders.mesa = function(prop, theme, parent)
	local s = prop.size
	local base = CFrame.new(prop.x, prop.y, prop.z) * CFrame.Angles(0, prop.yaw, 0)
	local layers = { { 70, 18, 60 }, { 58, 16, 50 }, { 46, 14, 40 } }
	local y = 0
	for i, l in layers do
		local color = vary(rgb(theme.wall), 0.25, i + prop.x)
		local p = part(parent, Vector3.new(l[1], l[2], l[3]) * s, base * CFrame.new(0, (y + l[2] / 2) * s, 0), color, Enum.Material.SmoothPlastic)
		p.CanCollide = true
		y += l[2]
	end
end

builders.cactus = function(prop, _theme, parent)
	local s = prop.size
	local base = CFrame.new(prop.x, prop.y, prop.z) * CFrame.Angles(0, prop.yaw, 0)
	local green = Color3.fromRGB(70, 130, 70)
	part(parent, Vector3.new(2, 12, 2) * s, base * CFrame.new(0, 6 * s, 0), green, Enum.Material.SmoothPlastic)
	part(parent, Vector3.new(3, 1.4, 1.4) * s, base * CFrame.new(1.8 * s, 6 * s, 0), green, Enum.Material.SmoothPlastic)
	part(parent, Vector3.new(1.4, 4, 1.4) * s, base * CFrame.new(2.8 * s, 8 * s, 0), green, Enum.Material.SmoothPlastic)
end

builders.tower = function(prop, theme, parent)
	local s = prop.size
	local base = CFrame.new(prop.x, prop.y, prop.z) * CFrame.Angles(0, prop.yaw, 0)
	local h = 60 * s + (math.floor(prop.x * 7) % 5) * 20
	local w = 30 * math.min(s, 1.4)
	local tower = part(parent, Vector3.new(w, h, w), base * CFrame.new(0, h / 2, 0), Color3.fromRGB(22, 20, 36), Enum.Material.Glass)
	tower.CanCollide = true
	local colors = { rgb(theme.accent), rgb(theme.wall), Color3.fromRGB(255, 200, 60) }
	local color = colors[(math.floor(prop.z) % #colors) + 1]
	-- Glowing window bands.
	for y = 12, h - 6, 14 do
		part(parent, Vector3.new(w + 0.4, 1.2, w + 0.4), base * CFrame.new(0, y, 0), color, Enum.Material.Neon)
	end
	part(parent, Vector3.new(1, 10, 1), base * CFrame.new(0, h + 5, 0), Color3.fromRGB(255, 60, 60), Enum.Material.Neon)
end

builders.lamp = function(prop, theme, parent)
	local base = CFrame.new(prop.x, prop.y, prop.z) * CFrame.Angles(0, prop.yaw, 0)
	part(parent, Vector3.new(0.8, 16, 0.8), base * CFrame.new(0, 8, 0), Color3.fromRGB(60, 60, 80), Enum.Material.SmoothPlastic)
	local head = part(parent, Vector3.new(1.2, 1.2, 6), base * CFrame.new(0, 16, 2.5), rgb(theme.wall), Enum.Material.Neon)
	local light = Instance.new("PointLight")
	light.Color = rgb(theme.wall)
	light.Range = 30
	light.Brightness = 2
	light.Parent = head
end

---------------------------------------------------------------------------
-- Oversized-world props (toy room, kitchen, backyard)
---------------------------------------------------------------------------
local function base(prop: any): CFrame
	return CFrame.new(prop.x, prop.y, prop.z) * CFrame.Angles(0, prop.yaw, 0)
end

local function pick(list: { Color3 }, prop: any): Color3
	return list[(math.floor(math.abs(prop.x * 3 + prop.z * 7)) % #list) + 1]
end

local TOY_COLORS = { Color3.fromRGB(240, 80, 80), Color3.fromRGB(80, 150, 240), Color3.fromRGB(255, 210, 60), Color3.fromRGB(110, 210, 120), Color3.fromRGB(190, 110, 230) }

builders.toyBlock = function(prop, _theme, parent)
	local s = prop.size * 14
	local color = pick(TOY_COLORS, prop)
	local parts = Shapes.roundedBox(parent, Vector3.new(s, s, s), s * 0.12, base(prop) * CFrame.new(0, s / 2, 0), { color = color, collide = true })
	local _ = parts
	-- A raised letter panel on the front.
	local panel = Shapes.box(parent, Vector3.new(s * 0.7, s * 0.7, 0.4), base(prop) * CFrame.new(0, s / 2, -s / 2 - 0.2), { color = Color3.fromRGB(255, 255, 255) })
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 10
	gui.Parent = panel
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = color
	local letters = { "A", "B", "C", "K", "Z", "1", "2", "3" }
	label.Text = letters[(math.floor(math.abs(prop.x + prop.z)) % #letters) + 1]
	label.Parent = gui
end

builders.toyBall = function(prop, _theme, parent)
	local d = prop.size * 20
	local cf = base(prop) * CFrame.new(0, d / 2, 0)
	Shapes.ball(parent, d, cf, { color = pick(TOY_COLORS, prop), collide = true })
	Shapes.tube(parent, d * 1.01, d * 0.18, cf * CFrame.Angles(0, 0, math.rad(90)), { color = Color3.fromRGB(255, 255, 255) })
end

builders.crayon = function(prop, _theme, parent)
	local s = prop.size
	local color = pick(TOY_COLORS, prop)
	local cf = base(prop) * CFrame.new(0, 2.5 * s, 0)
	Shapes.tube(parent, 5 * s, 28 * s, cf, { color = color })
	Shapes.tube(parent, 5.3 * s, 6 * s, cf * CFrame.new(4 * s, 0, 0), { color = Color3.fromRGB(255, 255, 255) })
	Shapes.ellipsoid(parent, Vector3.new(7 * s, 4 * s, 4 * s), cf * CFrame.new(15 * s, 0, 0), { color = color })
end

builders.book = function(prop, _theme, parent)
	local s = prop.size
	local color = pick(TOY_COLORS, prop)
	Shapes.roundedBox(parent, Vector3.new(50 * s, 7 * s, 36 * s), 2 * s, base(prop) * CFrame.new(0, 3.5 * s, 0), { color = color, collide = true })
	Shapes.box(parent, Vector3.new(48 * s, 5.6 * s, 35 * s), base(prop) * CFrame.new(1 * s, 3.5 * s, 0), { color = Color3.fromRGB(250, 245, 230) })
end

local FRUIT = { Color3.fromRGB(230, 50, 50), Color3.fromRGB(255, 160, 40), Color3.fromRGB(250, 220, 60), Color3.fromRGB(120, 200, 60), Color3.fromRGB(150, 60, 160) }

builders.fruit = function(prop, _theme, parent)
	local d = prop.size * 16
	local cf = base(prop) * CFrame.new(0, d / 2, 0)
	Shapes.ellipsoid(parent, Vector3.new(d, d * 0.92, d), cf, { color = pick(FRUIT, prop), collide = true, reflectance = 0.08 })
	Shapes.pillar(parent, 0.8 * prop.size, 3 * prop.size, cf * CFrame.new(0, d * 0.5, 0), { color = Color3.fromRGB(110, 75, 45) })
	Shapes.ellipsoid(parent, Vector3.new(4, 1, 2.2) * prop.size, cf * CFrame.new(1.8 * prop.size, d * 0.5, 0), { color = Color3.fromRGB(90, 180, 70) })
end

builders.jar = function(prop, _theme, parent)
	local s = prop.size
	local cf = base(prop)
	Shapes.pillar(parent, 20 * s, 26 * s, cf * CFrame.new(0, 13 * s, 0), { color = Color3.fromRGB(200, 230, 255), material = Enum.Material.Glass, transparency = 0.4, collide = true })
	Shapes.pillar(parent, 18 * s, 18 * s, cf * CFrame.new(0, 10 * s, 0), { color = pick(FRUIT, prop) })
	Shapes.pillar(parent, 21 * s, 4 * s, cf * CFrame.new(0, 27.5 * s, 0), { color = Color3.fromRGB(220, 60, 60) })
end

builders.cookie = function(prop, _theme, parent)
	local s = prop.size
	local cf = base(prop) * CFrame.new(0, 1.2 * s, 0)
	Shapes.disc(parent, 16 * s, 2.4 * s, cf, { color = Color3.fromRGB(215, 160, 95) })
	for i = 1, 5 do
		local a = i * 1.3
		Shapes.ball(parent, 2.2 * s, cf * CFrame.new(math.cos(a) * 4.5 * s, 1.3 * s, math.sin(a) * 4.5 * s), { color = Color3.fromRGB(90, 55, 35) })
	end
end

builders.shaker = function(prop, _theme, parent)
	local s = prop.size
	local cf = base(prop)
	Shapes.pillar(parent, 8 * s, 18 * s, cf * CFrame.new(0, 9 * s, 0), { color = Color3.fromRGB(245, 245, 250), material = Enum.Material.Glass, transparency = 0.2, collide = true })
	Shapes.ellipsoid(parent, Vector3.new(8.4, 5, 8.4) * s, cf * CFrame.new(0, 18 * s, 0), { color = Color3.fromRGB(200, 205, 215), reflectance = 0.3 })
end

builders.grassBlade = function(prop, _theme, parent)
	local s = prop.size
	local green = Color3.fromRGB(80 + math.floor(prop.x) % 40, 170 + math.floor(prop.z) % 40, 60)
	local cf = base(prop)
	for k = 0, 2 do
		local lean = CFrame.Angles(math.rad(8 + k * 6), math.rad(k * 120), 0)
		Shapes.ellipsoid(parent, Vector3.new(2.4 * s, 30 * s, 1 * s), cf * lean * CFrame.new(0, 14 * s, 0), { color = green })
	end
end

builders.flower = function(prop, _theme, parent)
	local s = prop.size
	local cf = base(prop)
	Shapes.pillar(parent, 1.4 * s, 26 * s, cf * CFrame.new(0, 13 * s, 0), { color = Color3.fromRGB(80, 160, 70) })
	local petal = pick({ Color3.fromRGB(255, 120, 170), Color3.fromRGB(255, 255, 255), Color3.fromRGB(255, 200, 60), Color3.fromRGB(170, 120, 255) }, prop)
	for i = 0, 5 do
		local a = i / 6 * math.pi * 2
		Shapes.ellipsoid(parent, Vector3.new(7, 2, 4) * s, cf * CFrame.new(math.cos(a) * 4 * s, 27 * s, math.sin(a) * 4 * s) * CFrame.Angles(0, -a, 0), { color = petal })
	end
	Shapes.ball(parent, 4 * s, cf * CFrame.new(0, 27.5 * s, 0), { color = Color3.fromRGB(255, 210, 60) })
	Shapes.ellipsoid(parent, Vector3.new(7, 1, 3) * s, cf * CFrame.new(2.5 * s, 9 * s, 0) * CFrame.Angles(0, 0, 0.5), { color = Color3.fromRGB(90, 170, 70) })
end

builders.pebble = function(prop, _theme, parent)
	local s = prop.size
	local grey = 150 + math.floor(math.abs(prop.x)) % 50
	Shapes.ellipsoid(parent, Vector3.new(14, 7, 10) * s, base(prop) * CFrame.new(0, 2.5 * s, 0), { color = Color3.fromRGB(grey, grey - 5, grey - 15), collide = true })
end

builders.mushroom = function(prop, _theme, parent)
	local s = prop.size
	local cf = base(prop)
	Shapes.pillar(parent, 5 * s, 10 * s, cf * CFrame.new(0, 5 * s, 0), { color = Color3.fromRGB(245, 235, 215) })
	Shapes.ellipsoid(parent, Vector3.new(16, 9, 16) * s, cf * CFrame.new(0, 11 * s, 0), { color = Color3.fromRGB(230, 60, 60) })
	for i = 1, 5 do
		local a = i * 1.25
		Shapes.ball(parent, 2.4 * s, cf * CFrame.new(math.cos(a) * 4.5 * s, 14.2 * s, math.sin(a) * 4.5 * s), { color = Color3.fromRGB(255, 255, 255) })
	end
end

builders.clover = function(prop, _theme, parent)
	local s = prop.size
	local cf = base(prop)
	Shapes.pillar(parent, 0.8 * s, 6 * s, cf * CFrame.new(0, 3 * s, 0), { color = Color3.fromRGB(80, 160, 70) })
	for i = 0, 2 do
		local a = i / 3 * math.pi * 2
		Shapes.ellipsoid(parent, Vector3.new(5, 0.8, 5) * s, cf * CFrame.new(math.cos(a) * 2.4 * s, 6 * s, math.sin(a) * 2.4 * s), { color = Color3.fromRGB(90, 190, 80) })
	end
end

function Props.build(prop: any, theme: any, parent: Instance)
	local builder = builders[prop.kind]
	if builder then
		builder(prop, theme, parent)
	end
end

Props.Kinds = builders

return Props
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="28">
        <Properties>
          <string name="Name">RaceService</string>
          <string name="Source"><![CDATA[-- Runs one race: builds the track, puts karts on the grid, counts down,
-- tracks positions and laps, respawns fallen karts, drives the CPU karts,
-- runs items, and reports results. RoundService decides when races happen
-- and who is in them.
--
-- Players drive their own karts on their client. The server checks progress
-- (ordered sectors, so skipping the course never counts) and decides
-- placings, item hits and the finish.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local AIDriver = require(Shared.AIDriver)
local KartBodies = require(Shared.KartBodies)
local KartPhysics = require(Shared.KartPhysics)
local Karts = require(Shared.Karts)
local RaceRules = require(Shared.RaceRules)
local Track = require(Shared.Track)
local KartRig = require(ReplicatedStorage.Common.KartRig)
local Shapes = require(ReplicatedStorage.Common.Shapes)

local ItemService = require(script.Parent.ItemService)
local Net = require(script.Parent.Net)
local TrackBuilder = require(script.Parent.TrackBuilder)

local RaceService = {}

local LOAD_TIME = 3 -- time for clients to see the track before the countdown
local END_GRACE = 4 -- after the last player finishes
local FINISH_TIMEOUT = 30 -- once any player finishes, the rest get this long
local FALL_DEPTH = 18
local TICK = 1 / 20
local RESPAWN_COOLDOWN = 2

export type Entrant = {
	id: string,
	name: string,
	isCpu: boolean,
	player: Player?,
	kartId: string,
	look: KartBodies.Look,
	profile: AIDriver.Profile,
}

export type Racer = {
	entrant: Entrant,
	model: Model,
	state: KartPhysics.State?, -- CPU karts (and players who finished); players simulate their own
	stats: Karts.KartStats,
	progress: Track.Progress,
	score: number,
	place: number,
	finishTime: number?,
	invincibleUntil: number,
	protectUntil: number, -- brief immunity after any hit, so nobody gets juggled
	shieldUntil: number, -- Bubble Shield: blocks the next attack
	speedFactor: number,
	lastRespawn: number,
	-- Stats for results and awards
	worstPlace: number,
	hitsTaken: number,
	shortcutsTaken: number,
	onShortcut: boolean,
	-- Items (managed by ItemService)
	item: string?,
	uses: number,
	itemReadyAt: number,
	cpuUseAt: number,
}

export type ResultRow = {
	place: number,
	id: string,
	name: string,
	isCpu: boolean,
	userId: number?,
	time: number?,
	finished: boolean,
	kartId: string,
	look: KartBodies.Look,
	worstPlace: number,
	hitsTaken: number,
	shortcutsTaken: number,
}

type Race = {
	trackId: string,
	track: Track.Built,
	racers: { Racer },
	goTime: number,
	endAt: number?,
	timeLimit: number,
	lastBroadcast: number,
	onEnded: (({ ResultRow }, string) -> ())?,
	ended: boolean,
}

local race: Race? = nil

local kartsFolder = Instance.new("Folder")
kartsFolder.Name = "Karts"
kartsFolder.Parent = Workspace

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function now(): number
	return Workspace:GetServerTimeNow()
end

local function vec(p: Vector3): Track.Vec
	return Track.v(p.X, p.Y, p.Z)
end

local function refreshRayFilter()
	local ignore: { Instance } = { kartsFolder }
	for _, name in { "Items", "PracticeKarts" } do
		local f = Workspace:FindFirstChild(name)
		if f then
			table.insert(ignore, f)
		end
	end
	for _, p in Players:GetPlayers() do
		if p.Character then
			table.insert(ignore, p.Character)
		end
	end
	rayParams.FilterDescendantsInstances = ignore
end

---------------------------------------------------------------------------
-- Effects (also used by ItemService)
---------------------------------------------------------------------------
local Effects = {}
RaceService.Effects = Effects

local HIT_PROTECTION = 2.5

local function removeBubble(racer: Racer)
	local bubble = racer.model:FindFirstChild("ShieldBubble")
	if bubble then
		bubble:Destroy()
	end
end

-- Bubble Shield: a see-through bubble around the kart that blocks one attack.
function Effects.shield(racer: Racer, seconds: number)
	local root = racer.model.PrimaryPart
	if not root then
		return
	end
	racer.shieldUntil = now() + seconds
	removeBubble(racer)
	local bubble = Shapes.ball(racer.model, 10, root.CFrame, {
		color = Color3.fromRGB(170, 220, 255),
		material = Enum.Material.Glass,
		transparency = 0.55,
		reflectance = 0.2,
		anchored = false,
		name = "ShieldBubble",
	})
	bubble.Massless = true
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = bubble
	weld.Parent = bubble
	task.delay(seconds, function()
		if now() >= racer.shieldUntil then
			removeBubble(racer)
		end
	end)
	Effects.warn(racer, "🫧 Shield up!")
end

-- Returns true if the hit landed. A Bubble Shield, Overdrive and the
-- post-hit grace period all block it.
function Effects.hit(racer: Racer, kind: string?): boolean
	local t = now()
	if t < racer.invincibleUntil or t < racer.protectUntil then
		return false
	end
	if t < racer.shieldUntil then
		racer.shieldUntil = 0
		racer.protectUntil = t + 0.8
		removeBubble(racer)
		local root = racer.model.PrimaryPart
		if root then
			ItemService.explode(root.Position + Vector3.new(0, 3, 0), "BLOCKED!", Color3.fromRGB(170, 220, 255))
		end
		Effects.warn(racer, "🫧 Shield blocked it!")
		return false
	end
	racer.protectUntil = t + HIT_PROTECTION
	racer.hitsTaken += 1
	local hitKind = kind or "spin"
	if racer.state then
		if hitKind == "slow" then
			KartPhysics.slow(racer.state, 2)
		else
			KartPhysics.hit(racer.state)
		end
		if hitKind == "launch" and racer.model.PrimaryPart then
			local root = racer.model.PrimaryPart
			root.AssemblyLinearVelocity += Vector3.new(0, 70, 0)
		end
	elseif racer.entrant.player then
		Net.KartEvent:FireClient(racer.entrant.player, hitKind)
	end
	return true
end

function Effects.boost(racer: Racer, seconds: number)
	if racer.state then
		KartPhysics.giveBoost(racer.state, seconds)
	elseif racer.entrant.player then
		Net.KartEvent:FireClient(racer.entrant.player, "boost", seconds)
	end
end

function Effects.overdrive(racer: Racer, seconds: number)
	racer.invincibleUntil = now() + seconds
	if racer.state then
		KartPhysics.overdrive(racer.state, seconds)
	elseif racer.entrant.player then
		Net.KartEvent:FireClient(racer.entrant.player, "overdrive", seconds)
	end
end

function Effects.warn(racer: Racer, text: string)
	if racer.entrant.player then
		Net.KartEvent:FireClient(racer.entrant.player, "warning", text)
	end
end

function Effects.itemChanged(racer: Racer)
	if racer.entrant.player then
		Net.ItemState:FireClient(racer.entrant.player, racer.item, racer.uses, racer.itemReadyAt)
	end
end

---------------------------------------------------------------------------
-- Helpers
---------------------------------------------------------------------------
local function yawFromTangent(tan: Track.Vec): number
	return math.atan2(-tan.x, -tan.z)
end

local function scaledStats(base: Karts.KartStats, factor: number): Karts.KartStats
	return { topSpeed = base.topSpeed * factor, accel = base.accel, handling = base.handling, weight = base.weight }
end

local function seatDriver(player: Player, model: Model)
	local character = player.Character
	if not character or not character.Parent then
		player:LoadCharacter()
		character = player.Character or player.CharacterAdded:Wait()
	end
	local humanoid = character:WaitForChild("Humanoid", 5) :: Humanoid?
	local seat = model:FindFirstChild("DriverSeat") :: Seat
	if humanoid and seat then
		humanoid.Sit = false
		character:PivotTo(seat.CFrame + Vector3.new(0, 2, 0))
		seat:Sit(humanoid)
	end
end

local function respawn(r: Race, racer: Racer)
	racer.lastRespawn = now()
	local d = racer.progress.distance
	local pos = Track.spot(r.track, d, 0)
	local _, tan = Track.at(r.track, d)
	local yaw = yawFromTangent(tan)
	KartRig.place(racer.model, CFrame.new(pos.x, pos.y, pos.z) * CFrame.Angles(0, yaw, 0))
	if racer.state then
		racer.state.speed = 0
		racer.state.yaw = yaw
		racer.state.drift = 0
		racer.state.charge = 0
	end
	if racer.entrant.player then
		Net.KartEvent:FireClient(racer.entrant.player, "respawn", yaw)
	end
	-- A moment of protection so nothing hits you while getting going again.
	racer.protectUntil = math.max(racer.protectUntil, now() + 2)
end

local function standings(r: Race): { Racer }
	local entries = {}
	local byId = {}
	for _, racer in r.racers do
		table.insert(entries, { id = racer.entrant.id, finished = racer.finishTime ~= nil, finishTime = racer.finishTime, score = racer.score })
		byId[racer.entrant.id] = racer
	end
	local ranked = RaceRules.rank(entries)
	local out = {}
	for place, e in ranked do
		local racer = byId[e.id]
		racer.place = place
		table.insert(out, racer)
	end
	return out
end

local function rowsOf(ranked: { Racer })
	local rows = {}
	for _, racer in ranked do
		table.insert(rows, {
			name = racer.entrant.name,
			isCpu = racer.entrant.isCpu,
			finished = racer.finishTime ~= nil,
			kart = racer.model.Name,
		})
	end
	return rows
end

local function raceStateFor(r: Race, ranked: { Racer }, me: Racer)
	return {
		place = me.place,
		field = #ranked,
		lap = math.clamp(me.progress.lap, 1, r.track.def.laps),
		laps = r.track.def.laps,
		finishTime = me.finishTime,
		rows = rowsOf(ranked),
		endAt = r.endAt,
	}
end

-- A player who has finished keeps cruising under CPU control while they spectate.
local function autopilot(racer: Racer)
	local root = racer.model.PrimaryPart
	if racer.state or not root then
		return
	end
	local look = root.CFrame.LookVector
	local s = KartPhysics.newState(math.atan2(-look.X, -look.Z))
	s.speed = math.max(0, root.AssemblyLinearVelocity:Dot(Vector3.new(look.X, 0, look.Z)))
	racer.state = s
	if root:CanSetNetworkOwnership() then
		root:SetNetworkOwner(nil)
	end
end

local function finishRace(r: Race)
	if r.ended then
		return
	end
	r.ended = true
	if race == r then
		race = nil
	end
	local ranked = standings(r)
	local rows: { ResultRow } = {}
	for place, racer in ranked do
		table.insert(rows, {
			place = place,
			id = racer.entrant.id,
			name = racer.entrant.name,
			isCpu = racer.entrant.isCpu,
			userId = racer.entrant.player and racer.entrant.player.UserId,
			time = racer.finishTime,
			finished = racer.finishTime ~= nil,
			kartId = racer.entrant.kartId,
			look = racer.entrant.look,
			worstPlace = racer.worstPlace,
			hitsTaken = racer.hitsTaken,
			shortcutsTaken = racer.shortcutsTaken,
		})
	end
	ItemService.clear()
	kartsFolder:ClearAllChildren()
	if r.onEnded then
		r.onEnded(rows, r.trackId)
	end
end

---------------------------------------------------------------------------
-- Public API
---------------------------------------------------------------------------

-- Starts a race. `onEnded(rows, trackId)` is called once with the final placings.
function RaceService.startRace(trackId: string, entrants: { Entrant }, onEnded: ({ ResultRow }, string) -> ())
	if race then
		finishRace(race)
	end
	local _, track = TrackBuilder.build(trackId)
	kartsFolder:ClearAllChildren()

	-- Grid: CPUs at the front, players at the back, so players get to overtake.
	local order = table.clone(entrants)
	table.sort(order, function(a, b)
		if a.isCpu ~= b.isCpu then
			return a.isCpu
		end
		return a.id < b.id
	end)

	local r: Race = {
		trackId = trackId,
		track = track,
		racers = {},
		goTime = now() + LOAD_TIME + RaceRules.CountdownSeconds,
		timeLimit = track.def.laps * 150,
		lastBroadcast = 0,
		onEnded = onEnded,
		ended = false,
	}

	for slot, entrant in order do
		local pos, gridD = Track.gridSpot(track, slot)
		local _, tan = Track.at(track, gridD)
		local yaw = yawFromTangent(tan)
		local cf = CFrame.new(pos.x, pos.y, pos.z) * CFrame.Angles(0, yaw, 0)
		local model = KartRig.build(entrant.kartId, entrant.name, cf, kartsFolder, entrant.look)
		model.PrimaryPart.Anchored = true
		local racer: Racer = {
			entrant = entrant,
			model = model,
			state = if entrant.isCpu then KartPhysics.newState(yaw) else nil,
			stats = Karts.get(entrant.kartId).stats,
			progress = Track.newProgress(track, gridD),
			score = 0,
			place = slot,
			finishTime = nil,
			invincibleUntil = 0,
			protectUntil = 0,
			shieldUntil = 0,
			speedFactor = 1,
			lastRespawn = 0,
			worstPlace = slot,
			hitsTaken = 0,
			shortcutsTaken = 0,
			onShortcut = false,
			item = nil,
			uses = 0,
			itemReadyAt = 0,
			cpuUseAt = 0,
		}
		racer.score = Track.score(track, racer.progress)
		table.insert(r.racers, racer)
	end

	race = r
	ItemService.setup(track)
	refreshRayFilter()

	for _, racer in r.racers do
		local player = racer.entrant.player
		if player then
			task.spawn(function()
				seatDriver(player, racer.model)
				Net.ItemState:FireClient(player, nil, 0, 0)
				Net.RaceStart:FireClient(player, {
					trackId = trackId,
					trackName = track.def.name,
					theme = track.def.theme,
					kart = racer.model,
					kartId = racer.entrant.kartId,
					yaw = racer.state and racer.state.yaw or yawFromTangent(select(2, Track.at(track, racer.progress.distance))),
					goTime = r.goTime,
					laps = track.def.laps,
				})
			end)
		end
	end

	task.delay(r.goTime - now(), function()
		if race ~= r then
			return
		end
		for _, racer in r.racers do
			local root = racer.model.PrimaryPart
			if root then
				root.Anchored = false
				local player = racer.entrant.player
				if player and player.Parent and not racer.state then
					root:SetNetworkOwner(player)
				else
					root:SetNetworkOwner(nil)
				end
			end
		end
	end)
end

function RaceService.isRunning(): boolean
	return race ~= nil
end

function RaceService.isRacing(player: Player): boolean
	if race then
		for _, racer in race.racers do
			if racer.entrant.player == player then
				return true
			end
		end
	end
	return false
end

-- What lobby spectators see: track name and live standings.
function RaceService.spectatorInfo()
	local r = race
	if not r then
		return nil
	end
	local ranked = {}
	for _, racer in r.racers do
		table.insert(ranked, racer)
	end
	table.sort(ranked, function(a, b)
		return a.place < b.place
	end)
	return {
		trackName = r.track.def.name,
		theme = r.track.def.theme,
		rows = rowsOf(ranked),
		goTime = r.goTime,
	}
end

function RaceService.abort()
	if race then
		finishRace(race)
	end
end

local function findRacer(player: Player): Racer?
	if race then
		for _, racer in race.racers do
			if racer.entrant.player == player then
				return racer
			end
		end
	end
	return nil
end

function RaceService.useItem(player: Player, aimBack: boolean?)
	local racer = findRacer(player)
	if racer and race and now() >= race.goTime and not racer.finishTime then
		ItemService.use(race.track, race.racers, racer, Effects, aimBack == true)
	end
end

-- Manual recovery: puts a stuck kart back on the road (with a short cooldown).
function RaceService.requestRespawn(player: Player)
	local racer = findRacer(player)
	if racer and race and now() >= race.goTime and now() - racer.lastRespawn > RESPAWN_COOLDOWN and not racer.finishTime then
		respawn(race, racer)
	end
end

function RaceService.removePlayer(player: Player)
	local racer = findRacer(player)
	if racer and race then
		racer.model:Destroy()
		table.remove(race.racers, table.find(race.racers, racer) :: number)
	end
end

---------------------------------------------------------------------------
-- Loops
---------------------------------------------------------------------------
local function stepCpus(dt: number)
	local r = race
	if not r or now() < r.goTime then
		return
	end
	local positions = {}
	for _, racer in r.racers do
		local p = racer.model.PrimaryPart
		if p then
			positions[racer] = { x = p.Position.X, z = p.Position.Z }
		end
	end
	for _, racer in r.racers do
		local s = racer.state
		local root = racer.model.PrimaryPart
		if not s or not root or root.Anchored then
			continue
		end
		local others = {}
		for other, p in positions do
			if other ~= racer then
				table.insert(others, p)
			end
		end
		local sensed = KartRig.sense(racer.model, rayParams)
		local pos = vec(root.Position)
		local proj = Track.project(r.track, pos, racer.progress.index)
		local input = AIDriver.input(r.track, proj, pos, s, racer.stats, racer.entrant.profile)
		local surface = Track.surfaceAt(r.track, proj, pos, now())
		input.surface = if surface == "wall" then "offroad" else surface
		input.grounded = sensed.grounded
		input.drafting = KartPhysics.isDrafting(root.Position.X, root.Position.Z, s.yaw, others)
		KartPhysics.step(scaledStats(racer.stats, racer.speedFactor), s, input, dt)
		KartRig.sync(racer.model, s)
		KartRig.apply(racer.model, s, sensed)
		KartRig.setEffects(racer.model, if s.drift ~= 0 then KartPhysics.chargeLevel(s.charge) else 0, s.boost > 0)
	end
end

local function tickRace(r: Race)
	local t = now()
	if t < r.goTime then
		return
	end
	local track = r.track
	local humansRacing, humansLeft = 0, 0

	for _, racer in r.racers do
		local root = racer.model.PrimaryPart
		if not root then
			continue
		end
		local player = racer.entrant.player
		local pos = vec(root.Position)
		local proj = Track.project(track, pos, racer.progress.index)
		local roadY = Track.spot(track, proj.distance, 0).y
		local onShortcut = Track.shortcutAt(track, pos) ~= nil
		if onShortcut and not racer.onShortcut then
			racer.shortcutsTaken += 1
		end
		racer.onShortcut = onShortcut
		local offTrack = proj.gap > track.def.width + Track.ShoulderWidth * 2 and not onShortcut
		if offTrack or root.Position.Y < roadY - FALL_DEPTH then
			respawn(r, racer)
		elseif Track.updateProgress(track, racer.progress, proj) then
			if racer.progress.lap > track.def.laps and not racer.finishTime then
				racer.finishTime = t - r.goTime
				if player then
					Net.Notify:FireClient(player, "FINISH!")
					autopilot(racer)
					-- Once any player finishes, the rest have a limited time left.
					if not r.endAt then
						r.endAt = t + FINISH_TIMEOUT
					end
				end
			elseif player and racer.progress.lap == track.def.laps then
				Net.Notify:FireClient(player, "FINAL LAP!")
			elseif player and racer.progress.lap > 1 then
				Net.Notify:FireClient(player, `Lap {racer.progress.lap}`)
			end
		end
		racer.score = Track.score(track, racer.progress)

		if player then
			if not player.Parent then
				continue
			end
			humansLeft += 1
			if not racer.finishTime then
				humansRacing += 1
			end
		end
	end

	local ranked = standings(r)
	for _, racer in ranked do
		racer.worstPlace = math.max(racer.worstPlace, racer.place)
	end

	-- CPU pace: catch up when far behind, ease off when running away from players.
	local leaderScore = ranked[1] and ranked[1].score or 0
	local bestHuman = -math.huge
	for _, racer in r.racers do
		if not racer.entrant.isCpu then
			bestHuman = math.max(bestHuman, racer.score)
		end
	end
	for _, racer in r.racers do
		if racer.entrant.isCpu then
			local lead = if bestHuman > -math.huge then racer.score - bestHuman else 0
			racer.speedFactor = RaceRules.cpuSpeedFactor(leaderScore - racer.score, lead, racer.entrant.profile.skill)
		end
	end

	-- Moving crossers (toy robot, train, beetles) bump anyone they touch.
	for _, cr in track.def.crossers or {} do
		local d, lat, active = Track.crosserAt(track, cr, t)
		if active then
			local p = Track.spot(track, d, lat)
			local hazard = Vector3.new(p.x, p.y, p.z)
			for _, racer in r.racers do
				local root = racer.model.PrimaryPart
				if root and (Vector3.new(root.Position.X, p.y, root.Position.Z) - hazard).Magnitude < cr.radius + 2.5 then
					if Effects.hit(racer, "spin") then
						Effects.warn(racer, "BONK!")
					end
				end
			end
		end
	end

	ItemService.tick(r.track, r.racers, TICK, Effects)

	if t - r.lastBroadcast >= 0.2 then
		r.lastBroadcast = t
		for _, racer in r.racers do
			local player = racer.entrant.player
			if player and player.Parent then
				Net.RaceState:FireClient(player, raceStateFor(r, ranked, racer))
			end
		end
	end

	if humansLeft == 0 then
		finishRace(r)
		return
	end
	if humansRacing == 0 then
		r.endAt = math.min(r.endAt or math.huge, t + END_GRACE)
	end
	if (r.endAt and t >= r.endAt) or t - r.goTime > r.timeLimit then
		finishRace(r)
	end
end

function RaceService.start()
	task.spawn(function()
		while true do
			task.wait(TICK)
			local r = race
			if r and not r.ended then
				local ok, err = pcall(tickRace, r)
				if not ok then
					warn("[RaceService] race tick failed:", err)
				end
			end
		end
	end)

	RunService.Heartbeat:Connect(function(dt)
		local ok, err = pcall(stepCpus, math.min(dt, 0.1))
		if not ok then
			warn("[RaceService] CPU step failed:", err)
		end
	end)

	Players.PlayerAdded:Connect(function(player)
		player.CharacterAdded:Connect(function()
			task.defer(refreshRayFilter)
		end)
	end)
	Players.PlayerRemoving:Connect(RaceService.removePlayer)
end

return RaceService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="29">
        <Properties>
          <string name="Name">RoundService</string>
          <string name="Source"><![CDATA[-- The round loop:
--   lobby → (someone readies up) → ready countdown → map voting (20s)
--   → race → results → back to the lobby
--
-- Players explore the Kart Carnival freely. Only players who ready up race
-- and vote; everyone else can keep practising or watch. Late joiners spawn in
-- the lobby and can ready up for the next race. Empty grid slots are filled
-- with CPU drivers, so one player can race alone.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local KartBodies = require(Shared.KartBodies)
local Karts = require(Shared.Karts)
local LobbyLayout = require(Shared.LobbyLayout)
local RaceRules = require(Shared.RaceRules)
local Tracks = require(Shared.Tracks)
local Voting = require(Shared.Voting)

local LobbyBuilder = require(script.Parent.LobbyBuilder)
local Net = require(script.Parent.Net)
local PracticeService = require(script.Parent.PracticeService)
local RaceService = require(script.Parent.RaceService)

local RoundService = {}

local READY_WAIT = 10 -- seconds after the first ready-up before voting opens
local RESULTS_TIME = 10
local TICK = 0.25

type Choice = { kart: string, look: KartBodies.Look, ready: boolean }

local phase: "lobby" | "voting" | "racing" | "results" = "lobby"
local deadline: number? = nil
local choices: { [Player]: Choice } = {}
local options: { string } = {}
local votes: { [number]: string } = {} -- UserId -> track id
local voters: { [Player]: boolean } = {}
local lastTrack: string? = nil
local lastResults: { any } = {}
local winner: string? = nil
local handles: LobbyBuilder.Handles
local foundTokens: { [Player]: { [number]: boolean } } = {}
local dirty = true

local function now(): number
	return Workspace:GetServerTimeNow()
end

local function choiceOf(player: Player): Choice
	local c = choices[player]
	if not c then
		c = { kart = Karts.Default, look = KartBodies.sanitize(nil), ready = false }
		choices[player] = c
	end
	return c
end

local function rootOf(player: Player): BasePart?
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

---------------------------------------------------------------------------
-- State for clients and signs
---------------------------------------------------------------------------
local function optionInfo(id: string)
	local def = Tracks.get(id)
	local voterIds = Voting.votersFor(votes, id)
	return {
		id = id,
		name = def.name,
		icon = def.icon or "🏁",
		difficulty = def.difficulty or "Medium",
		feature = def.feature or "",
		theme = def.theme,
		votes = #voterIds,
		voters = voterIds,
	}
end

local function roundState()
	local players = {}
	for player, c in choices do
		if player.Parent then
			table.insert(players, {
				userId = player.UserId,
				name = player.DisplayName,
				ready = c.ready,
				racing = RaceService.isRacing(player),
				voter = voters[player] == true,
			})
		end
	end
	local opts = {}
	for _, id in options do
		table.insert(opts, optionInfo(id))
	end
	return {
		phase = phase,
		deadline = deadline,
		players = players,
		options = opts,
		winner = winner,
		spectate = RaceService.spectatorInfo(),
		lastResults = lastResults,
	}
end

local function countReady(): (number, number)
	local total, ready = 0, 0
	for player, c in choices do
		if player.Parent then
			total += 1
			if c.ready and not RaceService.isRacing(player) then
				ready += 1
			end
		end
	end
	return total, ready
end

local function secondsLeft(): number
	return if deadline then math.max(0, math.ceil(deadline - now())) else 0
end

local function updateSigns()
	local _, ready = countReady()
	if phase == "lobby" then
		if deadline then
			handles.setStatus("GET READY!", `{ready} racer{if ready == 1 then "" else "s"} ready\nVoting opens in {secondsLeft()}s`)
		else
			handles.setStatus("KART CARNIVAL", "Step under the READY arch\n(or press READY) to join the next race")
		end
	elseif phase == "voting" then
		handles.setStatus("VOTE FOR A TRACK!", `Stand on a pad or use the menu\n{secondsLeft()}s left`)
	elseif phase == "racing" then
		local info = RaceService.spectatorInfo()
		handles.setStatus("RACE IN PROGRESS", if info then `{info.trackName}\nReady up to join the next one` else "")
	elseif phase == "results" then
		handles.setStatus("RESULTS", `Back to the lobby in {secondsLeft()}s`)
	end

	for i = 1, #LobbyLayout.VotePads do
		local id = options[i]
		handles.setVoteOption(i, if id and (phase == "voting" or phase == "racing") then optionInfo(id) else nil)
	end

	local info = RaceService.spectatorInfo()
	if info then
		local lines = {}
		for place, row in info.rows do
			if place > 8 then
				break
			end
			table.insert(lines, `{place}. {row.name}{if row.finished then " ✓" else ""}`)
		end
		handles.setSpectator(`LIVE: {info.trackName}`, table.concat(lines, "\n"))
	else
		handles.setSpectator("LIVE RACE", "No race running.\nReady up to start one!")
	end
end

local function broadcast()
	dirty = false
	Net.Round:FireAllClients(roundState())
	updateSigns()
end

local function refreshDisplays()
	local slot = 0
	for player, c in choices do
		if player.Parent then
			slot += 1
			if slot <= #LobbyLayout.KartDisplays then
				handles.setKartDisplay(slot, player.DisplayName, c.kart, c.look)
			end
		end
	end
	for s = slot + 1, #LobbyLayout.KartDisplays do
		handles.setKartDisplay(s, nil)
	end
end

---------------------------------------------------------------------------
-- Phases
---------------------------------------------------------------------------
local function toLobby()
	phase = "lobby"
	deadline = nil
	options = {}
	votes = {}
	voters = {}
	winner = nil
	dirty = true
end

local function startVoting()
	phase = "voting"
	deadline = now() + Voting.VoteSeconds
	votes = {}
	voters = {}
	options = Voting.pickOptions(Tracks.VotePool, Voting.OptionCount, math.random, lastTrack)
	for player, c in choices do
		if c.ready and player.Parent then
			voters[player] = true
		end
	end
	for player in voters do
		Net.Notify:FireClient(player, "Vote for a track!")
	end
	dirty = true
end

local function onRaceEnded(rows: { any }, trackId: string)
	phase = "results"
	deadline = now() + RESULTS_TIME
	lastTrack = trackId
	lastResults = {}
	for i, row in rows do
		if i <= 3 then
			table.insert(lastResults, { name = row.name, kartId = row.kartId, look = row.look })
		end
	end
	handles.setPodium(lastResults)

	local def = Tracks.get(trackId)
	local out = {}
	for _, row in rows do
		table.insert(out, {
			place = row.place,
			name = row.name,
			isCpu = row.isCpu,
			userId = row.userId,
			time = row.time,
			finished = row.finished,
		})
	end
	Net.Results:FireAllClients({ trackName = def.name, rows = out })

	-- Racers go back to the lobby; they ready up again for the next race.
	for _, row in rows do
		if row.userId then
			local player = Players:GetPlayerByUserId(row.userId)
			if player then
				choiceOf(player).ready = false
				task.defer(function()
					if player.Parent then
						player:LoadCharacter()
					end
				end)
			end
		end
	end
	dirty = true
end

local function startRace()
	-- Highest vote wins; ties are broken at random.
	local trackId = Voting.winner(options, votes, math.random)
	winner = trackId
	local entrants = {}
	for player in voters do
		if player.Parent then
			local c = choiceOf(player)
			PracticeService.stop(player)
			table.insert(entrants, {
				id = `u{player.UserId}`,
				name = player.DisplayName,
				isCpu = false,
				player = player,
				kartId = c.kart,
				look = c.look,
				profile = { lane = 0, skill = 1 },
			})
		end
	end
	if #entrants == 0 then
		toLobby()
		return
	end
	local cpuIndex = 0
	while #entrants < RaceRules.MaxRacers do
		cpuIndex += 1
		local driver = Karts.CpuDrivers[cpuIndex]
		table.insert(entrants, {
			id = `cpu{cpuIndex}`,
			name = driver.name,
			isCpu = true,
			kartId = driver.kart,
			look = KartBodies.cpuLook(cpuIndex),
			profile = { lane = ((cpuIndex % 3) - 1) * 0.6, skill = 0.45 + (cpuIndex % 4) * 0.15 },
		})
	end
	phase = "racing"
	deadline = nil
	-- Voters are now racers; their ready flag is spent.
	for player in voters do
		choiceOf(player).ready = false
	end
	voters = {}
	dirty = true
	local ok, err = pcall(RaceService.startRace, trackId, entrants, onRaceEnded)
	if not ok then
		warn("[RoundService] could not start the race:", err)
		RaceService.abort()
		toLobby()
	end
end

local function step()
	local t = now()
	local _, ready = countReady()

	if phase == "lobby" then
		if ready == 0 then
			if deadline then
				deadline = nil
				dirty = true
			end
		else
			if not deadline then
				deadline = t + READY_WAIT
				dirty = true
			end
			-- Everyone in the server ready? No need to wait.
			local total = 0
			for player in choices do
				if player.Parent and not RaceService.isRacing(player) then
					total += 1
				end
			end
			if t >= (deadline :: number) or ready == total then
				startVoting()
			end
		end
	elseif phase == "voting" then
		-- Standing on a vote pad counts as a vote.
		for player in voters do
			local root = rootOf(player)
			if root then
				local pad = LobbyLayout.padAt(root.Position.X, root.Position.Z)
				if pad and options[pad] and votes[player.UserId] ~= options[pad] then
					votes[player.UserId] = options[pad]
					dirty = true
				end
			end
		end
		local anyVoter = next(voters) ~= nil
		if not anyVoter then
			toLobby()
		elseif t >= (deadline :: number) then
			startRace()
		end
	elseif phase == "racing" then
		if not RaceService.isRunning() and phase == "racing" then
			-- The race ended without results (everyone left).
			toLobby()
		end
	elseif phase == "results" then
		if t >= (deadline :: number) then
			toLobby()
		end
	end

	-- Hidden tokens in the lobby.
	for _, player in Players:GetPlayers() do
		local root = rootOf(player)
		if root then
			for _, token in handles.collectibles do
				local id = token:GetAttribute("TokenId")
				local found = foundTokens[player]
				if found and not found[id] and (token.Position - root.Position).Magnitude < 7 then
					found[id] = true
					local count = 0
					for _ in found do
						count += 1
					end
					Net.Notify:FireClient(player, `Golden token found! {count}/{#handles.collectibles}`)
				end
			end
		end
	end
end

---------------------------------------------------------------------------
-- Remotes and setup
---------------------------------------------------------------------------
local function setReady(player: Player, isReady: boolean)
	if RaceService.isRacing(player) then
		return
	end
	local c = choiceOf(player)
	if c.ready == isReady then
		return
	end
	c.ready = isReady
	if phase == "voting" then
		if isReady then
			voters[player] = true
		else
			voters[player] = nil
			votes[player.UserId] = nil
		end
	end
	Net.Notify:FireClient(player, if isReady then "You're in the next race!" else "You left the next race.")
	dirty = true
end

function RoundService.start()
	handles = LobbyBuilder.build()
	PracticeService.init()

	local function onPlayer(player: Player)
		choiceOf(player)
		foundTokens[player] = {}
		dirty = true
		refreshDisplays()
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		onPlayer(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		choices[player] = nil
		voters[player] = nil
		votes[player.UserId] = nil
		foundTokens[player] = nil
		dirty = true
		task.defer(refreshDisplays)
	end)

	Net.Ready.OnServerEvent:Connect(function(player, isReady)
		setReady(player, isReady == true)
	end)
	handles.readyPrompt.Triggered:Connect(function(player)
		setReady(player, not choiceOf(player).ready)
	end)
	Net.Vote.OnServerEvent:Connect(function(player, trackId)
		if phase == "voting" and voters[player] and table.find(options, trackId) then
			votes[player.UserId] = trackId
			dirty = true
		end
	end)
	Net.ChooseKart.OnServerEvent:Connect(function(player, kartId)
		if not RaceService.isRacing(player) then
			choiceOf(player).kart = Karts.get(tostring(kartId)).id
			refreshDisplays()
			dirty = true
		end
	end)
	Net.ChooseLook.OnServerEvent:Connect(function(player, look)
		if not RaceService.isRacing(player) then
			choiceOf(player).look = KartBodies.sanitize(look)
			refreshDisplays()
			dirty = true
		end
	end)
	Net.UseItem.OnServerEvent:Connect(function(player, aimBack)
		RaceService.useItem(player, aimBack == true)
	end)
	Net.Respawn.OnServerEvent:Connect(RaceService.requestRespawn)

	handles.garagePrompt.Triggered:Connect(function(player)
		Net.OpenGarage:FireClient(player)
	end)
	handles.spectatePrompt.Triggered:Connect(function(player)
		if RaceService.isRunning() and not RaceService.isRacing(player) then
			Net.Spectate:FireClient(player)
		else
			Net.Notify:FireClient(player, "No race to watch right now.")
		end
	end)
	handles.practicePrompt.Triggered:Connect(function(player)
		if RaceService.isRacing(player) then
			return
		end
		local c = choiceOf(player)
		PracticeService.start(player, c.kart, c.look)
	end)

	task.spawn(function()
		local lastSecond = -1
		while true do
			task.wait(TICK)
			local ok, err = pcall(step)
			if not ok then
				warn("[RoundService]", err)
			end
			-- Rebroadcast on changes, and once a second so countdowns tick on signs.
			local second = math.floor(now())
			if dirty or second ~= lastSecond then
				lastSecond = second
				local ok2, err2 = pcall(broadcast)
				if not ok2 then
					warn("[RoundService] broadcast failed:", err2)
				end
			end
		end
	end)
end

return RoundService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="30">
        <Properties>
          <string name="Name">TrackBuilder</string>
          <string name="Source"><![CDATA[-- Builds a track's parts from its centerline: road, curbs and lane lines,
-- grass shoulders, walls, bridge pillars, boost pads, the start line, the
-- ground and scenery (see Scenery.luau / Props.luau). Lighting is applied on
-- each client (common/Atmos), so lobby players keep the lobby's look.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Scenery = require(Shared.Scenery)
local Track = require(Shared.Track)
local Tracks = require(Shared.Tracks)

local Landmarks = require(script.Parent.Landmarks)
local Props = require(script.Parent.Props)
local Shapes = require(ReplicatedStorage.Common.Shapes)

local BANK_MAX = math.rad(6) -- corners tilt inward a little

local TrackBuilder = {}

local function rgb(c: { number }): Color3
	return Color3.fromRGB(c[1], c[2], c[3])
end

local function v3(p: Track.Vec): Vector3
	return Vector3.new(p.x, p.y, p.z)
end

local function part(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

-- Markings sit just above the road; raycasts and collisions ignore them.
local function decal(parent: Instance, size: Vector3, cf: CFrame, color: Color3, glow: boolean): Part
	local p = part(parent, "Marking", size, cf, color, if glow then Enum.Material.Neon else Enum.Material.SmoothPlastic)
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	return p
end

local function flatAngle(a: Vector3, b: Vector3): number
	return math.atan2(b.X - a.X, b.Z - a.Z)
end

export type Options = {
	folderName: string?, -- default "Track"; the lobby practice loop uses its own folder
	ground: boolean?, -- build ground under the track (default true)
	scenery: boolean?, -- place scenery props (default true)
}

function TrackBuilder.build(trackId: string, options: Options?): (Folder, Track.Built)
	local opts = options or {}
	local def = Tracks.get(trackId)
	local track = Track.build(def)
	local theme = Tracks.Themes[def.theme]
	local roadColor, shoulderColor, wallColor = rgb(theme.road), rgb(theme.shoulder), rgb(theme.wall)
	local walled = def.walls ~= false

	local folderName = opts.folderName or "Track"
	local old = Workspace:FindFirstChild(folderName)
	if old then
		old:Destroy()
	end
	local folder = Instance.new("Folder")
	folder.Name = folderName
	folder:SetAttribute("TrackId", trackId)

	local half = def.width / 2
	local sw = Track.ShoulderWidth
	local pts = track.points
	local n = #pts
	local minY, minX, maxX, minZ, maxZ = math.huge, math.huge, -math.huge, math.huge, -math.huge
	local markings = Instance.new("Folder")
	markings.Name = "Markings"
	markings.Parent = folder
	local neon = def.theme == "neon"
	local curbColors = { rgb(theme.curb[1]), rgb(theme.curb[2]) }
	local lineColor = rgb(theme.line)

	-- Banking: smoothed signed turn per segment (positive = turning left).
	local signedTurn = {}
	for i = 1, n do
		local a, b, c = v3(pts[i]), v3(pts[i % n + 1]), v3(pts[(i + 1) % n + 1])
		signedTurn[i] = ((flatAngle(b, c) - flatAngle(a, b)) + math.pi) % (2 * math.pi) - math.pi
	end
	local function bank(i: number): number
		local sum = 0
		for k = -3, 3 do
			sum += signedTurn[(i - 1 + k) % n + 1]
		end
		return math.clamp(sum / 7 * 4, -BANK_MAX, BANK_MAX)
	end

	-- Wall openings where shortcuts leave and rejoin the road.
	local openings = {}
	for _, sc in def.shortcuts or {} do
		table.insert(openings, { side = sc.side, at = sc.from * track.length, half = sc.width / 2 + 6 })
		table.insert(openings, { side = sc.side, at = sc.to * track.length, half = sc.width / 2 + 6 })
	end
	local function wallOpen(side: number, distance: number, segLen: number): boolean
		for _, o in openings do
			local d = (distance - o.at + track.length / 2) % track.length - track.length / 2
			if o.side == side and math.abs(d) < o.half + segLen / 2 then
				return true
			end
		end
		return false
	end

	for i = 1, n do
		local a, b, c = v3(pts[i]), v3(pts[i % n + 1]), v3(pts[(i + 1) % n + 1])
		local length = (b - a).Magnitude
		-- Lengthen segments on the outside of bends so the edges have no gaps.
		local turn = math.abs(signedTurn[i])
		local extra = 1 + (half + sw + 1) * turn
		local roll = if walled then bank(i) else 0
		local cf = CFrame.lookAt((a + b) / 2, b) * CFrame.Angles(0, 0, roll)
		local segLen = length + extra
		local segDistance = track.cum[i] + length / 2

		local road = part(folder, "Road", Vector3.new(def.width, 1, segLen), cf * CFrame.new(0, -0.5, 0), roadColor, Enum.Material.SmoothPlastic)
		road:SetAttribute("Surface", "road")
		for _, side in (if walled then { -1, 1 } else {}) :: { number } do
			local shoulder = part(folder, "Shoulder", Vector3.new(sw, 1, segLen), cf * CFrame.new(side * (half + sw / 2), -0.52, 0), shoulderColor, Enum.Material.SmoothPlastic)
			shoulder:SetAttribute("Surface", "offroad")
			if not wallOpen(side, segDistance, segLen) then
				part(folder, "Wall", Vector3.new(1, 4, segLen), cf * CFrame.new(side * (half + sw + 0.5), 1.5, 0), wallColor, if def.theme == "neon" then Enum.Material.Neon else Enum.Material.SmoothPlastic)
			end
		end

		-- Red-and-white curbs through corners, lane lines on the straights.
		if turn > 0.02 and walled then
			for _, side in { -1, 1 } do
				decal(markings, Vector3.new(3, 0.1, length + 0.6), cf * CFrame.new(side * (half - 1.5), 0.05, 0), curbColors[i % 2 + 1], neon)
			end
		else
			for _, side in { -1, 1 } do
				decal(markings, Vector3.new(0.8, 0.06, length + 0.4), cf * CFrame.new(side * (half - 1.2), 0.03, 0), lineColor, neon)
			end
		end
		if i % 3 ~= 0 then
			decal(markings, Vector3.new(0.7, 0.06, length * 0.7), cf * CFrame.new(0, 0.03, 0), lineColor, neon)
		end

		minY = math.min(minY, a.Y)
		minX, maxX = math.min(minX, a.X), math.max(maxX, a.X)
		minZ, maxZ = math.min(minZ, a.Z), math.max(maxZ, a.Z)
	end

	-- Pillars under raised road, skipped where they would land on the road below.
	for i = 1, n, 6 do
		local p = pts[i]
		if p.y - minY > 8 then
			local blocked = false
			for j, q in pts do
				local apart = math.min(math.abs(i - j), n - math.abs(i - j))
				if apart > 20 and math.abs(q.x - p.x) < half + sw + 6 and math.abs(q.z - p.z) < half + sw + 6 and q.y < p.y - 8 then
					blocked = true
					break
				end
			end
			if not blocked then
				local h = p.y - minY
				part(folder, "Pillar", Vector3.new(6, h, 6), CFrame.new(p.x, minY + h / 2 - 1, p.z), wallColor, Enum.Material.SmoothPlastic)
			end
		end
	end

	-- Ground under everything.
	if opts.ground ~= false then
		local margin = 300
		local sizeX, sizeZ = maxX - minX + margin * 2, maxZ - minZ + margin * 2
		local tile = 1000
		for x = minX - margin, minX - margin + sizeX, tile do
			for z = minZ - margin, minZ - margin + sizeZ, tile do
				local g = part(folder, "Ground", Vector3.new(tile, 2, tile), CFrame.new(x + tile / 2, minY - 1.6, z + tile / 2), rgb(theme.ground), Enum.Material.SmoothPlastic)
				g:SetAttribute("Surface", "offroad")
			end
		end
	end

	-- Boost pads (visual; the surface is worked out from Track.surfaceAt).
	for _, pad in Track.pads(track) do
		local pos = v3(Track.spot(track, pad.distance, pad.lateral))
		local _, tan = Track.at(track, pad.distance)
		local cf = CFrame.lookAt(pos, pos + v3(tan))
		local p = part(folder, "BoostPad", Vector3.new(Track.PadWidth, 0.2, Track.PadLength), cf * CFrame.new(0, 0.05, 0), rgb(theme.accent), Enum.Material.Neon)
		p.CanCollide = false
		p.CanQuery = false
		for k = -1, 1 do
			local arrow = part(folder, "Arrow", Vector3.new(6, 0.25, 2), cf * CFrame.new(0, 0.12, k * 7) * CFrame.Angles(0, math.rad(45), 0), Color3.new(1, 1, 1), Enum.Material.Neon)
			arrow.CanCollide = false
			arrow.CanQuery = false
		end
	end

	-- Checkered start/finish line.
	local start, tan = Track.at(track, 0)
	local lineCf = CFrame.lookAt(v3(start), v3(start) + v3(tan))
	local squares = 8
	for k = 0, squares - 1 do
		for row = 0, 1 do
			local sq = part(folder, "Finish", Vector3.new(def.width / squares, 0.2, 3), lineCf * CFrame.new(-half + (k + 0.5) * def.width / squares, 0.06, (row - 0.5) * 3), if (k + row) % 2 == 0 then Color3.new(1, 1, 1) else Color3.new(0.05, 0.05, 0.05), Enum.Material.SmoothPlastic)
			sq.CanCollide = false
			sq.CanQuery = false
		end
	end
	-- Banner over the line.
	for _, side in { -1, 1 } do
		part(folder, "BannerPost", Vector3.new(1.5, 18, 1.5), lineCf * CFrame.new(side * (half + 4), 9, 0), wallColor, Enum.Material.SmoothPlastic)
	end
	part(folder, "Banner", Vector3.new(def.width + 10, 3, 1), lineCf * CFrame.new(0, 17, 0), rgb(theme.accent), Enum.Material.Neon)

	-- Surface patches: syrup, water, conveyor belts, launch pads.
	local zoneStyle = {
		sticky = { color = Color3.fromRGB(150, 85, 30), material = Enum.Material.Glass, transparency = 0.1 },
		slippery = { color = Color3.fromRGB(120, 190, 255), material = Enum.Material.Glass, transparency = 0.35 },
		conveyor = { color = Color3.fromRGB(70, 72, 82), material = Enum.Material.SmoothPlastic, transparency = 0 },
		launch = { color = Color3.fromRGB(255, 80, 80), material = Enum.Material.Neon, transparency = 0 },
	}
	for zi, zone in def.zones or {} do
		local style = zoneStyle[zone.kind]
		if style then
			local width = zone.width or def.width
			local offset = (zone.offset or 0) * (half - width / 2)
			local from = zone.t * track.length - zone.length / 2
			local steps = math.max(1, math.ceil(zone.length / 10))
			for k = 0, steps - 1 do
				local d = from + (k + 0.5) * zone.length / steps
				local p = v3(Track.spot(track, d, offset))
				local _, tan = Track.at(track, d)
				local zcf = CFrame.lookAt(p, p + v3(tan))
				local patch = part(markings, "Zone", Vector3.new(width, 0.12, zone.length / steps + 0.4), zcf * CFrame.new(0, 0.07, 0), style.color, style.material)
				patch.Transparency = style.transparency
				patch.CanCollide = false
				patch.CanQuery = false
				patch:SetAttribute("ZoneIndex", zi)
				if zone.kind == "conveyor" and k % 2 == 0 then
					local arrow = part(markings, "ConveyorArrow", Vector3.new(width * 0.5, 0.15, 2), zcf * CFrame.new(0, 0.1, 0) * CFrame.Angles(0, math.rad(45), 0), Color3.fromRGB(255, 210, 60), Enum.Material.Neon)
					arrow.CanCollide = false
					arrow.CanQuery = false
				end
			end
		end
	end

	-- Shortcut paths: a narrow road through the gap in the wall.
	for _, sc in def.shortcuts or {} do
		local sa, sb = Track.shortcutEnds(track, sc)
		local pa, pb = v3(sa), v3(sb)
		local length = (pb - pa).Magnitude + sc.width
		local scCf = CFrame.lookAt((pa + pb) / 2, pb)
		local road = part(folder, "ShortcutRoad", Vector3.new(sc.width, 1, length), scCf * CFrame.new(0, -0.5, 0), roadColor:Lerp(rgb(theme.accent), 0.25), Enum.Material.SmoothPlastic)
		road:SetAttribute("Surface", sc.surface or "road")
		-- Connect each end to the road edge across the grass shoulder.
		for _, endpoint in { { at = sc.from, p = pa }, { at = sc.to, p = pb } } do
			local edge = v3(Track.spot(track, endpoint.at * track.length, sc.side * half))
			local link = (endpoint.p - edge)
			part(folder, "ShortcutLink", Vector3.new(sc.width, 1, link.Magnitude + sc.width), CFrame.lookAt((edge + endpoint.p) / 2, endpoint.p) * CFrame.new(0, -0.49, 0), roadColor:Lerp(rgb(theme.accent), 0.25), Enum.Material.SmoothPlastic)
		end
		-- Little arrows hint the way in.
		for _, side in { -1, 1 } do
			Shapes.box(folder, Vector3.new(0.8, 6, 0.8), scCf * CFrame.new(side * (sc.width / 2 + 1), 3, -length / 2 + 2), { color = rgb(theme.accent), material = Enum.Material.Neon })
		end
		if def.theme == "backyard" then
			-- The shortcut runs through a hollow log.
			local logLen = math.min(length * 0.5, 60)
			for z = -logLen / 2, logLen / 2, 4 do
				Shapes.arch(folder, sc.width + 6, 3, 4.5, scCf * CFrame.new(0, -2, z), { color = Color3.fromRGB(130, 90, 55), collide = true }, 14)
			end
		end
	end

	-- Tunnels, landmarks and moving crossers.
	local landmarks = Instance.new("Folder")
	landmarks.Name = "Landmarks"
	landmarks.Parent = folder
	for _, tn in def.tunnels or {} do
		Landmarks.tunnel(track, tn.style, tn.from, tn.to, theme, landmarks)
	end
	for _, spot in Scenery.setPieceSpots(track) do
		Landmarks.setPiece(spot.kind, CFrame.new(spot.x, spot.y, spot.z) * CFrame.Angles(0, spot.yaw, 0), theme, landmarks)
	end
	local crossersFolder = Instance.new("Folder")
	crossersFolder.Name = "Crossers"
	crossersFolder.Parent = folder
	for ci, cr in def.crossers or {} do
		local p = Track.spot(track, cr.t * track.length, -(half + sw))
		Landmarks.crosser(cr.kind, ci, crossersFolder, CFrame.new(p.x, p.y, p.z))
	end
	if theme.room then
		Landmarks.room(theme, minX, maxX, minZ, maxZ, minY, landmarks)
	end

	-- Jump ramps. The low edge faces oncoming karts; the tall back edge launches them.
	for _, ramp in def.ramps or {} do
		local d = ramp.t * track.length
		local pos = v3(Track.spot(track, d, ramp.offset * (half - ramp.width / 2)))
		local _, rampTan = Track.at(track, d)
		local cf = CFrame.lookAt(pos, pos - v3(rampTan))
		local wedge = Instance.new("WedgePart")
		wedge.Name = "Ramp"
		wedge.Anchored = true
		wedge.Size = Vector3.new(ramp.width, 5, 18)
		wedge.CFrame = cf * CFrame.new(0, 2.5, 0)
		wedge.Color = rgb(theme.accent)
		wedge.Material = Enum.Material.SmoothPlastic
		wedge.TopSurface = Enum.SurfaceType.Smooth
		wedge:SetAttribute("Surface", "ramp")
		wedge.Parent = folder
		for k = -1, 1, 2 do
			local stripe = part(folder, "RampStripe", Vector3.new(1.2, 0.2, 18.6), cf * CFrame.new(k * (ramp.width / 2 - 1.5), 2.6, 0) * CFrame.Angles(math.atan2(5, 18), 0, 0), Color3.new(1, 1, 1), Enum.Material.Neon)
			stripe.CanCollide = false
			stripe.CanQuery = false
		end
	end

	-- Scenery around the track.
	if opts.scenery ~= false then
		local scenery = Instance.new("Folder")
		scenery.Name = "Scenery"
		scenery.Parent = folder
		for _, prop in Scenery.place(track) do
			Props.build(prop, theme, scenery)
		end
	end

	folder.Parent = Workspace
	return folder, track
end

return TrackBuilder
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="31">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="32">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="33">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">GarageUI</string>
            <string name="Source"><![CDATA[-- The garage: choose your kart type (stats), body design and paint. Opens
-- from the GARAGE button or the garage building in the lobby.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local KartBodies = require(Shared:WaitForChild("KartBodies"))
local Karts = require(Shared:WaitForChild("Karts"))

local UI = require(script.Parent.UI)

local GarageUI = {}

GarageUI.onChooseKart = nil :: ((string) -> ())?
GarageUI.onLook = nil :: ((any) -> ())?

local chosenKart = Karts.Default
local look = { body = KartBodies.Default, main = 1, accent = 10 }

local panel = UI.panel(UI.Screen, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0, 640, 0, 520), Visible = false })
UI.label(panel, { Position = UDim2.new(0, 20, 0, 10), Size = UDim2.new(1, -100, 0, 44), Text = "🔧 GARAGE", TextColor3 = UI.Colors.yellow, TextXAlignment = Enum.TextXAlignment.Left })
UI.button(panel, "✕", UI.Colors.red, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 12), Size = UDim2.new(0, 52, 0, 46) }, function()
	GarageUI.close()
end)

local function statBar(n: number, lo: number, hi: number): string
	local filled = math.clamp(math.floor((n - lo) / (hi - lo) * 5 + 0.5), 1, 5)
	return string.rep("●", filled) .. string.rep("○", 5 - filled)
end

-- Kart type cards (these set the stats).
local cards = Instance.new("Frame")
cards.BackgroundTransparency = 1
cards.Position = UDim2.new(0, 20, 0, 64)
cards.Size = UDim2.new(1, -40, 0, 160)
cards.Parent = panel
UI.list(cards, true, 10)
local cardButtons: { [string]: TextButton } = {}
for _, def in Karts.List do
	local c = Color3.fromRGB(def.color[1], def.color[2], def.color[3])
	local card = UI.button(cards, "", c:Lerp(Color3.new(0, 0, 0), 0.55), { Size = UDim2.new(1 / 3, -7, 1, 0) }, function()
		chosenKart = def.id
		if GarageUI.onChooseKart then
			GarageUI.onChooseKart(def.id)
		end
		GarageUI.refresh()
	end)
	UI.label(card, { Size = UDim2.new(1, 0, 0, 30), Text = def.name, TextColor3 = c })
	UI.label(card, {
		Position = UDim2.new(0, 0, 0, 34),
		Size = UDim2.new(1, 0, 1, -34),
		TextScaled = false,
		TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		Text = `{def.blurb}\nSpeed  {statBar(def.stats.topSpeed, 88, 108)}\nAccel  {statBar(def.stats.accel, 44, 72)}\nTurn   {statBar(def.stats.handling, 1.9, 2.4)}`,
	})
	cardButtons[def.id] = card
end

local function row(y: number, title: string, height: number): Frame
	UI.label(panel, { Position = UDim2.new(0, 20, 0, y), Size = UDim2.new(0, 80, 0, height), TextScaled = false, TextSize = 18, Text = title, TextXAlignment = Enum.TextXAlignment.Left })
	local r = Instance.new("Frame")
	r.BackgroundTransparency = 1
	r.Position = UDim2.new(0, 100, 0, y)
	r.Size = UDim2.new(1, -120, 0, height)
	r.Parent = panel
	local grid = Instance.new("UIGridLayout")
	grid.CellPadding = UDim2.new(0, 6, 0, 6)
	grid.CellSize = if height > 60 then UDim2.new(0, 160, 0, 40) else UDim2.new(0, 36, 0, 36)
	grid.SortOrder = Enum.SortOrder.LayoutOrder
	grid.Parent = r
	return r
end

local bodyButtons: { [string]: TextButton } = {}
local mainSwatches: { TextButton } = {}
local accentSwatches: { TextButton } = {}

local function sendLook()
	if GarageUI.onLook then
		GarageUI.onLook(look)
	end
	GarageUI.refresh()
end

local bodyRow = row(238, "Body", 132)
for _, body in KartBodies.List do
	bodyButtons[body.id] = UI.button(bodyRow, body.name, UI.Colors.panelLight, {}, function()
		look.body = body.id
		sendLook()
	end)
end

local function swatches(y: number, title: string, list: { TextButton }, key: string)
	local r = row(y, title, 36)
	for i, c in KartBodies.Palette do
		list[i] = UI.button(r, "", Color3.fromRGB(c[1], c[2], c[3]), {}, function()
			look[key] = i
			sendLook()
		end)
	end
end
swatches(384, "Paint", mainSwatches, "main")
swatches(432, "Trim", accentSwatches, "accent")

function GarageUI.refresh()
	for id, card in cardButtons do
		UI.highlight(card, id == chosenKart)
	end
	for id, b in bodyButtons do
		UI.highlight(b, id == look.body)
	end
	for i, b in mainSwatches do
		UI.highlight(b, i == look.main)
	end
	for i, b in accentSwatches do
		UI.highlight(b, i == look.accent)
	end
end
GarageUI.refresh()

function GarageUI.open()
	panel.Visible = true
	UI.pop(panel)
end

function GarageUI.close()
	panel.Visible = false
end

function GarageUI.toggle()
	if panel.Visible then
		GarageUI.close()
	else
		GarageUI.open()
	end
end

return GarageUI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">Hud</string>
            <string name="Source"><![CDATA[-- In-race screens: place, lap, item slot with roulette, standings, countdown,
-- warnings, speed, touch buttons, and the results screen after each race.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Items = require(Shared:WaitForChild("Items"))

local UI = require(script.Parent.UI)

local Hud = {}

local PLACE_COLORS = { Color3.fromRGB(255, 210, 60), Color3.fromRGB(210, 220, 235), Color3.fromRGB(240, 150, 80) }

local race = Instance.new("Frame")
race.Name = "Race"
race.BackgroundTransparency = 1
race.Size = UDim2.fromScale(1, 1)
race.Visible = false
race.Parent = UI.Screen

local placeLabel = UI.label(race, { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -24, 1, -20), Size = UDim2.new(0, 210, 0, 110), Text = "" })
local lapPanel = UI.panel(race, { Position = UDim2.new(0, 16, 0, 14), Size = UDim2.new(0, 220, 0, 74) })
local lapLabel = UI.label(lapPanel, { Position = UDim2.new(0, 12, 0, 6), Size = UDim2.new(1, -24, 0, 40), Text = "", TextXAlignment = Enum.TextXAlignment.Left })
local trackLabel = UI.label(lapPanel, { Position = UDim2.new(0, 12, 0, 46), Size = UDim2.new(1, -24, 0, 20), Text = "", TextColor3 = UI.Colors.muted, TextXAlignment = Enum.TextXAlignment.Left })

local itemSlot = UI.panel(race, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 12), Size = UDim2.new(0, 230, 0, 92) })
local itemIcon = UI.label(itemSlot, { Position = UDim2.new(0, 10, 0, 8), Size = UDim2.new(0, 64, 0, 64), Text = "" })
local itemLabel = UI.label(itemSlot, { Position = UDim2.new(0, 80, 0, 10), Size = UDim2.new(1, -90, 0, 36), Text = "", TextXAlignment = Enum.TextXAlignment.Left })
local itemHint = UI.label(itemSlot, { Position = UDim2.new(0, 80, 0, 50), Size = UDim2.new(1, -90, 0, 30), Text = "", TextColor3 = UI.Colors.muted, TextXAlignment = Enum.TextXAlignment.Left })

local standings = UI.panel(race, { Position = UDim2.new(0, 16, 0, 98), Size = UDim2.new(0, 200, 0, 8 * 24 + 16) })
local standingRows: { TextLabel } = {}
for i = 1, 8 do
	standingRows[i] = UI.label(standings, {
		Position = UDim2.new(0, 12, 0, 8 + (i - 1) * 24),
		Size = UDim2.new(1, -24, 0, 22),
		TextScaled = false,
		TextSize = 17,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = "",
	})
end
local bigText = UI.label(race, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.36), Size = UDim2.new(0, 520, 0, 130), Text = "", TextColor3 = UI.Colors.yellow, TextStrokeTransparency = 0.2 })
local speedLabel = UI.label(race, { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -24, 1, -132), Size = UDim2.new(0, 210, 0, 32), Text = "" })
local warnLabel = UI.label(race, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 112), Size = UDim2.new(0, 420, 0, 42), Text = "", TextColor3 = UI.Colors.red, TextStrokeTransparency = 0.3 })
local timeoutLabel = UI.label(race, { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -24), Size = UDim2.new(0, 420, 0, 30), Text = "", TextColor3 = UI.Colors.yellow })

local raceInfo: any = nil
local raceState: any = nil
local item: { id: string?, uses: number, readyAt: number } = { id = nil, uses = 0, readyAt = 0 }
local flashUntil, flashText = 0, ""
local warnUntil, warnText = 0, ""

function Hud.raceStarted(info: any)
	raceInfo = info
	raceState = nil
	item = { id = nil, uses = 0, readyAt = 0 }
	race.Visible = true
	trackLabel.Text = info.trackName or ""
	lapLabel.Text = `LAP 1/{info.laps or 3}`
end

function Hud.raceEnded()
	race.Visible = false
	raceInfo = nil
end

function Hud.isRacing(): boolean
	return raceInfo ~= nil
end

function Hud.setRaceState(s: any)
	raceState = s
	lapLabel.Text = if s.finishTime then `🏁 {UI.time(s.finishTime)}` else `LAP {s.lap}/{s.laps}`
	placeLabel.Text = UI.ordinal(s.place)
	placeLabel.TextColor3 = PLACE_COLORS[s.place] or UI.Colors.text
	for i, row in standingRows do
		local r = s.rows[i]
		row.Text = if r then `{i}. {r.name}{if r.finished then "  🏁" else ""}` else ""
		row.TextColor3 = if r and not r.isCpu then UI.Colors.yellow else UI.Colors.text
	end
end

function Hud.setItem(id: string?, uses: number, readyAt: number)
	item = { id = id, uses = uses, readyAt = readyAt }
end

function Hud.flash(message: string, seconds: number?)
	flashText = message
	flashUntil = os.clock() + (seconds or 1.5)
end

function Hud.warn(message: string, seconds: number?)
	warnText = message
	warnUntil = os.clock() + (seconds or 1.5)
end

function Hud.setKart(info: any)
	if info.countdown and info.countdown > 0 then
		local n = math.ceil(info.countdown)
		bigText.Text = if n <= 3 then tostring(n) else "GET READY"
	elseif os.clock() < flashUntil then
		bigText.Text = flashText
	else
		bigText.Text = ""
	end
	speedLabel.Text = `{math.floor(math.abs(info.speed or 0) * 0.6 + 0.5)} km/h`
	if os.clock() < warnUntil then
		warnLabel.Text = warnText
	else
		warnLabel.Text = if info.wrongWay then "WRONG WAY!" elseif info.drafting then "💨 SLIPSTREAM" else ""
		warnLabel.TextColor3 = if info.wrongWay then UI.Colors.red else UI.Colors.blue
	end
end

function Hud.update()
	if not raceInfo then
		return
	end
	local t = Workspace:GetServerTimeNow()
	if raceInfo.goTime and t >= raceInfo.goTime and t < raceInfo.goTime + 1 and os.clock() >= flashUntil then
		bigText.Text = "GO!"
	end
	if raceState and raceState.endAt and not raceState.finishTime then
		timeoutLabel.Text = `⏱ Race ends in {math.max(0, math.ceil(raceState.endAt - t))}s`
	else
		timeoutLabel.Text = ""
	end
	if item.id then
		local def = Items.Defs[item.id]
		if t < item.readyAt then
			-- Roulette: flick through items until it lands.
			local i = math.floor(t * 14) % #Items.Order + 1
			local spin = Items.Defs[Items.Order[i]]
			itemIcon.Text = spin.icon or "?"
			itemLabel.Text = spin.name
			itemHint.Text = ""
		else
			itemIcon.Text = def.icon or "?"
			itemLabel.Text = if item.uses > 1 then `{def.name} x{item.uses}` else def.name
			itemHint.Text = "E / X / ITEM · hold S to aim back"
		end
	else
		itemIcon.Text = "❔"
		itemLabel.Text = "No item"
		itemHint.Text = "Drive through a ? box"
	end
end

---------------------------------------------------------------------------
-- Results
---------------------------------------------------------------------------
local results = UI.panel(UI.Screen, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0, 480, 0, 430), Visible = false })
local resultsTitle = UI.label(results, { Position = UDim2.new(0, 20, 0, 12), Size = UDim2.new(1, -40, 0, 40), TextColor3 = UI.Colors.yellow, Text = "" })
local resultsBody = UI.label(results, {
	Position = UDim2.new(0, 24, 0, 62),
	Size = UDim2.new(1, -48, 1, -130),
	TextScaled = false,
	TextSize = 19,
	TextXAlignment = Enum.TextXAlignment.Left,
	TextYAlignment = Enum.TextYAlignment.Top,
	RichText = true,
	Text = "",
})
UI.button(results, "OK", UI.Colors.green, { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -14), Size = UDim2.new(0, 160, 0, 50) }, function()
	results.Visible = false
end)

function Hud.showResults(info: any)
	Hud.raceEnded()
	resultsTitle.Text = `🏁 {info.trackName}`
	local lines = {}
	for _, r in info.rows do
		local name = if r.isCpu then r.name else `<font color="#FFD23C">{r.name}</font>`
		local medal = ({ "🥇", "🥈", "🥉" })[r.place] or `{r.place}.`
		table.insert(lines, `{medal}  {name}   {if r.finished then UI.time(r.time) else "DNF"}`)
	end
	for _, line in info.extra or {} do
		table.insert(lines, line)
	end
	resultsBody.Text = table.concat(lines, "\n")
	results.Visible = true
	UI.pop(results)
	task.delay(10, function()
		results.Visible = false
	end)
end

---------------------------------------------------------------------------
-- Touch buttons
---------------------------------------------------------------------------
-- Touch controls live in their own layer so they also work on the practice loop.
local touch = Instance.new("Frame")
touch.Name = "Touch"
touch.BackgroundTransparency = 1
touch.Size = UDim2.fromScale(1, 1)
touch.Visible = false
touch.Parent = UI.Screen

function Hud.setDriving(on: boolean)
	touch.Visible = on
end

function Hud.addTouchButtons(onDrift: (boolean) -> (), onItem: () -> (), onReset: () -> ())
	local drift = UI.button(touch, "DRIFT", UI.Colors.pink, { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -24, 1, -176), Size = UDim2.new(0, 120, 0, 90) })
	drift.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch then
			onDrift(true)
		end
	end)
	drift.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch then
			onDrift(false)
		end
	end)
	UI.button(touch, "ITEM", UI.Colors.blue, { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -154, 1, -176), Size = UDim2.new(0, 100, 0, 90) }, onItem)
	UI.button(touch, "↺", UI.Colors.panelLight, { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -264, 1, -196), Size = UDim2.new(0, 60, 0, 60) }, onReset)
end

return Hud
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">KartController</string>
            <string name="Source"><![CDATA[-- Drives your kart: reads input, runs KartPhysics on this client (you own the
-- kart's physics), handles drift / items / rocket starts, and runs the chase
-- camera.
--
-- Two modes: "race" (server tracks laps, respawns and items) and "practice"
-- (the lobby loop; nothing is scored and resets happen here on the client).
--
-- Controls: W/S or stick to drive, A/D steer, Space or Shift to drift,
-- E to use your item (hold S to aim it behind you), R to reset a stuck kart.
-- Gamepad: R2/L2 gas and brake, R1 drift, X item, Y reset.

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local KartPhysics = require(Shared:WaitForChild("KartPhysics"))
local Karts = require(Shared:WaitForChild("Karts"))
local RaceRules = require(Shared:WaitForChild("RaceRules"))
local Track = require(Shared:WaitForChild("Track"))
local Tracks = require(Shared:WaitForChild("Tracks"))
local KartRig = require(ReplicatedStorage:WaitForChild("Common"):WaitForChild("KartRig"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local KartVisuals = require(script.Parent.KartVisuals)

local KartController = {}

local STUCK_SECONDS = 4 -- pressing the gas but not moving this long resets the kart

local player = Players.LocalPlayer
local camera = Workspace.CurrentCamera
local controls = require(player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule")):GetControls()

type Session = {
	mode: string, -- "race" | "practice"
	kart: Model,
	track: Track.Built,
	stats: Karts.KartStats,
	state: KartPhysics.State,
	goTime: number,
	hint: number?,
	throttleDownAt: number?,
	started: boolean,
	camYaw: number,
	camY: number,
	stuckFor: number,
}

local session: Session? = nil
local driftHeld = false
local driftPressed = false -- set on the frame drift goes down (tricks)
local gasHeld, brakeHeld = false, false
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

-- Hooks set by Main so the HUD can show speed, drift charge and warnings.
KartController.onUpdate = nil :: ((info: any) -> ())?
KartController.onTurbo = nil :: ((level: number) -> ())?
KartController.onWarning = nil :: ((text: string) -> ())?
KartController.onStopped = nil :: ((mode: string) -> ())?

local function refreshRayFilter()
	local ignore: { Instance } = {}
	for _, name in { "Karts", "Items", "PracticeKarts" } do
		local f = Workspace:FindFirstChild(name)
		if f then
			table.insert(ignore, f)
		end
	end
	for _, p in Players:GetPlayers() do
		if p.Character then
			table.insert(ignore, p.Character)
		end
	end
	rayParams.FilterDescendantsInstances = ignore
end

local function setRacingControls(racing: boolean)
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.JumpHeight = if racing then 0 else 7.2
		humanoid.JumpPower = if racing then 0 else 50
	end
	if racing then
		-- Bound above the default controls so Space drifts instead of jumping out.
		ContextActionService:BindActionAtPriority("KartDrift", function(_, inputState)
			driftHeld = inputState == Enum.UserInputState.Begin
			if driftHeld then
				driftPressed = true
			end
			return Enum.ContextActionResult.Sink
		end, false, Enum.ContextActionPriority.High.Value, Enum.KeyCode.Space, Enum.KeyCode.LeftShift, Enum.KeyCode.ButtonR1)
		ContextActionService:BindActionAtPriority("KartItem", function(_, inputState)
			if inputState == Enum.UserInputState.Begin then
				KartController.useItem()
			end
			return Enum.ContextActionResult.Sink
		end, false, Enum.ContextActionPriority.High.Value, Enum.KeyCode.E, Enum.KeyCode.ButtonX)
		ContextActionService:BindActionAtPriority("KartReset", function(_, inputState)
			if inputState == Enum.UserInputState.Begin then
				KartController.reset()
			end
			return Enum.ContextActionResult.Sink
		end, false, Enum.ContextActionPriority.High.Value, Enum.KeyCode.R, Enum.KeyCode.ButtonY)
		ContextActionService:BindActionAtPriority("KartPedals", function(action, inputState, input)
			local down = inputState ~= Enum.UserInputState.End
			if input.KeyCode == Enum.KeyCode.ButtonR2 then
				gasHeld = down
			else
				brakeHeld = down
			end
			return Enum.ContextActionResult.Sink
		end, false, Enum.ContextActionPriority.High.Value, Enum.KeyCode.ButtonR2, Enum.KeyCode.ButtonL2)
	else
		ContextActionService:UnbindAction("KartDrift")
		ContextActionService:UnbindAction("KartItem")
		ContextActionService:UnbindAction("KartPedals")
		ContextActionService:UnbindAction("KartReset")
		driftHeld, gasHeld, brakeHeld = false, false, false
	end
end

-- Touch buttons call these.
function KartController.setDrift(on: boolean)
	if on and not driftHeld then
		driftPressed = true
	end
	driftHeld = on
end
local readInput: () -> (number, number)

function KartController.useItem()
	local s = session
	if not s or s.mode ~= "race" then
		return
	end
	-- Holding brake/back while using an item throws or drops it behind you.
	local throttle = readInput()
	Remotes.UseItem:FireServer(throttle < -0.3)
end

function KartController.isRacing(): boolean
	return session ~= nil and session.mode == "race"
end

function KartController.mode(): string?
	return session and session.mode
end

-- Puts the kart back on the road. In races the server does it (with a short
-- cooldown); on the practice loop the client does it directly.
function KartController.reset()
	local s = session
	if not s or not s.kart.PrimaryPart then
		return
	end
	if s.mode == "race" then
		Remotes.Respawn:FireServer()
		return
	end
	local root = s.kart.PrimaryPart
	local proj = Track.project(s.track, Track.v(root.Position.X, root.Position.Y, root.Position.Z))
	local pos = Track.spot(s.track, proj.distance, 0)
	local _, tan = Track.at(s.track, proj.distance)
	local yaw = math.atan2(-tan.x, -tan.z)
	KartRig.place(s.kart, CFrame.new(pos.x, pos.y, pos.z) * CFrame.Angles(0, yaw, 0))
	s.state.speed = 0
	s.state.yaw = yaw
	s.state.drift = 0
	s.state.charge = 0
	s.camYaw = yaw
	s.hint = nil
end

local function stop()
	local mode = session and session.mode
	session = nil
	KartVisuals.setOwn(nil, 0, 0)
	setRacingControls(false)
	camera.CameraType = Enum.CameraType.Custom
	camera.FieldOfView = 70
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		camera.CameraSubject = humanoid
	end
	if mode and KartController.onStopped then
		KartController.onStopped(mode)
	end
end

-- Stops driving without touching the camera (used when a racer finishes and
-- switches to spectating while the server drives their kart home).
function KartController.handOff()
	if session then
		session = nil
		KartVisuals.setOwn(nil, 0, 0)
		setRacingControls(false)
		camera.FieldOfView = 70
	end
end

local function begin(info: any, mode: string)
	local kart: Model = info.kart
	local deadline = os.clock() + 10
	while (not kart or not kart.PrimaryPart) and os.clock() < deadline do
		task.wait()
	end
	if not kart or not kart.PrimaryPart then
		warn("[KartController] kart never arrived")
		return
	end
	session = {
		mode = mode,
		kart = kart,
		track = Track.build(Tracks.get(info.trackId)),
		stats = Karts.get(info.kartId).stats,
		state = KartPhysics.newState(info.yaw),
		goTime = info.goTime or (Workspace:GetServerTimeNow() - 1),
		hint = nil,
		throttleDownAt = nil,
		started = mode ~= "race",
		camYaw = info.yaw,
		camY = kart.PrimaryPart.Position.Y,
		stuckFor = 0,
	}
	refreshRayFilter()
	setRacingControls(true)
	camera.CameraType = Enum.CameraType.Scriptable
end

function readInput(): (number, number)
	local move = controls:GetMoveVector()
	local steer = math.clamp(move.X, -1, 1)
	local throttle = math.clamp(-move.Z, -1, 1)
	if gasHeld then
		throttle = 1
	elseif brakeHeld then
		throttle = -1
	end
	return throttle, steer
end

local function updateCamera(s: Session, dt: number)
	local root = s.kart.PrimaryPart
	if not root then
		return
	end
	-- The camera follows travel direction, so drifts show the kart sliding.
	local diff = (s.state.yaw - s.camYaw + math.pi) % (2 * math.pi) - math.pi
	s.camYaw += diff * math.min(1, dt * 6)
	local fx, fz = KartPhysics.forward(s.camYaw)
	local forward = Vector3.new(fx, 0, fz)
	-- Height follows more lazily in the air, so jumps feel big and the view stays steady.
	local airborne = s.state.air > 0.1
	s.camY += (root.Position.Y - s.camY) * math.min(1, dt * (if airborne then 2.5 else 8))
	local base = Vector3.new(root.Position.X, s.camY, root.Position.Z)
	local target = base + Vector3.new(0, 6.5, 0) - forward * 17
	local look = base + forward * 10 + Vector3.new(0, 2, 0)
	camera.CFrame = camera.CFrame:Lerp(CFrame.lookAt(target, look), math.min(1, dt * 10))
	local fov = if s.state.boost > 0 then 84 else 70
	camera.FieldOfView += (fov - camera.FieldOfView) * math.min(1, dt * 5)
end

local function step(dt: number)
	local s = session
	if not s then
		return
	end
	if not s.kart.Parent or not s.kart.PrimaryPart then
		stop()
		return
	end
	local root = s.kart.PrimaryPart :: BasePart
	local t = Workspace:GetServerTimeNow()
	local throttle, steer = readInput()

	if t < s.goTime then
		-- Countdown: remember when the gas went down for the rocket start.
		if throttle > 0.5 then
			s.throttleDownAt = s.throttleDownAt or (t - s.goTime)
		else
			s.throttleDownAt = nil
		end
		if KartController.onUpdate then
			KartController.onUpdate({ speed = 0, drift = 0, wrongWay = false, countdown = s.goTime - t })
		end
		return
	end
	if not s.started then
		s.started = true
		local boost = RaceRules.startBoost(s.throttleDownAt)
		if boost > 0 then
			KartPhysics.giveBoost(s.state, boost)
			if KartController.onTurbo then
				KartController.onTurbo(0)
			end
		end
	end
	if root.Anchored then
		return
	end
	-- Off the edge of the practice area: put the kart back.
	if s.mode == "practice" and root.Position.Y < -25 then
		KartController.reset()
		return
	end

	local sensed = KartRig.sense(s.kart, rayParams)
	local pos = Track.v(root.Position.X, root.Position.Y, root.Position.Z)
	local proj = Track.project(s.track, pos, s.hint)
	s.hint = proj.index
	local surface = Track.surfaceAt(s.track, proj, pos, t)
	if s.mode == "practice" and (surface == "offroad" or surface == "wall") then
		surface = "road" -- the practice area is open tarmac
	end

	-- Slipstream: tucked in behind any other kart?
	local others = {}
	local folder = Workspace:FindFirstChild(if s.mode == "race" then "Karts" else "PracticeKarts")
	if folder then
		for _, other in folder:GetChildren() do
			local p = other:IsA("Model") and other ~= s.kart and other.PrimaryPart
			if p then
				table.insert(others, { x = p.Position.X, z = p.Position.Z })
			end
		end
	end
	local drafting = KartPhysics.isDrafting(root.Position.X, root.Position.Z, s.state.yaw, others)

	local _, released = KartPhysics.step(s.stats, s.state, {
		throttle = throttle,
		steer = steer,
		drift = driftHeld,
		grounded = sensed.grounded,
		surface = if surface == "wall" then "offroad" else surface,
		trick = driftPressed,
		drafting = drafting,
	}, dt)
	driftPressed = false
	KartVisuals.setOwn(s.kart, steer, KartPhysics.trickRoll(s.state))

	-- Stuck against something with the gas held down? Put the kart back.
	if throttle > 0.5 and math.abs(s.state.speed) < 4 and s.state.spin <= 0 then
		s.stuckFor += dt
		if s.stuckFor > STUCK_SECONDS then
			s.stuckFor = 0
			KartController.reset()
		end
	else
		s.stuckFor = 0
	end
	KartRig.sync(s.kart, s.state)
	KartRig.apply(s.kart, s.state, sensed)
	local level = if s.state.drift ~= 0 then KartPhysics.chargeLevel(s.state.charge) else 0
	KartRig.setEffects(s.kart, level, s.state.boost > 0)
	if released > 0 and KartController.onTurbo then
		KartController.onTurbo(released)
	end

	if KartController.onUpdate then
		local fx, fz = KartPhysics.forward(s.state.yaw)
		KartController.onUpdate({
			speed = s.state.speed,
			drift = level,
			boosting = s.state.boost > 0,
			invincible = s.state.invincible > 0,
			drafting = drafting and s.state.draft > 0.2,
			wrongWay = s.mode == "race" and s.state.speed > 15 and Track.wrongWay(s.track, proj, fx, fz),
		})
	end
end

local function onKartEvent(kind: string, value: any)
	local s = session
	if not s then
		return
	end
	if kind == "warning" then
		if KartController.onWarning then
			KartController.onWarning(tostring(value))
		end
	elseif kind == "hit" or kind == "spin" then
		KartPhysics.hit(s.state)
	elseif kind == "slow" then
		KartPhysics.slow(s.state, 2)
	elseif kind == "launch" then
		KartPhysics.hit(s.state)
		local root = s.kart.PrimaryPart
		if root then
			root.AssemblyLinearVelocity += Vector3.new(0, 70, 0)
		end
	elseif kind == "boost" then
		KartPhysics.giveBoost(s.state, tonumber(value) or 1)
	elseif kind == "overdrive" then
		KartPhysics.overdrive(s.state, tonumber(value) or 6)
	elseif kind == "respawn" then
		s.state.speed = 0
		s.state.yaw = tonumber(value) or s.state.yaw
		s.state.drift = 0
		s.state.charge = 0
		s.camYaw = s.state.yaw
		s.hint = nil
	end
end

function KartController.start()
	driftPressed = false
	Remotes.RaceStart.OnClientEvent:Connect(function(info)
		task.spawn(begin, info, "race")
	end)
	Remotes.PracticeStart.OnClientEvent:Connect(function(info)
		task.spawn(begin, info, "practice")
	end)
	Remotes.KartEvent.OnClientEvent:Connect(onKartEvent)
	Remotes.Results.OnClientEvent:Connect(function()
		if session and session.mode == "race" then
			stop()
		end
	end)
	RunService.Heartbeat:Connect(function(dt)
		local ok, err = pcall(step, math.min(dt, 0.1))
		if not ok then
			warn("[KartController]", err)
		end
	end)
	-- Camera runs every rendered frame so it stays smooth.
	RunService:BindToRenderStep("KartCamera", Enum.RenderPriority.Camera.Value + 1, function(dt)
		if session and session.kart.PrimaryPart then
			updateCamera(session, dt)
		end
	end)
	player.CharacterAdded:Connect(function()
		if session then
			task.defer(refreshRayFilter)
		end
	end)
end

return KartController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">KartVisuals</string>
            <string name="Source"><![CDATA[-- Makes every nearby kart look alive, on this client only: the body leans into
-- turns, dips under braking, bounces on bumps and squashes on landing; front
-- wheels steer; all wheels spin; exhaust puffs harder when accelerating. Your
-- own kart also shows the trick barrel roll.
--
-- It only sets Motor6D.Transform, which is purely visual and never affects
-- the physics.

local Workspace = game:GetService("Workspace")

local KartVisuals = {}

type Anim = { spin: number, lastSpeed: number, lastVy: number, squash: number, lean: number, pitch: number, steer: number }
local anims: { [Model]: Anim } = setmetatable({}, { __mode = "k" }) :: any

local FOLDERS = { "Karts", "PracticeKarts" }
local RANGE = 260

-- Set by KartController for the local player's kart.
local ownKart: Model? = nil
local ownSteer = 0
local ownTrickRoll = 0

function KartVisuals.setOwn(kart: Model?, steer: number, trickRoll: number)
	ownKart = kart
	ownSteer = steer
	ownTrickRoll = trickRoll
end

local function approach(a: number, b: number, rate: number): number
	return a + (b - a) * math.min(1, rate)
end

local function animate(kart: Model, dt: number, t: number)
	local root = kart.PrimaryPart
	if not root then
		return
	end
	local anim = anims[kart]
	if not anim then
		anim = { spin = 0, lastSpeed = 0, lastVy = 0, squash = 0, lean = 0, pitch = 0, steer = 0 }
		anims[kart] = anim
	end
	local vel = root.AssemblyLinearVelocity
	local look = root.CFrame.LookVector
	local speed = vel.X * look.X + vel.Z * look.Z
	local yawRate = root.AssemblyAngularVelocity.Y
	local accel = (speed - anim.lastSpeed) / math.max(dt, 1e-3)

	-- Landing squash: falling fast last frame, stopped now.
	if anim.lastVy < -25 and vel.Y > -5 then
		anim.squash = math.clamp(-anim.lastVy / 120, 0.1, 0.5)
	end
	anim.squash = math.max(0, anim.squash - dt * 2.5)
	anim.lastSpeed = speed
	anim.lastVy = vel.Y

	local isOwn = kart == ownKart
	-- Positive yaw rate is a left turn. Lean into the turn (positive Z roll
	-- dips the left side), lift the nose when accelerating, dip it when braking.
	local leanTarget = math.clamp(yawRate * speed * 0.0035, -0.2, 0.2)
	local pitchTarget = math.clamp(accel * 0.0012, -0.09, 0.09)
	anim.lean = approach(anim.lean, leanTarget, dt * 8)
	anim.pitch = approach(anim.pitch, pitchTarget, dt * 6)
	-- Steer is "right = positive", matching player input.
	local steerTarget = if isOwn then ownSteer * 0.45 else math.clamp(-yawRate * 0.25, -0.45, 0.45)
	anim.steer = approach(anim.steer, steerTarget, dt * 12)

	local speedFrac = math.clamp(math.abs(speed) / 100, 0, 1)
	local bob = math.sin(t * 21 + root.Position.X) * 0.035 * speedFrac - anim.squash * 0.5
	local trick = if isOwn then ownTrickRoll else 0

	local bodyJoint = root:FindFirstChild("BodyJoint") :: Motor6D?
	if bodyJoint then
		bodyJoint.Transform = CFrame.new(0, bob, 0) * CFrame.Angles(anim.pitch, 0, anim.lean + trick)
	end

	local radius = kart:GetAttribute("WheelRadius") or 0.8
	anim.spin = (anim.spin + speed / radius * dt) % (math.pi * 2)
	for _, joint in root:GetChildren() do
		if joint:IsA("Motor6D") and joint.Name == "WheelJoint" then
			local steer = if joint:GetAttribute("Front") then anim.steer else 0
			-- Rolling forward (-z) turns the wheel's top toward the front.
			joint.Transform = CFrame.Angles(0, -steer, 0) * CFrame.Angles(-anim.spin, 0, 0)
		end
	end

	local exhaust = kart:FindFirstChild("Exhaust")
	local puff = exhaust and exhaust:FindFirstChild("ExhaustPuff") :: ParticleEmitter?
	if puff then
		puff.Rate = if accel > 5 then 22 elseif math.abs(speed) > 5 then 8 else 4
	end
end

function KartVisuals.step(dt: number)
	local t = os.clock()
	local camera = Workspace.CurrentCamera
	local camPos = camera and camera.CFrame.Position or Vector3.zero
	for _, name in FOLDERS do
		local folder = Workspace:FindFirstChild(name)
		if folder then
			for _, kart in folder:GetChildren() do
				if kart:IsA("Model") and kart.PrimaryPart and (kart.PrimaryPart.Position - camPos).Magnitude < RANGE then
					animate(kart, dt, t)
				end
			end
		end
	end
end

return KartVisuals
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">LobbyUI</string>
            <string name="Source"><![CDATA[-- Lobby screens: the status bar (phase + countdown, always visible), the
-- READY button, GARAGE and WATCH buttons, the map voting cards, the practice
-- "leave kart" button and spectator controls.

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local UI = require(script.Parent.UI)

local LobbyUI = {}

LobbyUI.onReady = nil :: ((boolean) -> ())?
LobbyUI.onVote = nil :: ((string) -> ())?
LobbyUI.onGarage = nil :: (() -> ())?
LobbyUI.onWatch = nil :: (() -> ())?
LobbyUI.onLeavePractice = nil :: (() -> ())?
LobbyUI.onSpectateNext = nil :: ((number) -> ())?
LobbyUI.onStopSpectating = nil :: (() -> ())?

local me = Players.LocalPlayer
local state: any = nil
local hidden = false -- hidden while racing

local root = Instance.new("Frame")
root.Name = "Lobby"
root.BackgroundTransparency = 1
root.Size = UDim2.fromScale(1, 1)
root.Parent = UI.Screen

-- Status bar ---------------------------------------------------------------
local status = UI.panel(root, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 10), Size = UDim2.new(0, 460, 0, 70) })
local statusTitle = UI.label(status, { Position = UDim2.new(0, 14, 0, 4), Size = UDim2.new(1, -28, 0, 36), Text = "KART CARNIVAL", TextColor3 = UI.Colors.yellow })
local statusSub = UI.label(status, { Position = UDim2.new(0, 14, 0, 40), Size = UDim2.new(1, -28, 0, 24), Text = "", TextColor3 = UI.Colors.muted })

-- Bottom buttons -------------------------------------------------------------
local isReady = false
local readyButton = UI.button(root, "READY UP", UI.Colors.green, { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -18), Size = UDim2.new(0, 260, 0, 66) }, function()
	if LobbyUI.onReady then
		LobbyUI.onReady(not isReady)
	end
end)
local garageButton = UI.button(root, "🔧 GARAGE", UI.Colors.blue, { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 18, 1, -18), Size = UDim2.new(0, 170, 0, 58) }, function()
	if LobbyUI.onGarage then
		LobbyUI.onGarage()
	end
end)
local watchButton = UI.button(root, "📺 WATCH", UI.Colors.purple, { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -18, 1, -18), Size = UDim2.new(0, 170, 0, 58), Visible = false }, function()
	if LobbyUI.onWatch then
		LobbyUI.onWatch()
	end
end)
local leaveButton = UI.button(root, "🚪 LEAVE KART", UI.Colors.red, { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -92), Size = UDim2.new(0, 220, 0, 52), Visible = false }, function()
	if LobbyUI.onLeavePractice then
		LobbyUI.onLeavePractice()
	end
end)

-- Voting cards ---------------------------------------------------------------
local votePanel = UI.panel(root, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 90), Size = UDim2.new(0, 720, 0, 300), Visible = false })
local voteTitle = UI.label(votePanel, { Position = UDim2.new(0, 16, 0, 8), Size = UDim2.new(1, -32, 0, 34), Text = "VOTE FOR A TRACK", TextColor3 = UI.Colors.yellow })
local cardHolder = Instance.new("Frame")
cardHolder.BackgroundTransparency = 1
cardHolder.Position = UDim2.new(0, 14, 0, 50)
cardHolder.Size = UDim2.new(1, -28, 1, -62)
cardHolder.Parent = votePanel
UI.list(cardHolder, true, 12)

local THEME_COLORS = {
	sunny = Color3.fromRGB(90, 170, 80),
	canyon = Color3.fromRGB(200, 120, 70),
	neon = Color3.fromRGB(120, 60, 200),
	toyroom = Color3.fromRGB(70, 80, 170),
	kitchen = Color3.fromRGB(230, 140, 90),
	backyard = Color3.fromRGB(100, 170, 70),
	carnival = Color3.fromRGB(240, 90, 140),
}
local DIFFICULTY_COLORS = { Easy = UI.Colors.green, Medium = UI.Colors.yellow, Hard = UI.Colors.red }

type Card = { button: TextButton, icon: TextLabel, name: TextLabel, chip: TextLabel, feature: TextLabel, votes: TextLabel, faces: Frame, id: string? }
local cards: { Card } = {}
for i = 1, 3 do
	local card: Card = {} :: any
	card.button = UI.button(cardHolder, "", UI.Colors.panelLight, { Size = UDim2.new(1 / 3, -8, 1, 0), LayoutOrder = i }, function()
		if card.id and LobbyUI.onVote then
			LobbyUI.onVote(card.id)
		end
	end)
	card.icon = UI.label(card.button, { Size = UDim2.new(1, 0, 0, 56), Text = "" })
	card.name = UI.label(card.button, { Position = UDim2.new(0, 0, 0, 58), Size = UDim2.new(1, 0, 0, 28), Text = "" })
	card.chip = UI.label(card.button, { Position = UDim2.new(0.25, 0, 0, 90), Size = UDim2.new(0.5, 0, 0, 22), Text = "", BackgroundTransparency = 0, TextColor3 = Color3.fromRGB(30, 30, 40), TextStrokeTransparency = 1 })
	local chipCorner = Instance.new("UICorner")
	chipCorner.CornerRadius = UDim.new(1, 0)
	chipCorner.Parent = card.chip
	card.feature = UI.label(card.button, { Position = UDim2.new(0, 0, 0, 116), Size = UDim2.new(1, 0, 0, 40), TextScaled = false, TextSize = 15, Text = "", TextColor3 = UI.Colors.muted })
	card.votes = UI.label(card.button, { Position = UDim2.new(0, 0, 1, -66), Size = UDim2.new(1, 0, 0, 26), Text = "" })
	card.faces = Instance.new("Frame")
	card.faces.BackgroundTransparency = 1
	card.faces.Position = UDim2.new(0, 0, 1, -36)
	card.faces.Size = UDim2.new(1, 0, 0, 30)
	card.faces.Parent = card.button
	UI.list(card.faces, true, 4, true)
	cards[i] = card
end

-- Spectator controls ---------------------------------------------------------
local spectateBar = UI.panel(root, { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -18), Size = UDim2.new(0, 460, 0, 70), Visible = false })
local spectateLabel = UI.label(spectateBar, { Position = UDim2.new(0, 80, 0, 10), Size = UDim2.new(1, -240, 0, 50), Text = "" })
UI.button(spectateBar, "◀", UI.Colors.panelLight, { Position = UDim2.new(0, 10, 0, 10), Size = UDim2.new(0, 60, 0, 50) }, function()
	if LobbyUI.onSpectateNext then
		LobbyUI.onSpectateNext(-1)
	end
end)
UI.button(spectateBar, "▶", UI.Colors.panelLight, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -150, 0, 10), Size = UDim2.new(0, 60, 0, 50) }, function()
	if LobbyUI.onSpectateNext then
		LobbyUI.onSpectateNext(1)
	end
end)
UI.button(spectateBar, "EXIT", UI.Colors.red, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 10), Size = UDim2.new(0, 130, 0, 50) }, function()
	if LobbyUI.onStopSpectating then
		LobbyUI.onStopSpectating()
	end
end)

-- Toasts (short messages while in the lobby) ---------------------------------
local toastHolder = Instance.new("Frame")
toastHolder.BackgroundTransparency = 1
toastHolder.AnchorPoint = Vector2.new(0.5, 0)
toastHolder.Position = UDim2.new(0.5, 0, 0, 90)
toastHolder.Size = UDim2.new(0, 420, 0, 200)
toastHolder.Parent = UI.Screen
UI.list(toastHolder, false, 6, true)

function LobbyUI.toast(text: string)
	local t = UI.panel(toastHolder, { Size = UDim2.new(1, 0, 0, 44) })
	UI.label(t, { Position = UDim2.new(0, 12, 0, 6), Size = UDim2.new(1, -24, 1, -12), Text = text })
	UI.pop(t)
	task.delay(3.5, function()
		t:Destroy()
	end)
end

---------------------------------------------------------------------------
-- Updates
---------------------------------------------------------------------------
local practicing = false
local spectating = false

function LobbyUI.setPracticing(on: boolean)
	practicing = on
	LobbyUI.refresh()
end

function LobbyUI.setSpectating(on: boolean, name: string?)
	spectating = on
	spectateLabel.Text = if name then `Watching {name}` else ""
	LobbyUI.refresh()
end

function LobbyUI.setHidden(on: boolean)
	hidden = on
	LobbyUI.refresh()
end

local function myEntry(): any?
	if not state then
		return nil
	end
	for _, p in state.players do
		if p.userId == me.UserId then
			return p
		end
	end
	return nil
end

function LobbyUI.setState(s: any)
	state = s
	local mine = myEntry()
	isReady = mine ~= nil and mine.ready
	LobbyUI.refresh()
end

function LobbyUI.refresh()
	local s = state
	local mine = myEntry()
	local racing = mine and mine.racing
	root.Visible = not hidden
	if not s then
		return
	end

	readyButton.Visible = not racing and not spectating and s.phase ~= "results"
	readyButton.Text = if isReady then "✓ READY (tap to cancel)" else "READY UP"
	readyButton.BackgroundColor3 = if isReady then UI.Colors.yellow else UI.Colors.green
	readyButton.TextColor3 = if isReady then Color3.fromRGB(40, 40, 50) else UI.Colors.text
	garageButton.Visible = not spectating
	watchButton.Visible = s.phase == "racing" and s.spectate ~= nil and not racing and not spectating
	leaveButton.Visible = practicing and not spectating
	spectateBar.Visible = spectating

	local voting = s.phase == "voting" and mine ~= nil and mine.voter
	votePanel.Visible = voting
	if voting then
		local myVote = nil
		for _, opt in s.options do
			if table.find(opt.voters, me.UserId) then
				myVote = opt.id
			end
		end
		for i, card in cards do
			local opt = s.options[i]
			card.button.Visible = opt ~= nil
			if opt then
				card.id = opt.id
				card.button.BackgroundColor3 = (THEME_COLORS[opt.theme] or UI.Colors.panelLight):Lerp(Color3.new(0, 0, 0), 0.35)
				card.icon.Text = opt.icon
				card.name.Text = opt.name
				card.chip.Text = opt.difficulty
				card.chip.BackgroundColor3 = DIFFICULTY_COLORS[opt.difficulty] or UI.Colors.muted
				card.feature.Text = opt.feature
				card.votes.Text = `{opt.votes} vote{if opt.votes == 1 then "" else "s"}`
				UI.highlight(card.button, opt.id == myVote)
				for _, child in card.faces:GetChildren() do
					if child:IsA("ImageLabel") then
						child:Destroy()
					end
				end
				for n, userId in opt.voters do
					if n > 6 then
						break
					end
					local face = Instance.new("ImageLabel")
					face.Size = UDim2.new(0, 28, 0, 28)
					face.BackgroundColor3 = Color3.new(1, 1, 1)
					face.Image = UI.headshot(userId)
					local corner = Instance.new("UICorner")
					corner.CornerRadius = UDim.new(1, 0)
					corner.Parent = face
					face.Parent = card.faces
				end
			end
		end
	end
end

-- Called every frame for the countdowns.
function LobbyUI.update()
	local s = state
	if not s then
		return
	end
	local t = Workspace:GetServerTimeNow()
	local left = if s.deadline then math.max(0, math.ceil(s.deadline - t)) else nil
	local readyCount = 0
	for _, p in s.players do
		if p.ready then
			readyCount += 1
		end
	end
	if s.phase == "lobby" then
		if left then
			statusTitle.Text = `RACE STARTING · {left}s`
			statusSub.Text = `{readyCount} ready · voting opens soon`
		else
			statusTitle.Text = "KART CARNIVAL"
			statusSub.Text = "Ready up to race · practice loop is south of spawn"
		end
	elseif s.phase == "voting" then
		statusTitle.Text = `VOTING · {left or 0}s`
		statusSub.Text = if myEntry() and myEntry().voter then "Tap a card or stand on a pad" else "Ready up to vote and race"
		voteTitle.Text = `VOTE FOR A TRACK · {left or 0}s`
	elseif s.phase == "racing" then
		statusTitle.Text = "RACE IN PROGRESS"
		statusSub.Text = if s.spectate then `{s.spectate.trackName} · ready up for the next race` else ""
	elseif s.phase == "results" then
		statusTitle.Text = "RESULTS"
		statusSub.Text = `Next round in {left or 0}s`
	end
end

return LobbyUI
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="39">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- Client entry point: wires remotes to the lobby screens, garage, race HUD,
-- kart controller, spectator camera and lighting.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local Atmos = require(ReplicatedStorage:WaitForChild("Common"):WaitForChild("Atmos"))

local GarageUI = require(script.Parent.GarageUI)
local Hud = require(script.Parent.Hud)
local KartVisuals = require(script.Parent.KartVisuals)
local KartController = require(script.Parent.KartController)
local LobbyUI = require(script.Parent.LobbyUI)
local Spectate = require(script.Parent.Spectate)
local TrackAnimator = require(script.Parent.TrackAnimator)

local roundState: any = nil

Atmos.apply("carnival")
KartController.start()

local function namesOf(rows: { any }): { string }
	local names = {}
	for _, r in rows do
		table.insert(names, r.kart or r.name)
	end
	return names
end

local function stopSpectating()
	Spectate.stop()
	LobbyUI.setSpectating(false)
	if not KartController.isRacing() then
		Atmos.apply("carnival")
	end
end

local function startSpectating(rows: { any }, theme: string?)
	if theme then
		Atmos.apply(theme)
	end
	GarageUI.close()
	Spectate.start(namesOf(rows), function(name)
		LobbyUI.setSpectating(true, name)
	end)
end

-- Lobby ----------------------------------------------------------------------
LobbyUI.onReady = function(ready)
	Remotes.Ready:FireServer(ready)
end
LobbyUI.onVote = function(trackId)
	Remotes.Vote:FireServer(trackId)
end
LobbyUI.onGarage = GarageUI.toggle
LobbyUI.onWatch = function()
	if roundState and roundState.spectate then
		startSpectating(roundState.spectate.rows, roundState.spectate.theme)
	end
end
LobbyUI.onLeavePractice = function()
	Remotes.LeavePractice:FireServer()
end
LobbyUI.onSpectateNext = Spectate.cycle
LobbyUI.onStopSpectating = stopSpectating

GarageUI.onChooseKart = function(kartId)
	Remotes.ChooseKart:FireServer(kartId)
end
GarageUI.onLook = function(look)
	Remotes.ChooseLook:FireServer(look)
end

Remotes.Round.OnClientEvent:Connect(function(state)
	roundState = state
	LobbyUI.setState(state)
	if Spectate.isActive() and not KartController.isRacing() then
		if state.spectate then
			Spectate.setOrder(namesOf(state.spectate.rows))
		elseif state.phase ~= "racing" then
			stopSpectating()
		end
	end
end)
Remotes.OpenGarage.OnClientEvent:Connect(GarageUI.open)
Remotes.Spectate.OnClientEvent:Connect(LobbyUI.onWatch)

-- Racing ---------------------------------------------------------------------
Remotes.RaceStart.OnClientEvent:Connect(function(info)
	stopSpectating()
	GarageUI.close()
	LobbyUI.setHidden(true)
	Hud.raceStarted(info)
	Hud.setDriving(true)
	Atmos.apply(info.theme or "sunny")
end)
Remotes.PracticeStart.OnClientEvent:Connect(function()
	GarageUI.close()
	LobbyUI.setPracticing(true)
	Hud.setDriving(true)
	LobbyUI.toast("Practice! Drift, jump and boost. R resets the kart.")
end)
KartController.onStopped = function(mode)
	Hud.setDriving(false)
	if mode == "practice" then
		LobbyUI.setPracticing(false)
	end
end

Remotes.RaceState.OnClientEvent:Connect(function(s)
	Hud.setRaceState(s)
	-- Finished: the server drives your kart home while you watch the others.
	if s.finishTime and KartController.isRacing() then
		KartController.handOff()
		Hud.setDriving(false)
		startSpectating(s.rows)
	elseif Spectate.isActive() then
		Spectate.setOrder(namesOf(s.rows))
	end
end)
Remotes.ItemState.OnClientEvent:Connect(Hud.setItem)
Remotes.Results.OnClientEvent:Connect(function(info)
	stopSpectating()
	Hud.setDriving(false)
	Hud.showResults(info)
	LobbyUI.setHidden(false)
	Atmos.apply("carnival")
end)
Remotes.Notify.OnClientEvent:Connect(function(message)
	if Hud.isRacing() then
		Hud.flash(message, 1.6)
	else
		LobbyUI.toast(message)
	end
end)

KartController.onUpdate = Hud.setKart
KartController.onWarning = function(text)
	Hud.warn(text, 1.5)
end
KartController.onTurbo = function(level)
	local text = if level == 0 then "ROCKET START!"
		elseif level == 3 then "ULTRA TURBO!"
		elseif level == 2 then "SUPER TURBO!"
		elseif level == 10 then "TRICK!"
		elseif level == 11 then "SLIPSTREAM!"
		else "TURBO!"
	Hud.flash(text, 0.8)
end

if UserInputService.TouchEnabled then
	Hud.addTouchButtons(KartController.setDrift, KartController.useItem, KartController.reset)
end

-- Spinning things (Ferris wheel, golden tokens, item boxes) turn on each client.
local spinners: { Instance } = {}
local function track(inst: Instance)
	if inst:GetAttribute("Spin") then
		table.insert(spinners, inst)
	end
end
for _, d in Workspace:GetDescendants() do
	track(d)
end
Workspace.DescendantAdded:Connect(track)

RunService.RenderStepped:Connect(function(dt)
	LobbyUI.update()
	Hud.update()
	KartVisuals.step(dt)
	TrackAnimator.step()
	for i = #spinners, 1, -1 do
		local inst = spinners[i]
		if not inst.Parent then
			table.remove(spinners, i)
			continue
		end
		local rate = inst:GetAttribute("Spin") or 0
		if inst:IsA("Model") then
			inst:PivotTo(inst:GetPivot() * CFrame.Angles(rate * dt, 0, 0))
		elseif inst:IsA("BasePart") then
			inst.CFrame *= CFrame.Angles(0, rate * dt, 0)
		end
	end
	local items = Workspace:FindFirstChild("Items")
	if items then
		for _, box in items:GetChildren() do
			if box:GetAttribute("ItemBox") and box:IsA("BasePart") then
				box.CFrame *= CFrame.Angles(0, dt * 2, 0)
			end
		end
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">Spectate</string>
            <string name="Source"><![CDATA[-- Spectator camera: follows a racer's kart from behind. Used by lobby players
-- watching a race and by racers who have already finished.

local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Spectate = {}

local camera = Workspace.CurrentCamera
local active = false
local order: { string } = {} -- kart (driver) names in race order
local index = 1
local onTargetChanged: ((string?) -> ())? = nil

local function karts(): Instance?
	return Workspace:FindFirstChild("Karts")
end

local function target(): Model?
	local folder = karts()
	if not folder or #order == 0 then
		return nil
	end
	index = (index - 1) % #order + 1
	local m = folder:FindFirstChild(order[index])
	return if m and m:IsA("Model") then m else nil
end

function Spectate.isActive(): boolean
	return active
end

-- `names` is the race order (leader first).
function Spectate.setOrder(names: { string })
	local current = order[index]
	order = names
	local found = table.find(order, current)
	index = found or 1
end

function Spectate.start(names: { string }?, changed: ((string?) -> ())?)
	active = true
	onTargetChanged = changed
	if names then
		order = names
		index = 1
	end
	camera.CameraType = Enum.CameraType.Scriptable
	if onTargetChanged then
		onTargetChanged(order[index])
	end
end

function Spectate.cycle(step: number)
	if #order == 0 then
		return
	end
	index = (index - 1 + step) % #order + 1
	if onTargetChanged then
		onTargetChanged(order[index])
	end
end

function Spectate.stop()
	if not active then
		return
	end
	active = false
	camera.CameraType = Enum.CameraType.Custom
	local character = game:GetService("Players").LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		camera.CameraSubject = humanoid
	end
end

RunService:BindToRenderStep("SpectateCamera", Enum.RenderPriority.Camera.Value + 2, function(dt)
	if not active then
		return
	end
	local m = target()
	local root = m and m.PrimaryPart
	if not root then
		return
	end
	local look = root.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	if flat.Magnitude < 0.1 then
		flat = Vector3.zAxis
	end
	flat = flat.Unit
	local goal = CFrame.lookAt(root.Position - flat * 20 + Vector3.new(0, 8, 0), root.Position + flat * 8)
	camera.CFrame = camera.CFrame:Lerp(goal, math.min(1, dt * 6))
end)

return Spectate
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">TrackAnimator</string>
            <string name="Source"><![CDATA[-- Animates the current track on this client: crossers (toy robot, toy train,
-- beetles) walk across the road, sprinklers spray while their wet zone is
-- on, and wet patches only show while they are slippery. Everything is
-- computed from the shared server clock (Track.crosserAt / Track.zoneActive),
-- so what you see matches what the server uses for hits.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Track = require(Shared:WaitForChild("Track"))
local Tracks = require(Shared:WaitForChild("Tracks"))

local TrackAnimator = {}

local current: { folder: Instance, track: Track.Built, sprinklers: { { emitter: ParticleEmitter, zone: any } }, patches: { { part: BasePart, zone: any } } }? = nil

local function setup(folder: Instance)
	local id = folder:GetAttribute("TrackId")
	if type(id) ~= "string" then
		return nil
	end
	local ok, def = pcall(Tracks.get, id)
	if not ok then
		return nil
	end
	local track = Track.build(def)

	-- Pair each sprinkler with the nearest slippery zone.
	local zones = {}
	for _, z in def.zones or {} do
		if z.kind == "slippery" then
			local p = Track.spot(track, z.t * track.length, 0)
			table.insert(zones, { zone = z, pos = Vector3.new(p.x, p.y, p.z) })
		end
	end
	local sprinklers = {}
	for _, d in folder:GetDescendants() do
		if d:IsA("ParticleEmitter") and d.Name == "Water" and d.Parent and d.Parent:IsA("BasePart") then
			local best, bestDist = nil, math.huge
			for _, z in zones do
				local dist = ((d.Parent :: BasePart).Position - z.pos).Magnitude
				if dist < bestDist then
					best, bestDist = z.zone, dist
				end
			end
			if best then
				table.insert(sprinklers, { emitter = d, zone = best })
			end
		end
	end
	local patches = {}
	for _, d in folder:GetDescendants() do
		local zi = d:GetAttribute("ZoneIndex")
		if zi and d:IsA("BasePart") then
			local zone = (def.zones :: any)[zi]
			if zone and zone.period then
				table.insert(patches, { part = d, zone = zone })
			end
		end
	end
	return { folder = folder, track = track, sprinklers = sprinklers, patches = patches }
end

function TrackAnimator.step()
	local folder = Workspace:FindFirstChild("Track")
	if not folder then
		current = nil
		return
	end
	if not current or current.folder ~= folder then
		current = setup(folder)
		if not current then
			return
		end
	end
	local c = current :: any
	local t = Workspace:GetServerTimeNow()
	local def = c.track.def

	local crossers = folder:FindFirstChild("Crossers")
	if crossers then
		for _, model in crossers:GetChildren() do
			local index = model:GetAttribute("CrosserIndex")
			local cr = index and (def.crossers :: any)[index]
			if cr and model:IsA("Model") then
				local d, lat = Track.crosserAt(c.track, cr, t)
				local _, latAhead = Track.crosserAt(c.track, cr, t + 0.1)
				local p = Track.spot(c.track, d, lat)
				local _, tan = Track.at(c.track, d)
				-- Face the way it is walking (across the road).
				local right = Vector3.new(-tan.z, 0, tan.x).Unit
				local facing = if latAhead >= lat then right else -right
				local bob = math.abs(math.sin(t * 8)) * (if cr.kind == "beetle" then 0.6 else 0.3)
				local pos = Vector3.new(p.x, p.y + bob, p.z)
				model:PivotTo(CFrame.lookAt(pos, pos + facing))
			end
		end
	end

	for _, s in c.sprinklers do
		s.emitter.Enabled = Track.zoneActive(s.zone, t)
	end
	for _, p in c.patches do
		p.part.Transparency = if Track.zoneActive(p.zone, t) then 0.25 else 0.85
	end
end

return TrackAnimator
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">UI</string>
            <string name="Source"><![CDATA[-- Shared look for every screen: rounded panels, chunky buttons sized for
-- thumbs, a friendly rounded font, soft outlines and gentle gradients.

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local UI = {}

UI.Font = Enum.Font.FredokaOne
UI.Colors = {
	panel = Color3.fromRGB(28, 26, 48),
	panelLight = Color3.fromRGB(48, 44, 80),
	text = Color3.fromRGB(255, 255, 255),
	muted = Color3.fromRGB(190, 190, 215),
	yellow = Color3.fromRGB(255, 210, 60),
	pink = Color3.fromRGB(255, 95, 140),
	green = Color3.fromRGB(70, 200, 120),
	red = Color3.fromRGB(230, 80, 90),
	blue = Color3.fromRGB(80, 150, 255),
	purple = Color3.fromRGB(150, 100, 240),
}

local screen = Instance.new("ScreenGui")
screen.Name = "KartUI"
screen.ResetOnSpawn = false
screen.IgnoreGuiInset = false
screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
screen.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
UI.Screen = screen

local function round(gui: GuiObject, radius: number)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius)
	c.Parent = gui
end

local function stroke(gui: GuiObject, color: Color3, thickness: number, transparency: number?)
	local s = Instance.new("UIStroke")
	s.Color = color
	s.Thickness = thickness
	s.Transparency = transparency or 0
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = gui
	return s
end
UI.stroke = stroke

local function apply(gui: Instance, props: { [string]: any }?)
	for k, v in props or {} do
		(gui :: any)[k] = v
	end
end

function UI.panel(parent: Instance, props: { [string]: any }?): Frame
	local f = Instance.new("Frame")
	f.BackgroundColor3 = UI.Colors.panel
	f.BackgroundTransparency = 0.08
	f.BorderSizePixel = 0
	round(f, 18)
	stroke(f, Color3.new(1, 1, 1), 2, 0.75)
	local g = Instance.new("UIGradient")
	g.Rotation = 90
	g.Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(200, 200, 220))
	g.Parent = f
	apply(f, props)
	f.Parent = parent
	return f
end

function UI.label(parent: Instance, props: { [string]: any }?): TextLabel
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Font = UI.Font
	l.TextColor3 = UI.Colors.text
	l.TextScaled = true
	l.TextWrapped = true
	l.TextStrokeTransparency = 0.7
	apply(l, props)
	l.Parent = parent
	return l
end

-- A chunky rounded button with a little press bounce.
function UI.button(parent: Instance, text: string, color: Color3, props: { [string]: any }?, onClick: (() -> ())?): TextButton
	local b = Instance.new("TextButton")
	b.Font = UI.Font
	b.TextScaled = true
	b.TextColor3 = UI.Colors.text
	b.TextStrokeTransparency = 0.6
	b.BackgroundColor3 = color
	b.BorderSizePixel = 0
	b.AutoButtonColor = true
	b.Text = text
	round(b, 14)
	stroke(b, Color3.new(1, 1, 1), 2, 0.6)
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 6)
	pad.PaddingBottom = UDim.new(0, 6)
	pad.PaddingLeft = UDim.new(0, 10)
	pad.PaddingRight = UDim.new(0, 10)
	pad.Parent = b
	apply(b, props)
	b.Parent = parent
	if onClick then
		b.Activated:Connect(function()
			local scale = b:FindFirstChildOfClass("UIScale") or Instance.new("UIScale")
			scale.Parent = b
			scale.Scale = 0.92
			TweenService:Create(scale, TweenInfo.new(0.18, Enum.EasingStyle.Back), { Scale = 1 }):Play()
			onClick()
		end)
	end
	return b
end

function UI.list(parent: Instance, horizontal: boolean, padding: number, center: boolean?): UIListLayout
	local l = Instance.new("UIListLayout")
	l.FillDirection = if horizontal then Enum.FillDirection.Horizontal else Enum.FillDirection.Vertical
	l.Padding = UDim.new(0, padding)
	l.SortOrder = Enum.SortOrder.LayoutOrder
	if center then
		l.HorizontalAlignment = Enum.HorizontalAlignment.Center
		l.VerticalAlignment = Enum.VerticalAlignment.Center
	end
	l.Parent = parent
	return l
end

function UI.highlight(gui: GuiObject, on: boolean)
	local s = gui:FindFirstChild("Highlight") :: UIStroke?
	if not s then
		s = stroke(gui, UI.Colors.yellow, 4)
		s.Name = "Highlight"
	end
	s.Enabled = on
end

-- Pops a panel in with a quick scale bounce.
function UI.pop(gui: GuiObject)
	local scale = gui:FindFirstChildOfClass("UIScale") or Instance.new("UIScale")
	scale.Parent = gui
	scale.Scale = 0.85
	TweenService:Create(scale, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Scale = 1 }):Play()
end

local thumbs: { [number]: string } = {}
-- Avatar headshot for a user (cached). Empty string until it loads.
function UI.headshot(userId: number): string
	if thumbs[userId] then
		return thumbs[userId]
	end
	thumbs[userId] = ""
	task.spawn(function()
		local ok, content = pcall(Players.GetUserThumbnailAsync, Players, userId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size48x48)
		if ok then
			thumbs[userId] = content
		end
	end)
	return ""
end

function UI.ordinal(n: number): string
	local suffix = "th"
	if n % 100 < 11 or n % 100 > 13 then
		suffix = ({ "st", "nd", "rd" })[n % 10] or "th"
	end
	return `{n}{suffix}`
end

function UI.time(t: number?): string
	if not t then
		return "--"
	end
	local m = math.floor(t / 60)
	return string.format("%d:%05.2f", m, t - m * 60)
end

return UI
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="43">
    <Properties>
      <string name="Name">Workspace</string>
      <float name="Gravity">150</float>
      <bool name="NeedsPivotMigration">false</bool>
    </Properties>
  </Item>
</roblox>