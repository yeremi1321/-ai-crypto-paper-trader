<roblox version="4">
  <Item class="Lighting" referent="0">
    <Properties>
      <string name="Name">Lighting</string>
      <float name="Brightness">3</float>
      <float name="EnvironmentDiffuseScale">0.5</float>
      <float name="EnvironmentSpecularScale">0.5</float>
      <bool name="GlobalShadows">true</bool>
      <token name="Technology">4</token>
    </Properties>
  </Item>
  <Item class="ReplicatedStorage" referent="1">
    <Properties>
      <string name="Name">ReplicatedStorage</string>
    </Properties>
    <Item class="Folder" referent="2">
      <Properties>
        <string name="Name">Common</string>
      </Properties>
      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">Atmos</string>
          <string name="Source"><![CDATA[-- Lighting for a track theme (sky haze, sun, bloom, colour grading). Runs on
-- each client: racers see the track's theme while lobby players keep the
-- Kart HQ look, since Lighting changes made on a client stay on that client.
-- Changes ease in over a second or so instead of snapping.

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local function child(parent: Instance, name: string): Instance
	return parent:FindFirstChild(name) or parent:WaitForChild(name)
end
local Tracks = require(child(child(ReplicatedStorage, "Shared"), "Tracks"))

local Atmos = {}

Atmos.FadeSeconds = 1.2

local function rgb(c: { number }): Color3
	return Color3.fromRGB(c[1], c[2], c[3])
end

-- The effect objects are made once and then tweened between themes.
local function effect(className: string, name: string): Instance
	local existing = Lighting:FindFirstChild(name)
	if existing and existing.ClassName == className then
		return existing
	end
	if existing then
		existing:Destroy()
	end
	local e = Instance.new(className)
	e.Name = name
	e.Parent = Lighting
	return e
end

local function tween(inst: Instance, seconds: number, goals: { [string]: any })
	if seconds <= 0 then
		for k, v in goals do
			(inst :: any)[k] = v
		end
		return
	end
	TweenService:Create(inst, TweenInfo.new(seconds, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), goals):Play()
end

-- Sky, sun and colour grading for a theme. `seconds` = fade time (0 = snap).
function Atmos.applyTheme(theme: any, seconds: number?)
	local fade = seconds or Atmos.FadeSeconds
	-- The sun can't sweep across the sky in a second without looking odd, so
	-- the time of day changes at once; everything else fades.
	Lighting.ClockTime = theme.clock
	Lighting.GlobalShadows = true
	-- Realistic themes let the sky light and reflect everything (PBR), with
	-- softer shadow edges; toy worlds keep flatter, cartoon lighting.
	Lighting.EnvironmentDiffuseScale = if theme.realistic then 1 else 0.5
	Lighting.EnvironmentSpecularScale = if theme.realistic then 1 else 0.5
	Lighting.ShadowSoftness = if theme.realistic then 0.15 else 0.2
	-- Roblox's realistic lighting style for the realistic themes (stronger
	-- sky light and shading); the toy worlds keep the softer style.
	pcall(function()
		(Lighting :: any).LightingStyle = if theme.realistic then Enum.LightingStyle.Realistic else Enum.LightingStyle.Soft
	end)
	tween(Lighting, fade, {
		Brightness = theme.brightness,
		Ambient = rgb(theme.ambient),
		OutdoorAmbient = rgb(theme.ambient),
	})

	local a = theme.atmosphere
	tween(effect("Atmosphere", "KartAtmosphere"), fade, {
		Density = a.density,
		Haze = a.haze,
		Glare = a.glare,
		Color = rgb(a.color),
		Decay = rgb(a.decay),
	})

	local bloom = effect("BloomEffect", "KartBloom") :: BloomEffect
	bloom.Size = 24
	bloom.Threshold = 0.9
	tween(bloom, fade, { Intensity = theme.bloom })

	local grade = effect("ColorCorrectionEffect", "KartGrade") :: ColorCorrectionEffect
	grade.Contrast = theme.contrast or 0.08
	tween(grade, fade, { TintColor = rgb(theme.tint), Saturation = theme.saturation })

	-- Volumetric clouds for outdoor themes (they live under Terrain).
	local terrain = workspace:FindFirstChildOfClass("Terrain")
	if terrain then
		local clouds = terrain:FindFirstChild("KartClouds") :: Clouds?
		if not clouds then
			local made = Instance.new("Clouds")
			made.Name = "KartClouds"
			made.Cover = 0
			made.Density = 0
			made.Parent = terrain
			clouds = made
		end
		local cloud = clouds :: Clouds
		local c = theme.clouds
		cloud.Enabled = c ~= nil
		if c then
			tween(cloud, fade, { Cover = c.cover, Density = c.density })
		end
	end

	local rays = effect("SunRaysEffect", "KartSunRays") :: SunRaysEffect
	rays.Spread = 0.6
	tween(rays, fade, { Intensity = if theme.clock > 6 and theme.clock < 19 then 0.08 else 0 })
end

function Atmos.apply(themeId: string, seconds: number?)
	local theme = Tracks.Themes[themeId] or Tracks.Themes.hq
	Atmos.applyTheme(theme, seconds)
end

return Atmos
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">KartRig</string>
          <string name="Source"><![CDATA[-- Builds a kart and connects KartPhysics to Roblox physics. Shared by the
-- server (CPU karts) and the client (your own kart, which you own physics for).
--
-- How it looks alive: the body hangs off the ball on a Motor6D ("BodyJoint")
-- and each wheel has its own Motor6D, so clients (client/KartVisuals) can
-- lean the body into turns, bounce the suspension, flip it for tricks, steer
-- the front wheels and spin all of them, without touching the physics.
--
-- How it moves: an invisible sphere carries the kart. A LinearVelocity pushes
-- it horizontally at the speed KartPhysics wants (vertical is left to
-- gravity, so hills and jumps just work), and an AlignOrientation turns the
-- visible body to match the heading and the slope of the road.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- FindFirstChild first so the smoke test (Lune has no WaitForChild) can load this.
local function child(parent: Instance, name: string): Instance
	return parent:FindFirstChild(name) or parent:WaitForChild(name)
end

local Shared = child(ReplicatedStorage, "Shared")
local KartPhysics = require(child(Shared, "KartPhysics"))
local Cosmetics = require(child(Shared, "Cosmetics"))
local KartBodies = require(child(Shared, "KartBodies"))
local Karts = require(child(Shared, "Karts"))

local KartRig = {}

KartRig.BallRadius = 2
local BODY_DROP = 1.0 -- body center sits this far below the ball center

local function weld(a: BasePart, b: BasePart)
	local w = Instance.new("WeldConstraint")
	w.Part0 = a
	w.Part1 = b
	w.Parent = b
end

local function visual(model: Model, root: BasePart, name: string, size: Vector3, offset: CFrame, color: Color3, material: Enum.Material?, shape: string?, weldTo: BasePart?): BasePart
	local p: BasePart
	if shape == "Wedge" then
		p = Instance.new("WedgePart")
	elseif shape == "Ellipsoid" then
		local part = Instance.new("Part")
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = part
		p = part
	else
		local part = Instance.new("Part")
		if shape == "Ball" then
			part.Shape = Enum.PartType.Ball
		elseif shape == "Cylinder" then
			part.Shape = Enum.PartType.Cylinder
		end
		p = part
	end
	p.Name = name
	p.Size = size
	p.CFrame = root.CFrame * offset
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = model
	weld(weldTo or root, p)
	return p
end

local function motor(name: string, part0: BasePart, part1: BasePart, c0: CFrame): Motor6D
	local m = Instance.new("Motor6D")
	m.Name = name
	m.Part0 = part0
	m.Part1 = part1
	m.C0 = c0
	m.C1 = CFrame.new()
	m.Parent = part0
	return m
end

local function rgb(c: { number }): Color3
	return Color3.fromRGB(c[1], c[2], c[3])
end

-- Colour, material, transparency and default reflectance for each body
-- part role. Realistic bodies get a clear-coat gloss on the paint, polished
-- chrome and darker, matte trim; cartoon bodies stay smooth and flat.
local function roleStyle(role: string, main: Color3, accent: Color3, realistic: boolean?): (Color3, Enum.Material, number, number)
	if role == "main" then
		return main, Enum.Material.SmoothPlastic, 0, if realistic then 0.12 else 0
	elseif role == "accent" then
		return accent, Enum.Material.SmoothPlastic, 0, if realistic then 0.1 else 0
	elseif role == "glass" then
		return if realistic then Color3.fromRGB(70, 90, 105) else Color3.fromRGB(150, 210, 255), Enum.Material.Glass, if realistic then 0.35 else 0.45, if realistic then 0.2 else 0
	elseif role == "chrome" then
		return Color3.fromRGB(205, 210, 220), Enum.Material.Metal, 0, if realistic then 0.35 else 0
	elseif role == "light" then
		return Color3.fromRGB(255, 250, 220), Enum.Material.Neon, 0, 0
	end
	return if realistic then Color3.fromRGB(28, 28, 32) else Color3.fromRGB(35, 35, 40), if realistic then Enum.Material.Plastic else Enum.Material.SmoothPlastic, 0, 0
end

-- `cf` is where the kart should sit on the road (position on the surface).
-- `look` picks the body design and paint (see KartBodies); stats come from `kartId`.
function KartRig.build(kartId: string, driverName: string, cf: CFrame, parent: Instance, look: KartBodies.Look?): Model
	local def = Karts.get(kartId)
	local chosen = look or { body = KartBodies.Default, main = 1, accent = 10 }
	local body = KartBodies.get(chosen.body)
	local main = rgb(KartBodies.color(chosen.main))
	local accent = rgb(KartBodies.color(chosen.accent))

	local model = Instance.new("Model")
	model.Name = driverName

	local root = Instance.new("Part")
	root.Name = "Root"
	root.Shape = Enum.PartType.Ball
	root.Size = Vector3.one * KartRig.BallRadius * 2
	root.CFrame = cf + Vector3.new(0, KartRig.BallRadius + 0.2, 0)
	root.Transparency = 1
	-- No friction: the LinearVelocity decides speed, walls just deflect.
	root.CustomPhysicalProperties = PhysicalProperties.new(0.6 + def.stats.weight * 0.25, 0, 0.1, 100, 1)
	root.Parent = model
	model.PrimaryPart = root

	local center = Instance.new("Attachment")
	center.Name = "Center"
	center.Parent = root

	local drive = Instance.new("LinearVelocity")
	drive.Name = "Drive"
	drive.Attachment0 = center
	drive.RelativeTo = Enum.ActuatorRelativeTo.World
	drive.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
	drive.ForceLimitMode = Enum.ForceLimitMode.PerAxis
	drive.MaxAxesForce = Vector3.zero
	drive.VectorVelocity = Vector3.zero
	drive.Parent = root

	local align = Instance.new("AlignOrientation")
	align.Name = "Align"
	align.Mode = Enum.OrientationAlignmentMode.OneAttachment
	align.Attachment0 = center
	align.MaxTorque = math.huge
	align.Responsiveness = 40
	align.CFrame = cf.Rotation
	align.Parent = root

	local drop = CFrame.new(0, -BODY_DROP, 0)
	-- Everything that leans and bounces hangs off this invisible part.
	local bodyRoot = Instance.new("Part")
	bodyRoot.Name = "BodyRoot"
	bodyRoot.Size = Vector3.one
	bodyRoot.CFrame = root.CFrame * drop
	bodyRoot.Transparency = 1
	bodyRoot.CanCollide = false
	bodyRoot.CanQuery = false
	bodyRoot.CanTouch = false
	bodyRoot.Massless = true
	bodyRoot.Parent = model
	motor("BodyJoint", root, bodyRoot, drop)

	for i, part in body.parts do
		local color, material, transparency, reflectance = roleStyle(part.role, main, accent, body.realistic)
		if part.color then
			color = Color3.fromRGB(part.color[1], part.color[2], part.color[3])
		end
		if part.material then
			material = (Enum.Material :: any)[part.material] or material
		end
		transparency = part.transparency or transparency
		local rot = part.rotation or { 0, 0, 0 }
		local localCf = CFrame.new(part.offset[1], part.offset[2], part.offset[3])
			* CFrame.Angles(math.rad(rot[1]), math.rad(rot[2]), math.rad(rot[3]))
		local p = visual(model, root, `Body{i}`, Vector3.new(part.size[1], part.size[2], part.size[3]), drop * localCf, color, material, part.shape, bodyRoot)
		p.Transparency = transparency
		p.Reflectance = part.reflectance or reflectance

		if part.anim then
			-- Swap the weld for a Motor6D so the client can animate this part.
			local w = p:FindFirstChildOfClass("WeldConstraint")
			if w then
				w:Destroy()
			end
			local m = Instance.new("Motor6D")
			m.Name = "Anim"
			m.Part0 = bodyRoot
			m.Part1 = p
			if part.anim == "orbit" then
				-- Pivot on the kart's centre line so it circles the kart.
				m.C0 = CFrame.new(0, part.offset[2], 0)
				m.C1 = CFrame.new(-part.offset[1], 0, -part.offset[3])
			else
				m.C0 = localCf
				m.C1 = CFrame.new()
			end
			m:SetAttribute("AnimKind", part.anim)
			m:SetAttribute("Side", if part.offset[1] < 0 then -1 else 1)
			m.Parent = bodyRoot
		end

		if part.text then
			for _, face in { Enum.NormalId.Left, Enum.NormalId.Right } do
				local gui = Instance.new("SurfaceGui")
				gui.Face = face
				gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
				gui.PixelsPerStud = 30
				gui.Parent = p
				local label = Instance.new("TextLabel")
				label.Size = UDim2.fromScale(1, 1)
				label.BackgroundTransparency = 1
				label.Font = Enum.Font.PermanentMarker
				label.TextScaled = true
				label.TextColor3 = Color3.fromRGB(40, 40, 70)
				label.Rotation = -6
				label.Text = part.text
				label.Parent = gui
			end
		end

		if part.bubbles then
			local bubbles = Instance.new("ParticleEmitter")
			bubbles.Name = "Bubbles"
			bubbles.Texture = "rbxasset://textures/particles/sparkles_main.dds"
			bubbles.Color = ColorSequence.new(Color3.fromRGB(210, 240, 255), Color3.fromRGB(255, 210, 245))
			bubbles.Size = NumberSequence.new(0.4, 1.1)
			bubbles.Transparency = NumberSequence.new(0.2, 1)
			bubbles.Lifetime = NumberRange.new(0.6, 1.2)
			bubbles.Speed = NumberRange.new(4, 8)
			bubbles.SpreadAngle = Vector2.new(30, 30)
			bubbles.Acceleration = Vector3.new(0, 6, 0)
			bubbles.EmissionDirection = Enum.NormalId.Back
			bubbles.Rate = 14
			bubbles.Parent = p
		end
	end
	local ex = body.exhaust
	local exhaust = visual(model, root, "Exhaust", Vector3.new(1.2, 0.6, 0.4), drop * CFrame.new(ex[1], ex[2], ex[3]), Color3.fromRGB(255, 140, 40), Enum.Material.Neon, nil, bodyRoot)
	exhaust.Transparency = 1
	local puff = Instance.new("ParticleEmitter")
	puff.Name = "ExhaustPuff"
	puff.Texture = "rbxasset://textures/particles/smoke_main.dds"
	puff.Color = ColorSequence.new(Color3.fromRGB(235, 235, 245))
	puff.Size = NumberSequence.new(0.5, 1.6)
	puff.Transparency = NumberSequence.new(0.5, 1)
	puff.Lifetime = NumberRange.new(0.4, 0.7)
	puff.Speed = NumberRange.new(3, 6)
	puff.EmissionDirection = Enum.NormalId.Back
	puff.Rate = 6
	puff.Parent = exhaust

	-- Wheels sit on the road: the body's center rides BODY_DROP below the ball's center.
	local groundToBody = KartRig.BallRadius - BODY_DROP
	-- Wheel style (cosmetic): scales the body's own wheels.
	local wheelStyle = Cosmetics.find("wheels", (chosen :: any).wheels) or Cosmetics.Wheels[1]
	local wheelRadius = body.wheelRadius * wheelStyle.radius
	local tyreColor = Color3.fromRGB(wheelStyle.color[1], wheelStyle.color[2], wheelStyle.color[3])
	local rearZ = -math.huge
	for _, w in body.wheels do
		rearZ = math.max(rearZ, w[2])
	end
	for i, w in body.wheels do
		local rear = w[2] >= rearZ
		-- Rear wheels can be bigger (hot rods, dragsters); each sits on the road.
		local radius = (if rear then body.rearWheelRadius or body.wheelRadius else body.wheelRadius) * wheelStyle.radius
		local width = (if rear then body.rearWheelWidth or body.wheelWidth else body.wheelWidth) * wheelStyle.width
		local name = if rear then (if w[1] < 0 then "WheelRL" else "WheelRR") else `Wheel{i}`
		local d = radius * 2
		local wheelCf = drop * CFrame.new(w[1], radius - groundToBody, w[2])
		local wheel = Instance.new("Part")
		wheel.Name = name
		wheel.Shape = Enum.PartType.Cylinder
		wheel.Size = Vector3.new(width, d, d)
		wheel.CFrame = root.CFrame * wheelCf
		wheel.Color = tyreColor
		wheel.Material = Enum.Material.Rubber
		wheel.CanCollide = false
		wheel.CanQuery = false
		wheel.CanTouch = false
		wheel.Massless = true
		wheel.Parent = model
		-- Wheels turn on their own joint: front ones steer, all of them spin.
		local joint = motor("WheelJoint", root, wheel, wheelCf)
		joint:SetAttribute("Front", not rear)
		-- Bigger wheels turn slower for the same road speed.
		joint:SetAttribute("SpinScale", wheelRadius / radius)
		if body.realistic and not wheelStyle.glow then
			-- Polished rim with six spokes and a dark centre cap.
			visual(model, root, `{name}Hub`, Vector3.new(width + 0.04, d * 0.62, d * 0.62), wheelCf, Color3.fromRGB(200, 204, 212), Enum.Material.Metal, "Cylinder", wheel).Reflectance = 0.3
			for k = 0, 2 do
				visual(model, root, `{name}Spoke`, Vector3.new(width + 0.08, d * 0.56, d * 0.09), wheelCf * CFrame.Angles(math.rad(k * 60), 0, 0), Color3.fromRGB(150, 154, 162), Enum.Material.Metal, nil, wheel)
			end
			visual(model, root, `{name}Cap`, Vector3.new(width + 0.12, d * 0.16, d * 0.16), wheelCf, Color3.fromRGB(35, 35, 40), Enum.Material.Metal, "Cylinder", wheel)
		else
			visual(model, root, `{name}Hub`, Vector3.new(width + 0.06, d * 0.55, d * 0.55), wheelCf, accent, if wheelStyle.glow then Enum.Material.Neon else Enum.Material.SmoothPlastic, "Cylinder", wheel)
			-- A spoke so you can see the wheel turning.
			visual(model, root, `{name}Spoke`, Vector3.new(width + 0.08, d * 0.5, d * 0.14), wheelCf, Color3.fromRGB(240, 240, 245), Enum.Material.SmoothPlastic, nil, wheel)
		end
		if rear then
			local sparks = Instance.new("ParticleEmitter")
			sparks.Name = "DriftSparks"
			sparks.Texture = "rbxasset://textures/particles/sparkles_main.dds"
			sparks.Size = NumberSequence.new(0.5, 0)
			sparks.Lifetime = NumberRange.new(0.15, 0.3)
			sparks.Speed = NumberRange.new(8, 14)
			sparks.SpreadAngle = Vector2.new(40, 40)
			sparks.EmissionDirection = Enum.NormalId.Back
			sparks.Rate = 60
			sparks.LightEmission = 1
			sparks.Enabled = false
			sparks.Parent = wheel
		end
	end

	-- Stickers on both sides.
	local sticker = Cosmetics.find("sticker", (chosen :: any).sticker)
	if sticker and sticker.id ~= "none" then
		for _, side in { -1, 1 } do
			local panel = visual(model, root, "Sticker", Vector3.new(0.05, 1.8, 1.8), drop * CFrame.new(side * 2.45, 0.9, 0.2), Color3.new(1, 1, 1), nil, nil, bodyRoot)
			panel.Transparency = 1
			local gui = Instance.new("SurfaceGui")
			gui.Face = if side < 0 then Enum.NormalId.Left else Enum.NormalId.Right
			gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
			gui.PixelsPerStud = 40
			gui.LightInfluence = 0.5
			gui.Parent = panel
			local label = Instance.new("TextLabel")
			label.Size = UDim2.fromScale(1, 1)
			label.BackgroundTransparency = 1
			label.TextScaled = true
			label.Text = sticker.icon
			label.Parent = gui
		end
	end

	-- Licence plate on the back.
	local plateText = (chosen :: any).plate
	if type(plateText) == "string" and plateText ~= "" then
		local plate = visual(model, root, "Plate", Vector3.new(1.8, 0.6, 0.08), drop * CFrame.new(0, 0.2, 3.65), Color3.fromRGB(250, 250, 240), nil, nil, bodyRoot)
		local gui = Instance.new("SurfaceGui")
		gui.Face = Enum.NormalId.Back
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 60
		gui.Parent = plate
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.FredokaOne
		label.TextScaled = true
		label.TextColor3 = Color3.fromRGB(40, 40, 60)
		label.Text = plateText
		label.Parent = gui
	end

	-- Trail streaming from the back.
	local trailStyle = Cosmetics.find("trail", (chosen :: any).trail)
	if trailStyle and #trailStyle.colors > 0 then
		local a0 = Instance.new("Attachment")
		a0.Name = "TrailTop"
		a0.Position = Vector3.new(0, 0.9, 3.4)
		a0.Parent = bodyRoot
		local a1 = Instance.new("Attachment")
		a1.Name = "TrailBottom"
		a1.Position = Vector3.new(0, -0.3, 3.4)
		a1.Parent = bodyRoot
		local keys = {}
		for i, c in trailStyle.colors do
			local t = if #trailStyle.colors == 1 then 0 else (i - 1) / (#trailStyle.colors - 1)
			table.insert(keys, ColorSequenceKeypoint.new(t, Color3.fromRGB(c[1], c[2], c[3])))
		end
		if #keys == 1 then
			table.insert(keys, ColorSequenceKeypoint.new(1, keys[1].Value))
		end
		local trail = Instance.new("Trail")
		trail.Name = "KartTrail"
		trail.Attachment0 = a0
		trail.Attachment1 = a1
		trail.Color = ColorSequence.new(keys)
		trail.Transparency = NumberSequence.new(0.2, 1)
		trail.Lifetime = 0.45
		trail.MinLength = 0.2
		trail.LightEmission = if trailStyle.id == "smoke" then 0 else 0.6
		trail.FaceCamera = true
		trail.Parent = bodyRoot
	end

	local seatPos = body.seat
	local seat = Instance.new("Seat")
	seat.Name = "DriverSeat"
	seat.Size = Vector3.new(2, 0.4, 2)
	seat.CFrame = root.CFrame * drop * CFrame.new(seatPos[1], seatPos[2], seatPos[3])
	seat.Transparency = 1
	seat.CanCollide = false
	seat.Massless = true
	seat.Parent = model
	weld(bodyRoot, seat)

	local tag = Instance.new("BillboardGui")
	tag.Name = "NameTag"
	tag.Size = UDim2.new(0, 120, 0, 24)
	tag.StudsOffset = Vector3.new(0, 5, 0)
	tag.MaxDistance = 150
	tag.Adornee = root
	tag.Parent = model
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.4
	label.Text = driverName
	label.Parent = tag

	model:SetAttribute("KartId", def.id)
	model:SetAttribute("Body", body.id)
	model:SetAttribute("WheelRadius", wheelRadius)
	model.Parent = parent
	return model
end

export type Sensed = { grounded: boolean, normal: Vector3, position: Vector3 }

-- Raycasts for the road under the kart. `ignore` should hold every kart.
function KartRig.sense(model: Model, params: RaycastParams): Sensed
	local root = model.PrimaryPart :: BasePart
	local hit = workspace:Raycast(root.Position, Vector3.new(0, -(KartRig.BallRadius + 1.5), 0), params)
	return {
		grounded = hit ~= nil,
		normal = if hit then hit.Normal else Vector3.yAxis,
		position = root.Position,
	}
end

-- If something (a wall, another kart) is holding the kart back, let the
-- simulated speed drop to what the kart is really doing.
function KartRig.sync(model: Model, s: KartPhysics.State)
	local root = model.PrimaryPart :: BasePart
	local fx, fz = KartPhysics.forward(s.yaw)
	local actual = root.AssemblyLinearVelocity.X * fx + root.AssemblyLinearVelocity.Z * fz
	if s.speed > 20 and actual < s.speed * 0.6 then
		s.speed += (math.max(actual, 0) - s.speed) * 0.25
	end
end

function KartRig.apply(model: Model, s: KartPhysics.State, sensed: Sensed)
	local root = model.PrimaryPart :: BasePart
	local drive = root:FindFirstChild("Drive") :: LinearVelocity
	local align = root:FindFirstChild("Align") :: AlignOrientation

	local fx, fz = KartPhysics.forward(s.yaw)
	local force = root.AssemblyMass * (if sensed.grounded then 400 else 60)
	drive.MaxAxesForce = Vector3.new(force, 0, force)
	drive.VectorVelocity = Vector3.new(fx * s.speed, 0, fz * s.speed)

	local vyaw = KartPhysics.visualYaw(s)
	local look = Vector3.new(-math.sin(vyaw), 0, -math.cos(vyaw))
	local up = sensed.normal
	local right = look:Cross(up).Unit
	align.CFrame = CFrame.fromMatrix(Vector3.zero, right, up)
end

-- Effects every viewer sees: drift sparks by mini-turbo level, exhaust flame on boost.
local SPARK_COLORS = {
	Color3.fromRGB(80, 170, 255),
	Color3.fromRGB(255, 150, 40),
	Color3.fromRGB(200, 90, 255),
}
function KartRig.setEffects(model: Model, driftLevel: number, boosting: boolean)
	for _, name in { "WheelRL", "WheelRR" } do
		local wheel = model:FindFirstChild(name)
		local sparks = wheel and wheel:FindFirstChild("DriftSparks") :: ParticleEmitter?
		if sparks then
			sparks.Enabled = driftLevel > 0
			if driftLevel > 0 then
				sparks.Color = ColorSequence.new(SPARK_COLORS[driftLevel])
			end
		end
	end
	local exhaust = model:FindFirstChild("Exhaust") :: BasePart?
	if exhaust then
		exhaust.Transparency = if boosting then 0.1 else 1
	end
	-- Lets clients animate boost-only details (like the toaster's toast).
	if model:GetAttribute("Boosting") ~= boosting then
		model:SetAttribute("Boosting", boosting)
	end
end

-- Puts a kart back on the road (after falling off, or on the grid).
function KartRig.place(model: Model, cf: CFrame)
	local root = model.PrimaryPart :: BasePart
	model:PivotTo(cf + Vector3.new(0, KartRig.BallRadius + 0.2, 0))
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
	local align = root:FindFirstChild("Align") :: AlignOrientation
	align.CFrame = cf.Rotation
	local drive = root:FindFirstChild("Drive") :: LinearVelocity
	drive.VectorVelocity = Vector3.zero
end

return KartRig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Shapes</string>
          <string name="Source"><![CDATA[-- Rounded building blocks for a smooth cartoon look without imported meshes:
-- ellipsoids (stretched spheres), discs, capsules and rounded boxes. Every
-- shape is one or a few anchored parts with smooth plastic.
--
-- Ellipsoids use a SpecialMesh sphere, which stretches to the part's size.
-- These are stand-ins: custom MeshParts made in Blender look better and can
-- replace any of them later.

local Shapes = {}

export type Style = {
	color: Color3,
	material: Enum.Material?,
	transparency: number?,
	reflectance: number?,
	collide: boolean?,
	anchored: boolean?,
	name: string?,
}

local function apply(p: BasePart, style: Style, parent: Instance?)
	p.Name = style.name or p.Name
	p.Anchored = if style.anchored == nil then true else style.anchored
	p.CanCollide = style.collide == true
	p.CanQuery = style.collide == true
	p.CanTouch = false
	p.Color = style.color
	p.Material = style.material or Enum.Material.SmoothPlastic
	p.Transparency = style.transparency or 0
	p.Reflectance = style.reflectance or 0
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if parent then
		p.Parent = parent
	end
end

function Shapes.box(parent: Instance?, size: Vector3, cf: CFrame, style: Style): Part
	local p = Instance.new("Part")
	p.Size = size
	p.CFrame = cf
	apply(p, style, parent)
	return p
end

function Shapes.ball(parent: Instance?, diameter: number, cf: CFrame, style: Style): Part
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Ball
	p.Size = Vector3.one * diameter
	p.CFrame = cf
	apply(p, style, parent)
	return p
end

-- A stretched sphere filling `size`.
function Shapes.ellipsoid(parent: Instance?, size: Vector3, cf: CFrame, style: Style): Part
	local p = Instance.new("Part")
	p.Size = size
	p.CFrame = cf
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = p
	apply(p, style, parent)
	return p
end

-- A cylinder standing upright (height along y).
function Shapes.pillar(parent: Instance?, diameter: number, height: number, cf: CFrame, style: Style): Part
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Cylinder
	p.Size = Vector3.new(height, diameter, diameter)
	p.CFrame = cf * CFrame.Angles(0, 0, math.rad(90))
	apply(p, style, parent)
	return p
end

-- A flat round disc lying on the ground (thickness along y).
function Shapes.disc(parent: Instance?, diameter: number, thickness: number, cf: CFrame, style: Style): Part
	return Shapes.pillar(parent, diameter, thickness, cf, style)
end

-- A cylinder lying along local x (wheels, pipes, logs).
function Shapes.tube(parent: Instance?, diameter: number, length: number, cf: CFrame, style: Style): Part
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Cylinder
	p.Size = Vector3.new(length, diameter, diameter)
	p.CFrame = cf
	apply(p, style, parent)
	return p
end

-- Upright capsule: a pillar with ball ends.
function Shapes.capsule(parent: Instance?, diameter: number, height: number, cf: CFrame, style: Style): { Part }
	local body = math.max(height - diameter, 0.05)
	return {
		Shapes.pillar(parent, diameter, body, cf, style),
		Shapes.ball(parent, diameter, cf * CFrame.new(0, body / 2, 0), style),
		Shapes.ball(parent, diameter, cf * CFrame.new(0, -body / 2, 0), style),
	}
end

-- A box with rounded vertical edges (four corner cylinders and two inner
-- boxes). Good for buildings, signs and counters.
function Shapes.roundedBox(parent: Instance?, size: Vector3, radius: number, cf: CFrame, style: Style): { Part }
	local r = math.min(radius, size.X / 2, size.Z / 2)
	local parts = {
		Shapes.box(parent, Vector3.new(size.X - r * 2, size.Y, size.Z), cf, style),
		Shapes.box(parent, Vector3.new(size.X, size.Y, size.Z - r * 2), cf, style),
	}
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			table.insert(parts, Shapes.pillar(parent, r * 2, size.Y, cf * CFrame.new(sx * (size.X / 2 - r), 0, sz * (size.Z / 2 - r)), style))
		end
	end
	return parts
end

-- A semicircular arch made of short segments (tunnels, doors, gates).
function Shapes.arch(parent: Instance?, span: number, thickness: number, depth: number, cf: CFrame, style: Style, segments: number?): { Part }
	local n = segments or 12
	local radius = span / 2
	local parts = {}
	for i = 0, n - 1 do
		local a0 = math.pi * i / n
		local a1 = math.pi * (i + 1) / n
		local mid = (a0 + a1) / 2
		local len = 2 * radius * math.sin((a1 - a0) / 2) + thickness * 0.3
		local pos = CFrame.new(math.cos(mid) * radius, math.sin(mid) * radius, 0)
		table.insert(parts, Shapes.box(parent, Vector3.new(len, thickness, depth), cf * pos * CFrame.Angles(0, 0, mid - math.pi / 2), style))
	end
	return parts
end

return Shapes
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Folder" referent="6">
      <Properties>
        <string name="Name">Shared</string>
      </Properties>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">AIDriver</string>
          <string name="Source"><![CDATA[--!strict
-- CPU driving: look ahead along the centerline, steer toward a point in the
-- driver's preferred lane, drift through long corners, ease off in hairpins.

local KartPhysics = require("./KartPhysics")
local Karts = require("./Karts")
local Track = require("./Track")

export type Profile = {
	lane: number, -- -1..1 preferred side of the road
	skill: number, -- 0..1
}

local AIDriver = {}

-- Signed angle from the kart's heading to a world direction; positive = turn right.
function AIDriver.angleTo(yaw: number, dx: number, dz: number): number
	local fx, fz = KartPhysics.forward(yaw)
	return math.atan2(fx * dz - fz * dx, fx * dx + fz * dz)
end

function AIDriver.input(
	track: Track.Built,
	proj: Track.Projection,
	pos: Track.Vec,
	s: KartPhysics.State,
	stats: Karts.KartStats,
	profile: Profile
): KartPhysics.Input
	local lookahead = 28 + math.max(s.speed, 0) * 0.42
	local target, tangent = Track.at(track, proj.distance + lookahead)
	-- Lane offset: right of travel is (-tz, tx) in this coordinate frame.
	local tl = math.sqrt(tangent.x * tangent.x + tangent.z * tangent.z)
	local rx, rz = -tangent.z / tl, tangent.x / tl
	local laneOffset = profile.lane * track.def.width * 0.28
	local tx = target.x + rx * laneOffset - pos.x
	local tz = target.z + rz * laneOffset - pos.z

	local angle = AIDriver.angleTo(s.yaw, tx, tz)
	local steer = math.clamp(angle * 2.4, -1, 1)

	local throttle = 1
	if math.abs(angle) > 0.7 and s.speed > stats.topSpeed * 0.6 then
		throttle = 0.2
	end

	-- Drift through bends that will last a while; skilled drivers drift more.
	local drift = false
	local farTarget = Track.at(track, proj.distance + lookahead * 2)
	local farAngle = AIDriver.angleTo(s.yaw, farTarget.x - pos.x, farTarget.z - pos.z)
	if s.drift ~= 0 then
		drift = math.sign(angle) == s.drift and math.abs(angle) > 0.06
	elseif math.abs(farAngle) > 0.35 - 0.12 * profile.skill and math.abs(angle) > 0.12 and math.sign(farAngle) == math.sign(angle) then
		drift = true
	end

	return { throttle = throttle, steer = steer, drift = drift, grounded = true, surface = "road" }
end

return AIDriver
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Cosmetics</string>
          <string name="Source"><![CDATA[--!strict
-- Kart cosmetics you unlock with coins. They change looks only, never speed
-- or handling, so every choice stays equally competitive.

local KartBodies = require("./KartBodies")

export type Item = { id: string, name: string, price: number, icon: string? }

local Cosmetics = {}

-- Wheel styles: radius and width multipliers on the body's own wheels.
Cosmetics.Wheels = {
	{ id = "standard", name = "Standard", price = 0, icon = "⚫", radius = 1, width = 1, color = { 26, 26, 30 } },
	{ id = "chunky", name = "Chunky", price = 150, icon = "🛞", radius = 1.15, width = 1.5, color = { 30, 30, 34 } },
	{ id = "slick", name = "Slick", price = 150, icon = "🏁", radius = 0.95, width = 1.25, color = { 20, 20, 24 } },
	{ id = "monster", name = "Monster", price = 400, icon = "🦖", radius = 1.35, width = 1.4, color = { 34, 30, 28 } },
	{ id = "whitewall", name = "Whitewall", price = 250, icon = "⚪", radius = 1, width = 1.1, color = { 240, 240, 245 } },
	{ id = "neon", name = "Neon Rims", price = 500, icon = "💡", radius = 1.05, width = 1.1, color = { 20, 20, 26 }, glow = true },
}

-- Stickers go on both sides of the body.
Cosmetics.Stickers = {
	{ id = "none", name = "None", price = 0, icon = "🚫" },
	{ id = "star", name = "Star", price = 50, icon = "⭐" },
	{ id = "flame", name = "Flames", price = 100, icon = "🔥" },
	{ id = "bolt", name = "Lightning", price = 100, icon = "⚡" },
	{ id = "rainbow", name = "Rainbow", price = 150, icon = "🌈" },
	{ id = "cool", name = "Cool", price = 150, icon = "😎" },
	{ id = "frog", name = "Frog", price = 200, icon = "🐸" },
	{ id = "pizza", name = "Pizza", price = 200, icon = "🍕" },
	{ id = "hundred", name = "Hundred", price = 300, icon = "💯" },
}

-- Horns: a sound id when you have one uploaded; otherwise a "HONK!" bubble.
Cosmetics.Horns = {
	{ id = "beep", name = "Beep Beep", price = 0, icon = "📯", text = "BEEP BEEP!", soundId = "" },
	{ id = "duck", name = "Rubber Duck", price = 100, icon = "🦆", text = "QUACK!", soundId = "" },
	{ id = "trumpet", name = "Fanfare", price = 200, icon = "🎺", text = "TA-DAAA!", soundId = "" },
	{ id = "moo", name = "Moo", price = 200, icon = "🐄", text = "MOOO!", soundId = "" },
	{ id = "boing", name = "Boing", price = 250, icon = "🪀", text = "BOING!", soundId = "" },
}

-- Trails streaming from the back of the kart.
Cosmetics.Trails = {
	{ id = "none", name = "None", price = 0, icon = "🚫", colors = {} },
	{ id = "smoke", name = "Puffy Smoke", price = 0, icon = "☁️", colors = { { 240, 240, 245 }, { 200, 200, 210 } } },
	{ id = "rainbow", name = "Rainbow", price = 300, icon = "🌈", colors = { { 255, 80, 80 }, { 255, 210, 60 }, { 80, 220, 120 }, { 80, 150, 255 }, { 190, 110, 255 } } },
	{ id = "fire", name = "Fire", price = 300, icon = "🔥", colors = { { 255, 220, 80 }, { 255, 110, 40 }, { 200, 40, 40 } } },
	{ id = "ice", name = "Ice", price = 300, icon = "❄️", colors = { { 230, 250, 255 }, { 120, 200, 255 } } },
	{ id = "bubbles", name = "Bubbles", price = 250, icon = "🫧", colors = { { 200, 235, 255 }, { 255, 200, 240 } } },
}

Cosmetics.PlateMaxLength = 8
Cosmetics.NameMaxLength = 16

local LISTS: { [string]: { any } } = {
	wheels = Cosmetics.Wheels,
	sticker = Cosmetics.Stickers,
	horn = Cosmetics.Horns,
	trail = Cosmetics.Trails,
}
Cosmetics.Lists = LISTS

function Cosmetics.find(kind: string, id: string?): any?
	if kind == "body" then
		for _, b in KartBodies.List do
			if b.id == id then
				return b
			end
		end
		return nil
	end
	for _, item in LISTS[kind] or {} do
		if item.id == id then
			return item
		end
	end
	return nil
end

function Cosmetics.price(kind: string, id: string): number?
	local item = Cosmetics.find(kind, id)
	if not item then
		return nil
	end
	return item.price or 0
end

-- Defaults every new player owns.
function Cosmetics.starterOwned(): { [string]: { [string]: boolean } }
	local owned: { [string]: { [string]: boolean } } = { body = {} }
	for _, b in KartBodies.List do
		if (b :: any).price == nil or (b :: any).price == 0 then
			owned.body[b.id] = true
		end
	end
	for kind, list in LISTS do
		owned[kind] = {}
		for _, item in list do
			if item.price == 0 then
				owned[kind][item.id] = true
			end
		end
	end
	return owned
end

-- Plate and name text: letters, numbers and spaces only, trimmed to length.
-- (The server also runs Roblox text filtering before anyone else sees it.)
function Cosmetics.cleanText(text: any, maxLength: number): string
	local s = if type(text) == "string" then text else ""
	s = string.gsub(s, "[^%w ]", "")
	s = string.gsub(s, "%s+", " ")
	s = string.gsub(s, "^%s+", "")
	s = string.gsub(s, "%s+$", "")
	return string.sub(s, 1, maxLength)
end

return Cosmetics
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Items</string>
          <string name="Source"><![CDATA[--!strict
-- Item definitions and the item box roll. Front runners mostly get defensive
-- items and modest traps; the middle gets a mix; the back gets more recovery
-- boosts and stronger attacks.
--
-- Every attack has a warning and a counter: rockets can be blocked with a
-- Bubble Shield or dodged sideways, bombs show a fuse, traps sit still where
-- you can see them, and a hit gives a few seconds of protection so nobody
-- gets juggled.

export type ItemDef = {
	id: string,
	name: string,
	icon: string,
	description: string,
	uses: number,
	front: number, -- roll weight in 1st
	back: number, -- roll weight in last
}

local Items = {}

Items.RouletteTime = 1.5 -- seconds of spinning before an item can be used
Items.BoxRespawn = 3
Items.MaxActiveHazards = 16 -- traps and projectiles on the track at once
Items.MaxTrapsPerRacer = 3

-- Tuning shared by server effects and tests.
Items.SodaBoost = 1.4
Items.ShieldTime = 12
Items.RocketSpeed = 170
Items.RocketLife = 6
Items.BombThrow = 45 -- studs ahead it lands
Items.BombFuse = 1.6
Items.BombRadius = 14
Items.JellyLife = 20
Items.JellyHits = 2
Items.JellySlow = 2
Items.MineLife = 25

Items.Defs = {
	turboSoda = { id = "turboSoda", name = "Turbo Soda", icon = "🥤", description = "A fizzy speed boost.", uses = 1, front = 8, back = 30 },
	windupRocket = { id = "windupRocket", name = "Wind-up Rocket", icon = "🚀", description = "Zooms along the road and pops on the first kart it meets. Hold back to fire it behind you.", uses = 1, front = 10, back = 26 },
	popcornBomb = { id = "popcornBomb", name = "Popcorn Bomb", icon = "🍿", description = "Throw it ahead (or drop it behind). Pops after a short fuse.", uses = 1, front = 14, back = 20 },
	jellyPuddle = { id = "jellyPuddle", name = "Jelly Puddle", icon = "🍮", description = "A sticky wobbly trap dropped behind you. Slows whoever drives in.", uses = 1, front = 26, back = 8 },
	bubbleShield = { id = "bubbleShield", name = "Bubble Shield", icon = "🫧", description = "Blocks one attack, then pops.", uses = 1, front = 24, back = 10 },
	springMine = { id = "springMine", name = "Spring Mine", icon = "🌀", description = "A springy trap dropped behind you. Boings karts into the air.", uses = 1, front = 18, back = 6 },
} :: { [string]: ItemDef }

Items.Order = { "turboSoda", "windupRocket", "popcornBomb", "jellyPuddle", "bubbleShield", "springMine" }

-- Weight of one item for a racer at `place` of `field`.
function Items.weight(id: string, place: number, field: number): number
	local def = Items.Defs[id]
	local f = if field > 1 then (place - 1) / (field - 1) else 0.5
	return math.max(def.front + (def.back - def.front) * f, 0)
end

-- r is a random number in [0, 1).
function Items.roll(place: number, field: number, r: number): string
	local total = 0
	for _, id in Items.Order do
		total += Items.weight(id, place, field)
	end
	local pick = r * total
	for _, id in Items.Order do
		pick -= Items.weight(id, place, field)
		if pick < 0 then
			return id
		end
	end
	return Items.Order[1]
end

-- Odds (0..1) of each item, for tests and an "item odds" screen.
function Items.odds(place: number, field: number): { [string]: number }
	local total = 0
	for _, id in Items.Order do
		total += Items.weight(id, place, field)
	end
	local out = {}
	for _, id in Items.Order do
		out[id] = Items.weight(id, place, field) / total
	end
	return out
end

-- Defensive = shield or trap; used to check the front gets more of them.
Items.Defensive = { bubbleShield = true, jellyPuddle = true, springMine = true }
Items.Recovery = { turboSoda = true, windupRocket = true }

return Items
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">KartBodies</string>
          <string name="Source"><![CDATA[--!strict
-- Kart body designs and paint. Bodies are looks only: speed and handling come
-- from the kart class (Karts.luau), so any body can be paired with any class.
--
-- Adding a body: copy one below and change its parts. Each part is a box,
-- ball, cylinder or wedge with a size and an offset from the kart's center
-- (cylinders run along their x size; rotate them to point elsewhere)
-- (x = right, y = up, z = back; the nose points toward -z). `role` picks the
-- colour: main/accent paint, dark trim, glass, chrome or light (glowing).

export type BodyPart = {
	size: { number },
	offset: { number },
	role: "main" | "accent" | "dark" | "glass" | "chrome" | "light",
	-- Ellipsoid = a smooth stretched sphere (best for rounded, toy-like shapes).
	shape: ("Block" | "Ball" | "Cylinder" | "Wedge" | "Ellipsoid")?,
	rotation: { number }?, -- degrees x, y, z
	color: { number }?, -- fixed colour instead of the role's (eyes, toast, cardboard)
	material: string?, -- e.g. "Glass" or "Neon" instead of the role's
	transparency: number?,
	reflectance: number?,
	-- Animated parts (client/KartVisuals): "blink" eyelids, "toast" pops up
	-- when boosting, "flap" wings, "flutter" laces, "claw" snips, "wobble"
	-- jelly, "rattle" lid, "orbit" lights circling the kart, "engine" an
	-- exposed motor's rumble (harder on the throttle).
	anim: string?,
	text: string?, -- marker drawing on both sides of this part
	bubbles: boolean?, -- this part blows bubbles
}

export type Body = {
	id: string,
	name: string,
	icon: string?,
	price: number?, -- coins to unlock (0 or nil = free)
	wheelRadius: number,
	wheelWidth: number,
	-- Bigger rear wheels (dragsters, hot rods). Default: same as the front.
	rearWheelRadius: number?,
	rearWheelWidth: number?,
	-- Realistic finish: glossy paint, polished chrome, rubber tyres on
	-- metal rims (KartRig). Cartoon bodies leave it off.
	realistic: boolean?,
	wheels: { { number } }, -- x, z of each wheel; the two with the largest z are rear wheels
	seat: { number }, -- where the driver sits
	exhaust: { number },
	parts: { BodyPart },
}

local KartBodies = {}

KartBodies.Default = "classic"

KartBodies.Palette = {
	{ 230, 60, 60 }, -- red
	{ 255, 140, 40 }, -- orange
	{ 255, 210, 50 }, -- yellow
	{ 120, 220, 90 }, -- lime
	{ 40, 170, 110 }, -- green
	{ 80, 200, 255 }, -- sky
	{ 40, 90, 220 }, -- blue
	{ 140, 80, 230 }, -- purple
	{ 255, 110, 190 }, -- pink
	{ 245, 245, 250 }, -- white
	{ 120, 120, 130 }, -- grey
	{ 25, 25, 30 }, -- black
}

