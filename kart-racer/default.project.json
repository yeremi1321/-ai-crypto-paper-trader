{
  "name": "kart-racer",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "Common": {
        "$path": "src/common"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "Lighting": {
      "$properties": {
        "Technology": "Future",
        "GlobalShadows": true,
        "Brightness": 3,
        "EnvironmentDiffuseScale": 0.5,
        "EnvironmentSpecularScale": 0.5
      }
    },
    "Workspace": {
      "$properties": {
        "Gravity": 150
      }
    }
  }
}