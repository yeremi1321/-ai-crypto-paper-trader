{
  "name": "kart-racer",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "Common": {
        "$path": "src/common"
      },
      "KartAssets": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true,
        "Trees": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        },
        "Pines": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        },
        "Rocks": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        },
        "Bushes": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        },
        "FarTrees": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        },
        "Sounds": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        },
        "Bodies": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        },
        "Tracks": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        }
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      },
      "$properties": {
        "NameDisplayDistance": 45,
        "HealthDisplayDistance": 0,
        "DevCameraOcclusionMode": "Invisicam",
        "CameraMaxZoomDistance": 80
      }
    },
    "Lighting": {
      "$properties": {
        "Technology": "Future",
        "GlobalShadows": true,
        "Brightness": 3,
        "EnvironmentDiffuseScale": 0.5,
        "EnvironmentSpecularScale": 0.5
      }
    },
    "Workspace": {
      "$properties": {
        "Gravity": 150,
        "StreamingEnabled": false
      },
      "Terrain": {
        "$className": "Terrain",
        "$properties": {
          "Decoration": true
        }
      }
    }
  }
}
