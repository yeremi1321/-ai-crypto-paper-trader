local T = require("./TestLib")
local PlayerProfile = require("../src/shared/PlayerProfile")
local CarCatalog = require("../src/shared/CarCatalog")

T.test("new players start with the starter car and some cash", function()
	local p = PlayerProfile.new()
	T.eq(#p.cars, 1)
	T.eq(p.cars[1].carId, CarCatalog.StarterCarId)
	T.ok(p.cash > 0)
end)

T.test("buying a car needs cash and a free bay", function()
	local p = PlayerProfile.new()
	p.cash = 100000
	local ok, err = PlayerProfile.buyCar(p, "ronin")
	T.ok(not ok)
	T.ok(string.find(err, "full"))
	T.ok(PlayerProfile.buyBay(p))
	T.ok(PlayerProfile.buyCar(p, "ronin"))
	T.eq(#p.cars, 2)
	T.eq(p.cash, 100000 - PlayerProfile.BayPrices[2] - CarCatalog.Cars.ronin.price)
	p.cash = 0
	PlayerProfile.buyBay(p)
	T.eq(p.garageBays, 2)
end)

T.test("installing swaps parts in the same slot back to inventory", function()
	local p = PlayerProfile.new()
	PlayerProfile.givePart(p, "engine1")
	PlayerProfile.givePart(p, "engine2")
	T.ok(PlayerProfile.installPart(p, 1, "engine1"))
	T.ok(PlayerProfile.installPart(p, 1, "engine2"))
	T.eq(#p.cars[1].parts, 1)
	T.eq(p.cars[1].parts[1], "engine2")
	T.eq(p.partsInventory.engine1, 1)
	T.eq(p.partsInventory.engine2, 0)
	T.ok(not PlayerProfile.installPart(p, 1, "turbo"))
end)

T.test("saved builds restore owned parts", function()
	local p = PlayerProfile.new()
	for _, id in { "engine1", "tiresDrift", "tiresRace" } do
		PlayerProfile.givePart(p, id)
	end
	PlayerProfile.installPart(p, 1, "engine1")
	PlayerProfile.installPart(p, 1, "tiresDrift")
	T.ok(PlayerProfile.saveBuild(p, 1, "drift"))
	PlayerProfile.installPart(p, 1, "tiresRace")
	T.ok(PlayerProfile.saveBuild(p, 1, "track"))
	T.ok(PlayerProfile.loadBuild(p, 1, "drift"))
	table.sort(p.cars[1].parts)
	T.eq(table.concat(p.cars[1].parts, ","), "engine1,tiresDrift")
	T.eq(p.partsInventory.tiresRace, 1)
	T.ok(not PlayerProfile.saveBuild(p, 1, "rally"))
end)

T.test("race results pay cash and district rep", function()
	local p = PlayerProfile.new()
	local cash0 = p.cash
	local cash, rep = PlayerProfile.recordResult(p, "circuit", "circuit", 1, 4, false)
	T.eq(p.cash, cash0 + cash)
	T.eq(p.rep.circuit, rep)
	T.eq(p.stats.wins, 1)
end)

T.test("discoveries only reward once", function()
	local p = PlayerProfile.new()
	T.ok(PlayerProfile.discover(p, "x"))
	T.ok(not PlayerProfile.discover(p, "x"))
end)

T.test("migrate fills missing fields and repairs bad data", function()
	local p = PlayerProfile.migrate({ cash = 50, cars = {}, activeCar = 9 })
	T.eq(p.cash, 50)
	T.eq(#p.cars, 1)
	T.eq(p.activeCar, 1)
	T.eq(p.garageBays, 1)
	T.eq(PlayerProfile.migrate(nil).cash, PlayerProfile.new().cash)
end)

T.test("paint is clamped", function()
	local p = PlayerProfile.new()
	PlayerProfile.setPaint(p, 1, 300, -5, 12.7)
	T.eq(p.cars[1].paint[1], 255)
	T.eq(p.cars[1].paint[2], 0)
	T.eq(p.cars[1].paint[3], 12)
end)
