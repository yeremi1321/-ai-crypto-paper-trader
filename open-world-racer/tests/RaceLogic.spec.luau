local T = require("./TestLib")
local RaceLogic = require("../src/shared/RaceLogic")

T.test("checkpoints must be hit in order", function()
	local race = RaceLogic.new("x", 3, 1, 0)
	RaceLogic.addRacer(race, 1, "a")
	T.eq(RaceLogic.hitCheckpoint(race, 1, 2, 1), "ignored")
	T.eq(RaceLogic.hitCheckpoint(race, 1, 1, 1), "checkpoint")
	T.eq(RaceLogic.hitCheckpoint(race, 1, 1, 2), "ignored")
	T.eq(RaceLogic.hitCheckpoint(race, 1, 2, 3), "checkpoint")
	T.eq(RaceLogic.hitCheckpoint(race, 1, 3, 4), "finished")
	T.eq(race.racers[1].finishTime, 4)
end)

T.test("laps wrap back to the first checkpoint", function()
	local race = RaceLogic.new("x", 2, 2, 10)
	RaceLogic.addRacer(race, 1, "a")
	T.eq(RaceLogic.hitCheckpoint(race, 1, 1, 11), "checkpoint")
	T.eq(RaceLogic.hitCheckpoint(race, 1, 2, 12), "lap")
	T.eq(RaceLogic.hitCheckpoint(race, 1, 1, 13), "checkpoint")
	T.eq(RaceLogic.hitCheckpoint(race, 1, 2, 14), "finished")
	T.eq(race.racers[1].finishTime, 4)
end)

T.test("standings order finishers, then progress, then DNF", function()
	local race = RaceLogic.new("x", 2, 1, 0)
	for id = 1, 4 do
		RaceLogic.addRacer(race, id, `p{id}`)
	end
	RaceLogic.hitCheckpoint(race, 3, 1, 1)
	RaceLogic.hitCheckpoint(race, 3, 2, 2) -- p3 wins
	RaceLogic.hitCheckpoint(race, 2, 1, 3) -- p2 later at cp1
	RaceLogic.hitCheckpoint(race, 1, 1, 2) -- p1 earlier at cp1
	RaceLogic.removeRacer(race, 4)
	local s = RaceLogic.standings(race)
	T.eq(s[1].id, 3)
	T.eq(s[2].id, 1)
	T.eq(s[3].id, 2)
	T.eq(s[4].id, 4)
	T.ok(s[4].dnf)
end)

T.test("race ends when everyone finished or DNF", function()
	local race = RaceLogic.new("x", 1, 1, 0, 60)
	RaceLogic.addRacer(race, 1, "a")
	RaceLogic.addRacer(race, 2, "b")
	RaceLogic.hitCheckpoint(race, 1, 1, 5)
	T.ok(not RaceLogic.isOver(race))
	RaceLogic.tick(race, 30)
	T.ok(not RaceLogic.isOver(race))
	RaceLogic.tick(race, 61)
	T.ok(RaceLogic.isOver(race))
	T.ok(race.racers[2].dnf)
	T.ok(not race.racers[1].dnf)
end)

T.test("finished racer cannot be marked DNF by leaving", function()
	local race = RaceLogic.new("x", 1, 1, 0)
	RaceLogic.addRacer(race, 1, "a")
	RaceLogic.hitCheckpoint(race, 1, 1, 5)
	RaceLogic.removeRacer(race, 1)
	T.ok(not race.racers[1].dnf)
end)
